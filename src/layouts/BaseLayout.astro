---
import '../styles/global.css';
import SocialBar from '../components/SocialBar.astro';
import NavBar from '../components/NavBar.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  /** Shared-link display title; defaults to the browser-tab title. The
      homepage overrides neither — its title is already the bare brand name. */
  ogTitle?: string;
  /** Set on pages that must not be indexed (404). */
  noindex?: boolean;
  showSocialBar?: boolean;
}

const { title, description, ogTitle = title, noindex = false, showSocialBar = true } = Astro.props;

// Astro.site comes from astro.config.mjs, so canonical/og URLs are absolute
// production URLs even on previews and local builds — which is what social
// scrapers and Google need to see.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL('/og-image.png', Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- viewport-fit=cover lets the page extend under notches/home
       indicators; components pad with env(safe-area-inset-*) -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <!-- Tints Safari's chrome on iOS 15–17. iOS 26 (Liquid Glass) ignores
       theme-color entirely and samples the body's background-color for the
       status-bar strip instead — that's handled by the charcoal body in
       global.css. Kept for the older-iOS audience. -->
  <meta name="theme-color" content="#1c1c22" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonicalUrl} />

  <!-- Icons: SVG for modern browsers, ICO (16/32/48) as fallback — the 48px
       entry is what lets Google show the logo beside search results.
       sizes="32x32" on the ICO keeps Chrome from preferring it over the SVG. -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Share metadata: og:title is the display title in link previews; the
       descriptive pitch belongs in og:description, not the title. -->
  <meta property="og:site_name" content="Trash Talk NYC" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Trash Talk NYC cleanup-vest logo" />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <slot name="head" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Nunito:wght@400;600;700;800&family=Space+Mono:wght@400;700&display=swap"
    rel="stylesheet"
  />
</head>
<body>

  {showSocialBar && <SocialBar />}

  <NavBar />

  <main>
    <slot />
  </main>

  <SiteFooter />

  <script>
    import { getCurrentLang, setLang } from '../lib/language';

    // Expose for debugging and any future inline handlers
    window.setLang = setLang;
    window.getCurrentLang = getCurrentLang;

    // Apply saved language on load
    if (getCurrentLang() !== 'en') {
      setLang(getCurrentLang());
    }
  </script>

</body>
</html>
