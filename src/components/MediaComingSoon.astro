---
/**
 * Body of a More Media subpage whose channel isn't live yet (Podcast,
 * Substack as of 2026-10). Honest by design: no invented shows,
 * episodes, or posts — just that it's coming and how to hear when it
 * lands. When the captain supplies the channel URL in socials.ts, the
 * section's `comingSoon` flag in media.ts flips and this gets replaced
 * by real content.
 */
import { Image } from 'astro:assets';
import MediaHero from './MediaHero.astro';
import MediaSubnav from './MediaSubnav.astro';
import { MORE_MEDIA_PATH, getMediaSection, type MediaSectionId } from '../lib/media';
import vestSticker from '../assets/vest-sticker.png';

interface Props {
  id: MediaSectionId;
  /** Line drawing for the poster (pre-colored for paper). */
  ill: { src: string };
  /** What's coming, in a sentence. */
  note: { en: string; es: string };
}

const { id, ill, note } = Astro.props;
const section = getMediaSection(id);
---

<MediaHero
  eyebrow={{ en: 'More Media', es: 'Más Medios' }}
  eyebrowHref={MORE_MEDIA_PATH}
  title={[{ en: section.label, es: section.label }]}
  description={section.blurb}
/>

<MediaSubnav current={id} />

<section class="wrap cs-body">
  <div class="cs-card paste">
    <Image src={vestSticker} alt="" class="slap cs-slap" width={104} densities={[1, 2]} />
    <img class="ill cs-ill" src={ill.src} alt="" />
    <div>
      <h2 class="cs-title" data-en="Coming soon" data-es="Muy pronto">Coming soon</h2>
      <p class="cs-note" data-en={note.en} data-es={note.es}>{note.en}</p>
      <div class="cs-row">
        <a class="btn btn-primary" href="/#signup" data-en="Join the newsletter →" data-es="Únete al boletín →">Join the newsletter →</a>
        <a class="btn btn-purple" href={MORE_MEDIA_PATH} data-en="Back to More Media" data-es="Volver a Más Medios">Back to More Media</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cs-body { padding-block: 64px 80px; }

  .cs-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    align-items: center;
    max-width: 860px;
    margin-inline: auto;
    padding: 30px 20px 28px;
    background-color: var(--paper);
    color: var(--black);
  }

  .cs-card :global(.cs-slap) {
    top: -32px;
    right: -6px;
    width: 74px;
    height: auto;
    transform: rotate(9deg);
  }

  .cs-ill { width: 130px; }

  .cs-title {
    font-size: 2.8rem;
    line-height: 0.95;
    color: var(--purple);
  }

  .cs-note {
    margin: 10px 0 20px;
    font-size: 1.15rem;
    line-height: 1.45;
  }

  .cs-row { display: flex; flex-wrap: wrap; gap: 14px; }
  .cs-row .btn { width: 100%; }

  @media (min-width: 761px) {
    .cs-body { padding-block: 80px 104px; }

    .cs-card {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 36px;
      padding: 40px clamp(24px, 4vw, 48px);
    }

    .cs-card :global(.cs-slap) { top: -40px; right: -22px; width: 104px; }
    .cs-ill { width: 170px; }
    .cs-title { font-size: clamp(3rem, 4.4vw, 4rem); }
    .cs-row .btn { width: auto; }
  }
</style>
