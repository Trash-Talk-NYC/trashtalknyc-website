---
/**
 * Interactive Leaflet + OpenStreetMap map of the Clean Zone (data:
 * src/lib/clean-zone.ts). No API key: OSM raster tiles, desaturated via
 * CSS so the map reads as printed paper instead of a stock web widget.
 *
 * Each zone is drawn as a shaded area — the primary visual — with a
 * sticker-style name tag; the individual tree beds inside it are small
 * secondary dots, detailed on demand (zone popup lists them, each dot has
 * its own mini popup). Zones without a hand-traced `outline` are shaded
 * as a circle sized to their beds (zoneCircle).
 *
 * The frame is the site's polaroid device — white lip, tape strips, press
 * shadow — so the map sits in the street-poster language like a map taped
 * to a lamppost.
 *
 * Log cards (or anything else) can focus a zone by dispatching
 *   document.dispatchEvent(new CustomEvent('clean-zone:focus', { detail: { id } }))
 * with a CleanZone id.
 */
---

<div class="cz-frame">
  <div
    class="cz-map"
    id="cleanZoneMap"
    role="region"
    aria-label="Map of Clean Zone areas"
  ></div>
  <div class="cz-caption" data-en="The Clean Zone · NYC" data-es="La Zona Limpia · NYC">The Clean Zone · NYC</div>
</div>

<script>
  import * as L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import { cleanZones, zoneCircle, type CleanZone, type TreeBed } from '../lib/clean-zone';
  import { getCurrentLang, onLanguageChange, type Lang } from '../lib/language';

  // Zone shading palette — hex mirrors of the --charcoal/--yellow tokens,
  // because Leaflet writes these as SVG attributes where CSS vars can't reach.
  const ZONE_STYLE: L.PathOptions = {
    color: '#1c1c22',
    weight: 2.5,
    dashArray: '7 7',
    fillColor: '#f5d000',
    fillOpacity: 0.28,
  };
  const ZONE_STYLE_ACTIVE: L.PathOptions = { fillOpacity: 0.45 };

  const BED_DOT_STYLE: L.PathOptions = {
    color: '#1c1c22',
    weight: 2,
    fillColor: '#f5d000',
    fillOpacity: 1,
  };

  // Popup/tooltip DOM is created by Leaflet at runtime, so it can't use the
  // data-en/data-es attribute swap — it re-renders via onLanguageChange.
  function zonePopupHtml(zone: CleanZone, lang: Lang): string {
    const chip = lang === 'es' ? 'Protegida' : 'Guarded';
    const date = lang === 'es' ? zone.dateEs : zone.dateEn;
    const name = lang === 'es' ? zone.nameEs : zone.nameEn;
    const desc = lang === 'es' ? zone.descriptionEs : zone.descriptionEn;
    const bedLabel =
      lang === 'es'
        ? `${zone.beds.length} ${zone.beds.length === 1 ? 'alcorque' : 'alcorques'}`
        : `${zone.beds.length} ${zone.beds.length === 1 ? 'tree bed' : 'tree beds'}`;
    return [
      '<div class="cz-popup">',
      `<span class="cz-popup-chip">${chip} · ${date}</span>`,
      `<strong class="cz-popup-name">${name}</strong>`,
      `<span class="cz-popup-area">${zone.neighborhood} · ${zone.borough}</span>`,
      `<p class="cz-popup-desc">${desc}</p>`,
      `<span class="cz-popup-bedcount">${bedLabel}</span>`,
      '<ul class="cz-popup-beds">',
      ...zone.beds.map((bed) => `<li>${bed.address}</li>`),
      '</ul>',
      '</div>',
    ].join('');
  }

  // Bed dot detail is language-neutral: an address plus, when recorded,
  // the NYC Parks Forestry tree-point ids for cross-reference.
  function bedPopupHtml(bed: TreeBed): string {
    const ids = bed.nycTreeIds?.length
      ? `<span class="cz-popup-bed-ids">NYC ${bed.nycTreeIds.map((id) => `#${id}`).join(', ')}</span>`
      : '';
    return `<div class="cz-popup"><strong class="cz-popup-bed-address">${bed.address}</strong>${ids}</div>`;
  }

  const mapEl = document.getElementById('cleanZoneMap');
  // A zone needs beds (or a traced outline) to be shadable; skip the whole
  // map rather than fitting bounds to nothing when the list is mid-edit.
  const shadableZones = cleanZones.filter((z) => z.beds.length > 0 || z.outline?.length);

  if (mapEl && shadableZones.length > 0) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const map = L.map(mapEl, {
      // Wheel zoom hijacks page scrolling on desktop; the +/− controls
      // and pinch zoom cover zooming.
      scrollWheelZoom: false,
      // One-finger drag would trap page scrolling on touch screens, so it
      // starts off there and comes back the moment the visitor zooms —
      // i.e. once they're deliberately engaging with the map.
      dragging: !L.Browser.mobile,
      zoomAnimation: !reducedMotion,
      fadeAnimation: !reducedMotion,
      markerZoomAnimation: !reducedMotion,
    });
    map.on('zoomstart', () => map.dragging.enable());

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);

    // Permanent zone tooltips project to screen space the moment they are
    // bound, so the map must have a view before any shape is added; the
    // fitBounds below refines it once the shapes exist.
    const seedPoints = shadableZones.flatMap((z) =>
      z.beds.length > 0 ? z.beds.map((b) => [b.lat, b.lng] as [number, number]) : (z.outline ?? []),
    );
    const seedLat = seedPoints.reduce((sum, p) => sum + p[0], 0) / seedPoints.length;
    const seedLng = seedPoints.reduce((sum, p) => sum + p[1], 0) / seedPoints.length;
    map.setView([seedLat, seedLng], 15);

    const initialLang = getCurrentLang();
    const zoneShapes = new Map<string, L.Path & { getBounds(): L.LatLngBounds }>();

    shadableZones.forEach((zone) => {
      let shape: (L.Path & { getBounds(): L.LatLngBounds }) | null = null;
      if (zone.outline?.length) {
        shape = L.polygon(zone.outline, ZONE_STYLE);
      } else {
        const circle = zoneCircle(zone);
        if (circle) shape = L.circle([circle.lat, circle.lng], { ...ZONE_STYLE, radius: circle.radiusMeters });
      }
      if (!shape) return;

      shape.addTo(map);
      shape.bindTooltip(initialLang === 'es' ? zone.nameEs : zone.nameEn, {
        permanent: true,
        direction: 'center',
        // Nudged up so the tag doesn't sit on the bed dots at the centroid
        offset: [0, -30],
        className: 'cz-zone-tag',
      });
      shape.bindPopup(zonePopupHtml(zone, initialLang), { maxWidth: 320 });
      shape.on('mouseover', () => shape!.setStyle(ZONE_STYLE_ACTIVE));
      shape.on('mouseout', () => shape!.setStyle(ZONE_STYLE));
      zoneShapes.set(zone.id, shape);

      // Secondary detail: a small dot per tree bed inside the shading
      zone.beds.forEach((bed) => {
        L.circleMarker([bed.lat, bed.lng], { ...BED_DOT_STYLE, radius: 5 })
          .addTo(map)
          .bindPopup(bedPopupHtml(bed), { maxWidth: 240 });
      });
    });

    const allBounds = L.latLngBounds([]);
    zoneShapes.forEach((shape) => allBounds.extend(shape.getBounds()));
    map.fitBounds(allBounds, { padding: [40, 40], maxZoom: 16 });

    onLanguageChange((lang) => {
      shadableZones.forEach((zone) => {
        const shape = zoneShapes.get(zone.id);
        if (!shape) return;
        shape.setTooltipContent(lang === 'es' ? zone.nameEs : zone.nameEn);
        shape.setPopupContent(zonePopupHtml(zone, lang));
      });
    });

    document.addEventListener('clean-zone:focus', (event) => {
      const id = (event as CustomEvent<{ id: string }>).detail?.id;
      const shape = id ? zoneShapes.get(id) : undefined;
      if (!shape) return;
      mapEl.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'center' });
      map.fitBounds(shape.getBounds(), {
        padding: [32, 32],
        maxZoom: 17,
        animate: !reducedMotion,
      });
      shape.openPopup();
    });
  }
</script>

<style>
  /* Polaroid treatment shared with the About page photo: white frame with
     a deep captioned lip, pinned down with two tape strips */
  .cz-frame {
    position: relative;
    background: #fff;
    border: 1px solid #d8d3c8;
    border-radius: 4px;
    padding: clamp(0.5rem, 1.5vw, 0.8rem);
    box-shadow: var(--press);
  }

  .cz-frame::before,
  .cz-frame::after {
    content: '';
    position: absolute;
    top: -0.8rem;
    width: 4.5rem;
    height: 1.6rem;
    background: rgba(245, 208, 0, 0.75);
    border: 1px solid rgba(201, 169, 0, 0.4);
    z-index: 1;
  }

  .cz-frame::before { left: 6%; transform: rotate(-6deg); }
  .cz-frame::after { right: 6%; transform: rotate(5deg); }

  .cz-map {
    height: clamp(340px, 62svh, 560px);
    border: 2px solid var(--charcoal);
    border-radius: 3px;
    background: var(--cream);
    /* Leaflet panes/controls carry z-indexes up to 1000; contain them so
       they never float over the sticky nav (z-index 200) while scrolling */
    position: relative;
    z-index: 0;
  }

  .cz-caption {
    padding: 0.9rem 0.5rem 0.6rem;
    text-align: center;
    font-family: 'Space Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--charcoal);
  }

  /* ── Leaflet overrides — runtime-created DOM, hence :global() ── */

  /* Desaturate the OSM tiles into the site's paper palette; the shaded
     yellow zones and purple accents then read as ink printed on top */
  .cz-map :global(.leaflet-tile-pane) {
    filter: grayscale(1) sepia(0.14) brightness(1.04) contrast(0.92);
  }

  /* Zone name tag: sticker chip pinned at the center of the shading.
     Leaflet tooltips ship a white card + arrow; restyle both away. */
  .cz-map :global(.cz-zone-tag) {
    background: var(--yellow);
    color: var(--charcoal);
    border: 2px solid var(--charcoal);
    border-radius: 4px;
    box-shadow: var(--press-sm);
    padding: 0.3em 0.7em;
    font-family: 'Space Mono', monospace;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    white-space: nowrap;
    transform: rotate(-2deg);
  }

  .cz-map :global(.cz-zone-tag::before) { display: none; }

  /* Popup: pressed off-white card matching the site's card language */
  .cz-map :global(.leaflet-popup-content-wrapper) {
    background: var(--off-white);
    color: var(--charcoal);
    border: 2px solid var(--charcoal);
    border-radius: var(--radius-sm);
    box-shadow: var(--press-sm);
  }

  .cz-map :global(.leaflet-popup-tip) {
    background: var(--charcoal);
  }

  .cz-map :global(.leaflet-popup-content) {
    margin: 1rem 1.1rem;
    font-family: 'Nunito', sans-serif;
    line-height: 1.55;
  }

  .cz-map :global(.leaflet-container a.leaflet-popup-close-button) {
    color: var(--charcoal);
    font-weight: 700;
  }

  .cz-map :global(.cz-popup) {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .cz-map :global(.cz-popup-chip) {
    align-self: flex-start;
    background: var(--yellow);
    border: 1.5px solid var(--charcoal);
    border-radius: 3px;
    padding: 0.2em 0.6em;
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .cz-map :global(.cz-popup-name) {
    margin-top: 0.3rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .cz-map :global(.cz-popup-area) {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--purple);
  }

  .cz-map :global(.cz-popup-desc) {
    margin: 0.35rem 0 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: #4a4850;
  }

  .cz-map :global(.cz-popup-bedcount) {
    margin-top: 0.6rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--charcoal);
  }

  .cz-map :global(.cz-popup-beds) {
    margin: 0.15rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .cz-map :global(.cz-popup-beds li) {
    font-size: 0.82rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .cz-map :global(.cz-popup-beds li::before) {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    background: var(--yellow);
    border: 1.5px solid var(--charcoal);
    border-radius: 50%;
  }

  .cz-map :global(.cz-popup-bed-address) {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .cz-map :global(.cz-popup-bed-ids) {
    font-family: 'Space Mono', monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--purple);
  }

  /* Zoom control: pressed street-sign buttons */
  .cz-map :global(.leaflet-bar) {
    border: 2px solid var(--charcoal);
    border-radius: 6px;
    box-shadow: var(--press-sm);
  }

  .cz-map :global(.leaflet-bar a) {
    width: 34px;
    height: 34px;
    line-height: 34px;
    background: var(--off-white);
    color: var(--charcoal);
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    border-bottom-color: var(--charcoal);
  }

  .cz-map :global(.leaflet-bar a:hover) {
    background: var(--yellow);
    color: var(--charcoal);
  }

  @media (pointer: coarse) {
    .cz-map :global(.leaflet-bar a) {
      width: var(--tap);
      height: var(--tap);
      line-height: var(--tap);
    }
  }

  .cz-map :global(.leaflet-control-attribution) {
    background: rgba(247, 244, 237, 0.85);
    font-size: 0.62rem;
    color: var(--gray);
  }

  .cz-map :global(.leaflet-control-attribution a) {
    color: var(--purple);
  }
</style>
