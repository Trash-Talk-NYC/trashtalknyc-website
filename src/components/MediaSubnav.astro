---
/**
 * Channel switcher under each More Media subpage hero, so readers can
 * hop between YouTube, Podcast, and Substack without going back up to
 * the overview. Labels are brand names, identical in EN and ES.
 */
import { mediaSections, type MediaSectionId } from '../lib/media';

interface Props {
  current: MediaSectionId;
}

const { current } = Astro.props;
---

<nav class="wrap ms-nav" aria-labelledby="msNavLabel">
  <span class="sr-only" id="msNavLabel" data-en="More Media channels" data-es="Canales de Más Medios">More Media channels</span>
  <ul>
    {mediaSections.map((s) => (
      <li>
        <a href={s.path} aria-current={s.id === current ? 'page' : undefined}>{s.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .ms-nav { padding-top: 28px; }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 8px 18px;
    border: 2.5px solid var(--beige);
    border-radius: 999px;
    font-family: var(--mono);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--beige);
    text-decoration: none;
  }

  a:hover { background: var(--beige); color: var(--black); }

  a[aria-current='page'] {
    background: var(--yellow);
    border-color: var(--yellow);
    color: var(--black);
  }
</style>
