---
/**
 * Subpage switcher under each More Media subpage hero, so readers can
 * hop between YouTube, Podcast, Substack, and Photo Albums without going
 * back up to the overview. Channel labels are brand names, identical in
 * EN and ES; Photo Albums translates.
 */
import { PHOTO_ALBUMS, mediaSections, type MediaSectionId } from '../lib/media';

interface Props {
  current: MediaSectionId | 'photo-albums';
}

const { current } = Astro.props;
---

<nav class="wrap ms-nav" aria-labelledby="msNavLabel">
  <span class="sr-only" id="msNavLabel" data-en="More Media pages" data-es="Páginas de Más Medios">More Media pages</span>
  <ul>
    {mediaSections.map((s) => (
      <li>
        <a href={s.path} aria-current={s.id === current ? 'page' : undefined}>{s.label}</a>
      </li>
    ))}
    <li>
      <a href={PHOTO_ALBUMS.path} aria-current={current === 'photo-albums' ? 'page' : undefined} data-en={PHOTO_ALBUMS.label.en} data-es={PHOTO_ALBUMS.label.es}>{PHOTO_ALBUMS.label.en}</a>
    </li>
  </ul>
</nav>

<style>
  .ms-nav { padding-top: 28px; }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px 12px;
    list-style: none;
  }

  /* Tape labels (captain's S2 pick, 2026-10-09): each link is a slightly
     tilted strip of translucent yellow tape with ragged ends; the current
     page is solid yellow tape */
  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 8px 20px;
    background: rgba(243, 207, 2, 0.2);
    clip-path: polygon(0 6%, 3% 0, 97% 4%, 100% 12%, 97% 30%, 100% 50%, 97% 72%, 100% 92%, 96% 100%, 3% 96%, 0 86%, 3% 66%, 0 46%, 3% 26%);
    font-family: var(--mono);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--beige);
    text-decoration: none;
    transform: rotate(-1.5deg);
    transition: background 0.15s;
  }

  li:nth-child(even) a { transform: rotate(1.5deg); }

  a:hover { background: rgba(243, 207, 2, 0.4); }

  a[aria-current='page'] {
    background: var(--yellow);
    color: var(--black);
  }

  @media (prefers-reduced-motion: reduce) {
    a { transition: none; }
  }
</style>
