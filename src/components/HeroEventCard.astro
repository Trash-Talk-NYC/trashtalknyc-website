---
import type { EventCardProps } from '../lib/events';
import { formatDate, formatTime } from '../lib/events';

interface Props extends EventCardProps {}

const { id, name, url, startIso, endIso, location, mapUrls } = Astro.props;

const dateStr = formatDate(startIso, 'en');
const timeStr = formatTime(startIso, 'en') + ' – ' + formatTime(endIso, 'en');

const rsvpBtnId = `eb-trigger-hero-${id}`;
---

<div class="next-event-card" data-start={startIso}>
  <div class="card-eyebrow">
    <span class="pulse-dot"></span>
    <span data-en="Next club event" data-es="Próximo evento">Next club event</span>
  </div>

  <div class="card-event-name">{name}</div>

  <div class="card-meta">
    <div class="card-meta-row">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
      <span class="hero-date-text" data-start-iso={startIso}>{dateStr}</span>
    </div>
    <div class="card-meta-row">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
      <span>{timeStr}</span>
    </div>
    {location && (
      <div class="card-meta-row">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        <span>{location}</span>
      </div>
    )}
    {mapUrls && (
      <div class="card-meta-row">
        <span class="map-links">
          <a class="map-link" href={mapUrls.google} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
            Google Maps
          </a>
          <a class="map-link" href={mapUrls.apple} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
            Apple Maps
          </a>
        </span>
      </div>
    )}
  </div>

  <div class="card-countdown">
    <span class="cd-label-top" data-en="Time left" data-es="Tiempo restante">Time left</span>
    <div class="cd-unit"><span class="cd-num" id="cdD">--</span><span class="cd-sub" data-en="days" data-es="días">days</span></div>
    <span class="cd-sep">:</span>
    <div class="cd-unit"><span class="cd-num" id="cdH">--</span><span class="cd-sub" data-en="hrs" data-es="hrs">hrs</span></div>
    <span class="cd-sep">:</span>
    <div class="cd-unit"><span class="cd-num" id="cdM">--</span><span class="cd-sub" data-en="min" data-es="min">min</span></div>
  </div>

  <a
    class="btn-rsvp"
    id={rsvpBtnId}
    href={url}
    target="_blank"
    rel="noopener"
    data-event-id={id}
    data-url={url}
    data-name={name}
    data-date={dateStr}
    data-time={timeStr}
    data-loc={location}
    data-en="RSVP for this event"
    data-es="Regístrate aquí"
  >
    RSVP for this event
  </a>
</div>

<script>
  import { createCountdown } from '../lib/countdown';

  const card = document.querySelector<HTMLElement>('.next-event-card[data-start]');
  if (card) {
    const startIso = card.dataset.start!;
    const pad = (n: number) => String(n).padStart(2, '0');

    const cleanup = createCountdown(startIso, ({ days, hours, minutes }) => {
      const dEl = document.getElementById('cdD');
      if (!dEl) return;
      dEl.textContent = pad(days);
      document.getElementById('cdH')!.textContent = pad(hours);
      document.getElementById('cdM')!.textContent = pad(minutes);
    });

    document.addEventListener('astro:before-swap', cleanup, { once: true });
  }
</script>

<style>
  .next-event-card {
    background: rgba(247,244,237,0.04);
    border: 1px solid rgba(155,93,229,0.3);
    border-radius: 18px;
    padding: 2rem 2.25rem;
    position: relative;
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(155,93,229,0.2), 0 0 0 1px rgba(155,93,229,0.08);
  }
  .next-event-card::after {
    content: '';
    position: absolute; bottom: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--yellow) 40%, transparent);
  }

  .card-eyebrow {
    font-size: 0.62rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.22em;
    color: var(--yellow); margin-bottom: 1rem;
    display: flex; align-items: center; gap: 0.5rem;
  }
  .pulse-dot {
    width: 7px; height: 7px; background: var(--yellow); border-radius: 50%;
    display: inline-block; flex-shrink: 0;
    animation: pulseDot 1.6s ease-in-out infinite;
  }
  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(0.55); }
  }

  .card-event-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    color: var(--off-white); line-height: 1; letter-spacing: 0.02em; margin-bottom: 1.1rem;
  }

  .card-meta { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem; }
  .card-meta-row {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.75rem; font-weight: 700; color: rgba(247,244,237,0.55);
  }
  .card-meta-row svg { width: 12px; height: 12px; color: var(--purple-light); flex-shrink: 0; }

  .map-links { gap: 0.5rem; margin-top: 0.5rem; }
  .map-link {
    font-size: 0.65rem; padding: 0.3rem 0.7rem; border-radius: 6px;
    color: rgba(247,244,237,0.7);
    background: rgba(247,244,237,0.08); border: 1.5px solid rgba(247,244,237,0.2);
    display: inline-flex; align-items: center; gap: 0.2rem;
    text-decoration: none; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    white-space: nowrap; transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .map-link:hover { background: rgba(247,244,237,0.15); border-color: rgba(247,244,237,0.45); color: #fff; }
  .map-link svg { width: 10px; height: 10px; flex-shrink: 0; }

  .card-countdown {
    display: flex; align-items: center; gap: 0.5rem;
    margin-bottom: 1.5rem; padding: 0.85rem 1rem;
    background: rgba(247,244,237,0.04);
    border: 1px solid rgba(247,244,237,0.07); border-radius: 10px;
  }
  .cd-label-top {
    font-size: 0.55rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.14em;
    color: rgba(247,244,237,0.25); margin-right: auto; white-space: nowrap;
  }
  .cd-unit { text-align: center; min-width: 36px; }
  .cd-num {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.9rem;
    color: var(--off-white); line-height: 1; display: block;
  }
  .cd-sub {
    font-family: 'Space Mono', monospace; font-size: 0.44rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.14em;
    color: rgba(247,244,237,0.28); display: block; margin-top: 1px;
  }
  .cd-sep {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.6rem;
    color: rgba(247,244,237,0.15); margin-top: -4px; align-self: flex-start; padding-top: 2px;
  }

  .btn-rsvp {
    background: var(--yellow); color: var(--charcoal);
    font-family: 'Nunito', sans-serif; font-size: 0.75rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.14em;
    padding: 0.7rem 1.4rem; border: 2px solid var(--yellow); border-radius: 8px;
    cursor: pointer; white-space: nowrap; text-decoration: none; display: inline-block;
    transition: background 160ms var(--ease-out), border-color 160ms var(--ease-out), color 160ms var(--ease-out), transform 120ms var(--ease-out), box-shadow 160ms var(--ease-out);
    box-shadow: 0 3px 14px rgba(245,208,0,0.22);
  }
  @media (hover: hover) and (pointer: fine) {
    .btn-rsvp:hover { background: var(--purple-light); border-color: var(--purple-light); color: #fff; box-shadow: 0 5px 20px rgba(155,93,229,0.3); transform: translateY(-1px); }
    .btn-rsvp:active { transform: scale(0.97); transition-duration: 80ms; }
  }
</style>
