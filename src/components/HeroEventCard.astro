---
import { Image } from 'astro:assets';
import type { EventCardProps } from '../lib/events';
import { formatDate, formatTime } from '../lib/events';
import vestSticker from '../assets/vest-sticker.png';

/**
 * The next club event as a wheatpasted poster inside the Club Events
 * brick hero: "Next club event" accent line, the event name in body
 * type (per the style guide, event names are Barlow, not display),
 * date/time/place rows, and the RSVP button wired to the same
 * Eventbrite widget bootstrap as the list cards.
 */
type Props = EventCardProps;

const { id, name, url, startIso, endIso, location } = Astro.props;

const dateStr = formatDate(startIso, 'en');
const dateStrEs = formatDate(startIso, 'es');
const timeStr = formatTime(startIso, 'en') + ' – ' + formatTime(endIso, 'en');

const btnId = `eb-hero-${id}`;
---

<article class="next paste f-sticker">
  <Image src={vestSticker} alt="" class="slap next-slap" width={96} densities={[1, 2]} />
  <div class="mono" data-en="Next club event" data-es="Próximo evento del club">Next club event</div>
  <h2>{name}</h2>
  <div class="ev-details">
    <span>
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
      <span data-en={dateStr} data-es={dateStrEs}>{dateStr}</span>
    </span>
    <span>
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
      {timeStr}
    </span>
    {location && (
      <span>
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
        {location}
      </span>
    )}
  </div>
  <button
    class="btn btn-purple next-rsvp"
    id={btnId}
    data-event-id={id}
    data-url={url}
    data-name={name}
    data-date={dateStr}
    data-time={timeStr}
    data-loc={location}
    data-en="RSVP →"
    data-es="Regístrate →"
  >
    RSVP &rarr;
  </button>
</article>

<style>
  .next {
    position: relative;
    width: min(35rem, 100%);
    --flyer-bg: var(--paper);
    color: var(--purple);
    padding: 24px 18px 20px;
  }

  .next .mono { color: var(--black); }

  .next h2 {
    font-family: var(--body);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.02;
    font-size: 2.3rem;
    margin: 10px 0 18px;
  }

  .ev-details {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-weight: 500;
    font-size: 1rem;
  }

  .ev-details > span { display: inline-flex; align-items: center; gap: 7px; }
  .ev-details svg { width: 17px; height: 17px; stroke: var(--purple); fill: none; flex: none; }

  .next-rsvp { margin-top: 22px; width: 100%; }

  .next :global(.next-slap) {
    top: -30px;
    right: -6px;
    width: 72px;
    height: auto;
    transform: rotate(10deg);
  }

  @media (min-width: 761px) {
    .next { padding: 30px 28px 26px; }
    .next h2 { font-size: clamp(2.2rem, 4vw, 3.2rem); }
    .next-rsvp { width: auto; }

    .next :global(.next-slap) {
      top: -40px;
      right: -22px;
      width: 96px;
    }
  }
</style>
