---
import type { BoroughId } from '../lib/events';

interface Props {
  borough: BoroughId;
}

const { borough } = Astro.props;
---

{/* Riso-duotone toon fruits, brand tokens only: yellow/purple/green fills,
    charcoal outlines, off-white die-cut sticker backing. Each fruit is
    "spoiled" — bites, bruises, a fly — per the borough-as-bitten-fruit hero
    concept. Decorative: the owning button carries the accessible name. */}

{borough === 'manhattan' && (
  <svg class="fruit-svg" viewBox="0 0 120 120" aria-hidden="true">
    <g stroke-linejoin="round" stroke-linecap="round">
      {/* die-cut backing */}
      <path
        d="M60 36 C52 24 32 22 22 36 C12 50 14 74 24 90 C34 105 50 112 60 106 C70 112 84 108 92 96 A14 14 0 0 1 91 72 A13 13 0 0 1 92 46 C86 32 70 28 60 36 Z"
        fill="var(--off-white)" stroke="var(--off-white)" stroke-width="11"
      />
      {/* body */}
      <path
        d="M60 36 C52 24 32 22 22 36 C12 50 14 74 24 90 C34 105 50 112 60 106 C70 112 84 108 92 96 A14 14 0 0 1 91 72 A13 13 0 0 1 92 46 C86 32 70 28 60 36 Z"
        fill="var(--yellow)" stroke="var(--charcoal)" stroke-width="4.5"
      />
      {/* toon shade along the left */}
      <path d="M27 42 C20 54 21 74 29 87 C24 72 23 54 27 42 Z" fill="var(--yellow-dark)" opacity="0.9" />
      {/* bite flesh */}
      <path
        d="M92 96 A14 14 0 0 1 91 72 A13 13 0 0 1 92 46 C99 56 102 84 92 96 Z"
        fill="var(--off-white)" stroke="var(--charcoal)" stroke-width="3.5"
      />
      <ellipse cx="95" cy="70" rx="2.6" ry="4.5" fill="var(--charcoal)" transform="rotate(12 95 70)" />
      {/* highlight */}
      <ellipse cx="42" cy="44" rx="7" ry="4" fill="var(--off-white)" opacity="0.85" transform="rotate(-24 42 44)" />
      {/* stem + leaf */}
      <path d="M60 34 C59 26 61 20 65 15" fill="none" stroke="var(--charcoal)" stroke-width="4.5" />
      <path d="M64 24 C70 14 84 12 90 16 C88 26 74 32 64 24 Z" fill="var(--green-light)" stroke="var(--charcoal)" stroke-width="3.5" />
      <path d="M68 23 C74 19 82 17 87 17" fill="none" stroke="var(--charcoal)" stroke-width="2" />
      {/* fly */}
      <circle cx="106" cy="26" r="3.2" fill="var(--charcoal)" />
      <ellipse cx="103" cy="22" rx="3" ry="1.6" fill="none" stroke="var(--charcoal)" stroke-width="1.5" transform="rotate(-30 103 22)" />
      <path d="M96 36 C99 33 97 30 100 27" fill="none" stroke="var(--charcoal)" stroke-width="1.5" opacity="0.6" />
    </g>
  </svg>
)}

{borough === 'brooklyn' && (
  <svg class="fruit-svg" viewBox="0 0 120 120" aria-hidden="true">
    {/* Half-peeled pop-art banana (peel flaps down, bitten flesh up) */}
    <g stroke-linejoin="round" stroke-linecap="round">
      {/* die-cut backing */}
      <g fill="var(--off-white)" stroke="var(--off-white)" stroke-width="11">
        <path d="M46 62 C41 44 44 26 54 12 A7 7 0 0 1 64 14 A6 6 0 0 0 73 18 C78 34 78 48 76 62 Z" />
        <path d="M47 62 C32 68 21 82 18 100 C32 97 45 84 50 68 Z" />
        <path d="M75 62 C90 68 101 82 104 100 C90 97 77 84 72 68 Z" />
        <path d="M47 62 C43 82 46 96 56 108 L66 108 C76 96 79 82 75 62 Z" />
      </g>
      {/* flesh with bite scallops at the tip */}
      <path
        d="M46 62 C41 44 44 26 54 12 A7 7 0 0 1 64 14 A6 6 0 0 0 73 18 C78 34 78 48 76 62 Z"
        fill="var(--off-white)" stroke="var(--charcoal)" stroke-width="4"
      />
      <path d="M56 22 C53 36 52 48 53 58" fill="none" stroke="var(--warm-gray)" stroke-width="2.5" opacity="0.8" />
      {/* peel flaps */}
      <path d="M47 62 C32 68 21 82 18 100 C32 97 45 84 50 68 Z" fill="var(--yellow)" stroke="var(--charcoal)" stroke-width="4" />
      <path d="M75 62 C90 68 101 82 104 100 C90 97 77 84 72 68 Z" fill="var(--yellow)" stroke="var(--charcoal)" stroke-width="4" />
      <path d="M28 88 C34 84 40 78 44 70" fill="none" stroke="var(--yellow-dark)" stroke-width="3" />
      <path d="M94 88 C88 84 82 78 78 70" fill="none" stroke="var(--yellow-dark)" stroke-width="3" />
      {/* front peel body */}
      <path d="M47 62 C43 82 46 96 56 108 L66 108 C76 96 79 82 75 62 Z" fill="var(--yellow)" stroke="var(--charcoal)" stroke-width="4.5" />
      <path d="M53 68 C51 82 53 94 59 104" fill="none" stroke="var(--yellow-dark)" stroke-width="3.5" />
      {/* bruise spots */}
      <ellipse cx="64" cy="84" rx="4.2" ry="3" fill="var(--charcoal)" opacity="0.9" transform="rotate(20 64 84)" />
      <circle cx="60" cy="98" r="2.2" fill="var(--charcoal)" opacity="0.9" />
      <ellipse cx="90" cy="86" rx="3" ry="2.2" fill="var(--charcoal)" opacity="0.85" transform="rotate(45 90 86)" />
      <ellipse cx="30" cy="90" rx="2.8" ry="2" fill="var(--charcoal)" opacity="0.85" transform="rotate(-45 30 90)" />
      {/* fly by the bite */}
      <circle cx="84" cy="22" r="3.2" fill="var(--charcoal)" />
      <ellipse cx="81" cy="18" rx="3" ry="1.6" fill="none" stroke="var(--charcoal)" stroke-width="1.5" transform="rotate(-30 81 18)" />
      <path d="M76 32 C79 29 77 26 80 23" fill="none" stroke="var(--charcoal)" stroke-width="1.5" opacity="0.6" />
    </g>
  </svg>
)}

{borough === 'queens' && (
  <svg class="fruit-svg" viewBox="0 0 120 120" aria-hidden="true">
    <g stroke-linejoin="round" stroke-linecap="round">
      {/* die-cut backing: crown + body */}
      <g fill="var(--off-white)" stroke="var(--off-white)" stroke-width="11">
        <path d="M60 40 C48 34 40 22 42 8 C50 14 54 20 56 26 C56 16 58 8 62 2 C66 10 67 18 66 26 C70 18 76 12 84 9 C84 22 74 34 60 40 Z" />
        <ellipse cx="60" cy="76" rx="27" ry="34" />
      </g>
      {/* crown — Queens wears one */}
      <path d="M60 40 C48 34 40 22 42 8 C50 14 54 20 56 26 C56 16 58 8 62 2 C66 10 67 18 66 26 C70 18 76 12 84 9 C84 22 74 34 60 40 Z"
        fill="var(--green-light)" stroke="var(--charcoal)" stroke-width="4" />
      <path d="M56 26 C56 16 58 8 62 2 C66 10 67 18 66 26 L63 34 Z" fill="var(--green)" stroke="var(--charcoal)" stroke-width="2.5" />
      {/* drooping spoiled leaf */}
      <path d="M44 26 C36 28 30 34 28 42 C36 42 42 36 44 26 Z" fill="var(--green)" stroke="var(--charcoal)" stroke-width="3" />
      {/* body */}
      <ellipse cx="60" cy="76" rx="27" ry="34" fill="var(--yellow)" stroke="var(--charcoal)" stroke-width="4.5" />
      {/* crosshatch, clipped */}
      <clipPath id="pine-clip"><ellipse cx="60" cy="76" rx="25" ry="32" /></clipPath>
      <g clip-path="url(#pine-clip)" stroke="var(--charcoal)" stroke-width="2" opacity="0.45" fill="none">
        <path d="M20 66 L100 106" /><path d="M20 46 L100 86" /><path d="M20 26 L100 66" />
        <path d="M100 66 L20 106" /><path d="M100 46 L20 86" /><path d="M100 26 L20 66" />
      </g>
      {/* toon shade + bruise */}
      <path d="M40 56 C34 68 34 88 40 98 C32 88 31 66 40 56 Z" fill="var(--yellow-dark)" opacity="0.9" />
      <ellipse cx="74" cy="94" rx="7" ry="5.5" fill="var(--yellow-dark)" stroke="var(--charcoal)" stroke-width="2" transform="rotate(-20 74 94)" />
      <circle cx="72" cy="93" r="1.6" fill="var(--charcoal)" opacity="0.8" />
      {/* highlight */}
      <ellipse cx="50" cy="58" rx="5" ry="3" fill="var(--off-white)" opacity="0.85" transform="rotate(-30 50 58)" />
      {/* fly */}
      <circle cx="99" cy="46" r="3.2" fill="var(--charcoal)" />
      <ellipse cx="96" cy="42" rx="3" ry="1.6" fill="none" stroke="var(--charcoal)" stroke-width="1.5" transform="rotate(-30 96 42)" />
      <path d="M92 56 C95 53 93 50 96 47" fill="none" stroke="var(--charcoal)" stroke-width="1.5" opacity="0.6" />
    </g>
  </svg>
)}

{borough === 'bronx' && (
  <svg class="fruit-svg" viewBox="0 0 120 120" aria-hidden="true">
    <g stroke-linejoin="round" stroke-linecap="round">
      {/* die-cut backing */}
      <path
        d="M60 36 C40 36 26 52 26 72 C26 92 42 108 62 108 C78 108 92 98 96 84 A13 13 0 0 1 88 62 A12 12 0 0 1 92 46 C84 39 72 36 60 36 Z"
        fill="var(--off-white)" stroke="var(--off-white)" stroke-width="11"
      />
      {/* body */}
      <path
        d="M60 36 C40 36 26 52 26 72 C26 92 42 108 62 108 C78 108 92 98 96 84 A13 13 0 0 1 88 62 A12 12 0 0 1 92 46 C84 39 72 36 60 36 Z"
        fill="var(--purple)" stroke="var(--charcoal)" stroke-width="4.5"
      />
      {/* bite flesh */}
      <path d="M96 84 A13 13 0 0 1 88 62 A12 12 0 0 1 92 46 C99 54 101 72 96 84 Z" fill="var(--off-white)" stroke="var(--charcoal)" stroke-width="3.5" />
      <ellipse cx="94" cy="66" rx="2.4" ry="4" fill="var(--charcoal)" transform="rotate(14 94 66)" />
      {/* cleft + toon highlight */}
      <path d="M56 38 C48 52 46 74 52 92" fill="none" stroke="var(--charcoal)" stroke-width="3" opacity="0.55" />
      <path d="M38 52 C32 60 30 74 34 86 C26 72 28 58 38 52 Z" fill="var(--purple-light)" opacity="0.95" />
      <ellipse cx="44" cy="52" rx="6" ry="3.5" fill="var(--off-white)" opacity="0.8" transform="rotate(-28 44 52)" />
      {/* stem + leaf */}
      <path d="M62 36 C61 28 63 22 67 17" fill="none" stroke="var(--charcoal)" stroke-width="4.5" />
      <path d="M66 26 C60 16 48 13 41 16 C44 26 57 32 66 26 Z" fill="var(--green-light)" stroke="var(--charcoal)" stroke-width="3.5" />
      {/* stink squiggles */}
      <path d="M78 24 C81 20 78 16 81 12" fill="none" stroke="var(--charcoal)" stroke-width="2" opacity="0.5" />
      <path d="M88 30 C91 26 88 22 91 18" fill="none" stroke="var(--charcoal)" stroke-width="2" opacity="0.5" />
      {/* fly */}
      <circle cx="104" cy="32" r="3.2" fill="var(--charcoal)" />
      <ellipse cx="101" cy="28" rx="3" ry="1.6" fill="none" stroke="var(--charcoal)" stroke-width="1.5" transform="rotate(-30 101 28)" />
    </g>
  </svg>
)}

{borough === 'staten-island' && (
  <svg class="fruit-svg" viewBox="0 0 120 120" aria-hidden="true">
    <g stroke-linejoin="round" stroke-linecap="round">
      {/* die-cut backing */}
      <path
        d="M14 46 L34 46 A11 11 0 0 0 56 46 L68 46 A10 10 0 0 0 88 46 L106 46 A46 46 0 0 1 14 46 Z"
        fill="var(--off-white)" stroke="var(--off-white)" stroke-width="11"
      />
      {/* rind (outer arc) */}
      <path d="M14 46 A46 46 0 0 0 106 46 L106 46 A46 46 0 0 1 14 46 Z" fill="none" />
      <path
        d="M14 46 L34 46 A11 11 0 0 0 56 46 L68 46 A10 10 0 0 0 88 46 L106 46 A46 46 0 0 1 14 46 Z"
        fill="var(--purple-light)" stroke="var(--charcoal)" stroke-width="4.5"
      />
      {/* green rind band along the bottom arc */}
      <path d="M17 56 A42 42 0 0 0 103 56" fill="none" stroke="var(--green)" stroke-width="9" />
      <path d="M18 52 A43 43 0 0 0 102 52" fill="none" stroke="var(--off-white)" stroke-width="3" />
      <path d="M14 46 A46 46 0 0 0 106 46" fill="none" stroke="var(--charcoal)" stroke-width="4.5" />
      {/* seeds */}
      <ellipse cx="40" cy="62" rx="2.6" ry="4.4" fill="var(--charcoal)" transform="rotate(18 40 62)" />
      <ellipse cx="60" cy="70" rx="2.6" ry="4.4" fill="var(--charcoal)" transform="rotate(-8 60 70)" />
      <ellipse cx="80" cy="60" rx="2.6" ry="4.4" fill="var(--charcoal)" transform="rotate(-24 80 60)" />
      <ellipse cx="52" cy="54" rx="2.2" ry="3.6" fill="var(--charcoal)" transform="rotate(30 52 54)" />
      {/* dripping juice */}
      <path d="M46 42 C46 46 44 48 44 51 A2.5 2.5 0 0 0 49 51 C49 48 47 46 47 42 Z" fill="var(--purple-light)" stroke="var(--charcoal)" stroke-width="2" />
      {/* highlight */}
      <path d="M28 56 A34 34 0 0 0 42 74" fill="none" stroke="var(--off-white)" stroke-width="3" opacity="0.7" />
      {/* fly */}
      <circle cx="98" cy="28" r="3.2" fill="var(--charcoal)" />
      <ellipse cx="95" cy="24" rx="3" ry="1.6" fill="none" stroke="var(--charcoal)" stroke-width="1.5" transform="rotate(-30 95 24)" />
      <path d="M88 38 C91 35 89 32 92 29" fill="none" stroke="var(--charcoal)" stroke-width="1.5" opacity="0.6" />
    </g>
  </svg>
)}
