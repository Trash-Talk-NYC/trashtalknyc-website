---
/**
 * A section background in the captain's A4 treatment (2026-10-09):
 * a real wall photo with a rough torn edge, toned by what the section is
 * about —
 *   cleanup:  the given wall photo in a Deep Purple duotone
 *   planting: the chalked-sidewalk photo tinted Post No Bills green, with
 *             the chalk pieces themselves masked back to full color
 * Drop it as the FIRST child of a section with the global `.wall` class;
 * it paints under everything else in that section.
 *
 * The chalk mask (src/assets/walls/chalk-mask.png, generated by
 * scripts/generate-chalk-mask.mjs) keeps the chalk pieces AND the chalk
 * drawn on the concrete in color (captain, 2026-10-09). It is made from
 * that one photo, so planting always uses it, and photo and mask always
 * share one size and position so they stay registered.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import chalkPhoto from '../assets/walls/wall-chalk-sidewalk.jpg';
import chalkMaskPng from '../assets/walls/chalk-mask.png';

interface Props {
  kind: 'cleanup' | 'planting';
  /** The wall photo for a cleanup section (planting always uses the chalk). */
  src?: ImageMetadata;
  /** Which edges are torn. */
  tear?: 'top' | 'bottom' | 'both';
  /** Extra Roadtop Black shade over the photo for text contrast, 0–1. */
  dim?: number;
  /**
   * Cleanup only: how strongly the purple duotone covers the photo, 0–1.
   * Below 1 the wall's own colors show through (Club Events, captain).
   */
  duotone?: number;
  /** Varies the tear so neighboring sections don't rip identically. */
  seed?: number;
  /**
   * Planting only: a selector (inside the section) for the text column
   * the chalk pieces must stay out from behind. The photo and its mask
   * are then framed together so that column sits on bare sidewalk.
   */
  keepClear?: string;
}

const { kind, src, tear = 'both', dim = 0.35, duotone = 1, seed = 1, keepClear } = Astro.props;
if (kind === 'cleanup' && !src) throw new Error('SectionWall: a cleanup wall needs a photo (src)');

// 2400 is the chalk original's full width, so zoomed framings stay sharp
const photo = await getImage({ src: kind === 'planting' ? chalkPhoto : src!, width: kind === 'planting' ? 2400 : 1600, format: 'webp' });

/** A ragged edge: deterministic jitter so builds are stable. */
function edge(fromTop: boolean): string[] {
  let s = seed * 9301 + (fromTop ? 49297 : 233280);
  const rand = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
  const pts: string[] = [];
  for (let i = 0; i <= 40; i++) {
    const x = i * 2.5;
    const depth = (4 + rand() * 18).toFixed(1);
    pts.push(fromTop ? `${x}% ${depth}px` : `${x}% calc(100% - ${depth}px)`);
  }
  return fromTop ? pts : pts.reverse();
}

const top = tear === 'top' || tear === 'both' ? edge(true) : ['0 0', '100% 0'];
const bottom = tear === 'bottom' || tear === 'both' ? edge(false) : ['100% 100%', '0 100%'];
const clip = `polygon(${[...top, ...bottom].join(',')})`;

const bg = `background-image:url(${photo.src})`;
// webp keeps the alpha channel the mask needs at a fraction of the PNG's bytes
const mask = kind === 'planting' ? await getImage({ src: chalkMaskPng, width: 1600, format: 'webp' }) : null;
---

<div class:list={['sw-layer', `sw-${kind}`]} aria-hidden="true" style={`clip-path:${clip};--sw-dim:${dim}`} data-keep-clear={kind === 'planting' ? keepClear : undefined}>
  {kind === 'cleanup' ? (
    <>
      {duotone < 1 && <div class="sw-photo" style={bg}></div>}
      <div class="sw-photo sw-duo" style={`${bg};opacity:${duotone}`}></div>
    </>
  ) : (
    <>
      <div class="sw-photo" style={bg}></div>
      <div class="sw-tint"></div>
    </>
  )}
  <div class="sw-shade"></div>
  {mask && <div class="sw-photo sw-pop" style={`${bg};--sw-mask:url(${mask.src})`}></div>}
  {(kind === 'planting' || duotone < 1) && <div class="sw-legible"></div>}
</div>

<script>
  // Frames the chalk photo (and its mask, identically) as zoomed OUT as
  // possible while no chalk PIECE sits behind the section's text column
  // (captain: "zoom the chalk picture out a little"; the drawn chalk lines
  // may run behind the copy, softened by .sw-legible). The pieces, as
  // rotated rectangles in the photo's 2000×1333 frame (from the hand-placed
  // src/assets/walls/chalk-mask.svg): [cx, cy, w, h, degrees].
  const PIECES: Array<[number, number, number, number, number]> = [
    [1045, 462, 170, 62, 20], [808, 640, 195, 72, 35], [1400, 572, 125, 62, 15],
    [1485, 555, 125, 62, -80], [1825, 442, 105, 58, -5], [1220, 755, 195, 72, 35],
    [1840, 782, 195, 68, 60], [1752, 885, 105, 62, -50], [1677, 1010, 115, 72, 75],
    [162, 760, 82, 82, 0], [155, 845, 72, 100, 0], [281, 812, 64, 92, 0],
  ];
  const FRAME_W = 2000;
  const FRAME_H = 1333;
  const RATIO = 1.5; // the chalk photo is 3:2
  const CLEARANCE = 24;

  // Each piece's axis-aligned bounds as fractions of the photo
  const boxes = PIECES.map(([cx, cy, w, h, deg]) => {
    const t = (deg * Math.PI) / 180;
    const hw = Math.abs((w / 2) * Math.cos(t)) + Math.abs((h / 2) * Math.sin(t));
    const hh = Math.abs((w / 2) * Math.sin(t)) + Math.abs((h / 2) * Math.cos(t));
    return { l: (cx - hw) / FRAME_W, r: (cx + hw) / FRAME_W, t: (cy - hh) / FRAME_H, b: (cy + hh) / FRAME_H };
  });

  function frame(layer: HTMLElement) {
    const section = layer.parentElement;
    const column = section?.querySelector(layer.dataset.keepClear ?? '');
    if (!section || !column) return;
    const s = section.getBoundingClientRect();
    const kids = Array.from(column.children, (c) => c.getBoundingClientRect());
    const col = {
      l: Math.min(...kids.map((k) => k.left)) - s.left - CLEARANCE,
      r: Math.max(...kids.map((k) => k.right)) - s.left + CLEARANCE,
      t: Math.min(...kids.map((k) => k.top)) - s.top - CLEARANCE,
      b: Math.max(...kids.map((k) => k.bottom)) - s.top + CLEARANCE,
    };
    // Smallest photo width that still covers the section…
    const minW = Math.max(s.width, s.height * RATIO);
    // …then zoom in only as far as it takes, trying the photo anchored
    // left and right, until no piece overlaps the column
    for (let w = minW; w <= minW * 4; w *= 1.02) {
      const h = w / RATIO;
      for (const anchorRight of [true, false]) {
        const x0 = anchorRight ? s.width - w : 0;
        const clear = boxes.every((p) => {
          const pl = x0 + p.l * w, pr = x0 + p.r * w, pt = p.t * h, pb = p.b * h;
          const visible = pr > 0 && pl < s.width && pb > 0 && pt < s.height;
          return !visible || pr < col.l || pl > col.r || pb < col.t || pt > col.b;
        });
        if (clear) {
          layer.style.setProperty('--sw-size', `${Math.ceil(w)}px auto`);
          layer.style.setProperty('--sw-pos', anchorRight ? '100% 0' : '0 0');
          return;
        }
      }
    }
  }

  document.querySelectorAll<HTMLElement>('.sw-layer[data-keep-clear]').forEach((layer) => {
    frame(layer);
    if (layer.parentElement) new ResizeObserver(() => frame(layer)).observe(layer.parentElement);
  });
</script>

<style>
  .sw-layer {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    /* Blends below stay inside this layer */
    isolation: isolate;
  }

  .sw-photo,
  .sw-tint,
  .sw-shade {
    position: absolute;
    inset: 0;
  }

  /* Photo and mask share one framing (see the script) */
  .sw-photo {
    background-size: var(--sw-size, cover);
    background-position: var(--sw-pos, center);
    background-repeat: no-repeat;
  }

  /* Purple duotone: the photo's luminance over Deep Purple */
  .sw-duo {
    background-color: var(--purple);
    background-blend-mode: luminosity;
    filter: brightness(0.85) contrast(1.1);
  }

  .sw-tint {
    background: var(--green);
    mix-blend-mode: color;
    opacity: 0.55;
  }

  .sw-shade { background: rgba(29, 29, 35, var(--sw-dim)); }

  /* Sections set their copy left, so a busy wall (bright chalk, or
     graffiti showing its own colors) is softened on that side only */
  .sw-legible {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(29, 29, 35, 0.6) 0%, rgba(29, 29, 35, 0.35) 40%, transparent 70%);
  }

  /* The chalk pieces cut out of the tint and shade, brightened */
  .sw-pop {
    filter: saturate(1.6) contrast(1.08) brightness(1.08);
    -webkit-mask: var(--sw-mask) var(--sw-pos, center) / var(--sw-size, cover) no-repeat;
    mask: var(--sw-mask) var(--sw-pos, center) / var(--sw-size, cover) no-repeat;
  }
</style>
