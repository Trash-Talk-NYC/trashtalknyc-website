---
/**
 * A section background in the captain's A4 treatment (2026-10-09):
 * a real wall photo with a rough torn edge, toned by what the section is
 * about —
 *   cleanup:  the given wall photo in a Deep Purple duotone, or in its
 *             own colors with `duotone={0}` (the captain's vivid street
 *             walls behind cream flyers, 2026-10-15)
 *   planting: the chalked-sidewalk photo tinted Post No Bills green, with
 *             the chalk pieces themselves masked back to full color
 * Drop it as the FIRST child of a section with the global `.wall` class;
 * it paints under everything else in that section.
 *
 * The chalk mask (src/assets/walls/chalk-mask.png, generated by
 * scripts/generate-chalk-mask.mjs) keeps the chalk pieces AND the chalk
 * drawn on the concrete in color (captain, 2026-10-09). It is made from
 * that one photo, so planting always uses it, and photo and mask always
 * share one size and position so they stay registered.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import chalkPhoto from '../assets/walls/wall-chalk-sidewalk.jpg';
import chalkMaskPng from '../assets/walls/chalk-mask.png';

interface Props {
  kind: 'cleanup' | 'planting';
  /** The wall photo for a cleanup section (planting always uses the chalk). */
  src?: ImageMetadata;
  /** Which edges are torn. */
  tear?: 'top' | 'bottom' | 'both';
  /** Extra Roadtop Black shade over the photo for text contrast, 0–1. */
  dim?: number;
  /**
   * Cleanup only: how strongly the purple duotone covers the photo, 0–1.
   * Below 1 the wall's own colors show through (Club Events, captain);
   * 0 is the photo in full color.
   */
  duotone?: number;
  /** Varies the tear so neighboring sections don't rip identically. */
  seed?: number;
  /**
   * Draws a thin Poster Beige line along the torn edges, for a wall that
   * meets another dark section and would otherwise blur into it (Contact,
   * captain 2026-10-10).
   */
  outline?: boolean;
}

const { kind, src, tear = 'both', dim = 0.35, duotone = 1, seed = 1, outline = false } = Astro.props;
if (kind === 'cleanup' && !src) throw new Error('SectionWall: a cleanup wall needs a photo (src)');

// 2400 is the chalk original's full width, so zoomed framings stay sharp
const photo = await getImage({ src: kind === 'planting' ? chalkPhoto : src!, width: kind === 'planting' ? 2400 : 1600, format: 'webp' });

/** A ragged edge: deterministic jitter so builds are stable. */
function edge(fromTop: boolean): string[] {
  let s = seed * 9301 + (fromTop ? 49297 : 233280);
  const rand = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
  const pts: string[] = [];
  for (let i = 0; i <= 40; i++) {
    const x = i * 2.5;
    const depth = (4 + rand() * 18).toFixed(1);
    pts.push(fromTop ? `${x}% ${depth}px` : `${x}% calc(100% - ${depth}px)`);
  }
  return fromTop ? pts : pts.reverse();
}

const top = tear === 'top' || tear === 'both' ? edge(true) : ['0 0', '100% 0'];
const bottom = tear === 'bottom' || tear === 'both' ? edge(false) : ['100% 100%', '0 100%'];
const clip = `polygon(${[...top, ...bottom].join(',')})`;

const bg = `background-image:url(${photo.src})`;
// webp keeps the alpha channel the mask needs at a fraction of the PNG's bytes
const mask = kind === 'planting' ? await getImage({ src: chalkMaskPng, width: 1600, format: 'webp' }) : null;
---

<!-- The outline is a drop-shadow on this unclipped wrapper, so it follows
     the clipped layer's torn edge exactly -->
<div class:list={['sw-wrap', { 'sw-outlined': outline }]} aria-hidden="true">
<div class:list={['sw-layer', `sw-${kind}`]} style={`clip-path:${clip};--sw-dim:${dim}`}>
  {kind === 'cleanup' ? (
    <>
      {duotone < 1 && <div class="sw-photo" style={bg}></div>}
      {duotone > 0 && <div class="sw-photo sw-duo" style={`${bg};opacity:${duotone}`}></div>}
    </>
  ) : (
    <>
      <div class="sw-photo" style={bg}></div>
      <div class="sw-tint"></div>
    </>
  )}
  {dim > 0 && <div class="sw-shade"></div>}
  {mask && <div class="sw-photo sw-pop" style={`${bg};--sw-mask:url(${mask.src})`}></div>}
  {/* A full-color wall (no duotone, no dim) carries no shade at all: its
       text sits on cream cards instead (captain, 2026-10-15) */}
  {(kind === 'planting' || (duotone > 0 && duotone < 1)) && <div class="sw-legible"></div>}
</div>
</div>


<style>
  .sw-wrap {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .sw-outlined {
    filter: drop-shadow(0 -3px 0 var(--beige)) drop-shadow(0 3px 0 var(--beige));
  }

  .sw-layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* Blends below stay inside this layer */
    isolation: isolate;
  }

  .sw-photo,
  .sw-tint,
  .sw-shade {
    position: absolute;
    inset: 0;
  }

  /* Photo and mask share one framing, so the mask stays registered.
     Plain cover (2026-10-10): the earlier zoom that kept every chalk piece
     off the copy made the photo unrecognizable on phones (captain), so the
     whole drawing shows and .sw-legible shades the copy side instead.
     A section may set --sw-size / --sw-pos to frame it differently. */
  .sw-photo {
    background-size: var(--sw-size, cover);
    background-position: var(--sw-pos, center);
    background-repeat: no-repeat;
  }

  /* Purple duotone: the photo's luminance over Deep Purple */
  .sw-duo {
    background-color: var(--purple);
    background-blend-mode: luminosity;
    filter: brightness(0.85) contrast(1.1);
  }

  .sw-tint {
    background: var(--green);
    mix-blend-mode: color;
    opacity: 0.55;
  }

  .sw-shade { background: rgba(29, 29, 35, var(--sw-dim)); }

  /* Sections set their copy left, so a busy wall (bright chalk, or
     graffiti showing its own colors) is softened on that side only */
  /* Phones stack the copy across the full width, so the shade is even
     there; desktop sets copy left, so only that side darkens */
  .sw-legible {
    position: absolute;
    inset: 0;
    background: rgba(29, 29, 35, 0.3);
  }

  @media (min-width: 761px) {
    .sw-legible {
      background: linear-gradient(90deg, rgba(29, 29, 35, 0.7) 0%, rgba(29, 29, 35, 0.45) 42%, transparent 72%);
    }
  }

  /* The chalk pieces cut out of the tint and shade, brightened */
  .sw-pop {
    filter: saturate(1.6) contrast(1.08) brightness(1.08);
    -webkit-mask: var(--sw-mask) var(--sw-pos, center) / var(--sw-size, cover) no-repeat;
    mask: var(--sw-mask) var(--sw-pos, center) / var(--sw-size, cover) no-repeat;
  }
</style>
