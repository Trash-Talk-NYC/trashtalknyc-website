---

{socials.map((s) => (
  <a
    class="social-link"
    href={s.href}
    target={s.placeholder ? undefined : '_blank'}
    rel={s.placeholder ? undefined : 'noopener'}
  >
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d={ICON_PATHS[s.icon]} /></svg>
    {s.label}
  </a>
))}

<style>
  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    text-decoration: none;
    min-height: 24px;
    transition: color 0.15s, opacity 0.15s;
  }

  .social-link svg {
    width: 1.1em;
    height: 1.1em;
    fill: currentColor;
    flex-shrink: 0;
  }

  @media (pointer: coarse) {
    .social-link { min-height: var(--tap); }
  }
</style>
