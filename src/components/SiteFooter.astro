---
/**
 * Single site-wide footer. Replaces the three per-page footer variants
 * that existed before the redesign (row layout on home, two slightly
 * different centered layouts on events/about) with one centered design.
 */
import SocialLinks from './SocialLinks.astro';
import { FOUNDER_PATH } from '../lib/founder';

const year = new Date().getFullYear();
---

<footer>
  <div class="footer-logo">Trash Talk NYC</div>
  <ul class="footer-links">
    <li><a href="/" data-en="Home" data-es="Inicio">Home</a></li>
    <li><a href="/events" data-en="Club Events" data-es="Eventos del Club">Club Events</a></li>
    <li><a href="/#signup" data-en="Join" data-es="Únete">Join</a></li>
    <li><a href="/about" data-en="About" data-es="Nosotros">About</a></li>
    <li><a href={FOUNDER_PATH} data-en="From the Founder" data-es="Del Fundador">From the Founder</a></li>
    <li><a href="/recruit" data-en="Open Roles" data-es="Puestos Abiertos">Open Roles</a></li>
    <li><a href="/contact" data-en="Contact" data-es="Contacto">Contact</a></li>
  </ul>
  <div class="footer-socials">
    <SocialLinks all />
  </div>
  <div class="footer-copy">© {year} Trash Talk NYC</div>
</footer>

<style>
  /* One deliberate vertical rhythm: logo, links, socials, copyright at
     an even --space-sm beat. Wrapped rows (links at phone widths,
     socials now that there are four) get NO extra row gap — the items'
     own min-height tap targets provide the breathing room, so wrapping
     never doubles the spacing. */
  footer {
    background: var(--charcoal);
    padding:
      var(--space-lg)
      max(var(--gutter), var(--safe-right))
      max(var(--space-lg), var(--safe-bottom))
      max(var(--gutter), var(--safe-left));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    border-top: 3px solid var(--purple-light);
    text-align: center;
  }

  .footer-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: var(--step-2);
    color: var(--yellow);
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    gap: 0 clamp(1rem, 3vw, 2rem);
    list-style: none;
    flex-wrap: wrap;
  }

  .footer-links a {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--paper-a55);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    transition: color 0.15s;
  }

  .footer-links a:hover { color: var(--yellow); }

  .footer-socials {
    width: 100%;
    max-width: 480px;
    display: flex;
    justify-content: center;
    gap: 0 clamp(1rem, 3vw, 1.5rem);
    flex-wrap: wrap;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--paper-a12);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--paper-a35);
  }

  .footer-socials :global(.social-link) { min-height: 32px; }
  .footer-socials :global(.social-link:hover) { color: var(--purple-light); }

  .footer-copy {
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(247, 244, 237, 0.22);
    line-height: 1;
  }

  @media (pointer: coarse) {
    .footer-links a,
    .footer-socials :global(.social-link) { min-height: var(--tap); }
  }

  /* Four socials at phone widths wrap 3+1, stranding the last one;
     capping the row width forces an even 2+2 instead */
  @media (max-width: 480px) {
    .footer-socials { max-width: 300px; }
  }
</style>
