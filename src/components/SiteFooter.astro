---
/**
 * Single site-wide footer in the 2026-10 identity: logo stickers,
 * links, the "Keep NYC clean." sign-off, and the full sticker icon
 * row (Instagram, TikTok, LinkedIn, YouTube, Facebook). No bricks
 * here — the captain removed the footer brick frame (2026-09-30).
 */
import { Image } from 'astro:assets';
import SocialLinks from './SocialLinks.astro';
import { FOUNDER_PATH } from '../lib/founder';
import wordmarkSticker from '../assets/wordmark-sticker.png';
import vestSticker from '../assets/vest-sticker.png';

const year = new Date().getFullYear();
---

<footer>
  <div class="wrap foot-grid">
    <div class="foot-stickers">
      <Image src={wordmarkSticker} alt="Trash Talk NYC" class="foot-logo" width={260} densities={[1, 2]} />
      <Image src={vestSticker} alt="" class="slap slap-foot" width={148} densities={[1, 2]} />
    </div>
    <ul class="foot-links">
      <li><a href="/" data-en="Home" data-es="Inicio">Home</a></li>
      <li><a href="/about" data-en="About" data-es="Nosotros">About</a></li>
      <li><a href="/events" data-en="Club Events" data-es="Eventos del Club">Club Events</a></li>
      <li><a href={FOUNDER_PATH} data-en="From the Founder" data-es="Del Fundador">From the Founder</a></li>
      <li><a href="/#signup" data-en="Join" data-es="Únete">Join</a></li>
      <li><a href="/recruit" data-en="Open Roles" data-es="Puestos Abiertos">Open Roles</a></li>
      <li class="foot-links-spacer" aria-hidden="true"></li>
      <li><a href="/contact" data-en="Contact" data-es="Contacto">Contact</a></li>
    </ul>
    <div class="foot-right">
      <div class="foot-big"><span data-en="Keep NYC" data-es="Mantén NYC">Keep NYC</span><br /><span class="accent" data-en="clean." data-es="limpia.">clean.</span></div>
      <SocialLinks ids={['instagram', 'tiktok', 'linkedin', 'youtube', 'facebook']} />
    </div>
    <div class="copy">© {year} Trash Talk NYC</div>
  </div>
</footer>

<style>
  footer {
    background: var(--black);
    color: var(--beige);
    border-top: 3px solid var(--beige);
    padding-block: 40px 28px;
    padding-bottom: max(28px, var(--safe-bottom));
  }

  .foot-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  .foot-stickers {
    position: relative;
    width: 170px;
  }

  footer :global(.foot-logo) {
    width: 130px;
    height: auto;
    transform: rotate(-4deg);
  }

  footer :global(.slap-foot) {
    position: absolute;
    width: 74px;
    height: auto;
    right: 0;
    bottom: -18px;
    transform: rotate(14deg);
  }

  .foot-links {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: 8px 48px;
    font-weight: 600;
    font-size: 1.05rem;
  }

  .foot-links a {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }

  .foot-links a:hover { color: var(--yellow); }

  .foot-right {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .foot-big {
    font-family: var(--display);
    font-weight: 400;
    font-size: 2.8rem;
    line-height: 0.92;
    text-align: left;
  }

  .foot-big .accent { color: var(--yellow); }

  .copy {
    border-top: 1px solid rgba(234, 233, 218, 0.2);
    padding-top: 18px;
    font-size: 0.9rem;
    opacity: 0.65;
  }

  @media (pointer: coarse) {
    .foot-links a { min-height: var(--tap); }
  }

  @media (min-width: 761px) {
    footer { padding-block: 56px 32px; }

    .foot-grid {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 48px;
    }

    .foot-links-spacer { display: list-item; }
    .foot-right { justify-items: end; }
    .foot-big { text-align: right; }
    .copy { grid-column: 1 / -1; }
  }
</style>
