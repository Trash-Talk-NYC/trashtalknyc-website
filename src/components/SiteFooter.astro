---
/**
 * Single site-wide footer in the 2026-10 identity: links, the "Let's
 * clean NYC, together" sign-off with a large vest sticker above it, and
 * the full sticker icon row (all five channels). No bricks here — the
 * captain removed the footer brick frame (2026-09-30). The wordmark
 * sticker on the left was dropped so the logo shows once (team
 * feedback, 2026-10-15).
 */
import { Image } from 'astro:assets';
import SocialLinks from './SocialLinks.astro';
import { FOUNDER_PATH } from '../lib/founder';
import { WALL_PATH } from '../lib/partners';
import { MORE_MEDIA_PATH } from '../lib/media';
import vestSticker from '../assets/vest-sticker.png';

const year = new Date().getFullYear();
---

<footer>
  <div class="wrap foot-grid">
    <ul class="foot-links">
      <li><a href="/" data-en="Home" data-es="Inicio">Home</a></li>
      <li><a href="/about" data-en="About" data-es="Nosotros">About</a></li>
      <li><a href="/events" data-en="Club Events" data-es="Eventos del Club">Club Events</a></li>
      <li><a href={FOUNDER_PATH} data-en="From the Founder" data-es="Del Fundador">From the Founder</a></li>
      <li><a href="/#signup" data-en="Join" data-es="Únete">Join</a></li>
      <li><a href={WALL_PATH} data-en="The Wall" data-es="La Pared">The Wall</a></li>
      <li><a href="/recruit" data-en="Open Roles" data-es="Puestos Abiertos">Open Roles</a></li>
      <li><a href={MORE_MEDIA_PATH} data-en="More Media" data-es="Más Medios">More Media</a></li>
      <li><a href="/contact" data-en="Contact" data-es="Contacto">Contact</a></li>
    </ul>
    <div class="foot-right">
      <!-- The footer's only logo now, so it names the brand -->
      <Image src={vestSticker} alt="Trash Talk NYC" class="foot-vest" width={220} densities={[1, 2]} />
      <SocialLinks ids={['instagram', 'tiktok', 'youtube', 'facebook', 'linkedin']} />
    </div>
    <div class="copy">© {year} Trash Talk NYC</div>
  </div>
</footer>

<style>
  footer {
    background: var(--black);
    color: var(--beige);
    border-top: 3px solid var(--beige);
    padding-block: 40px 28px;
    padding-bottom: max(28px, var(--safe-bottom));
  }

  .foot-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  /* The vest as its own large sticker beside the sign-off, right-
     aligned with the rest of the column on desktop (captain: larger
     and right-aligned, not slapped over the wordmark) and set straight,
     not tilted (captain, 2026-10-09). */
  footer :global(.foot-vest) {
    width: 150px;
    height: auto;
    filter: drop-shadow(3px 4px 0 rgba(234, 233, 218, 0.22));
    justify-self: end;
  }

  .foot-links {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: 8px 48px;
    font-weight: 500;
    font-size: 1.05rem;
  }

  .foot-links a {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }

  .foot-links a:hover { color: var(--yellow); }

  .foot-right {
    display: grid;
    gap: 16px;
    justify-items: start;
  }


  .copy {
    border-top: 1px solid rgba(234, 233, 218, 0.2);
    padding-top: 18px;
    font-size: 0.9rem;
    opacity: 0.65;
  }

  @media (pointer: coarse) {
    .foot-links a { min-height: var(--tap); }
  }

  @media (min-width: 761px) {
    footer { padding-block: 56px 32px; }

    .foot-grid {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 48px;
    }

    .foot-right { justify-items: end; }
    footer :global(.foot-vest) { width: 200px; }
    .copy { grid-column: 1 / -1; }
  }
</style>
