---
import type { EventCardProps } from '../lib/events';
import { formatDate, formatTime } from '../lib/events';

interface Props extends EventCardProps {
  isPast?: boolean;
  latLng?: { lat: number; lng: number } | null;
}

const {
  id, name, url, startIso, endIso, location, mapUrls,
  isPast = false,
  latLng = null,
} = Astro.props;

const start = new Date(startIso);
const monthEN = start.toLocaleDateString('en-US', { month: 'short' });
const monthES = start.toLocaleDateString('es-419', { month: 'short' });
const dowEN   = start.toLocaleDateString('en-US', { weekday: 'short' });
const dowES   = start.toLocaleDateString('es-419', { weekday: 'short' });
const day     = start.getDate();

const dateStr = formatDate(startIso, 'en');
const timeStr = formatTime(startIso, 'en') + ' – ' + formatTime(endIso, 'en');

const btnId = `eb-trigger-${id}`;
---

<div
  class:list={['event-card', isPast ? 'past' : 'upcoming']}
  data-event-id={id}
  data-end={endIso}
  data-lat={latLng?.lat ?? undefined}
  data-lng={latLng?.lng ?? undefined}
>
  <div class="event-date-block">
    <span class="month" data-en={monthEN} data-es={monthES}>{monthEN}</span>
    <span class="day">{day}</span>
    <span class="dow" data-en={dowEN} data-es={dowES}>{dowEN}</span>
  </div>

  <div class="event-info">
    <div class="event-name">{name}</div>
    <div class="event-details">
      <span class="event-detail">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        {timeStr}
      </span>
      {location && (
        <>
          <span class="event-detail">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            {location}
          </span>
          {mapUrls && (
            <span class="map-links">
              <a class="map-link" href={mapUrls.google} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                  <polyline points="15 3 21 3 21 9"/>
                  <line x1="10" y1="14" x2="21" y2="3"/>
                </svg>
                Google Maps
              </a>
              <a class="map-link" href={mapUrls.apple} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                  <polyline points="15 3 21 3 21 9"/>
                  <line x1="10" y1="14" x2="21" y2="3"/>
                </svg>
                Apple Maps
              </a>
            </span>
          )}
        </>
      )}
    </div>
  </div>

  <div class="event-cta">
    {isPast ? (
      <span class="card-status" data-en="Past" data-es="Pasado">Past</span>
    ) : (
      <button
        class="btn-card btn-card-purple"
        id={btnId}
        data-event-id={id}
        data-url={url}
        data-name={name}
        data-date={dateStr}
        data-time={timeStr}
        data-loc={location}
      >
        RSVP &rarr;
      </button>
    )}
  </div>
</div>

<style>
  .event-card {
    background: white;
    border: 2px solid #e0dcd4;
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: 1.5rem;
    align-items: center;
    opacity: 0;
    transform: translateY(8px);
    animation: cardIn 260ms var(--ease-out) forwards;
  }
  @keyframes cardIn { to { opacity: 1; transform: translateY(0); } }
  .event-card:nth-child(1) { animation-delay: 0ms; }
  .event-card:nth-child(2) { animation-delay: 45ms; }
  .event-card:nth-child(3) { animation-delay: 90ms; }
  .event-card:nth-child(4) { animation-delay: 135ms; }
  .event-card:nth-child(5) { animation-delay: 180ms; }
  @media (prefers-reduced-motion: reduce) { .event-card { animation: none; opacity: 1; transform: none; } }
  @media (hover: hover) and (pointer: fine) {
    .event-card:hover { border-color: rgba(155,93,229,0.45); box-shadow: 0 3px 18px rgba(107,63,160,0.08); transform: translateY(-1px); }
  }
  .event-card.upcoming { border-left: 4px solid var(--purple-light); padding-left: calc(1.75rem - 2px); }
  .event-card.past { opacity: 0.5; animation: none; }

  .event-date-block {
    text-align: center;
    background: var(--purple-pale);
    border-radius: 8px;
    padding: 0.6rem 0.5rem;
    flex-shrink: 0;
  }
  .event-date-block .month {
    font-size: 0.6rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--purple); display: block;
  }
  .event-date-block .day {
    font-family: 'Bebas Neue', sans-serif; font-size: 2rem; color: var(--charcoal);
    line-height: 1; display: block;
  }
  .event-date-block .dow {
    font-size: 0.58rem; font-weight: 700; color: var(--gray);
    text-transform: uppercase; letter-spacing: 0.1em; display: block;
  }

  .event-info { min-width: 0; }
  .event-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.35rem; letter-spacing: 0.03em; margin-bottom: 0.3rem;
  }
  .event-details { display: flex; flex-wrap: wrap; gap: 1rem; }
  .event-detail {
    display: flex; align-items: center; gap: 0.35rem;
    font-size: 0.75rem; font-weight: 700; color: var(--gray);
  }
  .event-detail svg { width: 12px; height: 12px; flex-shrink: 0; }

  .map-links { display: inline-flex; align-items: center; gap: 0.3rem; flex-wrap: wrap; }
  .map-link {
    display: inline-flex; align-items: center; gap: 0.2rem;
    font-size: 0.58rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    color: rgba(122,122,138,0.7); text-decoration: none;
    border: 1px solid rgba(122,122,138,0.3); border-radius: 4px;
    padding: 0.1rem 0.4rem; transition: border-color 0.15s, color 0.15s; white-space: nowrap;
  }
  .map-link:hover { color: var(--purple); border-color: var(--purple); }
  .map-link svg { width: 9px; height: 9px; flex-shrink: 0; }

  .event-cta {
    flex-shrink: 0; text-align: right;
    display: flex; flex-direction: column; align-items: flex-end; gap: 0.5rem;
  }
  .btn-card {
    display: inline-block; font-family: 'Nunito', sans-serif;
    font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em;
    padding: 0.4rem 1rem; border-radius: 40px; border: 1.5px solid;
    cursor: pointer; text-decoration: none; background: none;
    transition: background 150ms var(--ease-out), color 150ms var(--ease-out), transform 100ms var(--ease-out);
    white-space: nowrap;
  }
  .btn-card-purple { color: var(--purple); border-color: var(--purple); }
  @media (hover: hover) and (pointer: fine) {
    .btn-card-purple:hover { background: var(--purple); color: #fff; }
    .btn-card-purple:active { transform: scale(0.96); }
  }
  .card-status {
    font-size: 0.65rem; font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--warm-gray);
  }

  @media (max-width: 768px) {
    .event-card { grid-template-columns: 60px 1fr; }
    .event-cta { grid-column: 1 / -1; display: flex; justify-content: flex-start; padding-top: 0.25rem; }
    .event-card.past .event-cta { display: none; }
  }
</style>
