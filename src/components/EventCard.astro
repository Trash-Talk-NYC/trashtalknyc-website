---
import type { EventCardProps } from '../lib/events';
import { formatDate, formatTime } from '../lib/events';

interface Props extends EventCardProps {
  isPast?: boolean;
  latLng?: { lat: number; lng: number } | null;
}

const {
  id, name, url, startIso, endIso, location, mapUrls,
  isPast = false,
  latLng = null,
} = Astro.props;

const start = new Date(startIso);
const monthEN = start.toLocaleDateString('en-US', { month: 'short' });
const monthES = start.toLocaleDateString('es-419', { month: 'short' });
const dowEN   = start.toLocaleDateString('en-US', { weekday: 'short' });
const dowES   = start.toLocaleDateString('es-419', { weekday: 'short' });
const day     = start.getDate();

const dateStr = formatDate(startIso, 'en');
const timeStr = formatTime(startIso, 'en') + ' – ' + formatTime(endIso, 'en');

const btnId = `eb-trigger-${id}`;
---

<div
  class:list={['event-card', isPast ? 'past' : 'upcoming']}
  data-event-id={id}
  data-end={endIso}
  data-lat={latLng?.lat ?? undefined}
  data-lng={latLng?.lng ?? undefined}
>
  <div class="event-date-block">
    <span class="month" data-en={monthEN} data-es={monthES}>{monthEN}</span>
    <span class="day">{day}</span>
    <span class="dow" data-en={dowEN} data-es={dowES}>{dowEN}</span>
  </div>

  <div class="event-info">
    <div class="event-name">{name}</div>
    <div class="event-details">
      <span class="event-detail">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        {timeStr}
      </span>
      {location && (
        <>
          <span class="event-detail">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            {location}
          </span>
          {mapUrls && !isPast && (
            <a class="map-link" href={mapUrls.google} target="_blank" rel="noopener" data-en="Map ↗" data-es="Mapa ↗">
              Map ↗
            </a>
          )}
        </>
      )}
    </div>
  </div>

  {!isPast && (
    <div class="event-cta">
      <button
        class="btn-card btn-card-purple"
        id={btnId}
        data-event-id={id}
        data-url={url}
        data-name={name}
        data-date={dateStr}
        data-time={timeStr}
        data-loc={location}
        data-en="RSVP →"
        data-es="Regístrate →"
      >
        RSVP &rarr;
      </button>
    </div>
  )}
</div>

<style>
  /* Ticket-stub card: charcoal date stub + dashed perforation line */
  .event-card {
    background: white;
    border: 2px solid var(--charcoal);
    border-radius: 10px;
    padding: clamp(1rem, 3vw, 1.5rem) clamp(1rem, 3.5vw, 1.75rem);
    display: grid;
    grid-template-columns: 84px 1fr auto;
    gap: clamp(0.9rem, 2.5vw, 1.5rem);
    align-items: center;
    opacity: 0;
    transform: translateY(8px);
    animation: cardIn 260ms var(--ease-out) forwards;
    transition: box-shadow 150ms var(--ease-out);
  }
  @keyframes cardIn { to { opacity: 1; transform: translateY(0); } }
  .event-card:nth-child(1) { animation-delay: 0ms; }
  .event-card:nth-child(2) { animation-delay: 45ms; }
  .event-card:nth-child(3) { animation-delay: 90ms; }
  .event-card:nth-child(4) { animation-delay: 135ms; }
  .event-card:nth-child(5) { animation-delay: 180ms; }
  @media (prefers-reduced-motion: reduce) { .event-card { animation: none; opacity: 1; transform: none; } }
  @media (hover: hover) and (pointer: fine) {
    .event-card:hover { box-shadow: 5px 5px 0 var(--purple-light); }
  }
  .event-card.past { opacity: 0.5; animation: none; border-color: var(--warm-gray); }
  .event-card.past .event-date-block { background: var(--warm-gray); }
  /* Server-rendered past cards omit these; hiding them here also covers cards
     the staleness script flips to .past after the page was built. */
  .event-card.past .event-cta,
  .event-card.past .map-link { display: none; }

  .event-date-block {
    text-align: center;
    background: var(--charcoal);
    border-radius: 6px;
    padding: 0.6rem 0.5rem;
    flex-shrink: 0;
    position: relative;
  }
  /* perforation between the stub and the rest of the ticket */
  .event-date-block::after {
    content: '';
    position: absolute;
    top: 8%;
    bottom: 8%;
    right: calc(clamp(0.9rem, 2.5vw, 1.5rem) / -2);
    border-right: 2px dashed #d8d3c8;
  }
  .event-date-block .month {
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--yellow); display: block;
  }
  .event-date-block .day {
    font-family: 'Bebas Neue', sans-serif; font-size: 2rem; color: var(--off-white);
    line-height: 1; display: block;
  }
  .event-date-block .dow {
    font-family: 'Space Mono', monospace;
    font-size: 0.55rem; font-weight: 700; color: var(--paper-a55);
    text-transform: uppercase; letter-spacing: 0.1em; display: block;
  }

  .event-info { min-width: 0; }
  .event-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.35rem; letter-spacing: 0.03em; margin-bottom: 0.3rem;
  }
  .event-details { display: flex; flex-wrap: wrap; gap: 1rem; }
  .event-detail {
    display: flex; align-items: center; gap: 0.35rem;
    font-size: 0.75rem; font-weight: 700; color: var(--gray);
  }
  .event-detail svg { width: 12px; height: 12px; flex-shrink: 0; }

  .map-link {
    display: inline-flex; align-items: center;
    font-size: 0.58rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    color: rgba(122,122,138,0.7); text-decoration: none;
    border: 1px solid rgba(122,122,138,0.3); border-radius: 4px;
    padding: 0.1rem 0.4rem; transition: border-color 0.15s, color 0.15s; white-space: nowrap;
  }
  .map-link:hover { color: var(--purple); border-color: var(--purple); }

  .event-cta {
    flex-shrink: 0; text-align: right;
    display: flex; flex-direction: column; align-items: flex-end; gap: 0.5rem;
  }
  .btn-card {
    display: inline-flex; align-items: center; font-family: 'Nunito', sans-serif;
    font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em;
    padding: 0.4rem 1.1rem; min-height: 40px; border-radius: 6px; border: 2px solid;
    cursor: pointer; text-decoration: none; background: none;
    transition: transform 120ms var(--ease-out), box-shadow 120ms var(--ease-out), background 150ms var(--ease-out), color 150ms var(--ease-out);
    white-space: nowrap;
  }
  .btn-card-purple {
    color: var(--charcoal); border-color: var(--charcoal); background: var(--yellow);
    box-shadow: 3px 3px 0 var(--charcoal);
  }
  @media (hover: hover) and (pointer: fine) {
    .btn-card-purple:hover { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--charcoal); }
    .btn-card-purple:active { transform: translate(3px, 3px); box-shadow: 0 0 0 var(--charcoal); }
  }
  @media (max-width: 768px) {
    .event-card { grid-template-columns: 72px 1fr; }
    .event-date-block::after { display: none; }
    .event-cta { grid-column: 1 / -1; display: flex; justify-content: flex-start; padding-top: 0.25rem; }
  }
</style>
