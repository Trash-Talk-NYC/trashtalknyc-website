---
import type { EventCardProps } from '../lib/events';
import { formatDate, formatTime } from '../lib/events';

/**
 * One upcoming event as a wheatpasted date strip: purple date stub,
 * body-type event name (the style guide sets event names in Barlow,
 * not display type), time/place rows, map links, RSVP. The `.past`
 * class is only ever added client-side by the staleness check on the
 * events page — the page no longer renders a past-events section.
 */
interface Props extends EventCardProps {
  latLng?: { lat: number; lng: number } | null;
}

const {
  id, name, url, startIso, endIso, location, mapUrls,
  latLng = null,
} = Astro.props;

const start = new Date(startIso);
const monthEN = start.toLocaleDateString('en-US', { month: 'short' });
const monthES = start.toLocaleDateString('es-419', { month: 'short' });
const dowEN   = start.toLocaleDateString('en-US', { weekday: 'short' });
const dowES   = start.toLocaleDateString('es-419', { weekday: 'short' });
const day     = start.getDate();

const dateStr = formatDate(startIso, 'en');
const timeStr = formatTime(startIso, 'en') + ' – ' + formatTime(endIso, 'en');

const btnId = `eb-trigger-${id}`;
---

<article
  class="ev-card paste upcoming"
  data-event-id={id}
  data-end={endIso}
  data-lat={latLng?.lat ?? undefined}
  data-lng={latLng?.lng ?? undefined}
>
  <div class="date">
    <span class="m" data-en={monthEN} data-es={monthES}>{monthEN}</span>
    <span class="d">{day}</span>
    <span class="w" data-en={dowEN} data-es={dowES}>{dowEN}</span>
  </div>

  <div class="ev-info">
    <div class="ev-name">{name}</div>
    <div class="ev-details">
      <span>
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
        {timeStr}
      </span>
      {location && (
        <span>
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
          {location}
        </span>
      )}
    </div>
    {mapUrls && (
      <div class="maps">
        <a href={mapUrls.google} target="_blank" rel="noopener">Google Maps</a>
        <a href={mapUrls.apple} target="_blank" rel="noopener">Apple Maps</a>
      </div>
    )}
  </div>

  <button
    class="btn btn-purple ev-rsvp"
    id={btnId}
    data-event-id={id}
    data-url={url}
    data-name={name}
    data-date={dateStr}
    data-time={timeStr}
    data-loc={location}
    data-en="RSVP →"
    data-es="Regístrate →"
  >
    RSVP &rarr;
  </button>
</article>

<style>
  .ev-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    background-color: var(--paper);
    color: var(--black);
    padding: 16px 14px;
  }

  .ev-card.past { opacity: 0.6; }
  .ev-card.past .date { background: var(--black); }

  .date {
    display: grid;
    justify-items: center;
    width: 66px;
    padding: 10px 0;
    background: var(--purple);
    color: var(--beige);
    border-radius: 4px;
    line-height: 1;
  }

  .date .m {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .date .d {
    font-family: var(--display);
    font-weight: 400;
    font-size: 2.2rem;
    margin: 2px 0;
  }

  .date .w {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: var(--yellow);
  }

  .ev-info { min-width: 0; }

  .ev-name {
    font-family: var(--body);
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.05;
    color: var(--purple);
  }

  .ev-details {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 10px;
    font-weight: 600;
    font-size: 0.92rem;
  }

  .ev-details span { display: inline-flex; align-items: center; gap: 7px; }
  .ev-details svg { width: 17px; height: 17px; stroke: var(--purple); fill: none; flex: none; }

  .maps { display: flex; gap: 14px; margin-top: 8px; font-size: 0.92rem; }
  .maps a {
    color: var(--purple);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }

  .ev-rsvp { grid-column: 1 / -1; width: 100%; padding: 11px 18px; }
  .ev-card.past .ev-rsvp { display: none; }

  @media (min-width: 761px) {
    .ev-card {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 24px;
      padding: 20px 24px;
    }

    .date { width: 86px; }
    .date .d { font-size: 2.8rem; }
    .ev-name { font-size: 1.75rem; }
    .ev-details { font-size: 1rem; }
    .ev-rsvp { grid-column: auto; width: auto; }
  }

  @media (pointer: coarse) {
    .maps a { min-height: var(--tap); }
  }
</style>
