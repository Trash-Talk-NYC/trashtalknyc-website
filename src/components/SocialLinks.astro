---
/**
 * Die-cut sticker social icons — round yellow stickers with the beige
 * die-cut border, slightly tilted like they were slapped on. Reused by
 * SocialBar (Instagram / YouTube / TikTok) and SiteFooter (all five).
 * Icon-only: the accessible name is the aria-label (brand names, so
 * identical in both languages — setLang never touches attributes).
 */
import { getSocials, type SocialId } from '../lib/socials';

interface Props {
  ids: SocialId[];
}

const { ids } = Astro.props;
const channels = getSocials(ids);
---

<div class="icons">
  {channels.map((c) => (
    <a href={c.href} aria-label={c.label} {...(c.placeholder ? {} : { target: '_blank', rel: 'noopener' })}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={c.path} /></svg>
    </a>
  ))}
</div>

<style>
  .icons {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  /* Die-cut sticker: yellow disc, ink ring, beige die-cut halo, and a
     soft drop so it reads as a physical sticker on any ground */
  .icons a {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--black);
    border: 2.5px solid var(--black);
    box-shadow: 0 0 0 4px var(--beige), 2px 4px 0 4px rgba(0, 0, 0, 0.35);
    text-decoration: none;
    transition: transform 0.15s;
  }

  .icons a:nth-child(odd) { transform: rotate(-8deg); }
  .icons a:nth-child(even) { transform: rotate(7deg); }
  .icons a:hover { color: var(--black); transform: rotate(0) scale(1.1); }

  .icons svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  @media (min-width: 761px) {
    .icons a { width: 36px; height: 36px; }
    .icons svg { width: 17px; height: 17px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .icons a { transition: none; }
  }
</style>
