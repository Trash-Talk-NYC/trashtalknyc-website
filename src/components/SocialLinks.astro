---
/**
 * Social links, reused by SocialBar, SiteFooter, and the about page.
 * Inherits color/font from its parent (color: inherit) so each surface
 * only styles the wrapper it places this in.
 *
 * Default is the two content channels (Instagram + TikTok); `all` adds
 * Eventbrite and LinkedIn — the footer wants the complete set, while
 * the floating SocialBar stays follow-focused.
 */
interface Props {
  all?: boolean;
}

const { all = false } = Astro.props;
---

<a class="social-link" href="https://www.instagram.com/trashtalk_nyc/" target="_blank" rel="noopener">
  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
  @trashtalk_nyc
</a>
<a class="social-link" href="https://www.tiktok.com/@trashtalk_nyc" target="_blank" rel="noopener">
  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>
  TikTok
</a>
{all && (
  <>
    <a class="social-link" href="https://trashtalknyc.eventbrite.com" target="_blank" rel="noopener">
      {/* Eventbrite has no simple glyph mark; a ticket icon in the same
          stroke-less style reads as "events" at this size */}
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M22 10V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v3a2 2 0 0 1 0 4v3a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-3a2 2 0 0 1 0-4zm-2-1.46a4 4 0 0 0 0 6.92V17H4v-1.54a4 4 0 0 0 0-6.92V7h16zM9.5 9h5v2h-5zm0 4h5v2h-5z"/></svg>
      Eventbrite
    </a>
    <a class="social-link" href="https://www.linkedin.com/company/trash-talk-nyc/" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z"/></svg>
      LinkedIn
    </a>
  </>
)}

<style>
  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    text-decoration: none;
    min-height: 24px;
    transition: color 0.15s, opacity 0.15s;
  }

  .social-link svg {
    width: 1.1em;
    height: 1.1em;
    fill: currentColor;
    flex-shrink: 0;
  }

  @media (pointer: coarse) {
    .social-link { min-height: var(--tap); }
  }
</style>
