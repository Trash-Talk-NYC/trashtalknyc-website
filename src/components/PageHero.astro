---
/**
 * Dark poster-style page header used by secondary pages (Contact, From
 * the Founder). A giant outlined word sits behind the heading; the
 * eyebrow is a tilted sticker chip. Pass the heading in the default
 * slot so pages control line breaks and accent spans.
 */
interface Props {
  eyebrowEn: string;
  eyebrowEs: string;
  /** Oversized outlined word rendered behind the heading (decorative). */
  word: string;
}

const { eyebrowEn, eyebrowEs, word } = Astro.props;
---

<section class="page-hero diag-texture">
  <div class="page-hero-word" aria-hidden="true">{word}</div>
  <div class="page-hero-inner">
    <p class="sticker page-hero-eyebrow" data-en={eyebrowEn} data-es={eyebrowEs}>{eyebrowEn}</p>
    <h1><slot /></h1>
  </div>
</section>

<div class="tape-seam" aria-hidden="true"></div>

<style>
  .page-hero {
    background: var(--charcoal);
    padding: var(--space-xl) max(var(--gutter), var(--safe-right)) var(--space-xl) max(var(--gutter), var(--safe-left));
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .page-hero-word {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(6rem, 24vw, 20rem);
    letter-spacing: 0.04em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px var(--purple-lt-a30);
    user-select: none;
    pointer-events: none;
    white-space: nowrap;
  }

  .page-hero-inner { position: relative; z-index: 1; }

  .page-hero-eyebrow {
    margin-bottom: 1.5rem;
  }

  .page-hero h1 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: var(--step-4);
    color: var(--off-white);
    letter-spacing: 0.06em;
    line-height: 1.05;
    /* Captain (2026-08-13): a real black outline on the glyphs instead
       of the old offset press shadow. paint-order paints the stroke
       BEHIND the fill, so the letterforms keep their full weight and
       only half the stroke shows as a rim; browsers that don't support
       paint-order on HTML text centre the stroke instead, which reads
       slightly thinner but never broken. The em width tracks the
       clamped display size so the rim stays proportional and Bebas's
       tight counters don't close up. */
    -webkit-text-stroke: 0.06em var(--charcoal);
    paint-order: stroke fill;
  }

  .page-hero h1 :global(.accent) { color: var(--yellow); }
</style>
