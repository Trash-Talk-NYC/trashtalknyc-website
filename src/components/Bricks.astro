---
/**
 * The two halves of the brick frame for a hero, showing only whole rows
 * (generated by scripts/generate-bricks.mjs). Put it first inside a
 * section that has the global `.brick-hero` class and
 * `style={brickHeroStyle(rows)}` with the same rows, so the section is
 * always tall enough for both halves without them meeting.
 *
 * `continuous` (the Team page, captain 2026-10-09): instead of a short
 * frame, the side columns run unbroken from top to bottom. A script
 * measures the hero's content, picks just enough rows per half (the
 * generated variants go to 16, extending the drawing's own side rows),
 * and sets the hero's height so the two halves meet one mortar gap apart.
 * The static `rows` remain the no-JS fallback.
 */
import type { ImageMetadata } from 'astro';
import type { BrickRows } from '../lib/bricks';
import { BRICK_ROW_RATIOS } from '../lib/brick-rows.generated';

interface Props {
  rows: BrickRows;
  continuous?: boolean;
}

const { rows, continuous = false } = Astro.props;

const svgs = import.meta.glob<{ default: ImageMetadata }>('../assets/bricks/*.svg', { eager: true });
const src = (half: 'top' | 'bottom', n: number) => {
  const mod = svgs[`../assets/bricks/${half}-${n}.svg`];
  if (!mod) throw new Error(`Missing brick variant ${half}-${n}.svg — run node scripts/generate-bricks.mjs`);
  return mod.default.src;
};
---

<!-- Plain images toggled by the 760/761px breakpoint in global.css (not
     <picture>, whose source choice proved unreliable in testing): the
     phone and desktop variants show different numbers of rows. -->
<img class="bricks bricks-top bricks-phone" src={src('top', rows.phone)} alt="" />
<img class="bricks bricks-bottom bricks-phone" src={src('bottom', rows.phone)} alt="" />
<img class="bricks bricks-top bricks-desktop" src={src('top', rows.desktop)} alt="" />
<img class="bricks bricks-bottom bricks-desktop" src={src('bottom', rows.desktop)} alt="" />
{continuous && (
  <script
    type="application/json"
    class="bricks-variants"
    set:html={JSON.stringify({
      top: BRICK_ROW_RATIOS.top.map((_, i) => src('top', i + 1)),
      bottom: BRICK_ROW_RATIOS.bottom.map((_, i) => src('bottom', i + 1)),
    })}
  />
)}

<script>
  import { BRICK_GEOMETRY, BRICK_ROW_RATIOS } from '../lib/brick-rows.generated';

  // Halves sit this far in from the hero's edges (global.css .bricks-top/-bottom)
  const INSET = 10;
  const MAX = BRICK_ROW_RATIOS.top.length;

  // On phones the hero photo spans the full width, so side columns would
  // only peek out as slivers; there the static rows frame it above and below
  const desktop = window.matchMedia('(min-width: 761px)');

  function fill(section: HTMLElement, urls: { top: string[]; bottom: string[] }) {
    if (!desktop.matches) {
      section.style.removeProperty('min-height');
      section.style.removeProperty('height');
      return;
    }
    const w = section.clientWidth;
    const scale = w / BRICK_GEOMETRY.viewWidth;
    // Each variant keeps `pad` blank past its inner row; overlapping those
    // margins down to one mortar gap makes the two halves read as one wall
    const overlap = (2 * BRICK_GEOMETRY.pad - BRICK_GEOMETRY.gap) * scale;
    const height = (t: number, b: number) =>
      (BRICK_ROW_RATIOS.top[t - 1] + BRICK_ROW_RATIOS.bottom[b - 1]) * w + 2 * INSET - overlap;

    // The content's own height, ignoring any height we set before
    const content = Math.max(
      ...Array.from(section.children)
        .filter((c) => !c.classList.contains('bricks') && c.tagName !== 'SCRIPT')
        .map((c) => (c as HTMLElement).offsetHeight),
    );

    // Fewest rows (top gets the extra one when odd) whose wall covers it
    let top = MAX, bottom = MAX;
    for (let total = 2; total <= 2 * MAX; total++) {
      const t = Math.ceil(total / 2), b = Math.floor(total / 2);
      if (height(t, b) >= content) { top = t; bottom = b; break; }
    }

    section.style.minHeight = `${Math.ceil(height(top, bottom))}px`;
    section.style.height = `${Math.ceil(height(top, bottom))}px`;
    // Only the desktop pair is swapped; the phone pair keeps its static rows
    section.querySelectorAll<HTMLImageElement>('.bricks-top.bricks-desktop').forEach((img) => { img.src = urls.top[top - 1]; });
    section.querySelectorAll<HTMLImageElement>('.bricks-bottom.bricks-desktop').forEach((img) => { img.src = urls.bottom[bottom - 1]; });
  }

  document.querySelectorAll<HTMLScriptElement>('script.bricks-variants').forEach((data) => {
    const section = data.parentElement;
    if (!section) return;
    const urls = JSON.parse(data.textContent ?? '{}');
    const run = () => fill(section, urls);
    run();
    new ResizeObserver(run).observe(section);
    desktop.addEventListener('change', run);
    // Fonts and the hero photo change the content's height as they load
    document.fonts?.ready.then(run);
    window.addEventListener('load', run);
  });
</script>
