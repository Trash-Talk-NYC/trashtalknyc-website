---
/**
 * The two halves of the brick frame for a hero, showing only whole rows
 * (generated by scripts/generate-bricks.mjs). Put it first inside a
 * section that has the global `.brick-hero` class and
 * `style={brickHeroStyle(rows)}` with the same rows, so the section is
 * always tall enough for both halves without them meeting.
 */
import type { ImageMetadata } from 'astro';
import type { BrickRows } from '../lib/bricks';

interface Props {
  rows: BrickRows;
}

const { rows } = Astro.props;

const svgs = import.meta.glob<{ default: ImageMetadata }>('../assets/bricks/*.svg', { eager: true });
const src = (half: 'top' | 'bottom', n: number) => {
  const mod = svgs[`../assets/bricks/${half}-${n}.svg`];
  if (!mod) throw new Error(`Missing brick variant ${half}-${n}.svg — run node scripts/generate-bricks.mjs`);
  return mod.default.src;
};
---

<!-- Plain images toggled by the 760/761px breakpoint in global.css (not
     <picture>, whose source choice proved unreliable in testing): the
     phone and desktop variants show different numbers of rows. -->
<img class="bricks bricks-top bricks-phone" src={src('top', rows.phone)} alt="" />
<img class="bricks bricks-bottom bricks-phone" src={src('bottom', rows.phone)} alt="" />
<img class="bricks bricks-top bricks-desktop" src={src('top', rows.desktop)} alt="" />
<img class="bricks bricks-bottom bricks-desktop" src={src('bottom', rows.desktop)} alt="" />
