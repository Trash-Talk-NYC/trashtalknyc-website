---
/**
 * EN/ES language toggle. Owns its buttons, styling, and click wiring;
 * language state itself lives in src/lib/language.ts so any component
 * can subscribe via onLanguageChange(). Styled for the beige header:
 * ink-outlined pill, pressed side inverts to black.
 */
---

<div class="lang-toggle" role="group" aria-label="Language">
  <button class="lang-btn active" data-lang-btn="en" type="button" aria-pressed="true">EN</button>
  <button class="lang-btn" data-lang-btn="es" type="button" aria-pressed="false">ES</button>
</div>

<script>
  import { getCurrentLang, setLang, onLanguageChange } from '../lib/language';

  // The toggle renders twice (desktop nav + phone menu), so wire every
  // instance by data attribute rather than by id.
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]'));

  function updateButtons(lang: string) {
    buttons.forEach((btn) => {
      const active = btn.dataset.langBtn === lang;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-pressed', String(active));
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => setLang(btn.dataset.langBtn === 'es' ? 'es' : 'en'));
  });

  // Stay in sync when language changes from any source
  onLanguageChange(updateButtons);
  updateButtons(getCurrentLang());
</script>

<style>
  .lang-toggle {
    display: flex;
    border: 2.5px solid var(--black);
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .lang-btn {
    border: 0;
    background: transparent;
    padding: 5px 9px;
    min-width: var(--tap);
    min-height: 38px;
    cursor: pointer;
    color: var(--black);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    transition: background 0.15s, color 0.15s;
  }

  .lang-btn.active { background: var(--black); color: var(--beige); }

  @media (prefers-reduced-motion: reduce) {
    .lang-btn { transition: none; }
  }
</style>
