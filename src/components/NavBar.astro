---
/**
 * Sticky top navigation: logo, page links, Join CTA, language toggle,
 * and the mobile hamburger. Owns active-page detection and the mobile
 * menu open/close wiring.
 */
import LangToggle from './LangToggle.astro';

const pathname = Astro.url.pathname;

const isHome    = pathname === '/' || pathname === '';
const isEvents  = pathname === '/events' || pathname.startsWith('/events/');
const isCleanZone = pathname === '/clean-zone' || pathname.startsWith('/clean-zone/');
const isAbout   = pathname === '/about'  || pathname.startsWith('/about/');
const isContact = pathname === '/contact' || pathname.startsWith('/contact/');
---

<nav aria-label="Main">
  <a class="nav-logo" href="/">Trash Talk <span>NYC</span></a>
  <div class="nav-right">
    <LangToggle />
    <button class="nav-hamburger" id="navHamburger" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="navLinks">
      <span></span><span></span><span></span>
    </button>
  </div>
  <ul class="nav-links" id="navLinks">
    <li><a href="/" class:list={{ active: isHome }} data-en="Home" data-es="Inicio">Home</a></li>
    <li><a href="/events" class:list={{ active: isEvents }} data-en="Club Events" data-es="Eventos del Club">Club Events</a></li>
    <li><a href="/clean-zone" class:list={{ active: isCleanZone }} data-en="Clean Zone" data-es="Zona Limpia">Clean Zone</a></li>
    <li><a href="/about" class:list={{ active: isAbout }} data-en="About" data-es="Nosotros">About</a></li>
    <li><a href="/contact" class:list={{ active: isContact }} data-en="Contact" data-es="Contacto">Contact</a></li>
    <li><a href="/#signup" class="nav-cta" data-en="Join" data-es="Únete">Join</a></li>
  </ul>
</nav>

<script>
  const hamburger = document.getElementById('navHamburger');
  const links = document.getElementById('navLinks');

  function setOpen(open: boolean) {
    hamburger?.classList.toggle('open', open);
    links?.classList.toggle('open', open);
    hamburger?.setAttribute('aria-expanded', String(open));
  }

  hamburger?.addEventListener('click', () => {
    setOpen(!hamburger.classList.contains('open'));
  });

  // Close the mobile menu after navigating (matters for same-page #anchors)
  links?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => setOpen(false));
  });
</script>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 200;
    background: var(--charcoal);
    display: flex;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--space-md);
    flex-wrap: wrap;
    padding: var(--safe-top) max(var(--gutter), var(--safe-right)) 0 max(var(--gutter), var(--safe-left));
    min-height: calc(60px + var(--safe-top));
    border-bottom: 3px solid var(--purple-light);
  }

  /* iOS Safari opens a strip above a stuck header during rubber-band
     overscroll and collapsing-chrome transitions, exposing page background
     in the notch/dynamic-island area. Paint header color above the bar so
     that strip always reads as chrome. Scoped to widths where the social
     bar is hidden — on wider screens it sits above the nav and the bleed
     would cover it at the top of the page. */
  @media (max-width: 768px) {
    nav::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 100%;
      height: 120px;
      background: var(--charcoal);
    }
  }

  .nav-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.25rem, 1.1rem + 0.8vw, 1.6rem);
    color: var(--yellow);
    letter-spacing: 0.06em;
    text-decoration: none;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    min-height: 60px;
  }

  .nav-logo span { color: var(--purple-light); margin-left: 0.3em; }

  .nav-right {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 2rem);
    order: 3;
  }

  .nav-links {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2rem);
    list-style: none;
    order: 2;
    align-items: center;
  }

  .nav-links a {
    font-family: 'Nunito', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--paper-a70);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: inline-flex;
    align-items: center;
    min-height: 60px;
    transition: color 0.15s;
  }

  .nav-links a:hover,
  .nav-links a.active { color: var(--yellow); }

  .nav-links a.nav-cta {
    background: var(--yellow);
    color: var(--charcoal);
    padding: 0.4rem 1.1rem;
    border-radius: 4px;
    font-weight: 800;
    min-height: 0;
  }

  .nav-links a.nav-cta:hover { background: var(--purple-light); color: #fff; }

  /* ── HAMBURGER ── */
  .nav-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    min-width: var(--tap);
    min-height: var(--tap);
  }

  .nav-hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--cream);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  .nav-hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-hamburger.open span:nth-child(2) { opacity: 0; }
  .nav-hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ── MOBILE MENU ── */
  @media (max-width: 768px) {
    .nav-hamburger { display: flex; }

    .nav-links {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem 0 1rem;
      order: 3;
    }

    .nav-links.open { display: flex; }
    .nav-links li { border-top: 1px solid var(--paper-a12); }

    .nav-links a {
      display: flex;
      justify-content: center;
      padding: 0.85rem 0.5rem;
      font-size: 0.9rem;
      min-height: var(--tap);
    }

    .nav-links a.nav-cta {
      margin: 0.6rem 0 0.25rem;
      padding: 0.85rem 1.25rem;
      border-radius: 6px;
      min-height: var(--tap);
    }
  }
</style>
