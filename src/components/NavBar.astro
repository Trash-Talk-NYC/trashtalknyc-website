---
/**
 * Sticky top navigation: logo, page links, Join CTA, language toggle,
 * and the mobile hamburger. Owns active-page detection and the mobile
 * menu open/close wiring. Deliberately a PLAIN sticky header — see the
 * header bullet in AGENTS.md before adding any positioning tricks.
 * The iOS 26 header-gap bug was never the nav's fault: the device-
 * verified trigger was a position:fixed full-viewport overlay layered
 * above it (the grain, since fixed — see global.css). Never stack a
 * fixed full-viewport layer above this nav.
 */
import LangToggle from './LangToggle.astro';

const pathname = Astro.url.pathname;

const isHome     = pathname === '/' || pathname === '';
const isEvents   = pathname === '/events' || pathname.startsWith('/events/');
const isStory    = pathname === '/about/our-story' || pathname.startsWith('/about/our-story/');
// Our Story lives under /about/, which isTeam's prefix also matches, so
// the `!isStory` guard below is what stops "The Team" double-lighting on
// the story page. Keep the guard — declaration order alone does nothing.
const isTeam     = !isStory && (pathname === '/about' || pathname.startsWith('/about/'));
// The recruitment page is top-level at /recruit but belongs to the About menu
const isRecruit  = pathname === '/recruit' || pathname.startsWith('/recruit/');
// The About parent highlights when any of its children is current
const isAbout    = isTeam || isStory || isRecruit;
const isContact  = pathname === '/contact' || pathname.startsWith('/contact/');
---

<nav aria-label="Main">
  <a class="nav-logo" href="/">Trash Talk <span>NYC</span></a>
  <div class="nav-right">
    <LangToggle />
    <button class="nav-hamburger" id="navHamburger" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="navLinks">
      <span></span><span></span><span></span>
    </button>
  </div>
  <ul class="nav-links" id="navLinks">
    <li><a href="/" class:list={{ active: isHome }} data-en="Home" data-es="Inicio">Home</a></li>
    <li><a href="/events" class:list={{ active: isEvents }} data-en="Club Events" data-es="Eventos del Club">Club Events</a></li>
    <li class="nav-dropdown" id="aboutDropdown">
      <!-- Disclosure pattern (APG): the parent is a toggle, not a link —
           /about stays reachable as "The Team" below. aria-expanded is the
           whole submenu contract; no menu roles, no aria-haspopup.
           "Open Roles" is the captain's chosen label (round 20): "Join"
           is taken by the mailing-list nav CTA and "Work With Us" was
           rejected as confusable with Contact.
           Projects stays decoupled on fm/projects-tree-guard and rejoins
           this list when it lands. -->
      <button
        type="button"
        class:list={['nav-drop-toggle', { active: isAbout }]}
        id="aboutDropToggle"
        aria-expanded="false"
        aria-controls="aboutDropMenu"
      >
        <span data-en="About" data-es="Nosotros">About</span>
        <svg class="drop-caret" aria-hidden="true" width="10" height="7" viewBox="0 0 10 7" fill="none">
          <path d="M1 1.5 5 5.5 9 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <ul class="nav-drop-menu" id="aboutDropMenu">
        <li><a href="/about" class:list={{ active: isTeam }} data-en="The Team" data-es="El Equipo">The Team</a></li>
        <li><a href="/about/our-story" class:list={{ active: isStory }} data-en="Our Story" data-es="Nuestra Historia">Our Story</a></li>
        <li><a href="/recruit" class:list={{ active: isRecruit }} data-en="Open Roles" data-es="Puestos Abiertos">Open Roles</a></li>
      </ul>
    </li>
    <li><a href="/contact" class:list={{ active: isContact }} data-en="Contact" data-es="Contacto">Contact</a></li>
    <li><a href="/#signup" class="nav-cta" data-en="Join" data-es="Únete">Join</a></li>
  </ul>
</nav>

<script>
  const hamburger = document.getElementById('navHamburger');
  const links = document.getElementById('navLinks');

  const dropdown = document.getElementById('aboutDropdown');
  const dropToggle = document.getElementById('aboutDropToggle');
  const dropMenu = document.getElementById('aboutDropMenu');

  function setDropOpen(open: boolean) {
    dropdown?.classList.toggle('open', open);
    dropToggle?.setAttribute('aria-expanded', String(open));
  }

  function setOpen(open: boolean) {
    hamburger?.classList.toggle('open', open);
    links?.classList.toggle('open', open);
    hamburger?.setAttribute('aria-expanded', String(open));
    // A stale open submenu inside a re-opened mobile panel is disorienting
    if (!open) setDropOpen(false);
  }

  hamburger?.addEventListener('click', () => {
    setOpen(!hamburger.classList.contains('open'));
  });

  // Close the mobile menu after navigating (matters for same-page #anchors)
  links?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => setOpen(false));
  });

  // ── About dropdown (disclosure pattern) ──
  dropToggle?.addEventListener('click', () => {
    setDropOpen(dropToggle.getAttribute('aria-expanded') !== 'true');
  });

  // ArrowDown on the closed toggle opens and moves into the list, per APG
  dropToggle?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setDropOpen(true);
      dropMenu?.querySelector('a')?.focus();
    }
  });

  dropMenu?.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
    const items = Array.from(dropMenu.querySelectorAll('a'));
    const i = items.indexOf(document.activeElement as HTMLAnchorElement);
    if (i === -1) return;
    e.preventDefault();
    const next = e.key === 'ArrowDown' ? (i + 1) % items.length : (i - 1 + items.length) % items.length;
    items[next].focus();
  });

  dropdown?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && dropdown.classList.contains('open')) {
      setDropOpen(false);
      dropToggle?.focus();
    }
  });

  // Click-away and focus-leave both dismiss; Tab itself is never trapped
  document.addEventListener('click', (e) => {
    if (dropdown && !dropdown.contains(e.target as Node)) setDropOpen(false);
  });

  dropdown?.addEventListener('focusout', (e) => {
    if (!dropdown.contains(e.relatedTarget as Node)) setDropOpen(false);
  });
</script>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 200;
    background: var(--charcoal);
    display: flex;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--space-md);
    flex-wrap: wrap;
    /* No safe-area padding: viewport-fit=cover is gone (BaseLayout), so
       env(safe-area-inset-*) is always 0 — reintroducing cover would
       require adding it back here. */
    padding: 0 var(--gutter);
    min-height: 60px;
    border-bottom: 3px solid var(--purple-light);
  }

  .nav-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.25rem, 1.1rem + 0.8vw, 1.6rem);
    color: var(--yellow);
    letter-spacing: 0.06em;
    text-decoration: none;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    min-height: 60px;
  }

  .nav-logo span { color: var(--purple-light); margin-left: 0.3em; }

  .nav-right {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 2rem);
    order: 3;
  }

  .nav-links {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2rem);
    list-style: none;
    order: 2;
    align-items: center;
  }

  .nav-links a {
    font-family: 'Nunito', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--paper-a70);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: inline-flex;
    align-items: center;
    min-height: 60px;
    transition: color 0.15s;
  }

  .nav-links a:hover,
  .nav-links a.active { color: var(--yellow); }

  .nav-links a.nav-cta {
    background: var(--yellow);
    color: var(--charcoal);
    padding: 0.4rem 1.1rem;
    border-radius: 4px;
    font-weight: 800;
    min-height: 0;
  }

  .nav-links a.nav-cta:hover { background: var(--purple-light); color: #fff; }

  /* ── ABOUT DROPDOWN ── */
  .nav-dropdown { position: relative; }

  /* The toggle mirrors the sibling links exactly, plus a caret so it
     reads as "opens something", not a dead link */
  .nav-drop-toggle {
    font-family: 'Nunito', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--paper-a70);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 60px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: color 0.15s;
  }

  .nav-drop-toggle:hover,
  .nav-drop-toggle.active { color: var(--yellow); }

  .drop-caret { transition: transform 0.15s; }
  .nav-dropdown.open .drop-caret { transform: rotate(180deg); }

  /* visibility (not display) so the closed menu is out of the tab order
     but the open/close still gets a transition */
  .nav-drop-menu {
    position: absolute;
    top: calc(100% + 3px);
    left: 50%;
    min-width: 11rem;
    list-style: none;
    padding: 0.35rem 0;
    background: var(--charcoal);
    border: 1px solid var(--paper-a12);
    border-bottom: 3px solid var(--purple-light);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 6px);
    /* visibility flips only after the fade-out completes on close… */
    transition: opacity 0.15s, transform 0.15s, visibility 0s 0.15s;
  }

  .nav-dropdown.open .nav-drop-menu {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    /* …but instantly on open, so ArrowDown can focus a child link in the
       same keystroke that opened the menu */
    transition: opacity 0.15s, transform 0.15s, visibility 0s;
  }

  .nav-drop-menu a {
    display: flex;
    width: 100%;
    padding: 0 1.1rem;
    min-height: var(--tap);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-drop-menu,
    .drop-caret { transition: none; }
  }

  /* ── HAMBURGER ── */
  .nav-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    min-width: var(--tap);
    min-height: var(--tap);
  }

  .nav-hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--cream);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  .nav-hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-hamburger.open span:nth-child(2) { opacity: 0; }
  .nav-hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ── MOBILE MENU ── */
  @media (max-width: 768px) {
    .nav-hamburger { display: flex; }

    .nav-links {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem 0 1rem;
      order: 3;
    }

    .nav-links.open { display: flex; }
    .nav-links li { border-top: 1px solid var(--paper-a12); }

    .nav-links a {
      display: flex;
      justify-content: center;
      padding: 0.85rem 0.5rem;
      font-size: 0.9rem;
      min-height: var(--tap);
    }

    .nav-links a.nav-cta {
      margin: 0.6rem 0 0.25rem;
      padding: 0.85rem 1.25rem;
      border-radius: 6px;
      min-height: var(--tap);
    }

    /* Inside the panel the dropdown becomes an in-flow expanding sub-list —
       nothing floats, so nothing can clip or overflow */
    .nav-drop-toggle {
      width: 100%;
      justify-content: center;
      padding: 0.85rem 0.5rem;
      font-size: 0.9rem;
      min-height: var(--tap);
    }

    .nav-drop-menu {
      position: static;
      min-width: 0;
      padding: 0;
      border: none;
      transform: none;
      transition: none;
      display: none;
      opacity: 1;
      visibility: visible;
      background: var(--paper-a08);
    }

    .nav-dropdown.open .nav-drop-menu {
      display: block;
      transform: none;
    }

    .nav-drop-menu a { justify-content: center; font-size: 0.85rem; }
  }
</style>
