---
/**
 * Sticky top navigation: the wordmark sticker, page links, About
 * dropdown, EN/ES toggle, Join CTA, and the phone menu (a beige sheet
 * that expands inside the sticky nav, under the bar). Owns active-page
 * detection. Deliberately a PLAIN sticky header — see the header
 * bullet in AGENTS.md before adding any positioning tricks. The
 * iOS 26 header-gap bug was never the nav's fault: the device-
 * verified trigger was a position:fixed full-viewport overlay layered
 * above it (the grain, since fixed — see global.css). Never stack a
 * fixed full-viewport layer above this nav.
 *
 * The header stays Poster Beige on the Roadtop Black page ground
 * (captain, 2026-09-30).
 */
import { Image } from 'astro:assets';
import LangToggle from './LangToggle.astro';
import { FOUNDER_PATH } from '../lib/founder';
import wordmarkSticker from '../assets/wordmark-sticker.png';

const pathname = Astro.url.pathname;

/** A route is current when it is the page itself or anything beneath it. */
const isUnder = (base: string) => pathname === base || pathname.startsWith(base + '/');

const isHome     = pathname === '/' || pathname === '';
const isEvents   = isUnder('/events');
const isFounder  = isUnder(FOUNDER_PATH);
// The founder page lives under /about/, which isTeam's prefix also matches, so
// the `!isFounder` guard below is what stops "The Team" double-lighting on
// the founder page. Keep the guard — declaration order alone does nothing.
const isTeam     = !isFounder && isUnder('/about');
// The recruitment page is top-level at /recruit but belongs to the About menu
const isRecruit  = isUnder('/recruit');
// The About parent highlights when any of its children is current
const isAbout    = isTeam || isFounder || isRecruit;
const isContact  = isUnder('/contact');
---

<nav aria-label="Main">
  <div class="nav-bar">
    <a class="nav-logo-link" href="/" aria-label="Trash Talk NYC home">
      <Image src={wordmarkSticker} alt="" class="nav-logo" width={184} densities={[1, 2]} loading="eager" />
    </a>

    <ul class="nav-links">
      <li><a href="/" class:list={{ active: isHome }} data-en="Home" data-es="Inicio">Home</a></li>
      <li><a href="/events" class:list={{ active: isEvents }} data-en="Club Events" data-es="Eventos del Club">Club Events</a></li>
      <li class="nav-dropdown" id="aboutDropdown">
        <!-- Disclosure pattern (APG): the parent is a toggle, not a link —
             /about stays reachable as "The Team" below. aria-expanded is the
             whole submenu contract; no menu roles, no aria-haspopup.
             "Open Roles" is the captain's chosen label (round 20): "Join"
             is taken by the mailing-list nav CTA and "Work With Us" was
             rejected as confusable with Contact.
             Projects stays decoupled on fm/projects-tree-guard and rejoins
             this list when it lands. -->
        <button
          type="button"
          class:list={['nav-drop-toggle', { active: isAbout }]}
          id="aboutDropToggle"
          aria-expanded="false"
          aria-controls="aboutDropMenu"
        >
          <span data-en="About" data-es="Nosotros">About</span>
          <svg class="drop-caret" aria-hidden="true" width="10" height="7" viewBox="0 0 10 7" fill="none">
            <path d="M1 1.5 5 5.5 9 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <ul class="nav-drop-menu" id="aboutDropMenu">
          <li><a href="/about" class:list={{ active: isTeam }} data-en="The Team" data-es="El Equipo">The Team</a></li>
          <li><a href={FOUNDER_PATH} class:list={{ active: isFounder }} data-en="From the Founder" data-es="Del Fundador">From the Founder</a></li>
          <li><a href="/recruit" class:list={{ active: isRecruit }} data-en="Open Roles" data-es="Puestos Abiertos">Open Roles</a></li>
        </ul>
      </li>
      <li><a href="/contact" class:list={{ active: isContact }} data-en="Contact" data-es="Contacto">Contact</a></li>
    </ul>

    <div class="nav-right">
      <div class="nav-lang"><LangToggle /></div>
      <a href="/#signup" class="btn btn-primary nav-cta" data-en="Join" data-es="Únete">Join</a>
      <button class="burger" id="navBurger" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="mMenu">
        <svg viewBox="0 0 20 16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M1 2h18M1 8h18M1 14h18" /></svg>
      </button>
    </div>
  </div>

  <!-- PHONE MENU: a beige poster sheet under the light header. About is
       a dropdown; no sticker inside the menu; the yellow button says
       "Newsletter" (captain). Lives inside the sticky nav so it pins
       with the bar — no fixed layers. -->
  <div class="m-menu" id="mMenu" hidden>
    <div class="m-links">
      <a href="/" class:list={{ active: isHome }} data-en="Home" data-es="Inicio">Home</a>
      <a href="/events" class:list={{ active: isEvents }} data-en="Club Events" data-es="Eventos del Club">Club Events</a>
      <div class="m-group">
        <button type="button" class:list={['m-drop', { active: isAbout }]} id="mAboutToggle" aria-expanded="false" aria-controls="mAboutSub">
          <span data-en="About" data-es="Nosotros">About</span>
          <span class="chev" aria-hidden="true">▾</span>
        </button>
        <div class="m-sub" id="mAboutSub" hidden>
          <a href="/about" class:list={{ active: isTeam }} data-en="The Team" data-es="El Equipo">The Team</a>
          <a href={FOUNDER_PATH} class:list={{ active: isFounder }} data-en="From the Founder" data-es="Del Fundador">From the Founder</a>
          <a href="/recruit" class:list={{ active: isRecruit }} data-en="Open Roles" data-es="Puestos Abiertos">Open Roles</a>
        </div>
      </div>
      <a href="/contact" class:list={{ active: isContact }} data-en="Contact" data-es="Contacto">Contact</a>
    </div>
    <div class="m-foot">
      <a href="/#signup" class="btn btn-primary m-newsletter" data-en="Newsletter" data-es="Boletín">Newsletter</a>
      <LangToggle />
    </div>
  </div>
</nav>

<script>
  const burger = document.getElementById('navBurger');
  const menu = document.getElementById('mMenu');

  const dropdown = document.getElementById('aboutDropdown');
  const dropToggle = document.getElementById('aboutDropToggle');
  const dropMenu = document.getElementById('aboutDropMenu');

  const mAboutToggle = document.getElementById('mAboutToggle');
  const mAboutSub = document.getElementById('mAboutSub');

  function setDropOpen(open: boolean) {
    dropdown?.classList.toggle('open', open);
    dropToggle?.setAttribute('aria-expanded', String(open));
  }

  function setMenuOpen(open: boolean) {
    if (menu) menu.hidden = !open;
    burger?.classList.toggle('open', open);
    burger?.setAttribute('aria-expanded', String(open));
  }

  burger?.addEventListener('click', () => {
    setMenuOpen(menu?.hidden ?? false);
  });

  // Close the phone menu after navigating (matters for same-page #anchors)
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => setMenuOpen(false));
  });

  // Phone About sub-list; starts open when an About page is current so
  // the lit child is visible the moment the sheet opens
  function setMAboutOpen(open: boolean) {
    if (mAboutSub) mAboutSub.hidden = !open;
    mAboutToggle?.setAttribute('aria-expanded', String(open));
  }

  mAboutToggle?.addEventListener('click', () => {
    setMAboutOpen(mAboutSub?.hidden ?? false);
  });

  if (mAboutToggle?.classList.contains('active')) setMAboutOpen(true);

  // ── About dropdown (disclosure pattern) ──
  dropToggle?.addEventListener('click', () => {
    setDropOpen(dropToggle.getAttribute('aria-expanded') !== 'true');
  });

  // ArrowDown on the closed toggle opens and moves into the list, per APG
  dropToggle?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setDropOpen(true);
      dropMenu?.querySelector('a')?.focus();
    }
  });

  dropMenu?.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
    const items = Array.from(dropMenu.querySelectorAll('a'));
    const i = items.indexOf(document.activeElement as HTMLAnchorElement);
    if (i === -1) return;
    e.preventDefault();
    const next = e.key === 'ArrowDown' ? (i + 1) % items.length : (i - 1 + items.length) % items.length;
    items[next].focus();
  });

  dropdown?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && dropdown.classList.contains('open')) {
      setDropOpen(false);
      dropToggle?.focus();
    }
  });

  // Click-away and focus-leave both dismiss; Tab itself is never trapped
  document.addEventListener('click', (e) => {
    if (dropdown && !dropdown.contains(e.target as Node)) setDropOpen(false);
  });

  dropdown?.addEventListener('focusout', (e) => {
    if (!dropdown.contains(e.relatedTarget as Node)) setDropOpen(false);
  });
</script>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 200;
    background: var(--beige);
    color: var(--black);
    border-bottom: var(--ink);
  }

  .nav-bar {
    max-width: var(--container);
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 62px;
    /* No safe-area padding: viewport-fit=cover is gone (BaseLayout), so
       env(safe-area-inset-*) is always 0 — reintroducing cover would
       require adding it back here. */
    padding-inline: max(var(--gutter), var(--safe-left)) max(var(--gutter), var(--safe-right));
  }

  .nav-logo-link {
    display: block;
    flex-shrink: 0;
    margin-right: auto;
  }

  /* The wordmark sticker hangs slightly below the bar like a slapped-on
     sticker; the nav deliberately doesn't clip it. */
  nav :global(.nav-logo) {
    width: 70px;
    height: auto;
    margin-top: 20px;
    transform: rotate(-5deg);
    filter: drop-shadow(3px 3px 0 var(--black));
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 26px;
    list-style: none;
    font-weight: 600;
    font-size: 1.08rem;
  }

  .nav-links a,
  .nav-drop-toggle {
    text-decoration: none;
    color: var(--black);
    padding-block: 4px;
    border-bottom: 3px solid transparent;
    cursor: pointer;
  }

  .nav-links > li > a:hover,
  .nav-drop-toggle:hover { color: var(--purple); }

  .nav-links > li > a.active,
  .nav-drop-toggle.active {
    border-color: var(--purple);
    color: var(--purple);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .nav-lang { display: none; }

  nav :global(.nav-cta) {
    padding: 10px 18px;
    box-shadow: 3px 3px 0 var(--black);
  }

  /* ── ABOUT DROPDOWN ── */
  .nav-dropdown { position: relative; }

  .nav-drop-toggle {
    font: inherit;
    font-weight: 600;
    background: none;
    border-top: none;
    border-left: none;
    border-right: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .drop-caret { transition: transform 0.15s; }
  .nav-dropdown.open .drop-caret { transform: rotate(180deg); }

  /* visibility (not display) so the closed menu is out of the tab order
     but the open/close still gets a transition */
  .nav-drop-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: -14px;
    min-width: 200px;
    list-style: none;
    display: grid;
    padding: 8px;
    background: var(--paper);
    border: var(--ink);
    border-radius: 10px;
    box-shadow: 5px 5px 0 var(--black);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    /* visibility flips only after the fade-out completes on close… */
    transition: opacity 0.15s, transform 0.15s, visibility 0s 0.15s;
  }

  .nav-dropdown.open .nav-drop-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    /* …but instantly on open, so ArrowDown can focus a child link in the
       same keystroke that opened the menu */
    transition: opacity 0.15s, transform 0.15s, visibility 0s;
  }

  .nav-drop-menu a {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 8px 10px;
    min-height: var(--tap);
    border-radius: 6px;
    border-bottom: none;
    white-space: nowrap;
  }

  .nav-drop-menu a:hover { background: var(--yellow); color: var(--black); }
  .nav-drop-menu a.active { color: var(--purple); }

  @media (prefers-reduced-motion: reduce) {
    .nav-drop-menu,
    .drop-caret { transition: none; }
  }

  /* ── BURGER ── */
  .burger {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: var(--ink);
    border-radius: 10px;
    background: var(--beige);
    color: var(--black);
    padding: 0;
    box-shadow: 3px 3px 0 var(--black);
    cursor: pointer;
  }

  .burger svg { width: 20px; }
  .burger.open { background: var(--yellow); }

  /* ── PHONE MENU SHEET ── */
  .m-menu {
    border-top: var(--ink);
    padding: 22px 22px 26px;
    display: grid;
    gap: 22px;
  }

  .m-menu[hidden] { display: none; }

  .m-links { display: grid; gap: 2px; }

  .m-links > a,
  .m-drop {
    font-family: var(--display);
    font-weight: 400;
    font-size: 2.6rem;
    line-height: 1.05;
    text-decoration: none;
    color: var(--black);
    padding-block: 4px;
    border-bottom: 2px solid rgba(29, 29, 35, 0.12);
  }

  .m-links > a.active,
  .m-drop.active { color: var(--purple); }

  .m-links > a:hover,
  .m-drop:hover { color: var(--purple); }

  .m-drop {
    background: none;
    border-top: 0;
    border-left: 0;
    border-right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    cursor: pointer;
    text-align: left;
  }

  .m-drop .chev {
    font-family: var(--body);
    font-size: 1.4rem;
    transition: transform 0.15s;
  }

  .m-drop[aria-expanded='true'] .chev { transform: rotate(180deg); }

  .m-sub { display: grid; padding: 4px 0 6px; }
  .m-sub[hidden] { display: none; }

  .m-sub a {
    font-family: var(--body);
    font-weight: 600;
    font-size: 1.25rem;
    text-decoration: none;
    padding: 7px 0 7px 18px;
    min-height: var(--tap);
    display: flex;
    align-items: center;
    color: var(--black);
  }

  .m-sub a:hover,
  .m-sub a.active { color: var(--purple); }

  .m-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  nav :global(.m-newsletter) { box-shadow: 3px 3px 0 var(--black); }

  @media (prefers-reduced-motion: reduce) {
    .m-drop .chev { transition: none; }
  }

  /* ── DESKTOP ── */
  @media (min-width: 761px) {
    .nav-bar { height: 74px; gap: 28px; }

    nav :global(.nav-logo) {
      width: 92px;
      margin-top: 26px;
    }

    .nav-links { display: flex; margin-left: auto; }
    .nav-logo-link { margin-right: 0; }
    .nav-lang { display: block; }
    .burger { display: none; }
    .m-menu { display: none !important; }
  }
</style>
