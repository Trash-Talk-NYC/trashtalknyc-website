---
/**
 * Black strip above the nav pointing at club socials, with all five
 * sticker icons (captain: Facebook and LinkedIn join the strip).
 * Visible on all widths (the 2026-10 redesign keeps it on phones; it
 * is the black band the status bar blends into at the top of the
 * page). "Socials" replaced "Keep up with club socials" (captain).
 */
import SocialLinks from './SocialLinks.astro';
---

<div class="social-bar">
  <span class="social-bar-text" data-en="Socials" data-es="Redes">Socials</span>
  <div class="social-bar-divider" aria-hidden="true"></div>
  <SocialLinks ids={['instagram', 'tiktok', 'youtube', 'facebook', 'linkedin']} />
</div>

<style>
  .social-bar {
    background: var(--black);
    color: var(--beige);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    padding: 12px max(16px, var(--safe-right)) 12px max(16px, var(--safe-left));
    font-size: 0.8rem;
    font-weight: 500;
  }

  .social-bar-divider {
    width: 1px;
    height: 16px;
    background: rgba(234, 233, 218, 0.35);
  }

  @media (min-width: 761px) {
    .social-bar { gap: 16px; font-size: 0.9rem; }
  }
</style>
