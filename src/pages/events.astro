---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Events — Trash Talk NYC" description="Find and join upcoming Trash Talk NYC cleanup events across all five boroughs.">

  <!-- Load Eventbrite widget JS early; skipped on localhost so local dev doesn't depend on it -->
  <script is:inline>
    if (location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
      var s = document.createElement('script');
      s.src = 'https://www.eventbrite.com/static/widgets/eb_widgets.js';
      document.head.appendChild(s);
    }
  </script>

  <!-- HERO -->
  <section class="events-hero">
    <div class="events-hero-inner">

      <div class="events-hero-left">
        <div class="hero-page-label" data-en="Trash Talk NYC" data-es="Trash Talk NYC">Trash Talk NYC</div>
        <h1 class="hero-title">
          <span data-en="Club" data-es="Eventos">Club</span>
          <span class="accent" data-en="Events" data-es="del Club">Events</span>
        </h1>
      </div>

      <div class="next-event-card">
        <div class="card-eyebrow">
          <span class="pulse-dot"></span>
          <span data-en="Next club event" data-es="Próximo evento">Next club event</span>
        </div>
        <div class="card-event-name" id="heroEventName">Loading…</div>

        <div class="card-meta">
          <div class="card-meta-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span id="heroEventDate"></span>
          </div>
          <div class="card-meta-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span id="heroEventTime"></span>
          </div>
          <div class="card-meta-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span id="heroEventLoc"></span>
          </div>
          <div class="card-meta-row" id="heroMapRow" style="display:none">
            <span class="map-links">
              <a class="map-link" id="heroGoogleMap" href="#" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                Google Maps
              </a>
              <a class="map-link" id="heroAppleMap" href="#" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                Apple Maps
              </a>
            </span>
          </div>
        </div>

        <div class="card-countdown">
          <span class="cd-label-top" data-en="Time left" data-es="Tiempo restante">Time left</span>
          <div class="cd-unit"><span class="cd-num" id="cdD">--</span><span class="cd-sub" data-en="days" data-es="días">days</span></div>
          <span class="cd-sep">:</span>
          <div class="cd-unit"><span class="cd-num" id="cdH">--</span><span class="cd-sub" data-en="hrs" data-es="hrs">hrs</span></div>
          <span class="cd-sep">:</span>
          <div class="cd-unit"><span class="cd-num" id="cdM">--</span><span class="cd-sub" data-en="min" data-es="min">min</span></div>
        </div>

        <button class="btn-rsvp" id="heroRsvpBtn" data-event-id=""
          data-en="RSVP for this event" data-es="Regístrate aquí">
          RSVP for this event
        </button>
      </div>

    </div>
  </section>

  <!-- PAGE HEADER BAND -->
  <div class="page-header-band">
    <div class="page-header-band-inner">
      <div class="section-title" data-en="All Club Events" data-es="Todos los Eventos del Club">All Club Events</div>
      <span class="eb-badge">Eventbrite</span>
    </div>
  </div>

  <!-- EVENTS LIST -->
  <div class="events-page">

    <div id="skeletons">
      <div class="events-list">
        <div class="skeleton-card"><div class="skel skel-date"></div><div class="skel-body"><div class="skel skel-title"></div><div class="skel skel-meta"></div><div class="skel skel-tags"></div></div></div>
        <div class="skeleton-card"><div class="skel skel-date"></div><div class="skel-body"><div class="skel skel-title"></div><div class="skel skel-meta"></div><div class="skel skel-tags"></div></div></div>
      </div>
    </div>

    <div class="dist-sort-label" id="distSortLabel" style="display:none">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <span data-en="Sorted nearest to farthest" data-es="Ordenado del más cercano al más lejano">Sorted nearest to farthest</span>
    </div>

    <div id="upcomingList"></div>

    <div id="pastSection" style="display:none">
      <div class="past-divider">
        <div class="past-divider-line"></div>
        <button class="past-toggle" id="pastToggle" onclick="togglePast()">
          <span data-en="Past club events" data-es="Eventos pasados">Past club events</span>
          <span class="past-toggle-arrow">▾</span>
        </button>
        <div class="past-divider-line"></div>
      </div>
      <div class="events-list" id="pastList"></div>
    </div>

  </div>

  <!-- RSVP MODAL: fallback on localhost; Eventbrite widget used in production -->
  <div class="modal-overlay" id="rsvpModal" onclick="if(event.target===this)closeModal()">
    <div class="modal-box">
      <div class="modal-header">
        <div class="modal-event-name" id="modalEventName"></div>
        <button class="modal-close" onclick="closeModal()" aria-label="Close">✕</button>
      </div>
      <div class="modal-meta">
        <div class="modal-meta-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span id="modalDate"></span>
        </div>
        <div class="modal-meta-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span id="modalTime"></span>
        </div>
        <div class="modal-meta-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span id="modalLoc"></span>
        </div>
      </div>
      <div class="eb-sim">
        <div class="eb-head">
          <span class="eb-logo">eventbrite</span>
          <span class="eb-secure">🔒 Secure checkout</span>
        </div>
        <div class="eb-ticket">
          <div>
            <div class="eb-ticket-name">General Admission</div>
            <div class="eb-ticket-price">Free</div>
          </div>
          <div class="eb-qty">
            <button class="eb-qty-btn" onclick="adjQty(-1)">−</button>
            <span class="eb-qty-num" id="modalQty">1</span>
            <button class="eb-qty-btn" onclick="adjQty(1)">+</button>
          </div>
        </div>
        <div class="eb-cta-area">
          <a class="eb-register" id="modalRegisterBtn" href="#" target="_blank" rel="noopener">Register Now</a>
        </div>
        <div class="eb-powered">Powered by Eventbrite</div>
      </div>
      <div class="modal-foot">Checkout handled securely by Eventbrite</div>
    </div>
  </div>

  <!-- is:inline required: togglePast, adjQty, openModal, closeModal
       are called from onclick attributes in static HTML and dynamically-built card HTML -->
  <script is:inline>
    var heroEventStart = null;
    var isLocalhost = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
    var EB_PAGE = 'https://trashtalknyc.eventbrite.com';
    var MONTHS    = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    var MONTHS_ES = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
    var DAYS      = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    var DAYS_ES   = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];

    function parseDate(s) { return new Date(s); }

    // currentLang is defined by BaseLayout's is:inline (runs after this script).
    // These helpers reference it at call time, not at definition time, so they're safe.
    function fmtDate(d, opts) {
      return d.toLocaleDateString(currentLang === 'es' ? 'es' : 'en-US', opts);
    }
    function fmtTime(d) {
      return d.toLocaleTimeString(currentLang === 'es' ? 'es' : 'en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
    }

    function mapUrls(ev) {
      var v = ev.venue || {};
      var q = v.address || ((v.name || '') + (v.city ? ', ' + v.city : ''));
      if (!q) return null;
      var enc = encodeURIComponent(q);
      return {
        google: 'https://www.google.com/maps/search/?api=1&query=' + enc,
        apple:  'https://maps.apple.com/?q=' + enc
      };
    }

    var userLat = null, userLng = null;

    function haversineKm(lat1, lng1, lat2, lng2) {
      var R = 6371, dLat = (lat2-lat1)*Math.PI/180, dLng = (lng2-lng1)*Math.PI/180;
      var a = Math.sin(dLat/2)*Math.sin(dLat/2) + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLng/2)*Math.sin(dLng/2);
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    }
    function kmToMiles(km) { return km * 0.621371; }
    function distLabel(ev) {
      if (userLat === null || !ev.venue || !ev.venue.lat) return '';
      var mi = kmToMiles(haversineKm(userLat, userLng, ev.venue.lat, ev.venue.lng));
      return '<span class="dist-badge">' + mi.toFixed(1) + ' mi away</span>';
    }

    function startCountdown(isoStr) {
      function tick() {
        var diff = new Date(isoStr) - new Date();
        if (diff <= 0) { clearInterval(timer); return; }
        var p = function(n) { return String(n).padStart(2, '0'); };
        var dEl = document.getElementById('cdD');
        if (!dEl) return;
        dEl.textContent                             = p(Math.floor(diff / 864e5));
        document.getElementById('cdH').textContent = p(Math.floor((diff % 864e5) / 36e5));
        document.getElementById('cdM').textContent = p(Math.floor((diff % 36e5) / 6e4));
      }
      tick();
      var timer = setInterval(tick, 30000);
    }

    function buildCard(ev, isPast) {
      var start   = parseDate(ev.start.local || ev.start.utc);
      var end     = parseDate(ev.end.local   || ev.end.utc);
      var venue   = ev.venue || {};
      var loc     = (venue.name || '') + (venue.city ? ', ' + venue.city : '');
      var maps    = mapUrls(ev);
      var dist    = isPast ? '' : distLabel(ev);
      var btnId   = 'eb-trigger-' + ev.id;

      var months  = currentLang === 'es' ? MONTHS_ES : MONTHS;
      var days    = currentLang === 'es' ? DAYS_ES   : DAYS;
      var dateStr = fmtDate(start, { weekday: 'long', month: 'long', day: 'numeric' });
      var timeStr = fmtTime(start) + ' – ' + fmtTime(end);

      var pinSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>';
      var extSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>';
      var locHtml = loc
        ? '<span class="event-detail">' + pinSvg + loc + '</span>' +
          (maps
            ? '<span class="map-links">' +
                '<a class="map-link" href="' + maps.google + '" target="_blank" rel="noopener">' + extSvg + 'Google Maps</a>' +
                '<a class="map-link" href="' + maps.apple  + '" target="_blank" rel="noopener">' + extSvg + 'Apple Maps</a>' +
              '</span>'
            : '')
        : '';

      var cta = isPast
        ? '<div class="event-cta"><span class="card-status" data-en="Past" data-es="Pasado">Past</span></div>'
        : '<div class="event-cta"><button class="btn-card btn-card-purple" id="' + btnId + '"' +
            ' data-event-id="' + ev.id + '"' +
            ' data-url="'      + (ev.url  || '') + '"' +
            ' data-name="'     + (ev.name || '').replace(/"/g, '&quot;') + '"' +
            ' data-date="'     + dateStr + '"' +
            ' data-time="'     + timeStr + '"' +
            ' data-loc="'      + loc.replace(/"/g, '&quot;') + '"' +
            '>RSVP &rarr;</button>' + dist + '</div>';

      return '<div class="event-card ' + (isPast ? 'past' : 'upcoming') + '">' +
        '<div class="event-date-block">' +
          '<span class="month" data-en="' + MONTHS[start.getMonth()] + '" data-es="' + MONTHS_ES[start.getMonth()] + '">' + months[start.getMonth()] + '</span>' +
          '<span class="day">'  + start.getDate() + '</span>' +
          '<span class="dow" data-en="' + DAYS[start.getDay()] + '" data-es="' + DAYS_ES[start.getDay()] + '">' + days[start.getDay()] + '</span>' +
        '</div>' +
        '<div class="event-info">' +
          '<div class="event-name">' + ev.name + '</div>' +
          '<div class="event-details">' +
            '<span class="event-detail"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>' + fmtTime(start) + ' – ' + fmtTime(end) + '</span>' +
            locHtml +
          '</div>' +
        '</div>' +
        cta +
      '</div>';
    }

    var allUpcomingEvents = [];

    function sortByDist(events) {
      if (userLat === null) return events;
      return events.slice().sort(function(a, b) {
        var aLat = a.venue && a.venue.lat, bLat = b.venue && b.venue.lat;
        if (!aLat && !bLat) return 0;
        if (!aLat) return 1;
        if (!bLat) return -1;
        return haversineKm(userLat, userLng, a.venue.lat, a.venue.lng) -
               haversineKm(userLat, userLng, b.venue.lat, b.venue.lng);
      });
    }

    function renderList(events) {
      var sorted = sortByDist(events);
      var upcomingList = document.getElementById('upcomingList');
      if (!upcomingList) return;
      upcomingList.innerHTML = '<div class="events-list">' + sorted.map(function(e) { return buildCard(e, false); }).join('') + '</div>';
      setTimeout(initWidgets, 100);
    }

    function togglePast() {
      var list   = document.getElementById('pastList');
      var toggle = document.getElementById('pastToggle');
      var isOpen = toggle.classList.contains('open');
      toggle.classList.toggle('open', !isOpen);
      list.style.display = isOpen ? 'none' : 'flex';
    }

    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(function(pos) {
        userLat = pos.coords.latitude;
        userLng = pos.coords.longitude;
        var lbl = document.getElementById('distSortLabel');
        if (lbl) lbl.style.display = 'flex';
        if (allUpcomingEvents.length > 0) {
          renderList(allUpcomingEvents);
        }
      }, function() {});
    }

    function initWidgets() {
      document.querySelectorAll('[data-event-id]').forEach(function(btn) {
        var id = btn.getAttribute('data-event-id');
        if (!id || btn.dataset.widgetInit) return;
        btn.dataset.widgetInit = '1';
        if (!isLocalhost && window.EBWidgets) {
          window.EBWidgets.createWidget({ widgetType: 'checkout', eventId: id, modal: true, modalTriggerElementId: btn.id });
        } else {
          btn.addEventListener('click', function() { openModal(btn); });
        }
      });
    }

    function openModal(btn) {
      document.getElementById('modalEventName').textContent = btn.getAttribute('data-name') || '';
      document.getElementById('modalDate').textContent      = btn.getAttribute('data-date') || '';
      document.getElementById('modalTime').textContent      = btn.getAttribute('data-time') || '';
      document.getElementById('modalLoc').textContent       = btn.getAttribute('data-loc')  || '';
      document.getElementById('modalQty').textContent       = '1';
      var reg = document.getElementById('modalRegisterBtn');
      if (reg) reg.href = btn.getAttribute('data-url') || '#';
      document.getElementById('rsvpModal').classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      document.getElementById('rsvpModal').classList.remove('open');
      document.body.style.overflow = '';
    }

    function adjQty(delta) {
      var el = document.getElementById('modalQty');
      el.textContent = Math.max(1, parseInt(el.textContent, 10) + delta);
    }

    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });

    // Hero date reformat on language switch (BaseLayout's setLang handles everything else)
    document.addEventListener('DOMContentLoaded', function() {
      ['btnEN', 'btnES'].forEach(function(id) {
        var btn = document.getElementById(id);
        if (!btn) return;
        btn.addEventListener('click', function() {
          if (!heroEventStart) return;
          var lang = id === 'btnEN' ? 'en' : 'es';
          var dateEl = document.getElementById('heroEventDate');
          if (dateEl) {
            dateEl.textContent = heroEventStart.toLocaleDateString(
              lang === 'es' ? 'es' : 'en-US',
              { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }
            );
          }
        });
      });
    });

    fetch('/.netlify/functions/next-event?all=true')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var upcoming = data.upcoming || [];
        var past     = data.past     || [];

        if (upcoming[0]) {
          var ev    = upcoming[0];
          var start = parseDate(ev.start.local || ev.start.utc);
          var end   = parseDate(ev.end.local   || ev.end.utc);
          var venue = ev.venue || {};
          var loc   = (venue.name || '') + (venue.city ? ', ' + venue.city : '');

          heroEventStart = start;

          var nameEl = document.getElementById('heroEventName');
          var dateEl = document.getElementById('heroEventDate');
          var timeEl = document.getElementById('heroEventTime');
          var locEl  = document.getElementById('heroEventLoc');
          var rsvpEl = document.getElementById('heroRsvpBtn');

          if (nameEl) nameEl.textContent = ev.name;
          if (dateEl) dateEl.textContent = fmtDate(start, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
          if (timeEl) timeEl.textContent = fmtTime(start) + ' – ' + fmtTime(end);
          if (locEl && loc) {
            locEl.textContent = loc;
            var heroMaps = mapUrls(ev);
            if (heroMaps) {
              document.getElementById('heroGoogleMap').href = heroMaps.google;
              document.getElementById('heroAppleMap').href  = heroMaps.apple;
              document.getElementById('heroMapRow').style.display = '';
            }
          }
          if (rsvpEl) {
            rsvpEl.id = 'eb-trigger-hero-' + ev.id;
            rsvpEl.setAttribute('data-event-id', ev.id);
            rsvpEl.setAttribute('data-url',  ev.url || '');
            rsvpEl.setAttribute('data-name', ev.name || '');
            rsvpEl.setAttribute('data-date', start.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }));
            rsvpEl.setAttribute('data-time', fmtTime(start) + ' – ' + fmtTime(end));
            rsvpEl.setAttribute('data-loc',  loc || '');
          }
          startCountdown(ev.start.utc || ev.start.local);
        }

        var sk = document.getElementById('skeletons');
        if (sk) sk.remove();

        var upcomingList = document.getElementById('upcomingList');

        if (upcoming.length === 0) {
          var heroCard = document.querySelector('.next-event-card');
          if (heroCard) heroCard.style.display = 'none';
          var countdown = document.querySelector('.card-countdown');
          if (countdown) countdown.style.display = 'none';
          upcomingList.innerHTML =
            '<div class="no-events-cta">' +
              '<p>No upcoming events right now — stay tuned on our Eventbrite page for new dates.</p>' +
              '<a class="eb-cta-btn" href="' + EB_PAGE + '" target="_blank" rel="noopener">See us on Eventbrite →</a>' +
            '</div>';
        } else {
          allUpcomingEvents = upcoming;
          renderList(upcoming);
        }

        var pastSection = document.getElementById('pastSection');
        var pastList    = document.getElementById('pastList');
        if (past.length > 0 && pastSection && pastList) {
          pastSection.style.display = 'block';
          pastList.innerHTML = past.map(function(e) { return buildCard(e, true); }).join('');
        }
      })
      .catch(function() {
        var sk = document.getElementById('skeletons');
        if (sk) sk.remove();
        var upcomingList = document.getElementById('upcomingList');
        if (upcomingList) upcomingList.innerHTML =
          '<div style="text-align:center;padding:3rem;color:var(--gray);font-weight:700;font-size:0.85rem">' +
          'Could not load events. Visit <a href="https://www.eventbrite.com" target="_blank" rel="noopener" style="color:var(--purple)">Eventbrite</a> directly.</div>';
      });
  </script>

  <!-- Custom footer: flex-column centered with purple-light border (differs from global flex-row footer) -->
  <footer class="events-footer" slot="footer">
    <div class="footer-logo">Trash Talk NYC</div>
    <ul class="footer-links">
      <li><a href="/" data-en="Home" data-es="Inicio">Home</a></li>
      <li><a href="/events" data-en="Club Events" data-es="Eventos del Club">Club Events</a></li>
      <li><a href="/#signup" data-en="Join" data-es="Únete">Join</a></li>
      <li><a href="/about" data-en="About" data-es="Nosotros">About</a></li>
      <li><a href="/contact" data-en="Contact" data-es="Contacto">Contact</a></li>
    </ul>
    <ul class="footer-socials">
      <li>
        <a href="https://www.instagram.com/trashtalk_nyc/" target="_blank" rel="noopener">
