---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import { Image } from 'astro:assets';
import { assignPastCovers, boroughPreviewCovers, EVENTS_HERO_LINE, fetchEventsAtBuildTime, formatDate, groupPastByBorough, newestGroupIndex, sampleEvents, SHOW_EVENTS_HERO_LINE, SHOW_SAMPLE_EVENTS, toEventCardProps, type EventPlace } from '../lib/events';
import { streetPhotos } from '../lib/streetPhotos';
import WallHero from '../components/WallHero.astro';
import SectionWall from '../components/SectionWall.astro';
import wallFlyers from '../assets/walls/wall-9744.webp';
import wallHero from '../assets/walls/walk-1724.webp';
import { boroughCovers } from '../lib/boroughCovers';
import vestSticker from '../assets/vest-sticker.png';

const { upcoming: upcomingRaw, past } = await fetchEventsAtBuildTime();

// Past events by borough, each with its own Eventbrite cover image
// (captain, 2026-10-15: "Reinstate! By borough. Add pictures"). Only real
// Eventbrite events appear. A cover another card already shows gives way
// to a street photo from the captain's photo walk (2026-10-21: "diversify
// images"), so no picture repeats down the page.
const pastGroups = groupPastByBorough(past);
const pastCovers = assignPastCovers(pastGroups, streetPhotos);
const placeName = (b: EventPlace) =>
  b === null
    ? { en: 'Outside the five boroughs', es: 'Fuera de los cinco condados' }
    : { en: b, es: b === 'The Bronx' ? 'El Bronx' : b };
const pastDate = (iso: string) => ({ en: formatDate(iso, 'en'), es: formatDate(iso, 'es') });
const upcoming = upcomingRaw.map(ev => ({
  props: toEventCardProps(ev),
  latLng: ev.venue?.lat != null ? { lat: ev.venue.lat, lng: ev.venue.lng! } : null,
}));
// Sample flyers fill an empty list until real events are posted (round 10);
// a real Eventbrite event always replaces them
const flyers = upcoming.length > 0
  ? upcoming
  : SHOW_SAMPLE_EVENTS ? sampleEvents.map((props) => ({ props, latLng: null })) : [];
// Each borough folds; only the one with the most recent event starts open
const openGroup = newestGroupIndex(pastGroups, past[0]);
const eventCount = (n: number) => ({ en: `${n} ${n === 1 ? 'event' : 'events'}`, es: `${n} ${n === 1 ? 'evento' : 'eventos'}` });
---

<BaseLayout title="Events — Trash Talk NYC" description="Find and join upcoming Trash Talk NYC cleanup events across all five boroughs.">

  <!-- Load Eventbrite widget JS early; skipped on localhost so local dev doesn't depend on it -->
  <script is:inline>
    if (location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
      var s = document.createElement('script');
      s.src = 'https://www.eventbrite.com/static/widgets/eb_widgets.js';
      document.head.appendChild(s);
    }
  </script>

  <!-- The shared left-aligned hero, kept small (captain, 2026-10-21: "a
       tiny hero"). Its line is a placeholder in src/lib/events.ts, hidden
       for now. -->
  <WallHero
    src={wallHero}
    title={[{ en: 'Club Events', es: 'Eventos del Club' }]}
    line={SHOW_EVENTS_HERO_LINE ? EVENTS_HERO_LINE : undefined}
    seed={22}
  />

  <!-- Upcoming and past on ONE flat cream sheet pasted on the captain's
       wall pick, divided by a dashed cut line (captain's EL3, 2026-10-21:
       no disjoint boxes, no shadow) -->
  <section class="ev-section wall">
    <SectionWall kind="cleanup" src={wallFlyers} dim={0} duotone={0} seed={4} />
    <div class="wrap">
    <div class="ev-sheet">
    <section class="ev-upcoming" aria-labelledby="upcomingHeading">
      <!-- R2: one quiet newsletter link beside the heading replaces the
           old "best way to hear about events" box -->
      <div class="ev-head">
        <h2 id="upcomingHeading" class="ev-h" data-en="Upcoming" data-es="Próximos">Upcoming</h2>
        <a class="ev-inbox mono" href="/#signup" data-en="Get them in your inbox →" data-es="Recíbelos en tu correo →">Get them in your inbox →</a>
      </div>

      <div class="dist-sort-label mono" id="distSortLabel" style="display:none">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
        <span data-en="Sorted nearest to farthest" data-es="Ordenado del más cercano al más lejano">Sorted nearest to farthest</span>
      </div>

      {flyers.length > 0 ? (
        <div class="ev-list" id="eventsListInner">
          {flyers.map(({ props, latLng }) => (
            <EventCard {...props} latLng={latLng} />
          ))}
        </div>
      ) : (
        <p class="ev-none" data-en="No dates are posted yet. New cleanups get posted here." data-es="Aún no hay fechas publicadas. Las nuevas limpiezas se publican aquí.">No dates are posted yet. New cleanups get posted here.</p>
      )}
    </section>

    {pastGroups.length > 0 && (
      <>
      <hr class="ev-cut" />
      <section class="past" aria-labelledby="pastHeading">
        <h2 id="pastHeading" class="ev-h" data-en="Past events" data-es="Eventos pasados">Past events</h2>
        {pastGroups.map((group, gi) => {
          const count = eventCount(group.events.length);
          // The folded row previews the borough: its cover pick, then the
          // events' own covers (P1/P4); photo-less events are skipped
          const cover = group.borough ? boroughCovers[group.borough] : undefined;
          const strip = boroughPreviewCovers(group, cover ? 3 : 4);
          return (
          <details class="past-group" open={gi === openGroup}>
            <summary class="past-sum">
              <span class="past-row">
                <span class="past-place" data-en={placeName(group.borough).en} data-es={placeName(group.borough).es}>{placeName(group.borough).en}</span>
                <span class="past-count mono" data-en={count.en} data-es={count.es}>{count.en}</span>
                <svg class="past-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
              {(cover || strip.length > 0) && (
                <span class="past-strip" aria-hidden="true">
                  {cover && <Image class="past-strip-pic" src={cover} alt="" width={600} widths={[300, 600]} sizes="(min-width: 761px) 16rem, 25vw" />}
                  {strip.map((url) => <img class="past-strip-pic" src={url} alt="" loading="lazy" decoding="async" />)}
                </span>
              )}
            </summary>
            <ul class="past-list">
              {group.events.map((ev) => {
                const date = pastDate(ev.start.local || ev.start.utc);
                const cover = pastCovers.get(ev.id) ?? { kind: 'none' };
                return (
                  <li>
                    <a class="past-card" href={ev.url} target="_blank" rel="noopener">
                      {cover.kind === 'eventbrite' ? (
                        <img class="past-pic" src={cover.url} alt="" loading="lazy" decoding="async" />
                      ) : cover.kind === 'photo' ? (
                        <Image class="past-pic" src={cover.photo} alt="" width={600} widths={[300, 600]} sizes="(min-width: 761px) 18rem, 45vw" />
                      ) : (
                        <span class="past-pic past-pic-none"><Image src={vestSticker} alt="" width={72} densities={[1, 2]} /></span>
                      )}
                      <span class="past-name">{ev.name}</span>
                      <span class="past-date mono" data-en={date.en} data-es={date.es}>{date.en}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </details>
          );
        })}
      </section>
      </>
    )}
    </div>
    </div>
  </section>

  <!-- RSVP MODAL: fallback on localhost; Eventbrite widget used in production -->
  <div class="modal-overlay" id="rsvpModal" onclick="if(event.target===this)closeModal()">
    <div class="modal-box">
      <div class="modal-header">
        <div class="modal-event-name" id="modalEventName"></div>
        <button class="modal-close" onclick="closeModal()" aria-label="Close">✕</button>
      </div>
      <div class="modal-meta">
        <div class="modal-meta-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
          <span id="modalDate"></span>
        </div>
        <div class="modal-meta-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
          <span id="modalTime"></span>
        </div>
        <div class="modal-meta-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
          <span id="modalLoc"></span>
        </div>
      </div>
      <div class="eb-sim">
        <div class="eb-head">
          <span class="eb-logo">eventbrite</span>
          <span class="eb-secure">🔒 Secure checkout</span>
        </div>
        <div class="eb-ticket">
          <div>
            <div class="eb-ticket-name">General Admission</div>
            <div class="eb-ticket-price">Free</div>
          </div>
          <div class="eb-qty">
            <button class="eb-qty-btn" onclick="adjQty(-1)">−</button>
            <span class="eb-qty-num" id="modalQty">1</span>
            <button class="eb-qty-btn" onclick="adjQty(1)">+</button>
          </div>
        </div>
        <div class="eb-cta-area">
          <a class="eb-register" id="modalRegisterBtn" href="#" target="_blank" rel="noopener">Register Now</a>
        </div>
        <div class="eb-powered">Powered by Eventbrite</div>
      </div>
      <div class="modal-foot">Checkout handled securely by Eventbrite</div>
    </div>
  </div>

  <!-- is:inline required: adjQty, openModal, closeModal, initWidgets
       are called from onclick attributes in static HTML and event card markup -->
  <script is:inline>
    var isLocalhost = location.hostname === 'localhost' || location.hostname === '127.0.0.1';

    function openModal(btn) {
      document.getElementById('modalEventName').textContent = btn.getAttribute('data-name') || '';
      document.getElementById('modalDate').textContent      = btn.getAttribute('data-date') || '';
      document.getElementById('modalTime').textContent      = btn.getAttribute('data-time') || '';
      document.getElementById('modalLoc').textContent       = btn.getAttribute('data-loc')  || '';
      document.getElementById('modalQty').textContent       = '1';
      var reg = document.getElementById('modalRegisterBtn');
      if (reg) reg.href = btn.getAttribute('data-url') || '#';
      document.getElementById('rsvpModal').classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      document.getElementById('rsvpModal').classList.remove('open');
      document.body.style.overflow = '';
    }

    function adjQty(delta) {
      var el = document.getElementById('modalQty');
      el.textContent = Math.max(1, parseInt(el.textContent, 10) + delta);
    }

    function initWidgets() {
      document.querySelectorAll('[data-event-id]').forEach(function(btn) {
        var id = btn.getAttribute('data-event-id');
        if (!id || !btn.id || btn.dataset.widgetInit) return;
        btn.dataset.widgetInit = '1';
        if (!isLocalhost && window.EBWidgets) {
          window.EBWidgets.createWidget({ widgetType: 'checkout', eventId: id, modal: true, modalTriggerElementId: btn.id });
        } else {
          btn.addEventListener('click', function() { openModal(btn); });
        }
      });
    }

    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });

    // ── GEOLOCATION SORT (DOM re-order, no HTML rebuild) ──
    var userLat = null, userLng = null;

    function haversineKm(lat1, lng1, lat2, lng2) {
      var R = 6371, dLat = (lat2-lat1)*Math.PI/180, dLng = (lng2-lng1)*Math.PI/180;
      var a = Math.sin(dLat/2)*Math.sin(dLat/2) + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLng/2)*Math.sin(dLng/2);
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    }
    function kmToMiles(km) { return km * 0.621371; }

    function sortListByDist() {
      var list = document.getElementById('eventsListInner');
      if (!list) return;
      var cards = Array.from(list.querySelectorAll('.ev-card[data-lat]'));
      if (!cards.length) return;
      cards.sort(function(a, b) {
        var aLat = parseFloat(a.dataset.lat), aLng = parseFloat(a.dataset.lng);
        var bLat = parseFloat(b.dataset.lat), bLng = parseFloat(b.dataset.lng);
        if (isNaN(aLat) && isNaN(bLat)) return 0;
        if (isNaN(aLat)) return 1;
        if (isNaN(bLat)) return -1;
        return haversineKm(userLat, userLng, aLat, aLng) - haversineKm(userLat, userLng, bLat, bLng);
      });
      cards.forEach(function(card) { list.appendChild(card); });
      // Add distance badges
      cards.forEach(function(card) {
        var lat = parseFloat(card.dataset.lat), lng = parseFloat(card.dataset.lng);
        if (isNaN(lat)) return;
        var mi = kmToMiles(haversineKm(userLat, userLng, lat, lng));
        var existing = card.querySelector('.dist-badge');
        if (existing) { existing.textContent = mi.toFixed(1) + ' mi away'; return; }
        var info = card.querySelector('.maps');
        if (info) {
          var badge = document.createElement('span');
          badge.className = 'dist-badge';
          badge.textContent = mi.toFixed(1) + ' mi away';
          info.appendChild(badge);
        }
      });
    }

    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(function(pos) {
        userLat = pos.coords.latitude;
        userLng = pos.coords.longitude;
        var lbl = document.getElementById('distSortLabel');
        if (lbl) lbl.style.display = 'flex';
        sortListByDist();
      }, function() {});
    }

    // ── STALENESS: mark events whose end date has passed since build time ──
    document.querySelectorAll('.ev-card.upcoming[data-end]').forEach(function(card) {
      if (new Date(card.dataset.end) < new Date()) {
        card.classList.remove('upcoming');
        card.classList.add('past');
      }
    });

    document.addEventListener('DOMContentLoaded', function() {
      initWidgets();
    });
  </script>

</BaseLayout>

<style>
  /* ── THE SHEET ── */
  /* One flat cream sheet holding upcoming and past (EL3): no tape, no
     shadow, so it reads as one printed page on the wall */
  .ev-section { padding-block: 40px 56px; }

  .ev-sheet {
    background: var(--beige);
    color: var(--purple);
    padding: 26px 18px 30px;
  }

  .ev-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 18px;
    margin-bottom: 18px;
  }

  .ev-h {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(2.6rem, 11vw, 3.2rem);
    line-height: 0.95;
    color: var(--purple);
  }

  .ev-inbox {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: 0.85rem;
    color: var(--purple);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .ev-inbox:hover { color: var(--black); }

  .ev-none { margin: 0; font-size: 1.15rem; color: var(--black); }

  /* The cut line between upcoming and past */
  .ev-cut {
    border: 0;
    border-top: 3px dashed var(--purple);
    margin: 36px 0 28px;
  }

  @media (min-width: 761px) {
    .ev-section { padding-block: 64px 88px; }
    .ev-sheet { padding: 44px clamp(28px, 4vw, 56px) 52px; }
    .ev-h { font-size: clamp(3.4rem, 5vw, 4.4rem); }
    .ev-inbox { font-size: 0.95rem; }
    .ev-cut { margin: 52px 0 40px; }
  }

  /* A small tag on the sheet */
  .dist-sort-label {
    display: flex;
    align-items: center;
    justify-self: start;
    width: fit-content;
    gap: 0.4rem;
    padding: 6px 12px;
    background: var(--paper-bright);
    color: var(--black);
    font-size: 0.75rem;
    margin-bottom: 14px;
  }

  .dist-sort-label svg { width: 13px; height: 13px; stroke: var(--green); flex-shrink: 0; }

  .ev-section :global(.dist-badge) {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 0.7rem;
    color: var(--green);
    white-space: nowrap;
  }

  /* Flyers side by side on the sheet; the gap leaves room for the
     stickers that cross each flyer's edge */
  .ev-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 30rem), 1fr));
    gap: 48px 40px;
    padding-top: 14px;
  }

  /* ── PAST EVENTS ── */
  .past { display: grid; gap: 18px; }

  /* One white fold per borough on the sheet, flat like the rest of it */
  .past-group {
    background: var(--paper-bright);
    color: var(--black);
    border: 2.5px solid var(--purple);
  }

  /* The whole folded row is the toggle: the name, the count, and a strip
     of the borough's photos (P1/P4) that shows even while it is closed */
  .past-sum {
    display: grid;
    gap: 12px;
    padding: 14px 16px 16px;
    cursor: pointer;
    list-style: none;
  }

  .past-sum::-webkit-details-marker { display: none; }
  .past-sum:focus-visible { outline: 3px solid var(--purple); outline-offset: -3px; }

  .past-row { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; min-height: var(--tap); }

  .past-place { font-family: var(--display); font-size: clamp(1.9rem, 3.4vw, 2.6rem); line-height: 1; color: var(--purple); }
  .past-count { font-size: 0.8rem; color: var(--green); }

  .past-chev {
    width: 28px;
    height: 28px;
    margin-left: auto;
    color: var(--purple);
    transition: transform 150ms ease;
  }

  .past-group[open] .past-chev { transform: rotate(180deg); }

  .past-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
  }

  /* height auto so the <Image> height attribute can't beat the crop */
  .past-strip :global(.past-strip-pic) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--black);
  }

  @media (prefers-reduced-motion: reduce) {
    .past-chev { transition: none; }
  }

  .past-list {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
    padding: 4px 16px 20px;
  }

  .past-card {
    display: grid;
    gap: 6px;
    color: var(--black);
    text-decoration: none;
  }

  /* :global so the street photos' <Image> output matches too; height
     auto so its height attribute can't beat the crop */
  .past-card :global(.past-pic) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    background: var(--black);
    border: 2.5px solid var(--black);
  }

  .past-card .past-pic-none { display: grid; place-items: center; background: var(--green); }

  .past-name { font-weight: 700; font-size: 1.15rem; line-height: 1.2; }
  .past-card:hover .past-name,
  .past-card:focus-visible .past-name { text-decoration: underline; }
  .past-date { font-size: 0.8rem; color: var(--green); }

  @media (min-width: 600px) {
    .past-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 761px) {
    .past { gap: 22px; }
    .past-sum { padding: 18px 24px 22px; }
    .past-list { padding: 4px 24px 28px; }
    .past-strip { gap: 10px; }
  }

  @media (min-width: 1100px) {
    .past-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* ── RSVP MODAL (localhost fallback) ── */
  .modal-overlay {
    position: fixed; inset: 0; z-index: 500;
    background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    padding: max(1rem, var(--safe-top)) max(1rem, var(--safe-right)) max(1rem, var(--safe-bottom)) max(1rem, var(--safe-left));
    opacity: 0; pointer-events: none;
    transition: opacity 150ms;
  }
  .modal-overlay.open { opacity: 1; pointer-events: auto; }
  .modal-box {
    background: var(--black); border: 1px solid rgba(165,125,215,0.4);
    border-radius: 18px; padding: clamp(1.25rem, 4vw, 2rem);
    width: 100%; max-width: 420px;
    max-height: 100dvh; overflow-y: auto;
    box-shadow: 0 24px 64px rgba(0,0,0,0.5);
  }
  .modal-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
  .modal-event-name { font-family: var(--display); font-size: 1.5rem; letter-spacing: 0.03em; color: var(--beige); line-height: 1.1; }
  .modal-close {
    background: rgba(234,233,218,0.08); border: none; color: rgba(234,233,218,0.55);
    font-size: 1rem; width: 40px; height: 40px; border-radius: 50%;
    cursor: pointer; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
    transition: background 0.15s, color 0.15s;
  }
  .modal-close:hover { background: rgba(234,233,218,0.12); color: var(--beige); }
  .modal-meta { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem; }
  .modal-meta-row { display: flex; align-items: center; gap: 0.5rem; font-size: 0.78rem; font-weight: 700; color: rgba(234,233,218,0.55); }
  .modal-meta-row svg { width: 13px; height: 13px; color: var(--lavender); flex-shrink: 0; }
  .eb-sim { background: #fff; border-radius: 12px; overflow: hidden; margin-bottom: 1rem; }
  .eb-head { background: #f8623a; padding: 0.75rem 1rem; display: flex; align-items: center; justify-content: space-between; }
  .eb-logo { font-weight: 700; font-size: 0.85rem; color: #fff; letter-spacing: -0.02em; }
  .eb-secure { font-size: 0.65rem; font-weight: 700; color: rgba(255,255,255,0.85); }
  .eb-ticket { padding: 1rem; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #f0ece4; color: #333; }
  .eb-ticket-name { font-size: 0.82rem; font-weight: 700; }
  .eb-ticket-price { font-size: 0.75rem; color: #666; }
  .eb-qty { display: flex; align-items: center; gap: 0.5rem; }
  .eb-qty-btn { width: 36px; height: 36px; border-radius: 50%; border: 1.5px solid #ccc; background: transparent; font-size: 1rem; cursor: pointer; color: #333; display: flex; align-items: center; justify-content: center; }
  .eb-qty-btn:hover { border-color: #f8623a; color: #f8623a; }
