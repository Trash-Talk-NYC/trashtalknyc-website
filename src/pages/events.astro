---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import HeroEventCard from '../components/HeroEventCard.astro';
import { fetchEventsAtBuildTime, toEventCardProps } from '../lib/events';
import { formatDate } from '../lib/events';

const { upcoming: upcomingRaw, past: pastRaw } = await fetchEventsAtBuildTime();
const upcoming = upcomingRaw.map(ev => ({
  props: toEventCardProps(ev),
  latLng: ev.venue?.lat != null ? { lat: ev.venue.lat, lng: ev.venue.lng! } : null,
}));
const past = pastRaw.map(ev => ({
  props: toEventCardProps(ev),
}));
const nextEvent = upcoming[0]?.props ?? null;
---

<BaseLayout title="Events — Trash Talk NYC" description="Find and join upcoming Trash Talk NYC cleanup events across all five boroughs.">

  <!-- Load Eventbrite widget JS early; skipped on localhost so local dev doesn't depend on it -->
  <script is:inline>
    if (location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
      var s = document.createElement('script');
      s.src = 'https://www.eventbrite.com/static/widgets/eb_widgets.js';
      document.head.appendChild(s);
    }
  </script>

  <!-- HERO -->
  <section class="events-hero">
    <div class="events-hero-inner">

      <div class="events-hero-left">
        <div class="hero-page-label" data-en="Trash Talk NYC" data-es="Trash Talk NYC">Trash Talk NYC</div>
        <h1 class="hero-title">
          <span data-en="Club" data-es="Eventos">Club</span>
          <span class="accent" data-en="Events" data-es="del Club">Events</span>
        </h1>
      </div>

      {nextEvent ? (
        <HeroEventCard {...nextEvent} />
      ) : (
        <div class="next-event-card-empty">
          <p data-en="No upcoming events right now. Check back soon!" data-es="No hay eventos próximos. ¡Vuelve pronto!">
            No upcoming events right now. Check back soon!
          </p>
        </div>
      )}

    </div>
  </section>

  <!-- PAGE HEADER BAND -->
  <div class="page-header-band">
    <div class="page-header-band-inner">
      <div class="section-title" data-en="All Club Events" data-es="Todos los Eventos del Club">All Club Events</div>
      <span class="eb-badge">Eventbrite</span>
    </div>
  </div>

  <!-- EVENTS LIST -->
  <div class="events-page">

    <div class="dist-sort-label" id="distSortLabel" style="display:none">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <span data-en="Sorted nearest to farthest" data-es="Ordenado del más cercano al más lejano">Sorted nearest to farthest</span>
    </div>

    <div id="upcomingList">
      {upcoming.length > 0 ? (
        <div class="events-list" id="eventsListInner">
          {upcoming.map(({ props, latLng }) => (
            <EventCard {...props} latLng={latLng} />
          ))}
        </div>
      ) : (
        <div class="no-events-cta">
          <p>No upcoming events right now — stay tuned on our Eventbrite page for new dates.</p>
          <a class="eb-cta-btn" href="https://trashtalknyc.eventbrite.com" target="_blank" rel="noopener">See us on Eventbrite →</a>
        </div>
      )}
    </div>

    {past.length > 0 && (
      <div id="pastSection">
        <div class="past-divider">
          <div class="past-divider-line"></div>
          <button class="past-toggle" id="pastToggle" onclick="togglePast()">
            <span data-en="Past club events" data-es="Eventos pasados">Past club events</span>
            <span class="past-toggle-arrow">▾</span>
          </button>
          <div class="past-divider-line"></div>
        </div>
        <div class="events-list" id="pastList" style="display:none">
          {past.map(({ props }) => (
            <EventCard {...props} isPast />
          ))}
        </div>
      </div>
    )}

  </div>

  <!-- RSVP MODAL: fallback on localhost; Eventbrite widget used in production -->
  <div class="modal-overlay" id="rsvpModal" onclick="if(event.target===this)closeModal()">
    <div class="modal-box">
      <div class="modal-header">
        <div class="modal-event-name" id="modalEventName"></div>
        <button class="modal-close" onclick="closeModal()" aria-label="Close">✕</button>
      </div>
      <div class="modal-meta">
        <div class="modal-meta-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span id="modalDate"></span>
        </div>
        <div class="modal-meta-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span id="modalTime"></span>
        </div>
        <div class="modal-meta-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span id="modalLoc"></span>
        </div>
      </div>
      <div class="eb-sim">
        <div class="eb-head">
          <span class="eb-logo">eventbrite</span>
          <span class="eb-secure">🔒 Secure checkout</span>
        </div>
        <div class="eb-ticket">
          <div>
            <div class="eb-ticket-name">General Admission</div>
            <div class="eb-ticket-price">Free</div>
          </div>
          <div class="eb-qty">
            <button class="eb-qty-btn" onclick="adjQty(-1)">−</button>
            <span class="eb-qty-num" id="modalQty">1</span>
            <button class="eb-qty-btn" onclick="adjQty(1)">+</button>
          </div>
        </div>
        <div class="eb-cta-area">
          <a class="eb-register" id="modalRegisterBtn" href="#" target="_blank" rel="noopener">Register Now</a>
        </div>
        <div class="eb-powered">Powered by Eventbrite</div>
      </div>
      <div class="modal-foot">Checkout handled securely by Eventbrite</div>
    </div>
  </div>

  <!-- is:inline required: togglePast, adjQty, openModal, closeModal, initWidgets
       are called from onclick attributes in static HTML and event card markup -->
  <script is:inline>
    var isLocalhost = location.hostname === 'localhost' || location.hostname === '127.0.0.1';

    function togglePast() {
      var list   = document.getElementById('pastList');
      var toggle = document.getElementById('pastToggle');
      var isOpen = toggle.classList.contains('open');
      toggle.classList.toggle('open', !isOpen);
      list.style.display = isOpen ? 'none' : 'flex';
    }

    function openModal(btn) {
      document.getElementById('modalEventName').textContent = btn.getAttribute('data-name') || '';
      document.getElementById('modalDate').textContent      = btn.getAttribute('data-date') || '';
      document.getElementById('modalTime').textContent      = btn.getAttribute('data-time') || '';
      document.getElementById('modalLoc').textContent       = btn.getAttribute('data-loc')  || '';
      document.getElementById('modalQty').textContent       = '1';
      var reg = document.getElementById('modalRegisterBtn');
      if (reg) reg.href = btn.getAttribute('data-url') || '#';
      document.getElementById('rsvpModal').classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      document.getElementById('rsvpModal').classList.remove('open');
      document.body.style.overflow = '';
    }

    function adjQty(delta) {
      var el = document.getElementById('modalQty');
      el.textContent = Math.max(1, parseInt(el.textContent, 10) + delta);
    }

    function initWidgets() {
      document.querySelectorAll('[data-event-id]').forEach(function(btn) {
        var id = btn.getAttribute('data-event-id');
        if (!id || btn.dataset.widgetInit) return;
        btn.dataset.widgetInit = '1';
        if (!isLocalhost && window.EBWidgets) {
          window.EBWidgets.createWidget({ widgetType: 'checkout', eventId: id, modal: true, modalTriggerElementId: btn.id });
        } else {
          btn.addEventListener('click', function() { openModal(btn); });
        }
      });
    }

    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });

    // ── GEOLOCATION SORT (DOM re-order, no HTML rebuild) ──
    var userLat = null, userLng = null;

    function haversineKm(lat1, lng1, lat2, lng2) {
      var R = 6371, dLat = (lat2-lat1)*Math.PI/180, dLng = (lng2-lng1)*Math.PI/180;
      var a = Math.sin(dLat/2)*Math.sin(dLat/2) + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLng/2)*Math.sin(dLng/2);
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    }
    function kmToMiles(km) { return km * 0.621371; }

    function sortListByDist() {
      var list = document.getElementById('eventsListInner');
      if (!list) return;
      var cards = Array.from(list.querySelectorAll('.event-card[data-lat]'));
      if (!cards.length) return;
      cards.sort(function(a, b) {
        var aLat = parseFloat(a.dataset.lat), aLng = parseFloat(a.dataset.lng);
        var bLat = parseFloat(b.dataset.lat), bLng = parseFloat(b.dataset.lng);
        if (isNaN(aLat) && isNaN(bLat)) return 0;
        if (isNaN(aLat)) return 1;
        if (isNaN(bLat)) return -1;
        return haversineKm(userLat, userLng, aLat, aLng) - haversineKm(userLat, userLng, bLat, bLng);
      });
      cards.forEach(function(card) { list.appendChild(card); });
      // Add distance badges
      cards.forEach(function(card) {
        var lat = parseFloat(card.dataset.lat), lng = parseFloat(card.dataset.lng);
        if (isNaN(lat)) return;
        var mi = kmToMiles(haversineKm(userLat, userLng, lat, lng));
        var existing = card.querySelector('.dist-badge');
        if (existing) { existing.textContent = mi.toFixed(1) + ' mi away'; return; }
        var cta = card.querySelector('.event-cta');
        if (cta) {
          var badge = document.createElement('span');
          badge.className = 'dist-badge';
          badge.textContent = mi.toFixed(1) + ' mi away';
          cta.appendChild(badge);
        }
      });
    }

    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(function(pos) {
        userLat = pos.coords.latitude;
        userLng = pos.coords.longitude;
        var lbl = document.getElementById('distSortLabel');
        if (lbl) lbl.style.display = 'flex';
        sortListByDist();
      }, function() {});
    }

    // ── STALENESS: mark events whose end date has passed since build time ──
    document.querySelectorAll('.event-card.upcoming[data-end]').forEach(function(card) {
      if (new Date(card.dataset.end) < new Date()) {
        card.classList.remove('upcoming');
        card.classList.add('past');
      }
    });

    document.addEventListener('DOMContentLoaded', function() {
      initWidgets();
    });
  </script>

  <script>
    import { onLanguageChange } from '../lib/language';
    import { formatDate } from '../lib/events';

    // Update hero card date text when language switches
    onLanguageChange((lang) => {
      const dateEl = document.querySelector<HTMLElement>('.hero-date-text[data-start-iso]');
      if (dateEl) {
        dateEl.textContent = formatDate(dateEl.dataset.startIso!, lang);
      }
    });
  </script>

  <!-- Custom footer: flex-column centered with purple-light border -->
  <footer class="events-footer" slot="footer">
    <div class="footer-logo">Trash Talk NYC</div>
    <ul class="footer-links">
      <li><a href="/" data-en="Home" data-es="Inicio">Home</a></li>
      <li><a href="/events" data-en="Club Events" data-es="Eventos del Club">Club Events</a></li>
      <li><a href="/#signup" data-en="Join" data-es="Únete">Join</a></li>
      <li><a href="/about" data-en="About" data-es="Nosotros">About</a></li>
      <li><a href="/contact" data-en="Contact" data-es="Contacto">Contact</a></li>
    </ul>
    <ul class="footer-socials">
      <li>
        <a href="https://www.instagram.com/trashtalk_nyc/" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          @trashtalk_nyc
        </a>
      </li>
      <li>
        <a href="https://www.tiktok.com/@trashtalk_nyc" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>
          TikTok
        </a>
      </li>
    </ul>
    <div class="footer-copy">© 2025 Trash Talk NYC</div>
  </footer>

</BaseLayout>

<style>
  /* ── EVENTS HERO ── */
  .events-hero {
    background: var(--charcoal);
    position: relative; overflow: hidden;
    padding: 4rem 3rem 4.5rem;
    border-bottom: 4px solid var(--yellow);
  }
  .events-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image: repeating-linear-gradient(-45deg, transparent, transparent 18px, rgba(107,63,160,0.055) 18px, rgba(107,63,160,0.055) 19px);
    pointer-events: none;
  }
  .events-hero::after {
    content: '';
    position: absolute; right: -5%; top: -10%;
    width: 50vw; height: 120%;
    background: radial-gradient(ellipse at center, rgba(107,63,160,0.22) 0%, transparent 65%);
    pointer-events: none;
  }
  .events-hero-inner {
    max-width: 1000px; margin: 0 auto;
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 4rem; align-items: center;
  }
  .hero-page-label {
    font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.22em;
    color: var(--purple-light); margin-bottom: 0.75rem;
    display: flex; align-items: center; gap: 0.5rem;
  }
  .hero-page-label::before { content: ''; display: inline-block; width: 1.25rem; height: 3px; background: var(--purple-light); border-radius: 2px; }
  .hero-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(5rem, 9vw, 8rem);
    line-height: 0.88; letter-spacing: 0.02em;
    color: var(--off-white); margin-bottom: 1.5rem;
  }
  .hero-title .accent { color: var(--yellow); display: block; }
  .next-event-card-empty {
    display: flex; align-items: center; justify-content: center;
    min-height: 200px; color: rgba(247,244,237,0.45);
    font-size: 0.85rem; font-weight: 600; text-align: center;
    border: 1px solid rgba(155,93,229,0.2); border-radius: 18px; padding: 2rem;
  }

  /* ── PAGE HEADER BAND ── */
  .page-header-band { background: var(--cream); border-bottom: 2px solid #d8d3c8; padding: 1.75rem 3rem; }
  .page-header-band-inner { max-width: 1000px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .section-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(2rem, 3.5vw, 2.75rem); line-height: 1; letter-spacing: 0.02em; color: var(--charcoal); }
  .eb-badge { background: #f05537; color: #fff; font-size: 0.6rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; padding: 0.22rem 0.6rem; border-radius: 20px; }

  /* ── EVENTS LIST ── */
  .events-page { max-width: 1000px; margin: 0 auto; padding: 2.5rem 2rem 5rem; }
  .events-list { display: flex; flex-direction: column; gap: 0.85rem; }

  /* ── DISTANCE SORT ── */
  .dist-sort-label {
    display: flex; align-items: center; gap: 0.4rem;
    font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--green); margin-bottom: 1rem;
  }
  .dist-sort-label svg { width: 12px; height: 12px; stroke: var(--green); flex-shrink: 0; }
  .dist-badge {
    font-size: 0.58rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--green); background: rgba(42,107,42,0.1); border: 1px solid rgba(42,107,42,0.25);
    border-radius: 20px; padding: 0.1rem 0.5rem; white-space: nowrap;
  }

  /* ── NO EVENTS CTA ── */
  .no-events-cta { text-align: center; padding: 3rem 1rem; }
  .no-events-cta p { color: var(--gray); font-size: 0.9rem; font-weight: 600; margin-bottom: 1.25rem; }
  .no-events-cta .eb-cta-btn {
    display: inline-block; background: var(--yellow); color: var(--charcoal);
    font-family: 'Space Mono', monospace; font-size: 0.75rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em;
    padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; transition: background 0.15s;
  }
  .no-events-cta .eb-cta-btn:hover { background: var(--yellow-dark); }

  /* ── PAST DIVIDER ── */
  .past-divider { display: flex; align-items: center; gap: 1rem; margin: 2.5rem 0 0; }
  .past-divider-line { flex: 1; height: 1px; background: #ddd; }
  .past-toggle {
    display: inline-flex; align-items: center; gap: 0.45rem;
    background: none; border: 1.5px solid #d0ccc4; border-radius: 20px;
    padding: 0.3rem 0.9rem; cursor: pointer;
    font-size: 0.65rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.14em; color: var(--gray);
    white-space: nowrap; transition: border-color 0.15s, color 0.15s;
  }
  .past-toggle:hover { border-color: var(--purple-light); color: var(--purple-light); }
  .past-toggle-arrow { font-size: 0.55rem; transition: transform 0.2s; display: inline-block; }
  .past-toggle.open .past-toggle-arrow { transform: rotate(180deg); }
  #pastList { display: none; margin-top: 1.25rem; }

  /* ── RSVP MODAL ── */
  .modal-overlay {
    position: fixed; inset: 0; z-index: 500;
    background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none;
    transition: opacity 150ms var(--ease-out);
  }
  .modal-overlay.open { opacity: 1; pointer-events: auto; }
  .modal-box {
    background: var(--charcoal); border: 1px solid rgba(155,93,229,0.4);
    border-radius: 18px; padding: 2rem; width: 100%; max-width: 420px; margin: 1rem;
    box-shadow: 0 24px 64px rgba(0,0,0,0.5);
  }
  .modal-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
  .modal-event-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem; letter-spacing: 0.03em; color: var(--off-white); line-height: 1.1; }
  .modal-close {
    background: rgba(247,244,237,0.08); border: none; color: rgba(247,244,237,0.5);
    font-size: 1rem; width: 30px; height: 30px; border-radius: 50%;
    cursor: pointer; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
    transition: background 0.15s, color 0.15s;
  }
  .modal-close:hover { background: rgba(247,244,237,0.15); color: var(--off-white); }
  .modal-meta { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem; }
  .modal-meta-row { display: flex; align-items: center; gap: 0.5rem; font-size: 0.78rem; font-weight: 700; color: rgba(247,244,237,0.55); }
  .modal-meta-row svg { width: 13px; height: 13px; color: var(--purple-light); flex-shrink: 0; }
  .eb-sim { background: #fff; border-radius: 12px; overflow: hidden; margin-bottom: 1rem; }
  .eb-head { background: #f8623a; padding: 0.75rem 1rem; display: flex; align-items: center; justify-content: space-between; }
  .eb-logo { font-family: 'Nunito', sans-serif; font-weight: 800; font-size: 0.85rem; color: #fff; letter-spacing: -0.02em; }
  .eb-secure { font-size: 0.65rem; font-weight: 700; color: rgba(255,255,255,0.85); }
  .eb-ticket { padding: 1rem; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #f0ece4; }
  .eb-ticket-name { font-size: 0.82rem; font-weight: 700; color: #333; }
