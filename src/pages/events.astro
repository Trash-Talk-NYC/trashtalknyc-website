---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import BoroughEventCard from '../components/BoroughEventCard.astro';
import BoroughFruit from '../components/BoroughFruit.astro';
import TrashCan from '../components/TrashCan.astro';
import {
  BOROUGHS,
  fetchEventsAtBuildTime,
  getClubStats,
  groupUpcomingByBorough,
  toEventCardProps,
} from '../lib/events';

const { upcoming: upcomingRaw, past: pastRaw } = await fetchEventsAtBuildTime();
const upcoming = upcomingRaw.map(ev => ({
  props: toEventCardProps(ev),
  latLng: ev.venue?.lat != null ? { lat: ev.venue.lat, lng: ev.venue.lng! } : null,
}));
const past = pastRaw.map(ev => ({
  props: toEventCardProps(ev),
}));

const byBorough = groupUpcomingByBorough(upcomingRaw);
// Carousel order: boroughs by their soonest event, so the first card is
// always the next event citywide.
const heroBoroughs = BOROUGHS.filter(b => byBorough.has(b.id)).sort((a, b) =>
  byBorough.get(a.id)![0].start.utc.localeCompare(byBorough.get(b.id)![0].start.utc),
);
const emptyBoroughs = BOROUGHS.filter(b => !byBorough.has(b.id));
// With zero upcoming events nothing is preselected: the page then carries a
// single global "no upcoming events" message (in the list section), and the
// per-borough notes only appear when a withered fruit is clicked.
const defaultBorough: string | null = heroBoroughs[0]?.id ?? null;

const stats = getClubStats(pastRaw);
const statEn = `${stats.events} events in ${stats.weeks} weeks`;
const statEs = `${stats.events} eventos en ${stats.weeks} semanas`;

// Orbit slot angles (degrees from 12 o'clock, clockwise), arranged loosely
// like the borough map: Bronx up top, Queens east, Brooklyn south-east,
// Staten Island south-west, Manhattan west.
const ORBIT_ANGLES: Record<string, number> = {
  bronx: -90,
  queens: -18,
  brooklyn: 54,
  'staten-island': 126,
  manhattan: 198,
};
---

<BaseLayout title="Events — Trash Talk NYC" description="Find and join upcoming Trash Talk NYC cleanup events across all five boroughs.">

  <!-- Load Eventbrite widget JS early; skipped on localhost so local dev doesn't depend on it -->
  <script is:inline>
    if (location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
      var s = document.createElement('script');
      s.src = 'https://www.eventbrite.com/static/widgets/eb_widgets.js';
      document.head.appendChild(s);
    }
  </script>

  <!-- HERO: next event per borough — carousel on mobile, fruit market on desktop -->
  <section class="events-hero diag-texture">
    <div class="events-hero-inner">

      <div class="events-hero-head">
        <h1 class="hero-title">
          <span data-en="Club" data-es="Eventos">Club</span>
          <span class="accent" data-en="Events" data-es="del Club">Events</span>
        </h1>
        <p class="stat-sticker sticker" style="--tilt: -1.5deg">
          <span data-en={statEn} data-es={statEs}>{statEn}</span>
        </p>
      </div>

      <!-- Desktop-only: the five borough fruits orbit a trash can; clicking
           one travels it down to dock onto that borough's card below -->
      <div class="fruit-orbit" id="fruitOrbit" role="group" aria-label="Pick a borough">
        <div class="orbit-path" aria-hidden="true"></div>
        <div class="orbit-center" aria-hidden="true"><TrashCan /></div>
        {BOROUGHS.map(b => {
          const events = byBorough.get(b.id);
          return (
            <div class="orbit-slot" data-slot={b.id} style={`--a0: ${ORBIT_ANGLES[b.id]}deg`}>
              <button
                type="button"
                class:list={['fruit-btn', { 'is-active': b.id === defaultBorough }]}
                data-borough={b.id}
                data-empty={events ? undefined : ''}
                aria-controls={`borough-card-${b.id}`}
                aria-expanded={b.id === defaultBorough ? 'true' : 'false'}
              >
                <BoroughFruit borough={b.id} />
                <span class="fruit-label" data-en={b.labelEn} data-es={b.labelEs}>{b.labelEn}</span>
                {events ? (
                  <span class="fruit-count">{events.length}</span>
                ) : (
                  <span class="fruit-none" data-en="No events" data-es="Sin eventos">No events</span>
                )}
              </button>
            </div>
          );
        })}
      </div>

    </div>
  </section>

  <!-- BOROUGH DETAIL: carousel on mobile; on desktop the clicked fruit docks
       onto the active card here, keeping it visually tied to what was clicked -->
  <section class="borough-detail diag-texture" id="boroughDetail">
    <div class:list={['borough-stage', { 'no-hero-events': heroBoroughs.length === 0 }]}>
      <div
        class:list={['borough-track', { single: heroBoroughs.length === 1 }]}
        id="boroughTrack"
        role="group"
        aria-label="Next event per borough"
      >
        {heroBoroughs.map(b => (
          <div class:list={['borough-slide', { 'is-active': b.id === defaultBorough }]} data-borough={b.id}>
            <BoroughEventCard borough={b} events={byBorough.get(b.id)!} />
          </div>
        ))}
        {emptyBoroughs.map(b => (
          <div
            class:list={['borough-slide', 'borough-slide-none', { 'is-active': b.id === defaultBorough }]}
            data-borough={b.id}
          >
            <div class="borough-card-none" id={`borough-card-${b.id}`} role="group" aria-label={`No upcoming events in ${b.inEn}`}>
              <div class="fruit-dock" data-dock={b.id}></div>
              <p class="none-msg">
                <span data-en={`No upcoming events in ${b.inEn} — yet.`} data-es={`No hay eventos próximos en ${b.inEs} — todavía.`}>
                  No upcoming events in {b.inEn} — yet.
                </span>
              </p>
              <a class="none-nudge" href="/#signup" data-en="Join the club list — hear about new dates first →" data-es="Únete a la lista del club — entérate primero de nuevas fechas →">
                Join the club list — hear about new dates first →
              </a>
            </div>
          </div>
        ))}
      </div>
      {heroBoroughs.length > 1 && (
        <div class="borough-dots">
          {heroBoroughs.map((b, i) => (
            <button
              type="button"
              class="borough-dot"
              data-borough={b.id}
              aria-label={`Next event in ${b.inEn}`}
              aria-current={i === 0 ? 'true' : undefined}
            ></button>
          ))}
        </div>
      )}
    </div>
  </section>

  <div class="tape-seam" aria-hidden="true"></div>

  <!-- EVENTS LIST -->
  <div class="events-page-bg">
  <div class="events-page">

    <h2 class="all-events-marker" id="all-events">
      <span data-en="See all club events" data-es="Ver todos los eventos del club">See all club events</span>
    </h2>

    <div class="dist-sort-label" id="distSortLabel" style="display:none">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <span data-en="Sorted nearest to farthest" data-es="Ordenado del más cercano al más lejano">Sorted nearest to farthest</span>
    </div>

    <div id="upcomingList">
      {upcoming.length > 0 ? (
        <div class="events-list" id="eventsListInner">
          {upcoming.map(({ props, latLng }) => (
            <EventCard {...props} latLng={latLng} />
          ))}
        </div>
      ) : (
        <div class="no-events-cta">
          <p data-en="No upcoming events right now — stay tuned on our Eventbrite page for new dates." data-es="No hay eventos próximos. ¡Síguenos en Eventbrite para nuevas fechas!">No upcoming events right now — stay tuned on our Eventbrite page for new dates.</p>
          <a class="eb-cta-btn" href="https://trashtalknyc.eventbrite.com" target="_blank" rel="noopener" data-en="See us on Eventbrite →" data-es="Vernos en Eventbrite →">See us on Eventbrite →</a>
          <a class="signup-nudge" href="/#signup" data-en="Or join the club list — hear about new dates first →" data-es="O únete a la lista del club — entérate primero de nuevas fechas →">Or join the club list — hear about new dates first →</a>
        </div>
      )}
    </div>

    {past.length > 0 && (
      <div id="pastSection">
        <div class="past-divider">
          <div class="past-divider-line"></div>
          <button class="past-toggle" id="pastToggle" onclick="togglePast()">
            <span data-en="Past club events" data-es="Eventos pasados">Past club events</span>
            <span class="past-toggle-arrow">▾</span>
          </button>
          <div class="past-divider-line"></div>
        </div>
        <div class="events-list" id="pastList" style="display:none">
          {past.map(({ props }) => (
            <EventCard {...props} isPast />
          ))}
        </div>
      </div>
    )}

  </div>
  </div>

  <!-- RSVP MODAL: fallback on localhost; Eventbrite widget used in production -->
  <div class="modal-overlay" id="rsvpModal" onclick="if(event.target===this)closeModal()">
    <div class="modal-box">
      <div class="modal-header">
        <div class="modal-event-name" id="modalEventName"></div>
        <button class="modal-close" onclick="closeModal()" aria-label="Close">✕</button>
      </div>
      <div class="modal-meta">
        <div class="modal-meta-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span id="modalDate"></span>
        </div>
        <div class="modal-meta-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span id="modalTime"></span>
        </div>
        <div class="modal-meta-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span id="modalLoc"></span>
        </div>
      </div>
      <div class="eb-sim">
        <div class="eb-head">
          <span class="eb-logo">eventbrite</span>
          <span class="eb-secure">🔒 Secure checkout</span>
        </div>
        <div class="eb-ticket">
          <div>
            <div class="eb-ticket-name">General Admission</div>
            <div class="eb-ticket-price">Free</div>
          </div>
          <div class="eb-qty">
            <button class="eb-qty-btn" onclick="adjQty(-1)">−</button>
            <span class="eb-qty-num" id="modalQty">1</span>
            <button class="eb-qty-btn" onclick="adjQty(1)">+</button>
          </div>
        </div>
        <div class="eb-cta-area">
          <a class="eb-register" id="modalRegisterBtn" href="#" target="_blank" rel="noopener">Register Now</a>
        </div>
        <div class="eb-powered">Powered by Eventbrite</div>
      </div>
      <div class="modal-foot">Checkout handled securely by Eventbrite</div>
    </div>
  </div>

  <!-- is:inline required: togglePast, adjQty, openModal, closeModal, initWidgets
       are called from onclick attributes in static HTML and event card markup -->
  <script is:inline>
    var isLocalhost = location.hostname === 'localhost' || location.hostname === '127.0.0.1';

    function togglePast() {
      var list   = document.getElementById('pastList');
      var toggle = document.getElementById('pastToggle');
      var isOpen = toggle.classList.contains('open');
      toggle.classList.toggle('open', !isOpen);
      list.style.display = isOpen ? 'none' : 'flex';
    }

    function openModal(btn) {
      document.getElementById('modalEventName').textContent = btn.getAttribute('data-name') || '';
      document.getElementById('modalDate').textContent      = btn.getAttribute('data-date') || '';
      document.getElementById('modalTime').textContent      = btn.getAttribute('data-time') || '';
      document.getElementById('modalLoc').textContent       = btn.getAttribute('data-loc')  || '';
      document.getElementById('modalQty').textContent       = '1';
      var reg = document.getElementById('modalRegisterBtn');
      if (reg) reg.href = btn.getAttribute('data-url') || '#';
      document.getElementById('rsvpModal').classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      document.getElementById('rsvpModal').classList.remove('open');
      document.body.style.overflow = '';
    }

    function adjQty(delta) {
      var el = document.getElementById('modalQty');
      el.textContent = Math.max(1, parseInt(el.textContent, 10) + delta);
    }

    function initWidgets() {
      // Triggers only: EventCard root divs also carry data-event-id (for the
      // staleness/geolocation logic) and must not get widget bindings.
      document.querySelectorAll('button[data-event-id], a[data-event-id]').forEach(function(btn) {
        var id = btn.getAttribute('data-event-id');
        if (!id || btn.dataset.widgetInit) return;
        btn.dataset.widgetInit = '1';
        if (!isLocalhost && window.EBWidgets) {
          window.EBWidgets.createWidget({ widgetType: 'checkout', eventId: id, modal: true, modalTriggerElementId: btn.id });
        } else {
          btn.addEventListener('click', function() { openModal(btn); });
        }
      });
    }

    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });

    // ── GEOLOCATION SORT (DOM re-order, no HTML rebuild) ──
    var userLat = null, userLng = null;

    function haversineKm(lat1, lng1, lat2, lng2) {
      var R = 6371, dLat = (lat2-lat1)*Math.PI/180, dLng = (lng2-lng1)*Math.PI/180;
      var a = Math.sin(dLat/2)*Math.sin(dLat/2) + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLng/2)*Math.sin(dLng/2);
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    }
    function kmToMiles(km) { return km * 0.621371; }

    function distBadgeText(mi) {
      // data-en/data-es pair so the language toggle keeps translating it
      return { en: mi.toFixed(1) + ' mi away', es: 'a ' + mi.toFixed(1) + ' mi' };
    }

    function applyDistBadge(badge, mi) {
      var text = distBadgeText(mi);
      badge.setAttribute('data-en', text.en);
      badge.setAttribute('data-es', text.es);
      badge.textContent = document.documentElement.lang === 'es' ? text.es : text.en;
    }

    function sortListByDist() {
      var list = document.getElementById('eventsListInner');
      if (!list) return;
      var cards = Array.from(list.querySelectorAll('.event-card[data-lat]'));
      if (!cards.length) return;
      cards.sort(function(a, b) {
        var aLat = parseFloat(a.dataset.lat), aLng = parseFloat(a.dataset.lng);
        var bLat = parseFloat(b.dataset.lat), bLng = parseFloat(b.dataset.lng);
        if (isNaN(aLat) && isNaN(bLat)) return 0;
        if (isNaN(aLat)) return 1;
        if (isNaN(bLat)) return -1;
        return haversineKm(userLat, userLng, aLat, aLng) - haversineKm(userLat, userLng, bLat, bLng);
      });
      cards.forEach(function(card) { list.appendChild(card); });
      // Add distance badges
      cards.forEach(function(card) {
        var lat = parseFloat(card.dataset.lat), lng = parseFloat(card.dataset.lng);
        if (isNaN(lat)) return;
        var mi = kmToMiles(haversineKm(userLat, userLng, lat, lng));
        var existing = card.querySelector('.dist-badge');
        if (existing) { applyDistBadge(existing, mi); return; }
        var cta = card.querySelector('.event-cta');
        if (cta) {
          var badge = document.createElement('span');
          badge.className = 'dist-badge';
          applyDistBadge(badge, mi);
          cta.appendChild(badge);
        }
      });
    }

    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(function(pos) {
        userLat = pos.coords.latitude;
        userLng = pos.coords.longitude;
        var lbl = document.getElementById('distSortLabel');
        if (lbl) lbl.style.display = 'flex';
        sortListByDist();
      }, function() {});
    }

    // ── STALENESS: mark events whose end date has passed since build time ──
    document.querySelectorAll('.event-card.upcoming[data-end]').forEach(function(card) {
      if (new Date(card.dataset.end) < new Date()) {
        card.classList.remove('upcoming');
        card.classList.add('past');
      }
    });

    document.addEventListener('DOMContentLoaded', function() {
      initWidgets();
    });
  </script>

  <!-- Borough hero: orbiting fruit buttons (desktop) + carousel dots (mobile)
       drive one shared active-borough state over the same set of cards. On
       desktop the clicked fruit FLIP-travels from its orbit slot into the
       active card's dock so the reveal stays anchored to what was clicked. -->
  <script>
    const track = document.getElementById('boroughTrack');
    if (track) {
      const orbit = document.getElementById('fruitOrbit');
      const detail = document.getElementById('boroughDetail');
      const hero = document.querySelector<HTMLElement>('.events-hero');
      const slides = Array.from(track.querySelectorAll<HTMLElement>('.borough-slide'));
      const fruitBtns = Array.from(document.querySelectorAll<HTMLElement>('.fruit-btn'));
      const dots = Array.from(document.querySelectorAll<HTMLElement>('.borough-dot'));
      const isDesktop = window.matchMedia('(min-width: 900px)');
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      const scrollBehavior = () => (prefersReduced.matches ? ('auto' as const) : ('smooth' as const));

      const fruitFor = (borough: string) => fruitBtns.find(f => f.dataset.borough === borough);
      const homeSlotFor = (borough: string) =>
        orbit?.querySelector<HTMLElement>(`.orbit-slot[data-slot="${borough}"]`) ?? null;
      const dockFor = (borough: string) =>
        document.querySelector<HTMLElement>(`.fruit-dock[data-dock="${borough}"]`);
      const dockedFruit = () => fruitBtns.find(f => f.classList.contains('is-docked')) ?? null;

      // FLIP: move the node, then animate from its old screen position to the
      // new one so the fruit visibly travels instead of teleporting.
      const flipMove = (node: HTMLElement, moveIntoPlace: () => void) => {
        const first = node.getBoundingClientRect();
        moveIntoPlace();
        if (prefersReduced.matches) return;
        const last = node.getBoundingClientRect();
        if (last.width === 0) return; // target hidden (e.g. mid-resize) — skip animating
        const dx = first.left - last.left;
        const dy = first.top - last.top;
        const scale = first.width / last.width;
        orbit?.classList.add('is-animating');
        node.style.transition = 'none';
        node.style.transformOrigin = 'top left';
        node.style.transform = `translate(${dx}px, ${dy}px) scale(${scale})`;
        // Cleanup must fire only for THIS node's transform transition:
        // transitionend bubbles (the child .fruit-svg has its own filter
        // transition that ends mid-travel on hover loss), and an interrupted
        // travel fires transitioncancel instead of transitionend — both would
        // otherwise leave is-animating (a paused orbit) or stale styles behind.
        const cleanup = (e: TransitionEvent) => {
          if (e.target !== node || e.propertyName !== 'transform') return;
          node.style.transition = '';
          node.style.transformOrigin = '';
          node.style.transform = '';
          node.removeEventListener('transitionend', cleanup);
          node.removeEventListener('transitioncancel', cleanup);
          orbit?.classList.remove('is-animating');
        };
        requestAnimationFrame(() => {
          node.style.transition = 'transform 480ms var(--ease-out)';
          node.style.transform = '';
          node.addEventListener('transitionend', cleanup);
          node.addEventListener('transitioncancel', cleanup);
        });
      };

      const sendFruitHome = (fruit: HTMLElement, animate: boolean) => {
        const home = homeSlotFor(fruit.dataset.borough!);
        if (!home || fruit.parentElement === home) return;
        // Class changes happen inside the move callback so flipMove measures
        // the "first" rect while the fruit still has its docked geometry —
        // otherwise the return travel starts from a visibly offset position.
        const moveIntoHome = () => {
          fruit.classList.remove('is-docked');
          home.classList.remove('is-vacant');
          home.appendChild(fruit);
        };
        if (animate) flipMove(fruit, moveIntoHome);
        else moveIntoHome();
      };

      const dockFruit = (borough: string, animate: boolean) => {
        const fruit = fruitFor(borough);
        const dock = dockFor(borough);
        if (!fruit || !dock) return;
        const previous = dockedFruit();
        if (previous && previous !== fruit) sendFruitHome(previous, false);
        if (fruit.parentElement === dock) return;
        const moveIntoDock = () => {
          homeSlotFor(borough)?.classList.add('is-vacant');
          dock.appendChild(fruit);
          fruit.classList.add('is-docked');
        };
        if (animate) flipMove(fruit, moveIntoDock);
        else moveIntoDock();
      };

      const setActive = (borough: string | null, opts: { scrollCarousel?: boolean; travel?: boolean } = {}) => {
        slides.forEach(s => s.classList.toggle('is-active', s.dataset.borough === borough));
        fruitBtns.forEach(f => {
          const on = f.dataset.borough === borough;
          f.classList.toggle('is-active', on);
          f.setAttribute('aria-expanded', String(on));
        });
        dots.forEach(d => {
          if (borough && d.dataset.borough === borough) d.setAttribute('aria-current', 'true');
          else d.removeAttribute('aria-current');
        });
        if (isDesktop.matches) {
          if (borough) dockFruit(borough, opts.travel ?? false);
          else {
            const previous = dockedFruit();
            if (previous) sendFruitHome(previous, opts.travel ?? false);
          }
        } else if (borough && opts.scrollCarousel) {
          const slide = slides.find(s => s.dataset.borough === borough);
          if (slide) {
            track.scrollTo({
              left: slide.offsetLeft - (track.clientWidth - slide.clientWidth) / 2,
              behavior: scrollBehavior(),
            });
          }
        }
      };

      fruitBtns.forEach(f =>
        f.addEventListener('click', () => {
          const borough = f.dataset.borough!;
          if (f.classList.contains('is-docked')) {
            // The docked fruit is the "back" control: return it to orbit and
            // bring the orbit back into view.
            setActive(null, { travel: true });
            hero?.scrollIntoView({ behavior: scrollBehavior(), block: 'start' });
          } else {
            setActive(borough, { travel: true, scrollCarousel: true });
            if (isDesktop.matches) detail?.scrollIntoView({ behavior: scrollBehavior(), block: 'start' });
          }
        }),
      );
      dots.forEach(d => d.addEventListener('click', () => setActive(d.dataset.borough!, { scrollCarousel: true })));

      // Swiping the carousel updates the dots: mark the slide nearest the
      // track center as active (without scrolling again).
      let scrollRaf = 0;
      track.addEventListener('scroll', () => {
        if (isDesktop.matches) return;
        cancelAnimationFrame(scrollRaf);
        scrollRaf = requestAnimationFrame(() => {
          const center = track.scrollLeft + track.clientWidth / 2;
          let nearest: HTMLElement | null = null;
          let nearestDist = Infinity;
          for (const s of slides) {
            if (s.offsetWidth === 0) continue;
            const d = Math.abs(s.offsetLeft + s.offsetWidth / 2 - center);
            if (d < nearestDist) { nearestDist = d; nearest = s; }
          }
          if (nearest?.dataset.borough) setActive(nearest.dataset.borough);
        });
      }, { passive: true });

      // Keep fruit placement consistent with the current mode: docked on the
      // active card on desktop, all home in orbit on mobile.
      const syncFruitPlacement = () => {
        const active = slides.find(s => s.classList.contains('is-active'))?.dataset.borough ?? null;
        if (isDesktop.matches && active) dockFruit(active, false);
        else {
          const previous = dockedFruit();
          if (previous) sendFruitHome(previous, false);
        }
      };
      isDesktop.addEventListener('change', syncFruitPlacement);
      syncFruitPlacement();
    }
  </script>

</BaseLayout>

<style>
  /* ── EVENTS HERO ── */
  .events-hero {
    background: var(--charcoal);
    position: relative;
    overflow: hidden;
    padding: var(--space-lg) max(var(--gutter), var(--safe-right)) var(--space-md) max(var(--gutter), var(--safe-left));
  }
