---
import BaseLayout from '../layouts/BaseLayout.astro';
import WallHero from '../components/WallHero.astro';
import wall404 from '../assets/walls/wall-9572.webp';

// Prerendered so URL misses (mostly bot scans) get a static, CDN-cacheable
// body instead of a fresh SSR function render per request.
export const prerender = true;

---

<BaseLayout title="Page Not Found — Trash Talk NYC" description="This page doesn't exist." noindex>

  <!-- 404: a dead-end block. A street wall edge to edge, a street-sign-
       yellow Dead End diamond, and the way back. -->
  <!-- The shared left-aligned hero on the captain's wall pick
       (2026-10-21), the yellow DEAD END sign above it -->
  <WallHero
    src={wall404}
    eyebrow={{ en: 'Error 404 — Wrong Block', es: 'Error 404 — Cuadra Equivocada' }}
    title={[{ en: 'This page got picked up with the trash.', es: 'Esta página se fue con la basura.' }]}
    seed={21}
  >
    <div class="sign" slot="before" aria-hidden="true"><span data-en="DEAD END" data-es="SIN SALIDA">DEAD END</span></div>
    <div class="nf-actions">
      <a href="/" class="btn btn-primary" data-en="Back to Home →" data-es="Volver al Inicio →">Back to Home →</a>
      <a href="/events" class="plain" data-en="See Club Events →" data-es="Ver Eventos del Club →">See Club Events →</a>
    </div>
  </WallHero>
</BaseLayout>

<style>
  /* Street-sign-yellow diamond */
  .sign {
    width: clamp(70px, 8vw, 100px);
    aspect-ratio: 1;
    background: var(--yellow);
    border: 3px solid var(--black);
    border-radius: 8px;
    transform: rotate(45deg);
    display: grid;
    place-items: center;
    margin: 14px 0 28px 14px;
  }

  .sign span {
    transform: rotate(-45deg);
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(0.95rem, 1.4vw, 1.25rem);
    line-height: 0.9;
    color: var(--black);
    max-width: 5ch;
  }

  /* Phones stack the link under the button */
  .nf-actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
    margin-top: 10px;
  }

  /* Beige and underlined, so it stays AA on the shaded photo */
  .nf-actions .plain {
    font-weight: 700;
    color: var(--beige);
    text-decoration: underline;
    text-underline-offset: 4px;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  @media (min-width: 761px) {
    .nf-actions { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 14px 24px; }
  }
</style>
