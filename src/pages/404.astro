---
import BaseLayout from '../layouts/BaseLayout.astro';
import bricksTop from '../assets/bricks-top-lav.svg';
import bricksBottom from '../assets/bricks-bottom-lav.svg';
import illTrash from '../assets/ill-trash-lav.svg';

// Prerendered so URL misses (mostly bot scans) get a static, CDN-cacheable
// body instead of a fresh SSR function render per request.
export const prerender = true;
---

<BaseLayout title="Page Not Found — Trash Talk NYC" description="This page doesn't exist." noindex>

  <!-- 404: a dead-end block. Brick wall edge to edge, the trash can
       that took the page, a street-sign-yellow Dead End diamond, and
       the way back. -->
  <section class="nf">
    <img class="bricks bricks-top" src={bricksTop.src} alt="" />
    <img class="bricks bricks-bottom" src={bricksBottom.src} alt="" />
    <div class="nf-inner">
      <div class="nf-row" aria-hidden="true">
        <div class="sign"><span data-en="DEAD END" data-es="SIN SALIDA">DEAD END</span></div>
        <img class="ill" src={illTrash.src} alt="" />
      </div>
      <div class="mono nf-code" data-en="Error 404 — Wrong Block" data-es="Error 404 — Cuadra Equivocada">Error 404 — Wrong Block</div>
      <h1 data-en="This page got picked up with the trash." data-es="Esta página se fue con la basura.">This page got picked up with the trash.</h1>
      <div class="nf-actions">
        <a href="/" class="btn btn-primary" data-en="Back to Home →" data-es="Volver al Inicio →">Back to Home →</a>
        <a href="/events" class="plain" data-en="See Cleanup Events" data-es="Ver Eventos de Limpieza">See Cleanup Events</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* One brick-frame behavior site-wide (captain): edge-to-edge halves
     scaling with the viewport, content kept inside the opening by the
     vw-proportional padding — same pattern as the homepage hero. */
  .nf {
    position: relative;
    overflow: hidden;
    border-bottom: var(--ink);
  }

  .nf-inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 16px;
    padding: calc(100vw * 0.17) 34px calc(100vw * 0.16);
    text-align: center;
  }

  .nf-row {
    display: flex;
    align-items: flex-end;
    gap: 18px;
  }

  .nf-row .ill { width: clamp(96px, 12vw, 150px); }

  /* Street-sign-yellow diamond */
  .sign {
    width: clamp(70px, 8vw, 100px);
    aspect-ratio: 1;
    background: var(--yellow);
    border: 3px solid var(--black);
    border-radius: 8px;
    transform: rotate(45deg);
    display: grid;
    place-items: center;
    margin-bottom: 24px;
  }

  .sign span {
    transform: rotate(-45deg);
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(0.95rem, 1.4vw, 1.25rem);
    line-height: 0.9;
    color: var(--black);
    max-width: 5ch;
  }

  .nf-code { color: var(--yellow); }

  .nf h1 {
    font-size: 2rem;
    max-width: 15ch;
    color: var(--beige);
  }

  /* Phones stack the link under the button so it stays inside the
     opening between the side bricks instead of running into them. */
  .nf-actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
    justify-content: center;
    align-items: center;
    margin-top: 6px;
  }

  /* The vw term only bites below ~370px, where the bottom bricks close
     in on "Ver Eventos de Limpieza". */
  .nf-actions .plain {
    font-size: min(1em, 4.6vw);
    font-weight: 700;
    color: var(--lavender);
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  @media (min-width: 761px) {
    .nf-inner { padding: calc(100vw * 0.09) 30px calc(100vw * 0.085); }
    .nf h1 { font-size: clamp(2.2rem, 4.4vw, 3.8rem); }
    .nf-actions { flex-direction: row; flex-wrap: wrap; }
  }
</style>
