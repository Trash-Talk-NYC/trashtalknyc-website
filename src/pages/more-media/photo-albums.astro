---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaHero from '../../components/MediaHero.astro';
import MediaSubnav from '../../components/MediaSubnav.astro';
import { MORE_MEDIA_PATH } from '../../lib/media';
import SectionWall from '../../components/SectionWall.astro';
import vestSticker from '../../assets/vest-sticker.png';
import treeWithShovels from '../../assets/albums/album-3/01-tree-with-shovels.jpg';
import plantUnderGrowLight from '../../assets/albums/album-3/02-plant-under-grow-light.jpg';
import labeledSeedlingCups from '../../assets/albums/album-3/03-labeled-seedling-cups.jpg';
import pegboardWorkbench from '../../assets/albums/album-3/04-pegboard-workbench.jpg';
import microscopePlantCutting from '../../assets/albums/album-3/05-microscope-plant-cutting.jpg';

/**
 * More Media → Photo Albums (captain, 2026-10-09). The captain named
 * three albums; only Album 3 has photos so far, so Albums 1 and 2 show
 * an honest "coming soon" — no invented captions or placeholder shots.
 * Photos carry descriptive alt text (what is in the frame), not captions.
 *
 * Sources are the captain's camera originals; astro:assets re-encodes
 * them (EXIF orientation applied, metadata stripped) so only optimized
 * webp ever ships.
 */

type Copy = { en: string; es: string };
type Photo = { src: ImageMetadata; alt: Copy };
type Album = { number: Copy; name?: Copy; photos: Photo[] };

const albums: Album[] = [
  {
    number: { en: 'Album 1', es: 'Álbum 1' },
    name: { en: 'The Lab', es: 'El Laboratorio' },
    photos: [],
  },
  {
    number: { en: 'Album 2', es: 'Álbum 2' },
    name: { en: 'The Block Party', es: 'La Fiesta de la Cuadra' },
    photos: [],
  },
  {
    number: { en: 'Album 3', es: 'Álbum 3' },
    photos: [
      {
        src: treeWithShovels,
        alt: {
          en: 'A small potted tree beside two shovels and a bucket of tools, in front of a painted canvas',
          es: 'Un pequeño árbol en maceta junto a dos palas y un balde de herramientas, frente a un lienzo pintado',
        },
      },
      {
        src: plantUnderGrowLight,
        alt: {
          en: 'A plant cutting in a jar of water under a grow light on a metal shelf',
          es: 'Un esqueje de planta en un frasco con agua bajo una lámpara de cultivo en un estante de metal',
        },
      },
      {
        src: labeledSeedlingCups,
        alt: {
          en: 'Clear cups of soil with handwritten wooden plant labels on a shelf under a grow light',
          es: 'Vasos transparentes con tierra y etiquetas de madera escritas a mano en un estante bajo una lámpara de cultivo',
        },
      },
      {
        src: pegboardWorkbench,
        alt: {
          en: 'A workbench with tools hung on a black pegboard and seed packets laid out on a green mat',
          es: 'Una mesa de trabajo con herramientas colgadas en un tablero perforado negro y sobres de semillas sobre una alfombrilla verde',
        },
      },
      {
        src: microscopePlantCutting,
        alt: {
          en: 'A microscope next to a leafy plant cutting in a glass jar',
          es: 'Un microscopio junto a un esqueje de hojas en un frasco de vidrio',
        },
      },
    ],
  },
];

// Each thumbnail links to a larger optimized copy, never the original
const fullSizes = new Map<ImageMetadata, string>();
for (const album of albums) {
  for (const photo of album.photos) {
    fullSizes.set(photo.src, (await getImage({ src: photo.src, width: 1800 })).src);
  }
}

// How each photo is stuck to the wall — a mix, like every other card
const flyerFor = (i: number) => ['f-tape', 'f-staple', 'f-sticker', 'f-tape', 'f-staple'][i % 5];

const emptyAlbums = albums.filter((a) => a.photos.length === 0);
const fullAlbums = albums.filter((a) => a.photos.length > 0);
---

<BaseLayout
  title="Photo Albums — Trash Talk NYC"
  description="Photo albums from Trash Talk NYC: the lab, the block party, and more."
>
  <MediaHero
    eyebrow={{ en: 'More Media', es: 'Más Medios' }}
    eyebrowHref={MORE_MEDIA_PATH}
    title={[{ en: 'Photo', es: 'Álbumes' }, { en: 'Albums', es: 'de Fotos' }]}
    description={{ en: 'Photos from Trash Talk NYC, album by album.', es: 'Fotos de Trash Talk NYC, álbum por álbum.' }}
  />

  <MediaSubnav current="photo-albums" />

  <!-- A planting section (the lab, seedlings): green chalk, captain's A4 -->
  <section class="pa-sec wall">
  <SectionWall kind="planting" dim={0.5} seed={5} />
  <div class="wrap pa-body">
    <!-- Albums without photos yet sit side by side as compact cards so
         they don't push the real photos down the page -->
    <div class="pa-soon-row">
      {emptyAlbums.map((album) => (
        <section class="pa-soon paste f-tape" aria-labelledby={`album-${album.number.en.replace(/\D/g, '')}`}>
          <p class="mono pa-num" data-en={album.number.en} data-es={album.number.es}>{album.number.en}</p>
          {album.name && (
            <h2 id={`album-${album.number.en.replace(/\D/g, '')}`} data-en={album.name.en} data-es={album.name.es}>{album.name.en}</h2>
          )}
          <p class="pa-soon-note" data-en="Photos coming soon." data-es="Fotos muy pronto.">Photos coming soon.</p>
        </section>
      ))}
    </div>

    {fullAlbums.map((album) => (
      <section class="pa-album" aria-labelledby={`album-${album.number.en.replace(/\D/g, '')}`}>
        <h2 id={`album-${album.number.en.replace(/\D/g, '')}`} class="pa-album-title">
          <span data-en={album.number.en} data-es={album.number.es}>{album.number.en}</span>
          {album.name && <span class="accent" data-en={album.name.en} data-es={album.name.es}>{album.name.en}</span>}
        </h2>
        <ul class="pa-grid">
          {album.photos.map((photo, i) => (
            <li class:list={['pa-photo', 'paste', flyerFor(i)]}>
              {flyerFor(i) === 'f-sticker' && <Image src={vestSticker} alt="" class="slap pa-slap" width={80} densities={[1, 2]} />}
              <a href={fullSizes.get(photo.src)} class="pa-link">
                <Image
                  src={photo.src}
                  alt={photo.alt.en}
                  data-alt-en={photo.alt.en}
                  data-alt-es={photo.alt.es}
                  class="pa-img"
                  width={1000}
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 761px) 30vw, 100vw"
                />
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  </section>
</BaseLayout>

<script>
  import { getCurrentLang, onLanguageChange, type Lang } from '../../lib/language';

  // Alt text is an attribute, which setLang never translates
  const imgs = Array.from(document.querySelectorAll<HTMLImageElement>('img[data-alt-en]'));
  function applyAlts(lang: Lang) {
    imgs.forEach((img) => {
      const alt = img.getAttribute(`data-alt-${lang}`);
      if (alt) img.alt = alt;
    });
  }
  applyAlts(getCurrentLang());
  onLanguageChange(applyAlts);
</script>

<style>
  .pa-body {
    display: grid;
    gap: 56px;
    padding-block: 56px 80px;
  }

  .pa-soon-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 36px;
  }

  .pa-soon {
    --flyer-bg: var(--paper);
    color: var(--black);
    padding: 26px 22px 24px;
  }

  .pa-num { color: var(--green); margin-bottom: 4px; }
  .pa-soon h2 { font-size: 2.4rem; color: var(--purple); }
  .pa-soon-note { margin: 10px 0 0; font-size: 1.1rem; }

  .pa-album-title {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.35em;
    font-size: clamp(2.6rem, 5vw, 4rem);
    color: var(--beige);
    margin-bottom: 28px;
  }

  .pa-album-title .accent { color: var(--lavender); }

  .pa-grid {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }

  .pa-photo {
    --flyer-bg: var(--paper);
    padding: 10px 10px 12px;
  }

  .pa-photo :global(.pa-slap) {
    top: -30px;
    right: -10px;
    width: 62px;
    height: auto;
    transform: rotate(9deg);
  }

  .pa-link { display: block; }

  /* One shape for every frame so the grid stays even; explicit height
     beats the width/height attributes <Image> emits */
  .pa-photo :global(.pa-img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  @media (min-width: 761px) {
    .pa-body { gap: 72px; padding-block: 72px 104px; }
    .pa-soon-row { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
    .pa-soon { padding: 30px 30px 28px; }
    .pa-soon h2 { font-size: clamp(2.4rem, 3.4vw, 3rem); }
    .pa-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 44px 32px; }
    .pa-photo :global(.pa-slap) { top: -36px; right: -20px; width: 80px; }
  }
</style>
