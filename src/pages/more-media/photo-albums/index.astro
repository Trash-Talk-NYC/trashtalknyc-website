---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MediaHero from '../../../components/MediaHero.astro';
import MediaSubnav from '../../../components/MediaSubnav.astro';
import SectionWall from '../../../components/SectionWall.astro';
import { MORE_MEDIA_PATH } from '../../../lib/media';
import { albumPath, albumStatusLabel, albums } from '../../../lib/albums';

/**
 * More Media → Photo Albums (captain, 2026-10-09). The list is the
 * captain's G2 pick: each album is a taped film-roll card — a cover
 * photo, a small film strip of its photos, and the album name — and the
 * whole card opens the album (no separate button). An album without
 * photos says "Coming soon" and doesn't open. Grows as albums are added
 * in src/lib/albums.ts.
 */

// Film frames under each cover; empty albums show blank frames
const FRAMES = 5;
---

<BaseLayout
  title="Photo Albums — Trash Talk NYC"
  description="Photo albums from Trash Talk NYC: the lab, the block party, and more."
>
  <MediaHero
    eyebrow={{ en: 'More Media', es: 'Más Medios' }}
    eyebrowHref={MORE_MEDIA_PATH}
    title={[{ en: 'Photo', es: 'Álbumes' }, { en: 'Albums', es: 'de Fotos' }]}
    description={{ en: 'Photos from Trash Talk NYC, album by album.', es: 'Fotos de Trash Talk NYC, álbum por álbum.' }}
  />

  <MediaSubnav current="photo-albums" />

  <!-- A planting section (the lab, seedlings): green chalk -->
  <section class="pa-sec wall">
    <SectionWall kind="planting" dim={0.55} seed={5} />
    <div class="wrap pa-body">
      <ul class="pa-grid">
        {albums.map((album) => {
          const status = albumStatusLabel(album);
          const open = album.photos.length > 0;
          const Card = open ? 'a' : 'div';
          const [cover, ...rest] = album.photos;
          // The strip shows the album's other photos (all of them when short)
          const strip = (rest.length >= FRAMES ? rest : album.photos).slice(0, FRAMES);
          return (
            <li>
              <Card class:list={['pa-card', 'paste', 'f-tape', { 'pa-empty': !open }]} {...(open ? { href: albumPath(album) } : {})}>
                {cover ? (
                  <Image src={cover.src} alt="" class="pa-cover" width={900} widths={[480, 900]} sizes="(min-width: 1800px) 22vw, (min-width: 1100px) 30vw, (min-width: 600px) 46vw, 92vw" />
                ) : (
                  <span class="pa-cover pa-cover-empty mono" data-en={status?.en} data-es={status?.es}>{status?.en}</span>
                )}
                <span class="pa-film" aria-hidden="true">
                  {open
                    ? strip.map((p) => <Image src={p.src} alt="" class="pa-frame" width={200} widths={[100, 200]} sizes="80px" />)
                    : Array.from({ length: FRAMES }, () => <span class="pa-frame pa-frame-empty"></span>)}
                </span>
                <span class="pa-caption">
                  <span class="mono pa-num" data-en={album.number.en} data-es={album.number.es}>{album.number.en}</span>
                  <span class="pa-name" data-en={album.name.en} data-es={album.name.es}>{album.name.en}</span>
                </span>
              </Card>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .pa-body { padding-block: 64px 80px; }

  .pa-grid {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px 36px;
  }

  .pa-card {
    --flyer-bg: var(--paper);
    display: grid;
    gap: 10px;
    padding: 12px 12px 18px;
    color: var(--black);
    text-decoration: none;
  }

  li:nth-child(even) .pa-card { transform: rotate(1deg); }

  a.pa-card:hover .pa-name,
  a.pa-card:focus-visible .pa-name { color: var(--green); }

  .pa-card :global(.pa-cover) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .pa-card .pa-cover-empty {
    display: grid;
    place-items: center;
    background: #cfcdbd;
    color: #6b6a61;
    font-size: 0.9rem;
  }

  /* A small film strip: black stock with sprocket holes top and bottom */
  .pa-film {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 5px;
    padding: 12px 7px;
    background: #141418;
  }

  .pa-film::before,
  .pa-film::after {
    content: '';
    position: absolute;
    left: 6px;
    right: 6px;
    height: 5px;
    background: repeating-linear-gradient(90deg, #e9e4cf 0 7px, transparent 7px 14px);
    opacity: 0.7;
  }

  .pa-film::before { top: 3px; }
  .pa-film::after { bottom: 3px; }

  .pa-film :global(.pa-frame) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .pa-frame-empty { aspect-ratio: 3 / 4; background: #cfcdbd; }

  .pa-caption { display: grid; gap: 2px; padding-top: 4px; }
  .pa-num { color: var(--green); }

  .pa-name {
    font-family: var(--display);
    font-size: clamp(1.7rem, 2.2vw, 2.3rem);
    line-height: 1;
    color: var(--purple);
  }

  /* Muted, but still solid paper so the wall doesn't show through */
  .pa-empty .pa-film,
  .pa-empty .pa-name { opacity: 0.6; }

  /* Card count per row (captain, 2026-10-09): 1 phone, 2 tablet, 3
     desktop, 4 on wide screens — a whole card always fits on screen */
  @media (min-width: 600px) {
    .pa-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 28px; }
  }

  @media (min-width: 761px) {
    .pa-body { padding-block: 72px 96px; }
  }

  @media (min-width: 1100px) {
    .pa-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 44px 32px; }
  }

  @media (min-width: 1800px) {
    .pa-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
