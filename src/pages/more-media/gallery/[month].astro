---
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WallHero from '../../../components/WallHero.astro';
import MediaSubnav from '../../../components/MediaSubnav.astro';
import SectionWall from '../../../components/SectionWall.astro';
import wallGallery from '../../../assets/walls/wall-9736.webp';
import { GALLERY } from '../../../lib/media';
import { galleryByMonth, type GalleryMonth } from '../../../lib/gallery';

/**
 * One Gallery month — /more-media/gallery/YYYY-MM (captain, 2026-10-21:
 * a page per month, "because some could get pretty full"). Every photo
 * of that month on one cream sheet, each opening a large copy of itself.
 * The Gallery index lists the months.
 */
export const getStaticPaths = (() =>
  galleryByMonth().map((m) => ({ params: { month: m.month }, props: { m } }))) satisfies GetStaticPaths;

const { m } = Astro.props as { m: GalleryMonth };
const photos = await Promise.all(
  m.photos.map(async (p) => ({ ...p, large: (await getImage({ src: p.src, width: 1800, format: 'webp' })).src })),
);
const count = { en: `${photos.length} ${photos.length === 1 ? 'photo' : 'photos'}`, es: `${photos.length} ${photos.length === 1 ? 'foto' : 'fotos'}` };
---

<BaseLayout
  title={`${m.label.en} — Gallery — Trash Talk NYC`}
  description={`Photos from Trash Talk NYC in ${m.label.en}.`}
>
  <WallHero
    src={wallGallery}
    eyebrow={GALLERY.label}
    eyebrowHref={GALLERY.path}
    title={[m.label]}
    line={count}
    seed={24}
  >
    <MediaSubnav current="gallery" />
  </WallHero>

  <section class="gl-sec wall">
    <SectionWall kind="cleanup" src={wallGallery} dim={0} duotone={0} seed={5} />
    <div class="wrap gl-body">
      <div class="gl-month paste f-tape">
          <ul class="gl-grid">
            {photos.map((p) => (
              <li>
                <a href={p.large} target="_blank" rel="noopener" class="gl-link">
                  <Image
                    src={p.src}
                    alt={p.alt.en}
                    data-alt-en={p.alt.en}
                    data-alt-es={p.alt.es}
                    class="gl-pic"
                    width={720}
                    widths={[360, 540, 720]}
                    sizes="(min-width: 1100px) 22vw, (min-width: 600px) 44vw, 90vw"
                  />
                  <span class="sr-only" data-en="(opens a large copy)" data-es="(abre una copia grande)">(opens a large copy)</span>
                </a>
              </li>
            ))}
          </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { getCurrentLang, onLanguageChange, type Lang } from '../../../lib/language';

  // setLang never translates attributes, so each photo's alt follows the
  // language from its data-alt-* pair
  const pics = Array.from(document.querySelectorAll<HTMLImageElement>('img[data-alt-en]'));
  const applyAlts = (lang: Lang) => pics.forEach((img) => (img.alt = img.getAttribute(`data-alt-${lang}`) ?? img.alt));
  applyAlts(getCurrentLang());
  onLanguageChange(applyAlts);
</script>

<style>
  .gl-body { display: grid; gap: 52px; padding-block: 64px 80px; }

  .gl-month {
    --flyer-bg: var(--paper);
    color: var(--black);
    padding: 30px 16px 20px;
  }


  .gl-grid {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
  }

  .gl-link { display: block; }
  .gl-link:focus-visible { outline: 3px solid var(--purple); outline-offset: 3px; }

  .gl-grid :global(.gl-pic) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 2.5px solid var(--black);
    transition: transform 0.15s;
  }

  .gl-link:hover :global(.gl-pic) { transform: rotate(-0.8deg) scale(1.01); }

  @media (min-width: 600px) {
    .gl-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 761px) {
    .gl-body { gap: 64px; padding-block: 88px 104px; }
    .gl-month { padding: 40px 36px 32px; }
  }

  /* Desktop (captain, 2026-10-21: "weird spacing" at 1280–1440): three
     even columns of square crops with one gap size, so a month reads as
     a compact contact sheet, and one margin around every sheet and
     between months */
  @media (min-width: 1100px) {
    .gl-body { gap: 56px; padding-block: 72px 88px; }
    .gl-month { padding: 32px; }
    .gl-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
    .gl-grid :global(.gl-pic) { aspect-ratio: 1 / 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gl-grid :global(.gl-pic) { transition: none; }
  }
</style>
