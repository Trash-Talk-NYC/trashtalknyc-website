---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaHero from '../../components/MediaHero.astro';
import { mediaSections, moreMediaTagline, type MediaSectionId } from '../../lib/media';
import vestSticker from '../../assets/vest-sticker.png';
import illGloveShovel from '../../assets/ill-glove-shovel-beige.svg';
import illFamilyVests from '../../assets/ill-family-vests-beige.svg';
import illTrash from '../../assets/ill-trash-purple.svg';

/**
 * More Media — /more-media (captain, 2026-10-09): a title + description
 * hero ("Hear us talk trash across several platforms.") over a three-
 * section layout, one paper poster per channel, stuck up a different
 * way each (sticker, staple, tape). Podcast and Substack have
 * no links yet, so their posters say "coming soon" honestly instead of
 * inventing shows or posts.
 */

// Per-channel poster stock and drawing (copy and routes come from media.ts),
// the button that reads on that stock, and how the poster is stuck up
// (a mix of sticker, staple, and tape).
const look: Record<MediaSectionId, { tone: string; ill: { src: string }; soonBtn: string; flyer: string; sticker: boolean }> = {
  youtube: { tone: 'mm-purple', ill: illGloveShovel, soonBtn: 'btn-ghost-light', flyer: 'f-sticker', sticker: true },
  podcast: { tone: 'mm-green', ill: illFamilyVests, soonBtn: 'btn-ghost-light', flyer: 'f-staple', sticker: false },
  substack: { tone: 'mm-paper', ill: illTrash, soonBtn: 'btn-purple', flyer: 'f-tape f-torn', sticker: false },
};
---

<BaseLayout
  title="More Media — Trash Talk NYC"
  description="Hear Trash Talk NYC talk trash across several platforms: videos on YouTube, plus a podcast and a Substack on the way."
>
  <MediaHero
    title={[{ en: 'More', es: 'Más' }, { en: 'Media', es: 'Medios' }]}
    description={moreMediaTagline}
  />

  <section class="wrap mm-grid" aria-label="Channels">
    {mediaSections.map((s) => (
      <article class:list={['mm-card', 'paste', look[s.id].tone, look[s.id].flyer]}>
        {look[s.id].sticker && <Image src={vestSticker} alt="" class="slap mm-slap" width={96} densities={[1, 2]} />}
        <img class="ill mm-ill" src={look[s.id].ill.src} alt="" />
        <h2 class="mm-name">{s.label}</h2>
        <p class="mm-blurb" data-en={s.blurb.en} data-es={s.blurb.es}>{s.blurb.en}</p>
        {s.comingSoon ? (
          <>
            <p class="mono mm-soon" data-en="Coming soon" data-es="Muy pronto">Coming soon</p>
            <a class:list={['btn', look[s.id].soonBtn, 'mm-btn']} href={s.path}>
              <span data-en={`About our ${s.label} →`} data-es={`Sobre nuestro ${s.label} →`}>About our {s.label} →</span>
            </a>
          </>
        ) : (
          <a class="btn btn-primary mm-btn" href={s.path}>
            <span data-en="Watch the video →" data-es="Ver el video →">Watch the video →</span>
          </a>
        )}
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .mm-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 52px;
    padding-block: 64px 72px;
  }

  .mm-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 30px 22px 26px;
  }

  .mm-purple { --flyer-bg: var(--purple); color: var(--beige); }
  .mm-green { --flyer-bg: var(--green); color: var(--beige); }
  .mm-paper { --flyer-bg: var(--paper); color: var(--black); }

  .mm-card :global(.mm-slap) {
    top: -34px;
    width: 76px;
    height: auto;
  }

  .mm-card :global(.mm-slap) { right: -8px; transform: rotate(9deg); }

  .mm-ill {
    width: 128px;
    height: 96px;
    object-fit: contain;
    object-position: left center;
  }

  .mm-name {
    font-size: 2.8rem;
    line-height: 0.95;
  }

  .mm-purple .mm-name,
  .mm-green .mm-name { color: var(--yellow); }
  .mm-paper .mm-name { color: var(--purple); }

  .mm-blurb {
    margin: 0;
    font-size: 1.12rem;
    line-height: 1.45;
  }

  .mm-soon {
    margin: 0;
    font-size: 0.85rem;
  }

  .mm-purple .mm-soon,
  .mm-green .mm-soon { color: var(--yellow); }
  .mm-paper .mm-soon { color: var(--green); }

  /* The action sits on the card's bottom edge so the three posters
     line up their buttons on desktop */
  .mm-btn { margin-top: auto; align-self: stretch; }

  @media (min-width: 761px) {
    .mm-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(24px, 3vw, 40px);
      padding-block: 88px 96px;
    }

    .mm-card {
      padding: 36px clamp(20px, 2.4vw, 32px) 30px;
    }

    .mm-card :global(.mm-slap) { top: -40px; width: 92px; }
    .mm-name { font-size: clamp(2.8rem, 3.6vw, 3.6rem); }
    .mm-btn { align-self: flex-start; }
  }
</style>
