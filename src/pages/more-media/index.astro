---
import SectionWall from '../../components/SectionWall.astro';
import wallBluePlate from '../../assets/walls/wall-blue-plate.webp';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaHero from '../../components/MediaHero.astro';
import { GALLERY, liveMediaSections, moreMediaTagline, type MediaSectionId } from '../../lib/media';
import { galleryByMonth } from '../../lib/gallery';
import vestSticker from '../../assets/vest-sticker.png';

/**
 * More Media — /more-media (captain, 2026-10-09): a title + description
 * hero ("Hear us talk trash across several platforms.") over one poster
 * per live channel, plus the Gallery. Podcast and Substack are hidden
 * until they're ready (captain, 2026-10-15); `comingSoon` in media.ts
 * brings them back.
 */

// Per-channel poster stock and how the poster is stuck up
const look: Record<MediaSectionId, { tone: string; flyer: string; sticker: boolean }> = {
  youtube: { tone: 'mm-purple', flyer: 'f-sticker', sticker: true },
  podcast: { tone: 'mm-green', flyer: 'f-staple', sticker: false },
  substack: { tone: 'mm-paper', flyer: 'f-tape f-torn', sticker: false },
};

// The newest month's first photos preview the Gallery
const preview = galleryByMonth()[0]?.photos.slice(0, 3) ?? [];
---

<BaseLayout
  title="More Media — Trash Talk NYC"
  description="Hear Trash Talk NYC talk trash on YouTube, and see photos from the club, month by month."
>
  <MediaHero
    title={[{ en: 'More', es: 'Más' }, { en: 'Media', es: 'Medios' }]}
    description={moreMediaTagline}
  />

  <!-- One torn-edge wall behind the posters, in the photo's own colors
       (captain, 2026-10-15) -->
  <section class="mm-wall wall">
  <SectionWall kind="cleanup" src={wallBluePlate} dim={0} duotone={0} seed={8} />
  <div class="wrap mm-grid" role="group" aria-label="More Media">
    {liveMediaSections.map((s) => (
      <article class:list={['mm-card', 'paste', look[s.id].tone, look[s.id].flyer]}>
        {look[s.id].sticker && <Image src={vestSticker} alt="" class="slap mm-slap" width={96} densities={[1, 2]} />}
        <h2 class="mm-name">{s.label}</h2>
        <p class="mm-blurb" data-en={s.blurb.en} data-es={s.blurb.es}>{s.blurb.en}</p>
        <a class="btn btn-primary mm-btn" href={s.path}>
          <span data-en={`${s.action.en} →`} data-es={`${s.action.es} →`}>{s.action.en} →</span>
        </a>
      </article>
    ))}
    <article class="mm-card paste mm-paper f-tape">
      <h2 class="mm-name" data-en={GALLERY.label.en} data-es={GALLERY.label.es}>{GALLERY.label.en}</h2>
      <p class="mm-blurb" data-en="Photos from Trash Talk NYC, month by month." data-es="Fotos de Trash Talk NYC, mes a mes.">Photos from Trash Talk NYC, month by month.</p>
      {preview.length > 0 && (
        <div class="mm-thumbs" aria-hidden="true">
          {preview.map((p) => <Image src={p.src} alt="" class="mm-thumb" width={240} widths={[120, 240]} sizes="7rem" />)}
        </div>
      )}
      <a class="btn btn-purple mm-btn" href={GALLERY.path}>
        <span data-en="Look →" data-es="Ver →">Look →</span>
      </a>
    </article>
  </div>
  </section>
</BaseLayout>

<style>
  .mm-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 52px;
    padding-block: 64px 72px;
  }

  .mm-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 30px 22px 26px;
  }

  .mm-purple { --flyer-bg: var(--purple); color: var(--beige); }
  .mm-green { --flyer-bg: var(--green); color: var(--beige); }
  .mm-paper { --flyer-bg: var(--paper); color: var(--black); }

  .mm-card :global(.mm-slap) {
    top: -34px;
    width: 76px;
    height: auto;
  }

  .mm-card :global(.mm-slap) { right: -8px; transform: rotate(9deg); }


  .mm-name {
    font-size: 2.8rem;
    line-height: 0.95;
  }

  /* Yellow on purple, white on the green poster, ink on paper (captain,
     2026-10-09) */
  .mm-purple .mm-name { color: var(--yellow); }
  .mm-green .mm-name { color: var(--beige); }
  .mm-paper .mm-name { color: var(--black); }

  .mm-blurb {
    margin: 0;
    font-size: 1.12rem;
    line-height: 1.45;
  }

  /* A few of the newest photos, so the Gallery poster shows what's inside */
  .mm-thumbs { display: flex; gap: 8px; }

  .mm-thumbs :global(.mm-thumb) {
    width: 5.5rem;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 2.5px solid var(--black);
  }

  /* The action sits on the card's bottom edge so the posters line up
     their buttons on desktop */
  .mm-btn { margin-top: auto; align-self: stretch; }

  /* Square-cornered buttons across More Media (captain, 2026-10-09) */
  .mm-btn { border-radius: 0; }

  @media (min-width: 761px) {
    .mm-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 62rem;
      gap: clamp(24px, 3vw, 40px);
      padding-block: 88px 104px;
    }

    .mm-card {
      padding: 36px clamp(20px, 2.4vw, 32px) 30px;
    }

    .mm-card :global(.mm-slap) { top: -40px; width: 92px; }
    .mm-name { font-size: clamp(2.8rem, 3.6vw, 3.6rem); }
    .mm-btn { align-self: flex-start; }
    .mm-thumbs :global(.mm-thumb) { width: 6.5rem; }
  }
</style>
