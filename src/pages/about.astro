---
import Bricks from '../components/Bricks.astro';
import { brickHeroStyle, type BrickRows } from '../lib/bricks';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { team } from '../lib/team';
import groupPhoto from '../assets/film-group-pic-1.jpg';
import vestSticker from '../assets/vest-sticker.png';

/**
 * The Team — the group photo pasted up like a poster inside the brick
 * frame, then the three wheatpasted bio sheets in photo order on
 * desktop (Nandi, David, Fabiola) and David-first on phones (CSS
 * order), each with a round face chip cropped from the group photo.
 * Bios come verbatim from src/lib/team.ts — never edit them here.
 *
 * The face-chip crops are background-size/-position percentages tuned
 * by eye against the group photo in the approved mockups; they are
 * resolution-independent, so the optimized build asset works the same.
 */
const faceCrops: Record<string, { size: string; position: string }> = {
  david: { size: '400% auto', position: '46.3% 27.5%' },
  nandi: { size: '360% auto', position: '21.6% 29.3%' },
  fabiola: { size: '360% auto', position: '67.3% 39.7%' },
};

// One mid-size rendition for the face chips (they show a ~70px circle,
// but the crop zooms 3.6–4×, so a 1200px frame keeps faces sharp).
const faceImage = await getImage({ src: groupPhoto, width: 1200 });

// How each bio flyer is stuck to the wall — mixed on purpose (captain,
// 2026-10-09), with one torn bottom for variety
const bioFlyer: Record<string, string> = {
  nandi: 'f-tape',
  david: 'f-staple',
  fabiola: 'f-tape f-torn',
};

// Whole brick rows per half: as many as this hero's height fits
// Phones: a short wall above and below the full-width photo. Desktop:
// the continuous wall (Bricks `continuous`); 8 is its no-JS fallback.
const bricks: BrickRows = { phone: 3, desktop: 8 };
---

<BaseLayout
  title="About — Trash Talk NYC"
  description="Meet Trash Talk NYC, a grassroots initiative cleaning New York City through fun volunteer cleanup events, community engagement, and educational entertainment."
>
  <!-- HERO: group photo in the brick frame -->
  <section class="tm-hero brick-hero" style={brickHeroStyle(bricks)}>
    <Bricks rows={bricks} continuous />
    <div class="tm-hero-inner">
      <!-- "About" is an eyebrow over the page name, the same pattern as
           From the Founder (captain, 2026-10-09) -->
      <div class="mono tm-eyebrow" data-en="About" data-es="Nosotros">About</div>
      <h1 class="tm-title" data-en="The Team" data-es="El Equipo">The Team</h1>
      <figure class="tm-photo paste f-sticker">
        <Image src={vestSticker} alt="" class="slap tm-slap" width={92} densities={[1, 2]} />
        <Image
          src={groupPhoto}
          alt="Nandi, David, and Fabiola sitting together on a rock in a park"
          class="pic"
          width={1280}
          widths={[640, 960, 1280]}
          sizes="(min-width: 761px) 640px, 100vw"
          loading="eager"
        />
        <figcaption><span>Nandi</span><span>David</span><span>Fabiola</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap team-section">
    <div class="bios">
      {team.map((p) => (
        <article class:list={['bio', 'paste', `b-${p.id}`, bioFlyer[p.id]]}>
          <div class="who">
            <span
              class="face"
              style={`background-image:url(${faceImage.src});background-size:${faceCrops[p.id]?.size};background-position:${faceCrops[p.id]?.position}`}
              aria-hidden="true"
            ></span>
            <div class="who-text">
              <h2>{p.name}</h2>
              <span class="role mono" data-en={p.role.en} data-es={p.role.es}>{p.role.en}</span>
            </div>
          </div>
          {p.bio.map((b) =>
            b.parts ? (
              <p>
                {b.parts.map((seg) =>
                  seg.href
                    ? <a href={seg.href} data-en={seg.en} data-es={seg.es}>{seg.en}</a>
                    : <span data-en={seg.en} data-es={seg.es}>{seg.en}</span>
                )}
              </p>
            ) : (
              <p data-en={b.en} data-es={b.es}>{b.en}</p>
            )
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- Closing hand-off to the recruitment page. Old emails linked
       /about#join-the-team; keep the anchor landing here. -->
  <!-- A short row: the heading with the roles button beside it, nothing
       else (captain, 2026-10-09) -->
  <section class="lend" id="join-the-team">
    <div class="wrap lend-inner">
      <h2 data-en="Want to lend a hand?" data-es="¿Quieres echar una mano?">Want to lend a hand?</h2>
      <a class="btn btn-primary" href="/recruit" data-en="See open roles →" data-es="Ver puestos abiertos →">See open roles →</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── HERO ── */
  .tm-hero {
    position: relative;
    overflow: hidden;
    border-bottom: var(--ink);
  }

  .tm-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 51.25rem;
    margin-inline: auto;
    display: grid;
    gap: 16px;
    justify-items: center;
    padding: calc(100vw * 0.15) 22px calc(100vw * 0.15);
  }

  /* Same eyebrow voice as the founder page's */
  .tm-eyebrow { color: var(--yellow); font-size: 1.02rem; margin-bottom: -6px; }

  .tm-title { font-size: 3.4rem; line-height: 0.92; color: var(--lavender); }

  .tm-photo {
    position: relative;
    width: min(40rem, 100%);
    margin: 0;
    --flyer-bg: var(--paper);
    color: var(--black);
    padding: 10px 10px 12px;
  }

  .tm-photo :global(.pic) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }

  .tm-photo figcaption {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-top: 10px;
    font-family: var(--mono);
    font-weight: 700;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
  }

  .tm-photo :global(.tm-slap) {
    top: -28px;
    right: -8px;
    width: 66px;
    height: auto;
    transform: rotate(10deg);
  }

  @media (min-width: 761px) {
    .tm-hero-inner { gap: 22px; padding: calc(100vw * 0.08) 16px calc(100vw * 0.08); }
    .tm-title { font-size: clamp(3.4rem, 6.4vw, 5.8rem); }
    /* The hero always shows the full brick drawing on desktop, whose height
       scales with the viewport, so the photo scales with it too and the
       side columns stay one connected wall (captain, 2026-10-09) */
    .tm-hero-inner { max-width: none; width: 100%; }
    .tm-photo { width: min(46vw, 100%); padding: 14px 14px 18px; }
    .tm-photo figcaption { font-size: 0.72rem; }

    .tm-photo :global(.tm-slap) {
      top: -38px;
      right: -26px;
      width: 92px;
    }
  }

  /* ── BIOS ── */
  /* Breathing room under the hero now that the bios lead the section */
  .team-section { padding-top: 48px; }

  .bios {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    padding-bottom: 44px;
    align-items: start;
  }

  .bio {
    --flyer-bg: var(--paper);
    color: var(--black);
    padding: 22px 18px;
    display: grid;
    gap: 12px;
  }

  /* Photo beside the name, with the role title left-aligned under the
     name (captain, 2026-10-09) rather than pushed to the right edge */
  .bio .who {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .who-text { display: grid; gap: 4px; justify-items: start; min-width: 0; }
  .bio .who .role { color: var(--green); }

  .face {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    border: 2.5px solid var(--black);
    background-repeat: no-repeat;
    flex: none;
  }

  .bio h2 { font-size: 2.4rem; color: var(--purple); }
  .bio p { margin: 0; font-size: 1.05rem; line-height: 1.55; }
  .bio a { color: var(--purple); font-weight: 700; }

  /* Photo order on desktop, David first on phones */
  .b-david { order: 1; }
  .b-nandi { order: 2; }
  .b-fabiola { order: 3; }

  @media (min-width: 761px) {
    .bios { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 26px; padding-bottom: 64px; }
    .bio { padding: 26px 24px 24px; }
    .bio h2 { font-size: 2.8rem; }
    .b-nandi { order: 1; }
    .b-david { order: 2; }
  }

  /* ── LEND A HAND ── */
  .lend {
    background-color: var(--green);
    color: var(--beige);
    padding-block: 32px;
  }

  .lend-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
  }

  .lend h2 { font-size: 2.4rem; }

  @media (min-width: 761px) {
    .lend { padding-block: 40px; }
    .lend h2 { font-size: clamp(2.6rem, 4vw, 3.6rem); }
  }
</style>
