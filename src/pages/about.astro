---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Trash Talk NYC" showSocialBar={false}>

  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="page-hero-eyebrow" data-en="About" data-es="Sobre Nosotros">About</p>
      <h1><span data-en="WE KEEP" data-es="MANTENEMOS">WE KEEP</span><br /><span class="accent" data-en="NYC CLEAN" data-es="NYC LIMPIA">NYC CLEAN</span></h1>
    </div>
  </section>

  <!-- DAVID -->
  <section class="david-section">
    <div class="david-inner">

      <div>
        <div class="david-photo" id="davidPhoto">
          <img src="/assets/IMG_0952_Original.jpeg" alt="David, organizer of Trash Talk NYC" />
          <div class="david-tag" data-en="Organizer" data-es="Organizador">Organizer</div>
        </div>
      </div>

      <div class="david-text">
        <div class="david-name" id="davidName">David</div>
        <div class="david-role" id="davidRole" data-en="Organizer" data-es="Organizador">Organizer</div>
        <div class="david-divider" id="davidDivider"></div>

        <div class="david-bio">
          <p id="davidP1" data-en="Trash Talk is a grassroots social media initiative to clean New York through educational entertainment." data-es="Trash Talk es una iniciativa de base impulsada por las redes sociales para limpiar Nueva York a través del entretenimiento educativo.">Trash Talk is a grassroots social media initiative to clean New York through educational entertainment.</p>
          <p id="davidP2" data-en="By generating a national and international following, David hopes to clean his neighborhood and the city through fun volunteer events and community engagement. Funds for the projects are received through donations and sponsorships." data-es="Al generar una comunidad de seguidores a nivel nacional e internacional, David espera limpiar su vecindario y la ciudad a través de eventos de voluntariado divertidos y la participación comunitaria. Los fondos para los proyectos se reciben mediante donaciones y patrocinios.">By generating a national and international following, David hopes to clean his neighborhood and the city through fun volunteer events and community engagement. Funds for the projects are received through donations and sponsorships.</p>
          <p id="davidP3" data-en="This is an incredibly complex and exciting project, and we hope you'll join us to clean New York!" data-es="¡Este es un proyecto increíblemente complejo y emocionante, y esperamos que te unas a nosotros para limpiar Nueva York!">This is an incredibly complex and exciting project, and we hope you'll join us to clean New York!</p>
        </div>

        <div class="david-socials" id="davidIg">
          <a class="david-ig" href="https://instagram.com/trashtalk_nyc" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            Instagram
          </a>
          <a class="david-ig" href="https://www.tiktok.com/@trashtalk_nyc" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>
            TikTok
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- CUSTOM FOOTER (centered layout, matches about.html original) -->
  <footer class="about-footer" slot="footer">
    <div class="footer-logo">Trash Talk NYC</div>
    <ul class="footer-links">
      <li><a href="/" data-en="Home" data-es="Inicio">Home</a></li>
      <li><a href="/#signup" data-en="Join" data-es="Únete">Join</a></li>
      <li><a href="/about" data-en="About" data-es="Nosotros">About</a></li>
      <li><a href="/contact" data-en="Contact" data-es="Contacto">Contact</a></li>
    </ul>
    <ul class="footer-socials">
      <li>
        <a href="https://www.instagram.com/trashtalk_nyc/" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          @trashtalk_nyc
        </a>
      </li>
      <li>
        <a href="https://www.tiktok.com/@trashtalk_nyc" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>
          TikTok
        </a>
      </li>
    </ul>
    <div class="footer-copy">© 2025 Trash Talk NYC</div>
  </footer>

</BaseLayout>

<style>
  /* ── PAGE HERO ── */
  .page-hero {
    background: var(--charcoal);
    padding: 3rem 2rem 2.75rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    border-bottom: 3px solid var(--purple-light);
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 18px,
      rgba(107, 63, 160, 0.06) 18px,
      rgba(107, 63, 160, 0.06) 19px
    );
    pointer-events: none;
  }

  .page-hero-inner { position: relative; z-index: 1; }

  .page-hero-eyebrow {
    font-family: 'Space Mono', monospace;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: rgba(247, 244, 237, 0.45);
    margin-bottom: 1rem;
  }

  .page-hero h1 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.8rem, 7vw, 5rem);
    color: var(--off-white);
    letter-spacing: 0.06em;
    line-height: 1.05;
    margin-bottom: 0;
  }

  .page-hero h1 .accent { color: var(--yellow); }

  /* ── DAVID SECTION ── */
  .david-section {
    background: var(--off-white);
    padding: 5rem 3rem 5.5rem;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid #ddd9d0;
  }

  .david-section::before {
    content: '';
    position: absolute;
    left: -10%;
    top: -20%;
    width: 55vw;
    height: 100%;
    background: radial-gradient(ellipse at center, rgba(245, 208, 0, 0.07) 0%, transparent 65%);
    pointer-events: none;
  }

  .david-section::after {
    content: '';
    position: absolute;
    right: -5%;
    bottom: -20%;
    width: 40vw;
    height: 80%;
    background: radial-gradient(ellipse at center, rgba(155, 93, 229, 0.06) 0%, transparent 65%);
    pointer-events: none;
  }

  .david-inner {
    max-width: 960px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 4rem;
    align-items: flex-start;
    position: relative;
    z-index: 1;
  }

  .david-photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 18px;
    overflow: hidden;
    position: relative;
    background: var(--cream);
    border: 1px solid #d8d3c8;
    box-shadow: 0 2px 4px rgba(28, 28, 34, 0.04), 0 8px 24px rgba(28, 28, 34, 0.08), 0 24px 48px rgba(28, 28, 34, 0.06);
    opacity: 0;
    transform: translateY(24px) scale(0.97);
    transition: opacity 500ms var(--ease-out), transform 500ms var(--ease-out);
  }

  .david-photo.visible { opacity: 1; transform: translateY(0) scale(1); }

  .david-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
    transition: transform 600ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .david-photo:hover img { transform: scale(1.03); }
  }

  .david-tag {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: var(--yellow);
    color: var(--charcoal);
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 300ms 200ms var(--ease-out), transform 300ms 200ms var(--ease-out);
  }

  .david-photo.visible .david-tag { opacity: 1; transform: translateY(0); }

  .david-text { padding-top: 0.5rem; }

  .david-name {
    font-family: 'Nunito', sans-serif;
    font-size: clamp(2.4rem, 4.5vw, 4rem);
    font-weight: 800;
    color: var(--charcoal);
    line-height: 1;
    letter-spacing: -0.01em;
    margin-bottom: 0.25rem;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 440ms 60ms var(--ease-out), transform 440ms 60ms var(--ease-out);
  }

  .david-name.visible { opacity: 1; transform: translateY(0); }

  .david-role {
    font-family: 'Nunito', sans-serif;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--warm-gray);
    margin-bottom: 2rem;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 400ms 100ms var(--ease-out), transform 400ms 100ms var(--ease-out);
  }

  .david-role.visible { opacity: 1; transform: translateY(0); }

  .david-divider {
    height: 2px;
    background: linear-gradient(90deg, var(--purple-light), transparent);
    border-radius: 2px;
    margin-bottom: 1.75rem;
    opacity: 0;
    width: 0;
    transition: opacity 400ms 130ms var(--ease-out), width 500ms 130ms var(--ease-out);
  }

  .david-divider.visible { opacity: 1; width: 2.5rem; }

  .david-bio { display: flex; flex-direction: column; gap: 1rem; }

  .david-bio p {
    font-size: 0.97rem;
    font-weight: 600;
    color: #4a4850;
    line-height: 1.8;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 380ms var(--ease-out), transform 380ms var(--ease-out);
  }

  .david-bio p.visible { opacity: 1; transform: translateY(0); }
  .david-bio p:nth-child(1) { transition-delay: 150ms; }
  .david-bio p:nth-child(2) { transition-delay: 210ms; }
  .david-bio p:nth-child(3) { transition-delay: 270ms; }

  .david-socials {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 360ms 300ms var(--ease-out), transform 360ms 300ms var(--ease-out);
  }

  .david-socials.visible { opacity: 1; transform: translateY(0); }

  .david-ig {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--purple);
    text-decoration: none;
    letter-spacing: 0.06em;
    border-bottom: 2px solid rgba(107, 63, 160, 0.25);
    padding-bottom: 0.1rem;
    transition: color 160ms var(--ease-out), border-color 160ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .david-ig:hover { color: var(--purple-light); border-color: var(--purple-light); }
  }

  .david-ig svg { width: 14px; height: 14px; fill: currentColor; flex-shrink: 0; }

  /* ── ABOUT FOOTER (centered, matches original about.html) ── */
  .about-footer {
    background: var(--charcoal);
    color: rgba(247, 244, 237, 0.55);
    text-align: center;
    padding: 2.5rem 1rem;
    font-size: 0.8rem;
    /* override global footer flex-row layout */
    display: block;
    border-top: none;
  }

  .about-footer .footer-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem;
    color: var(--yellow);
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
  }

  .about-footer .footer-links {
    list-style: none;
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .about-footer .footer-links a {
    color: rgba(247, 244, 237, 0.55);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: color 0.15s;
  }

  .about-footer .footer-links a:hover { color: var(--yellow); }

  .about-footer .footer-socials {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    list-style: none;
    flex-wrap: wrap;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(247, 244, 237, 0.1);
    width: 100%;
    margin-bottom: 1rem;
  }

  .about-footer .footer-socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: rgba(247, 244, 237, 0.45);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: color 0.15s;
  }

  .about-footer .footer-socials a:hover { color: var(--yellow); }
  .about-footer .footer-socials svg { width: 13px; height: 13px; fill: currentColor; flex-shrink: 0; }

  .about-footer .footer-copy { font-size: 0.7rem; }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .david-section { padding: 3.5rem 1.5rem 4rem; }
    .david-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .david-photo { max-width: 220px; aspect-ratio: 1/1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .david-photo,
    .david-name,
    .david-role,
    .david-bio p,
    .david-socials {
      transform: none !important;
      opacity: 1 !important;
    }
    .david-divider { width: 2.5rem !important; opacity: 1 !important; }
  }
</style>

<script>
  const photoObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        photoObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });

  const photo = document.getElementById('davidPhoto');
  if (photo) photoObserver.observe(photo);

  const textObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        textObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  ['davidName', 'davidRole', 'davidDivider', 'davidP1', 'davidP2', 'davidP3', 'davidIg'].forEach((id) => {
    const el = document.getElementById(id);
    if (el) textObserver.observe(el);
  });
</script>
