---
import { Image } from 'astro:assets';
import { actions } from 'astro:actions';
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonSocials from '../components/PersonSocials.astro';
import { JOIN_ROLES } from '../lib/server/schemas';
import { team } from '../lib/team';
import groupPhoto from '../assets/film-group-pic-1.jpg';
import workDavidFabi from '../assets/film-david-fabi.jpg';
import workNandiFabi from '../assets/film-holo-nandi-fabi.jpg';

/**
 * The hero renders a fixed vertical crop of the landscape group shot:
 * the top 9% (empty trees) and bottom 5% (rock) go, which buys back
 * ~130px of viewport at 1440px so the bio row enters the first
 * screenful sooner. The crop is a build-time constant — never a
 * viewport-dependent object-fit — so person coordinates stay exact:
 * py() remaps a y-percentage of the full frame into the cropped frame.
 */
const CROP = { top: 9, height: 86 };
const py = (y: number) => Math.min(100, Math.max(0, ((y - CROP.top) / CROP.height) * 100));

/**
 * Photo geometry per person, left to right as seated in the group
 * photo. Names, roles, bios, and social links live in src/lib/team.ts
 * (shared with the /about/{person} pages); only the About-page-specific
 * presentation lives here.
 * - face/band: hotspot geometry in % of the full (uncropped) photo
 *   frame — the template remaps y through py(). The photograph itself
 *   is always fully lit (the round-13 captain call retired the radial
 *   spotlight veil); interaction illuminates the person's name chip.
 */
const geometry: Record<string, {
  face: { x: number; y: number };
  band: { x1: number; x2: number; y1: number; y2: number };
}> = {
  nandi: {
    face: { x: 29.5, y: 26.5 },
    band: { x1: 18, x2: 43, y1: 13, y2: 97 },
  },
  david: {
    face: { x: 47.2, y: 26.5 },
    band: { x1: 43, x2: 54.5, y1: 18, y2: 100 },
  },
  fabiola: {
    face: { x: 60.5, y: 31.5 },
    band: { x1: 54.5, x2: 74.5, y1: 24, y2: 92 },
  },
};

const people = team.map((p) => ({ ...p, ...geometry[p.id] }));

/**
 * Bio order is fixed: David leads, then Nandi, then Fabiola — the
 * captain's "always" order for mobile. Desktop restores photo order
 * (Nandi/David/Fabiola) with CSS `order` so the columns still map
 * onto the photograph left-to-right; DOM (and screen-reader) order
 * stays David-first, the primary bio.
 */
const bioOrder = ['david', 'nandi', 'fabiola']
  .map((id) => people.find((p) => p.id === id)!);

/**
 * Join the Team role boxes. `value` must stay inside JOIN_ROLES in
 * src/lib/server/schemas.ts — the form select and the action's enum
 * validate against it, so rename them together.
 *
 * The fourth role is a crew-proposed PLACEHOLDER: the captain named only
 * Videographer / Social Media Manager / Developer and has not chosen the
 * fourth yet. "Events & Operations Lead" is our suggestion for a street
 * cleanup club — captain, rename at will (here + JOIN_ROLES).
 *
 * `accent` is an existing brand token per card (yellow / purple-light /
 * orange / green-light) — no new hues.
 */
const roles = [
  {
    value: JOIN_ROLES[0], // Videographer
    accent: 'var(--yellow)',
    title: { en: 'Videographer', es: 'Videógrafo/a' },
    desc: {
      en: "Shoot the cleanups. Cut the clips people can't scroll past.",
      es: 'Graba las limpiezas. Edita los clips que nadie puede ignorar.',
    },
  },
  {
    value: JOIN_ROLES[1], // Social Media Manager
    accent: 'var(--purple-light)',
    title: { en: 'Social Media Manager', es: 'Gestor/a de Redes' },
    desc: {
      en: 'Run the accounts, talk to the comments, grow the club.',
      es: 'Maneja las cuentas, responde los comentarios, haz crecer el club.',
    },
  },
  {
    value: JOIN_ROLES[2], // Developer
    accent: 'var(--orange)',
    title: { en: 'Developer', es: 'Desarrollador/a' },
    desc: {
      en: 'Build this site and the tools that keep the club moving.',
      es: 'Construye este sitio y las herramientas que mueven el club.',
    },
  },
  {
    value: JOIN_ROLES[3], // Events & Operations Lead — PLACEHOLDER name
    accent: 'var(--green-light)',
    title: { en: 'Events & Operations Lead', es: 'Líder de Eventos y Operaciones' },
    desc: {
      en: 'Plan the routes, wrangle the gear, make cleanup day run.',
      es: 'Planifica las rutas, organiza el equipo y haz que el día funcione.',
    },
  },
];
---

<BaseLayout
  title="About — Trash Talk NYC"
  description="Meet Trash Talk NYC — a grassroots initiative cleaning New York City through fun volunteer cleanup events, community engagement, and educational entertainment."
  showSocialBar={false}
>

  <!-- HERO + BIOS share a wrapper so the hero can pin (mobile) exactly
       while the bios scroll past it, then release before the closing
       cleanup photographs. -->
  <div class="team-flow">

    <!-- TEAM PHOTO — the page opens on one photograph, no headline.
         "About" rides it as a chip in the same translucent-paper family
         as the name chips. Each person is a focusable hotspot: hover,
         focus, or scrolling to their bio illuminates their name chip
         (the photograph itself always stays fully lit); activating
         scrolls to their bio. -->
    <section class="team-hero">
      <div class="tape-seam" aria-hidden="true"></div>
      <figure class="team-figure">
        <div class="team-crop" id="teamCrop">
          <Image
            src={groupPhoto}
            alt="Nandi, David and Fabiola — the Trash Talk NYC team — sitting together on a rock in a park"
            class="team-photo"
            width={2560}
            widths={[640, 960, 1280, 1600, 2048, 2560]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
          <h1 class="about-chip" data-en="About" data-es="Sobre Nosotros">About</h1>
          {people.map((p) => (
            <span class="face-marker" data-person={p.id} style={`left:${p.face.x}%; top:${py(p.face.y + 22)}%;`} aria-hidden="true">{p.name}</span>
          ))}
          {people.map((p) => (
            <button
              type="button"
              class="hotspot"
              data-person={p.id}
              style={`left:${p.band.x1}%; width:${p.band.x2 - p.band.x1}%; top:${py(p.band.y1)}%; height:${py(p.band.y2) - py(p.band.y1)}%;`}
            >
              <span class="sr-only" data-en={`Show ${p.name}'s bio`} data-es={`Mostrar la biografía de ${p.name}`}>Show {p.name}'s bio</span>
            </button>
          ))}
        </div>
      </figure>
      <div class="tape-seam" aria-hidden="true"></div>
    </section>

    <!-- BIOS — editorial: a charcoal rule, the name large with the
         marker swipe, the bio in a measured column. All three always
         readable; the photo interactions only highlight, never gate.
         The intro blurb runs first: it introduces the crew collectively
         AND buys the resting, fully-lit photo more scroll runway on
         mobile before the first bio takes the spotlight. -->
    <section class="team-section grid-paper">
      <div class="team-intro">
        <p data-en="Three of us, one crew. We pick up New York block by block — cleanups anyone can join, filmed so the whole city catches on. Meet the people behind the grabbers." data-es="Somos tres, un solo equipo. Levantamos Nueva York cuadra por cuadra — limpiezas abiertas a cualquiera, filmadas para que toda la ciudad se sume. Conoce a la gente detrás de las pinzas.">Three of us, one crew. We pick up New York block by block — cleanups anyone can join, filmed so the whole city catches on. Meet the people behind the grabbers.</p>
      </div>
      <div class="team-cards" id="teamCards">
        {bioOrder.map((p, i) => (
          <article class="team-entry" data-person={p.id} data-index={i}>
            {/* Interaction split: taps/hovers on the PHOTO highlight and
                scroll; the card's name and the "Full bio" link are the
                explicit navigation to the person's own page. */}
            <h2 class="team-name"><a href={`/about/${p.id}`}><mark>{p.name}</mark></a></h2>
            <p class="team-role" data-en={p.role.en} data-es={p.role.es}>{p.role.en}</p>
            <div class="team-bio">
              {p.bio.map((b) => (
                <p data-en={b.en} data-es={b.es}>{b.en}</p>
              ))}
            </div>
            <div class="team-socials">
              <PersonSocials socials={p.socials} />
            </div>
            <a class="team-more" href={`/about/${p.id}`} data-en="Full bio →" data-es="Biografía completa →">Full bio →</a>
          </article>
        ))}
      </div>
    </section>

  </div>

  <!-- The cleanup frames — the only images on the site showing the
       club mid-cleanup. Unlabelled on purpose; the images carry it.
       They close the page. -->
  <section class="team-tail grid-paper">
    <div class="team-work">
      <div class="team-work-grid">
        <figure>
          <Image
            src={workDavidFabi}
            alt="David holding a full refuse sack and Fabiola in a hi-vis vest holding up a pink polka-dot bag, mid-conversation on a park path"
            class="team-work-img"
            width={1080}
            widths={[480, 720, 1080]}
            sizes="(min-width: 700px) 34rem, 100vw"
            loading="lazy"
          />
        </figure>
        <figure>
          <Image
            src={workNandiFabi}
            alt="Nandi with a litter grabber and Fabiola holding a bag open, both in hi-vis vests, walking through the park"
            class="team-work-img"
            width={1080}
            widths={[480, 720, 1080]}
            sizes="(min-width: 700px) 34rem, 100vw"
            loading="lazy"
          />
        </figure>
      </div>
    </div>

  </section>

  <!-- JOIN THE TEAM — the loud CTA moment of the page. Four role boxes
       feed an application form; the intake destination is still the
       captain's call (NOT Brevo — see AGENTS.md), so submissions land
       in a Netlify Blobs holding pen for now. -->
  <section class="join-team diag-texture" id="join">
    <div class="tape-seam" aria-hidden="true"></div>
    <div class="join-word" aria-hidden="true">CREW</div>
    <div class="join-inner">
      <p class="sticker join-eyebrow" style="--tilt: 2deg" data-en="Now recruiting" data-es="Estamos reclutando">Now recruiting</p>
      <h2 class="join-title">
        <span data-en="Join the" data-es="Únete al">Join the</span>
        <span class="join-title-accent" data-en="team" data-es="equipo">team</span>
      </h2>
      <p class="join-sub" data-en="Trash Talk NYC is a crew before it's anything else. Pick a role, tell us why, and let's clean this city." data-es="Trash Talk NYC es un equipo antes que nada. Elige un rol, cuéntanos por qué, y limpiemos esta ciudad.">Trash Talk NYC is a crew before it's anything else. Pick a role, tell us why, and let's clean this city.</p>

      <div class="join-roles">
        {roles.map((r, i) => (
          <button type="button" class="role-card" data-role={r.value} style={`--accent:${r.accent}; --card-tilt:${i % 2 === 0 ? '-1deg' : '1deg'}`} aria-pressed="false">
            <span class="role-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="role-title" data-en={r.title.en} data-es={r.title.es}>{r.title.en}</span>
            <span class="role-desc" data-en={r.desc.en} data-es={r.desc.es}>{r.desc.en}</span>
            <span class="role-apply"><span data-en="Apply" data-es="Postúlate">Apply</span> <span class="role-arrow" aria-hidden="true">→</span></span>
          </button>
        ))}
      </div>

      <div class="join-form-wrap" id="joinFormWrap">
        <form id="joinForm" method="POST" action={actions.joinTeam}>
          <input type="hidden" name="botcheck" value="">
          <input type="hidden" name="startedAt" id="joinStartedAt" value="">
          <div class="form-row">
            <div class="form-group">
              <label for="joinName" data-en="Name *" data-es="Nombre *">Name *</label>
              <input type="text" id="joinName" name="name" required maxlength="200" placeholder="Jane Doe" autocomplete="name">
            </div>
            <div class="form-group">
              <label for="joinEmail" data-en="Email address *" data-es="Correo electrónico *">Email address *</label>
              <input type="email" id="joinEmail" name="email" required placeholder="jane@example.com" autocomplete="email">
            </div>
          </div>

          <div class="form-group">
            <label for="joinRole" data-en="Which role? *" data-es="¿Qué rol? *">Which role? *</label>
            <select id="joinRole" name="role" required>
              <option value="" selected disabled data-en="Pick a role" data-es="Elige un rol">Pick a role</option>
              {roles.map((r) => (
                <option value={r.value} data-en={r.title.en} data-es={r.title.es}>{r.title.en}</option>
              ))}
            </select>
          </div>

          <div class="form-group">
            <label for="joinWhy" data-en="Why do you want to join? *" data-es="¿Por qué quieres unirte? *">Why do you want to join? *</label>
            <textarea id="joinWhy" name="why" required maxlength="2000" data-placeholder-en="A few sentences is plenty — what would you bring to the crew?" data-placeholder-es="Con unas frases basta — ¿qué aportarías al equipo?" placeholder="A few sentences is plenty — what would you bring to the crew?"></textarea>
          </div>

          <button type="submit" class="form-submit" data-en="Send my application →" data-es="Enviar mi solicitud →">Send my application →</button>
          <!-- No data-en/data-es: the submit handler and onLanguageChange
               own this element's content (same rule as the other forms) -->
          <p class="form-error" id="joinFormError" aria-live="polite"></p>
        </form>

        <div class="form-success" id="joinSuccess">
          <div class="check">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--purple)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" style="width:3rem;height:3rem"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/></svg>
          </div>
          <h3 data-en="Application received" data-es="Solicitud recibida">Application received</h3>
          <!-- Honest copy: the submission IS saved (Netlify Blobs holding
               pen), but the roles are brand new and there's no inbox
               workflow yet — don't promise a fast reply. -->
          <p data-en="It's saved with the crew. These roles are brand new and applications are just opening up, so give us a little time and we'll reach out. Meanwhile, come say hi at a cleanup or DM @trashtalk_nyc." data-es="Quedó guardada con el equipo. Estos roles son completamente nuevos y las solicitudes apenas están abriendo, así que danos un poco de tiempo y te contactaremos. Mientras tanto, ven a saludar en una limpieza o escríbenos por DM a @trashtalk_nyc.">It's saved with the crew. These roles are brand new and applications are just opening up, so give us a little time and we'll reach out. Meanwhile, come say hi at a cleanup or DM @trashtalk_nyc.</p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* ── PHOTO HERO ── */
  .team-hero {
    background: var(--charcoal);
  }

  /* Mobile: the taped photo plate pins under the nav while the bios
     scroll past beneath it, so the scroll-driven spotlight is always
     visible while reading. The wrapper ends after the bios, which
     releases the pin before the closing photographs. Desktop keeps
     normal flow — the hero is most of a screenful there, and its lower
     half stays naturally visible while the bio row is read. */
  @media (max-width: 700px) {
    .team-hero {
      position: sticky;
      top: var(--nav-h);
      z-index: 2;
    }

    /* Phased scroll: while the photo is pinned, the bios arrive as
       beats — the second and third bios snap in under the plate with
       `scroll-snap-stop: always`, so momentum can't blow past a person
       and the light walks in deliberate steps. `proximity` (never
       mandatory) so leaving the section stays effortless: past the
       last bio there are no snap areas and the page scrolls freely.

       Two deliberate omissions, learned the hard way:
       - NO snap-align on the wrapper or the first bio. The landing
         screen (photo + first bio's opening) IS the first beat — the
         first bio's aligned position sits ~18px below scrollY 0, so
         giving it a snap position risks a load-time re-snap that would
         light him up at rest (the captain wants nobody lit on landing)
         and would trap the first flick at a standstill.
       - NEVER put snap-align on an ancestor taller than the viewport
         (we tried .team-flow): Chrome treats an oversized snap area as
         a RANGE of valid positions that swallows every per-bio snap
         position inside it, and the range's end becomes a phantom
         attractor mid-band. */
    :global(html) {
      scroll-snap-type: y proximity;
    }

    .team-entry:not(:first-child) {
      scroll-snap-align: start;
      scroll-snap-stop: always;
      /* Pinned plate = two 8px seams + the 57.0103vw photo crop
         (100vw × 3318/5820). +4px so the snapped position lands exactly
         on scrollToEntry's target: the html scroll-padding already
         contributes nav + 12px, and nav + plate + 16px is the JS
         offset — keeping the two equal stops tap-to-scroll from being
         re-snapped somewhere else afterwards. */
      scroll-margin-top: calc(57.0103vw + 20px);
    }
  }

  .team-figure {
    line-height: 0;
  }

  /* Fixed build-time crop (see CROP in frontmatter): the wrapper's
     aspect ratio is the source 5820:3858 with 14% of the height
     removed, and the image is shifted up by the cropped top band.
     Everything positioned inside uses py()-remapped percentages. */
  .team-crop {
    position: relative;
    overflow: hidden;
    /* 3858 × 0.86 */
    aspect-ratio: 5820 / 3318;
  }

  .team-crop .team-photo {
    position: absolute;
    left: 0;
    width: 100%;
    height: auto;
    /* 9% of image height as a fraction of the cropped height */
    top: calc(-9% / 0.86);
  }

  .hotspot {
    position: absolute;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* The illuminated name chip IS the focus indicator for these buttons
     (set from the focus listener, with an extra solid ring for
     keyboard focus — see .face-marker.is-focus); the global purple
     ring is intentionally suppressed here at the captain's direction. */
  .hotspot:focus-visible {
    outline: none;
  }

  /* The signature: translucent paper name-chips pinned at chest
     height, always visible on every device. Quiet by design — the
     look is captain-approved, do not restyle.
     Sizing scales with the viewport (= the full-bleed photo) so the
     chips hold the same visual weight against the photo at every
     width. The floor is the signed-off phone size (0.55rem at 390px
     ≈ 2.25vw), so mobile renders exactly as before; the ceiling only
     guards ultrawide monitors. Border/radius are in em so the whole
     chip zooms as one object. */
  .face-marker {
    position: absolute;
    transform: translate(-50%, -50%) rotate(-2deg);
    font-family: 'Space Mono', monospace;
    font-size: clamp(0.55rem, 2.25vw, 2.2rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    line-height: 1;
    color: var(--charcoal);
    background: var(--paper-a70);
    border: 0.12em solid rgba(28, 28, 34, 0.35);
    border-radius: 0.35em;
    padding: 0.3em 0.55em;
    pointer-events: none;
    transition:
      translate 200ms var(--ease-out),
      border-color 200ms var(--ease-out),
      background-color 200ms var(--ease-out),
      box-shadow 200ms var(--ease-out);
  }

  /* "Illuminated" chip — the whole interaction language since the
     radial veil retired: the paper turns opaque, the border sets to
     full charcoal, and a warm yellow glow reads as light hitting the
     tag. Quiet on purpose; the lift is em-scaled so it grows with the
     chip. */
  .face-marker.is-active {
    translate: 0 -0.45em;
    background: var(--off-white);
    border-color: var(--charcoal);
    box-shadow:
      0 0 0.4em rgba(245, 208, 0, 0.9),
      0 0 1.1em rgba(245, 208, 0, 0.55);
  }

  /* Keyboard focus = illumination + a solid yellow ring. The glow
     alone is a state, not a focus indicator; the hard ring is the
     smallest addition that is unmistakable at a glance. */
  .face-marker.is-focus {
    box-shadow:
      0 0 0 0.22em var(--yellow),
      0 0 1.1em rgba(245, 208, 0, 0.55);
  }

  /* "About" rides the photo as part of the same paper set; same
     proportional sizing (0.72rem at 390px ≈ 2.95vw) */
  .about-chip {
    position: absolute;
    left: 2.2%;
    top: 5.5%;
    transform: rotate(-1.5deg);
    font-family: 'Space Mono', monospace;
    font-size: clamp(0.72rem, 2.95vw, 2.85rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    line-height: 1;
    color: var(--charcoal);
    background: var(--paper-a70);
    border: 0.09em solid rgba(28, 28, 34, 0.35);
    border-radius: 0.26em;
    padding: 0.4em 0.7em;
  }

  /* ── BIOS (editorial) ── */
  .team-section {
    background: var(--off-white);
    padding: var(--space-lg) max(var(--gutter), var(--safe-right)) var(--space-xl) max(var(--gutter), var(--safe-left));
    position: relative;
    overflow: hidden;
  }

  .team-section::before {
    content: '';
    position: absolute;
    left: -10%;
    top: -20%;
    width: 55vw;
    height: 100%;
    background: radial-gradient(ellipse at center, rgba(245, 208, 0, 0.07) 0%, transparent 65%);
    pointer-events: none;
  }

  /* Editorial lede introducing the crew as a whole. On mobile it also
     buys the resting photo more runway: the first bio starts lower, so
     the reader scrolls through neutral ground (nobody spotlighted)
     before David's entry claims the light. */
  .team-intro {
    max-width: var(--container);
    margin: 0 auto var(--space-xl);
    position: relative;
    z-index: 1;
  }

  /* Lede-sized on purpose: the type scale and the space-xl below are
     what buy the resting photo its scroll runway on mobile — shrink
     either and David's spotlight fires almost immediately again. */
  .team-intro p {
    font-size: var(--step-2);
    font-weight: 800;
    color: var(--charcoal);
    line-height: 1.45;
    max-width: 40ch;
  }

  .team-cards {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: var(--space-lg);
    align-items: start;
    position: relative;
    z-index: 1;
  }

  /* DOM order is David → Nandi → Fabiola (the captain's fixed mobile
     order, and the reading order). Desktop restores photo order
     left-to-right so the columns map onto the photograph. */
  @media (min-width: 701px) {
    .team-entry[data-person='nandi'] { order: 1; }
    .team-entry[data-person='david'] { order: 2; }
    .team-entry[data-person='fabiola'] { order: 3; }
  }

  /* Editorial entry: a rule, a name, a measured column. --entry is the
     entrance slide, --lift the hover/focus raise — separate vars so the
     two motions compose instead of fighting. */
  .team-entry {
    --entry: 18px;
    --lift: 0px;
    opacity: 0;
    transform: translateY(calc(var(--entry) + var(--lift)));
    transition:
      opacity 440ms var(--ease-out),
      transform 300ms var(--ease-out);
  }

  /* Hi-vis orange at rest — the palette's third voice — as a small
     taped-on tab: orange fill, hard charcoal border, press shadow.
     Raw orange lines are out by captain decision (round 13); orange
     only appears as a bordered object. Warms to yellow (the loudest
     colour) when the person is chosen. */
  .team-entry::before {
    content: '';
    display: block;
    width: 3.2rem;
    height: 0.85rem;
    background: var(--orange);
    border: 2px solid var(--charcoal);
    border-radius: 3px;
    box-shadow: var(--press-sm);
    transform: rotate(-2deg);
    margin-bottom: 1.15rem;
    transition: background 300ms var(--ease-out);
  }

