---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { team } from '../lib/team';
import groupPhoto from '../assets/film-group-pic-1.jpg';

/**
 * The hero renders a fixed vertical crop of the landscape group shot:
 * the top 9% (empty trees) and bottom 5% (rock) go, which buys back
 * ~130px of viewport at 1440px so the bio row enters the first
 * screenful sooner. The crop is a build-time constant — never a
 * viewport-dependent object-fit — so person coordinates stay exact:
 * py() remaps a y-percentage of the full frame into the cropped frame.
 */
const CROP = { top: 9, height: 86 };
const py = (y: number) => Math.min(100, Math.max(0, ((y - CROP.top) / CROP.height) * 100));

/**
 * Photo geometry per person, left to right as seated in the group
 * photo. Names, roles, bios, and social links live in src/lib/team.ts
 * (shared with the /about/{person} pages); only the About-page-specific
 * presentation lives here.
 * - face/band: hotspot geometry in % of the full (uncropped) photo
 *   frame — the template remaps y through py(). The photograph itself
 *   is always fully lit (the round-13 captain call retired the radial
 *   spotlight veil); interaction illuminates the person's name chip.
 */
const geometry: Record<string, {
  face: { x: number; y: number };
  band: { x1: number; x2: number; y1: number; y2: number };
}> = {
  nandi: {
    face: { x: 29.5, y: 26.5 },
    band: { x1: 18, x2: 43, y1: 13, y2: 97 },
  },
  david: {
    face: { x: 47.2, y: 26.5 },
    band: { x1: 43, x2: 54.5, y1: 18, y2: 100 },
  },
  fabiola: {
    face: { x: 60.5, y: 31.5 },
    band: { x1: 54.5, x2: 74.5, y1: 24, y2: 92 },
  },
};

const people = team.map((p) => ({ ...p, ...geometry[p.id] }));

/**
 * Bio order is fixed: David leads, then Nandi, then Fabiola — the
 * captain's "always" order for mobile. Desktop restores photo order
 * (Nandi/David/Fabiola) with CSS `order` so the columns still map
 * onto the photograph left-to-right; DOM (and screen-reader) order
 * stays David-first, the primary bio.
 */
const bioOrder = ['david', 'nandi', 'fabiola']
  .map((id) => people.find((p) => p.id === id)!);

---

<BaseLayout
  title="About — Trash Talk NYC"
  description="Meet Trash Talk NYC — a grassroots initiative cleaning New York City through fun volunteer cleanup events, community engagement, and educational entertainment."
  showSocialBar={false}
>

  <!-- HERO + BIOS share a wrapper so the hero can pin (mobile) exactly
       while the bios scroll past it, then release before the closing
       cleanup photographs. -->
  <div class="team-flow">

    <!-- TEAM PHOTO — the page opens on one photograph, no headline.
         "About" rides it as a chip in the same translucent-paper family
         as the name chips. Each person is a focusable hotspot: hover,
         focus, or scrolling to their bio illuminates their name chip
         (the photograph itself always stays fully lit); activating
         scrolls to their bio. -->
    <section class="team-hero">
      <div class="tape-seam" aria-hidden="true"></div>
      <figure class="team-figure">
        <div class="team-crop" id="teamCrop">
          <Image
            src={groupPhoto}
            alt="Nandi, David and Fabiola — the Trash Talk NYC team — sitting together on a rock in a park"
            class="team-photo"
            width={2560}
            widths={[640, 960, 1280, 1600, 2048, 2560]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
          <h1 class="about-chip" data-en="About" data-es="Sobre Nosotros">About</h1>
          {people.map((p) => (
            <span class="face-marker" data-person={p.id} style={`left:${p.face.x}%; top:${py(p.face.y + 34)}%;`} aria-hidden="true">{p.name}</span>
          ))}
          {people.map((p) => (
            <button
              type="button"
              class="hotspot"
              data-person={p.id}
              style={`left:${p.band.x1}%; width:${p.band.x2 - p.band.x1}%; top:${py(p.band.y1)}%; height:${py(p.band.y2) - py(p.band.y1)}%;`}
            >
              <span class="sr-only" data-en={`Show ${p.name}'s bio`} data-es={`Mostrar la biografía de ${p.name}`}>Show {p.name}'s bio</span>
            </button>
          ))}
        </div>
      </figure>
      <div class="tape-seam" aria-hidden="true"></div>
    </section>

    <!-- BIOS — editorial: a charcoal rule, the name large with the
         marker swipe, the bio in a measured column. All three always
         readable; the photo interactions only highlight, never gate.
         The intro blurb runs first: it introduces the crew collectively
         AND buys the resting, fully-lit photo more scroll runway on
         mobile before the first bio takes the spotlight. -->
    <section class="team-section grid-paper">
      <div class="team-intro">
        <p data-en="Three of us, one crew. We pick up New York block by block — cleanups anyone can join, filmed so the whole city catches on. Meet the people behind the grabbers." data-es="Somos tres, un solo equipo. Levantamos Nueva York cuadra por cuadra — limpiezas abiertas a cualquiera, filmadas para que toda la ciudad se sume. Conoce a la gente detrás de las pinzas.">Three of us, one crew. We pick up New York block by block — cleanups anyone can join, filmed so the whole city catches on. Meet the people behind the grabbers.</p>
      </div>
      <div class="team-cards" id="teamCards">
        {bioOrder.map((p, i) => (
          <article class="team-entry" data-person={p.id} data-index={i}>
            {/* Interaction model (round 17): the NAME is the one link to
                the person's page — the round-14 arrow and whole-block
                click are gone (redundant beside a named link, and the
                block click made text selection worse). Hover/focus
                anywhere in the block still illuminates the person's tag
                on the photo (bidirectional with the face hotspots). */}
            <h2 class="team-name">
              <a href={`/about/${p.id}`}>
                <mark>{p.name}</mark>
                <span class="sr-only" data-en={`— open ${p.name}'s page`} data-es={`— abrir la página de ${p.name}`}>— open {p.name}'s page</span>
              </a>
            </h2>
            <p class="team-role" data-en={p.role.en} data-es={p.role.es}>{p.role.en}</p>
            <div class="team-bio">
              {p.bio.map((b) => (
                b.parts ? (
                  <p>
                    {b.parts.map((seg) =>
                      seg.href
                        ? <a href={seg.href} data-en={seg.en} data-es={seg.es}>{seg.en}</a>
                        : <span data-en={seg.en} data-es={seg.es}>{seg.en}</span>
                    )}
                  </p>
                ) : (
                  <p data-en={b.en} data-es={b.es}>{b.en}</p>
                )
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

  </div>

  <!-- CLOSING CTA (round 19) — the page's one closer: it absorbs and
       replaces the round-15 pointer band rather than standing beside
       it. The id is a stable contract: the Contact page banner
       (another crewmate's branch) links to /about#join-the-team, so it
       must stay until that banner is repointed at /contact/join. -->
  <section class="close-cta diag-texture" id="join-the-team">
    <div class="tape-seam" aria-hidden="true"></div>
    <div class="close-cta-inner">
      <p class="sticker close-cta-eyebrow" style="--tilt: 2deg" data-en="Now recruiting" data-es="Estamos reclutando">Now recruiting</p>
      <h2 class="close-cta-title" data-en="Want to lend a hand?" data-es="¿Quieres echar una mano?">Want to lend a hand?</h2>
      <p class="close-cta-sub" data-en="We're expanding — more blocks, more projects, more crew." data-es="Estamos creciendo — más cuadras, más proyectos, más equipo.">We're expanding — more blocks, more projects, more crew.</p>
      <a class="close-cta-btn" href="/contact/join">
        <span data-en="Join the team" data-es="Únete al equipo">Join the team</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* ── PHOTO HERO ── */
  .team-hero {
    background: var(--charcoal);
  }

  /* Mobile: the taped photo plate pins under the nav while the bios
     scroll past beneath it, so the scroll-driven spotlight is always
     visible while reading. The wrapper ends after the bios, which
     releases the pin before the closing photographs. Desktop keeps
     normal flow — the hero is most of a screenful there, and its lower
     half stays naturally visible while the bio row is read. */
  @media (max-width: 700px) {
    .team-hero {
      position: sticky;
      top: var(--nav-h);
      z-index: 2;
    }

    /* Phased scroll: while the photo is pinned, the bios arrive as
       beats — the second and third bios snap in under the plate with
       `scroll-snap-stop: always`, so momentum can't blow past a person
       and the light walks in deliberate steps. `proximity` (never
       mandatory) so leaving the section stays effortless: past the
       last bio there are no snap areas and the page scrolls freely.

       Two deliberate omissions, learned the hard way:
       - NO snap-align on the wrapper or the first bio. The landing
         screen (photo + first bio's opening) IS the first beat — the
         first bio's aligned position sits ~18px below scrollY 0, so
         giving it a snap position risks a load-time re-snap that would
         light him up at rest (the captain wants nobody lit on landing)
         and would trap the first flick at a standstill.
       - NEVER put snap-align on an ancestor taller than the viewport
         (we tried .team-flow): Chrome treats an oversized snap area as
         a RANGE of valid positions that swallows every per-bio snap
         position inside it, and the range's end becomes a phantom
         attractor mid-band. */
    :global(html) {
      scroll-snap-type: y proximity;
    }

    .team-entry:not(:first-child) {
      scroll-snap-align: start;
      scroll-snap-stop: always;
      /* Pinned plate = two 8px seams + the 57.0103vw photo crop
         (100vw × 3318/5820). +4px so the snapped position lands exactly
         on scrollToEntry's target: the html scroll-padding already
         contributes nav + 12px, and nav + plate + 16px is the JS
         offset — keeping the two equal stops tap-to-scroll from being
         re-snapped somewhere else afterwards. */
      scroll-margin-top: calc(57.0103vw + 20px);
    }
  }

  .team-figure {
    line-height: 0;
  }

  /* Fixed build-time crop (see CROP in frontmatter): the wrapper's
     aspect ratio is the source 5820:3858 with 14% of the height
     removed, and the image is shifted up by the cropped top band.
     Everything positioned inside uses py()-remapped percentages. */
  .team-crop {
    position: relative;
    overflow: hidden;
    /* 3858 × 0.86 */
    aspect-ratio: 5820 / 3318;
  }

  .team-crop .team-photo {
    position: absolute;
    left: 0;
    width: 100%;
    height: auto;
    /* 9% of image height as a fraction of the cropped height */
    top: calc(-9% / 0.86);
  }

  .hotspot {
    position: absolute;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* The illuminated name chip IS the focus indicator for these buttons
     (set from the focus listener, with an extra solid ring for
     keyboard focus — see .face-marker.is-focus); the global purple
     ring is intentionally suppressed here at the captain's direction. */
  .hotspot:focus-visible {
    outline: none;
  }

  /* The signature: translucent paper name-chips pinned at chest
     height, always visible on every device. Quiet by design — the
     look is captain-approved, do not restyle.
     Sizing scales with the viewport (= the full-bleed photo) so the
     chips hold the same visual weight against the photo at every
     width. The floor is the signed-off phone size (0.55rem at 390px
     ≈ 2.25vw), so mobile renders exactly as before; the ceiling only
     guards ultrawide monitors. Border/radius are in em so the whole
     chip zooms as one object. */
  .face-marker {
    position: absolute;
    transform: translate(-50%, -50%) rotate(-2deg);
    font-family: 'Space Mono', monospace;
    font-size: clamp(0.55rem, 2.25vw, 2.2rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    line-height: 1;
    color: var(--charcoal);
    background: var(--paper-a70);
    border: 0.12em solid rgba(28, 28, 34, 0.35);
    border-radius: 0.35em;
    padding: 0.3em 0.55em;
    pointer-events: none;
    transition:
      translate 200ms var(--ease-out),
      border-color 200ms var(--ease-out),
      background-color 200ms var(--ease-out),
      box-shadow 200ms var(--ease-out);
  }

  /* "Illuminated" chip — the whole interaction language since the
     radial veil retired: the paper turns opaque, the border sets to
     full charcoal, and a warm yellow glow reads as light hitting the
     tag. Quiet on purpose; the lift is em-scaled so it grows with the
     chip. */
  .face-marker.is-active {
    translate: 0 -0.45em;
    background: var(--off-white);
    border-color: var(--charcoal);
    box-shadow:
      0 0 0.4em rgba(245, 208, 0, 0.9),
      0 0 1.1em rgba(245, 208, 0, 0.55);
  }

  /* Keyboard focus = illumination + a solid yellow ring. The glow
     alone is a state, not a focus indicator; the hard ring is the
     smallest addition that is unmistakable at a glance. */
  .face-marker.is-focus {
    box-shadow:
      0 0 0 0.22em var(--yellow),
      0 0 1.1em rgba(245, 208, 0, 0.55);
  }

  /* "About" rides the photo as part of the same paper set; same
     proportional sizing (0.72rem at 390px ≈ 2.95vw).
     It carries a PERMANENT, gentler version of the name tags'
     illumination (opaque paper, solid border, softer glow, no lift):
     it is the page's title, so it is always "on" — hover-only
     illumination would advertise an activation it doesn't have, which
     is exactly the person-tag look the captain said to avoid. */
  .about-chip {
    position: absolute;
    left: 2.2%;
    top: 5.5%;
    transform: rotate(-1.5deg);
    font-family: 'Space Mono', monospace;
    font-size: clamp(0.72rem, 2.95vw, 2.85rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    line-height: 1;
    color: var(--charcoal);
    background: var(--off-white);
    border: 0.09em solid var(--charcoal);
    border-radius: 0.26em;
    padding: 0.4em 0.7em;
    box-shadow:
      0 0 0.35em rgba(245, 208, 0, 0.6),
      0 0 0.9em rgba(245, 208, 0, 0.35);
  }

  /* ── BIOS (editorial) ── */
  .team-section {
    background: var(--off-white);
    padding: var(--space-lg) max(var(--gutter), var(--safe-right)) var(--space-xl) max(var(--gutter), var(--safe-left));
    position: relative;
    overflow: hidden;
  }

  .team-section::before {
    content: '';
    position: absolute;
    left: -10%;
    top: -20%;
    width: 55vw;
    height: 100%;
    background: radial-gradient(ellipse at center, rgba(245, 208, 0, 0.07) 0%, transparent 65%);
    pointer-events: none;
  }

  /* Editorial lede introducing the crew as a whole. On mobile it also
     buys the resting photo more runway: the first bio starts lower, so
     the reader scrolls through neutral ground (nobody spotlighted)
     before David's entry claims the light. */
  .team-intro {
    max-width: var(--container);
    margin: 0 auto var(--space-xl);
    position: relative;
    z-index: 1;
  }

  /* Lede-sized on purpose: the type scale and the space-xl below are
     what buy the resting photo its scroll runway on mobile — shrink
     either and David's spotlight fires almost immediately again. */
  .team-intro p {
    font-size: var(--step-2);
    font-weight: 800;
    color: var(--charcoal);
    line-height: 1.45;
    max-width: 40ch;
  }

  .team-cards {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: var(--space-lg);
    align-items: start;
    position: relative;
    z-index: 1;
  }

  /* DOM order is David → Nandi → Fabiola (the captain's fixed mobile
     order, and the reading order). Desktop restores photo order
     left-to-right so the columns map onto the photograph. */
  @media (min-width: 701px) {
    .team-entry[data-person='nandi'] { order: 1; }
    .team-entry[data-person='david'] { order: 2; }
    .team-entry[data-person='fabiola'] { order: 3; }
  }

  /* Editorial entry: a rule, a name, a measured column. --entry is the
     entrance slide, --lift the hover/focus raise — separate vars so the
     two motions compose instead of fighting. */
  .team-entry {
    --entry: 18px;
    --lift: 0px;
    opacity: 0;
    transform: translateY(calc(var(--entry) + var(--lift)));
    transition:
      opacity 440ms var(--ease-out),
      transform 300ms var(--ease-out);
  }

  /* Hi-vis orange at rest — the palette's third voice — as a small
     taped-on tab: orange fill, hard charcoal border, press shadow.
     Raw orange lines are out by captain decision (round 13); orange
     only appears as a bordered object. Warms to yellow (the loudest
     colour) when the person is chosen. */
  .team-entry::before {
    content: '';
    display: block;
    width: 3.2rem;
    height: 0.85rem;
    background: var(--orange);
    border: 2px solid var(--charcoal);
    border-radius: 3px;
    box-shadow: var(--press-sm);
    transform: rotate(-2deg);
    margin-bottom: 1.15rem;
    transition: background 300ms var(--ease-out);
  }

  .team-entry.visible { opacity: 1; --entry: 0px; }

  /* Hover/focus on a face raises that entry, and its tab answers in
     yellow; the other two step back gently. Resting state stays at
     full strength. */
  .team-entry.is-raised {
    --lift: -8px;
  }

  .team-entry.is-raised::before {
    background: var(--yellow);
  }

  .team-entry.is-receded {
    --lift: 2px;
    opacity: 0.8;
  }

  .team-name {
    font-family: 'Nunito', sans-serif;
    font-size: var(--step-3);
    font-weight: 800;
    color: var(--charcoal);
    line-height: 1;
    letter-spacing: -0.01em;
    margin-bottom: 0.35rem;
  }

  /* The name links through to the person's own page; the marker swipe
     stays, and on hover the swipe floods to a full highlight so the
     link affordance reads without adding an underline. */
  .team-name a {
    color: inherit;
    text-decoration: none;
  }

  /* Marker-highlight swipe behind the name */
  .team-name mark {
    color: inherit;
    background: linear-gradient(transparent 52%, var(--yellow) 52%, var(--yellow) 94%, transparent 94%);
    padding-inline: 0.08em;
    transition: background-color 160ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .team-name a:hover mark {
      background-color: var(--yellow);
    }
  }

  /* Role dash — charcoal since round 13 (raw orange lines are out and
     a 3px dash can't carry a border; the orange tab above the name is
     the entry's orange now) */
  .team-role::before {
    content: '';
    display: inline-block;
    width: 1.1rem;
    height: 3px;
    background: var(--charcoal);
    border-radius: 2px;
    margin-right: 0.55rem;
    vertical-align: 0.18em;
  }

  .team-role {
    font-family: 'Space Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--warm-gray);
    margin-bottom: 1.1rem;
  }

  .team-bio {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .team-bio p {
    font-size: 0.92rem;
    font-weight: 600;
    color: #4a4850;
    line-height: 1.7;
    max-width: 38ch;
  }

  /* Inline links inside bio copy (e.g. Fabiola's "please get in
     touch"): purple with the yellow marker underline — noticeable in a
     paragraph without shouting */
  .team-bio a {
    color: var(--purple);
    text-decoration: none;
    border-bottom: 2px solid var(--yellow);
    transition: color 160ms var(--ease-out), border-color 160ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .team-bio a:hover { color: var(--purple-light); border-color: var(--purple-light); }
  }

  /* ── CLOSING CTA (the join route, findable from the page itself;
        the Join the Team content lives at /contact/join) ── */
  .close-cta {
    background: var(--charcoal);
    position: relative;
    overflow: hidden;
  }

  .close-cta-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-xl) max(var(--gutter), var(--safe-right)) var(--space-xl) max(var(--gutter), var(--safe-left));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .close-cta-eyebrow { margin-bottom: 0.4rem; }

  .close-cta-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: var(--step-3);
    line-height: 1;
    letter-spacing: 0.05em;
    color: var(--off-white);
    text-shadow: 3px 3px 0 rgba(107, 63, 160, 0.55);
  }

  .close-cta-sub {
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--paper-a70);
    max-width: 44ch;
    line-height: 1.6;
  }

  /* Primary action: yellow plate, charcoal border, purple press (the
     dark-section press convention) */
  .close-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 0.7rem;
    background: var(--yellow);
    color: var(--charcoal);
    font-family: 'Space Mono', monospace;
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    padding: 0.9em 1.5em;
    min-height: var(--tap);
    border: 3px solid var(--charcoal);
    border-radius: var(--radius-sm);
    box-shadow: 5px 5px 0 var(--purple-light);
    transform: rotate(-1deg);
    transition: transform 0.15s var(--ease-out), box-shadow 0.15s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .close-cta-btn:hover {
      transform: rotate(0deg) translate(2px, 2px);
      box-shadow: 3px 3px 0 var(--purple-light);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-entry {
      transition: none;
      opacity: 1;
      --entry: 0px;
      --lift: 0px !important;
    }
    /* The chip illumination still switches — only its motion is removed */
    .face-marker { transition: none; }
    .close-cta-btn { transition: none; }
  }
</style>

<script>
  const entryEls = Array.from(document.querySelectorAll<HTMLElement>('.team-entry'));
  const entries = new Map(entryEls.map((el) => [el.dataset.person, el]));
  const markers = new Map(
    Array.from(document.querySelectorAll<HTMLElement>('.face-marker')).map((el) => [el.dataset.person, el]),
  );
  const hero = document.querySelector<HTMLElement>('.team-hero');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Two independent sources drive the name-chip illumination (the
  // photograph itself always stays fully lit):
  // - pointerId: hover or keyboard focus on a face (wins while active,
  //   and additionally raises that person's bio entry)
  // - scrollId: which bio currently owns the viewport (stacked layouts
  //   only — in the desktop 3-column row no single bio owns the scroll)
  let pointerId: string | null = null;
  let focusStrong = false;
  let scrollId: string | null = null;

  function render() {
    const id = pointerId ?? scrollId;
    markers.forEach((marker, key) => {
      marker.classList.toggle('is-active', key === id);
      marker.classList.toggle('is-focus', key === id && pointerId !== null && focusStrong);
    });
    entries.forEach((entry, key) => {
      entry.classList.toggle('is-raised', pointerId !== null && key === pointerId);
      entry.classList.toggle('is-receded', pointerId !== null && key !== pointerId);
    });
  }

  // ── Scroll ownership ──
  // A bio owns the viewport while the 55%-height line sits inside it;
  // in the gaps the previous owner holds on (the line's crossing of
  // the next entry's top is the single, monotone handover point — no
  // flicker). Above the first bio and well past the last one, nobody
  // owns and no name chip is illuminated.
  let stacked = false;

  function computeStacked() {
    const els = Array.from(entries.values());
    stacked = els.length > 1 && Math.abs(els[0].offsetLeft - els[1].offsetLeft) < 4;
  }

  function ownerFromScroll(): string | null {
    if (!stacked) return null;
    // At page open no chip is illuminated — nobody owns the scroll
    // until the reader actually moves toward a bio; returning to the
    // very top restores that resting state. 8px separates "landed"
    // from "reading".
    if (window.scrollY < 8) return null;
    const line = window.innerHeight * 0.55;
    let owner: string | null = null;
    let ownerTop = -Infinity;
    let lastKey: string | null = null;
    let lastRect: DOMRect | null = null;
    entries.forEach((el, key) => {
      const r = el.getBoundingClientRect();
      if (r.top <= line && r.top > ownerTop) {
        owner = key ?? null;
        ownerTop = r.top;
      }
      if (!lastRect || r.top > lastRect.top) {
        lastRect = r;
        lastKey = key ?? null;
      }
    });
    if (owner !== null && owner === lastKey && lastRect && (lastRect as DOMRect).bottom + 120 < line) {
      return null;
    }
    return owner;
  }

  let scrollTick = false;
  function onScroll() {
    if (scrollTick) return;
    scrollTick = true;
    requestAnimationFrame(() => {
      scrollTick = false;
      const owner = ownerFromScroll();
      if (owner !== scrollId) {
        scrollId = owner;
        render();
      }
    });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', () => { computeStacked(); onScroll(); });
  computeStacked();
  onScroll();

  // Scroll the chosen entry's top under the sticky chrome. Walks the
  // offset chain (transform-proof) and accounts for the pinned photo
  // plate on mobile, which scrollIntoView knows nothing about.
  function scrollToEntry(el: HTMLElement) {
    let y = 0;
    for (let n: Element | null = el; n instanceof HTMLElement; n = n.offsetParent) y += n.offsetTop;
    const navH = document.querySelector('nav')?.getBoundingClientRect().height ?? 70;
    const pinned = hero && getComputedStyle(hero).position === 'sticky' ? hero.offsetHeight : 0;
    window.scrollTo(0, Math.max(0, y - navH - pinned - 16));
  }

  document.querySelectorAll<HTMLButtonElement>('.hotspot').forEach((btn) => {
    const id = btn.dataset.person ?? null;
    if (!id) return;
    // pointerType check keeps hover states off touch devices, where a
    // tap would otherwise leave a person stuck in the spotlight
    btn.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      pointerId = id;
      focusStrong = false;
      render();
    });
    btn.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      pointerId = null;
      render();
    });
    // The spotlight is the focus indicator (the ring is suppressed in
    // CSS): keyboard focus lights the person with a deeper veil
    btn.addEventListener('focus', () => {
      pointerId = id;
      focusStrong = btn.matches(':focus-visible');
      render();
    });
    btn.addEventListener('blur', () => {
      pointerId = null;
      focusStrong = false;
      render();
    });
    // Activating a face takes you to that bio; the scroll handler then
    // hands the spotlight to the same person, so the state is stable
    btn.addEventListener('click', () => {
      const entry = entries.get(id);
      if (entry) scrollToEntry(entry);
    });
  });

  // ── Bidirectional hover (round 14, click-through removed round 17) ──
  // Hovering or keyboard-focusing a bio block illuminates that person's
  // name tag exactly like hovering their face. Navigation is the NAME
  // link only (captain, round 17) — the block-level click handler was
  // removed as redundant beside it, which also gives text selection
  // back its ordinary behavior. Mobile scroll illumination is untouched
  // (mouse-only pointer guards, same as the photo hotspots).
  entries.forEach((el, id) => {
    if (!id) return;
    el.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      pointerId = id;
      focusStrong = false;
      render();
    });
    el.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      if (pointerId === id) {
        pointerId = null;
        render();
      }
    });
    el.addEventListener('focusin', () => {
      pointerId = id;
      focusStrong = false;
      render();
    });
    el.addEventListener('focusout', (e) => {
      if (el.contains(e.relatedTarget as Node)) return;
      if (pointerId === id) {
        pointerId = null;
        render();
      }
    });
  });

  // Staggered entrance, delayed in JS rather than transition-delay so
  // the same transform transition can serve the hover lift undelayed
  const entryObserver = new IntersectionObserver((observed) => {
    observed.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      const delay = reduceMotion.matches ? 0 : Number(el.dataset.index ?? 0) * 90;
      window.setTimeout(() => el.classList.add('visible'), delay);
      entryObserver.unobserve(el);
    });
  }, { threshold: 0.1 });

  entryEls.forEach((el) => entryObserver.observe(el));
</script>
