---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { team } from '../lib/team';
import groupPhoto from '../assets/film-group-pic-1.jpg';
import vestSticker from '../assets/vest-sticker.png';
import bricksTop from '../assets/bricks-top-lav.svg';
import bricksBottom from '../assets/bricks-bottom-lav.svg';
import illFamilyVests from '../assets/ill-family-vests-beige.svg';

/**
 * The Team — the group photo pasted up like a poster inside the brick
 * frame, then the three wheatpasted bio sheets in photo order on
 * desktop (Nandi, David, Fabiola) and David-first on phones (CSS
 * order), each with a round face chip cropped from the group photo.
 * Bios come verbatim from src/lib/team.ts — never edit them here.
 *
 * The face-chip crops are background-size/-position percentages tuned
 * by eye against the group photo in the approved mockups; they are
 * resolution-independent, so the optimized build asset works the same.
 */
const faceCrops: Record<string, { size: string; position: string }> = {
  david: { size: '400% auto', position: '46.3% 27.5%' },
  nandi: { size: '360% auto', position: '21.6% 29.3%' },
  fabiola: { size: '360% auto', position: '67.3% 39.7%' },
};

// One mid-size rendition for the face chips (they show a ~70px circle,
// but the crop zooms 3.6–4×, so a 1200px frame keeps faces sharp).
const faceImage = await getImage({ src: groupPhoto, width: 1200 });
---

<BaseLayout
  title="About — Trash Talk NYC"
  description="Meet Trash Talk NYC, a grassroots initiative cleaning New York City through fun volunteer cleanup events, community engagement, and educational entertainment."
>
  <!-- HERO: group photo in the brick frame -->
  <section class="tm-hero">
    <img class="bricks bricks-top" src={bricksTop.src} alt="" />
    <img class="bricks bricks-bottom" src={bricksBottom.src} alt="" />
    <div class="tm-hero-inner">
      <h1 class="tm-title" data-en="About" data-es="Nosotros">About</h1>
      <figure class="tm-photo paste">
        <Image src={vestSticker} alt="" class="slap tm-slap" width={92} densities={[1, 2]} />
        <Image
          src={groupPhoto}
          alt="Nandi, David, and Fabiola sitting together on a rock in a park"
          class="pic"
          width={1280}
          widths={[640, 960, 1280]}
          sizes="(min-width: 761px) 640px, 100vw"
          loading="eager"
        />
        <figcaption><span>Nandi</span><span>David</span><span>Fabiola</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap team-section">
    <p class="intro" data-en="This is us!" data-es="¡Estos somos nosotros!">This is us!</p>
    <div class="bios">
      {team.map((p) => (
        <article class:list={['bio', 'paste', `b-${p.id}`]}>
          <div class="who">
            <span
              class="face"
              style={`background-image:url(${faceImage.src});background-size:${faceCrops[p.id]?.size};background-position:${faceCrops[p.id]?.position}`}
              aria-hidden="true"
            ></span>
            <h2>{p.name}</h2>
            <span class="role mono" data-en={p.role.en} data-es={p.role.es}>{p.role.en}</span>
          </div>
          {p.bio.map((b) =>
            b.parts ? (
              <p>
                {b.parts.map((seg) =>
                  seg.href
                    ? <a href={seg.href} data-en={seg.en} data-es={seg.es}>{seg.en}</a>
                    : <span data-en={seg.en} data-es={seg.es}>{seg.en}</span>
                )}
              </p>
            ) : (
              <p data-en={b.en} data-es={b.es}>{b.en}</p>
            )
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- Closing hand-off to the recruitment page. Old emails linked
       /about#join-the-team; keep the anchor landing here. -->
  <section class="lend" id="join-the-team">
    <div class="wrap lend-grid">
      <img class="ill" src={illFamilyVests.src} alt="" />
      <div>
        <h2 data-en="Want to lend a hand?" data-es="¿Quieres echar una mano?">Want to lend a hand?</h2>
        <p data-en="We need your help!" data-es="¡Necesitamos tu ayuda!">We need your help!</p>
        <a class="btn btn-primary" href="/recruit" data-en="See the open roles →" data-es="Ver los puestos abiertos →">See the open roles →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── HERO ── */
  .tm-hero {
    position: relative;
    overflow: hidden;
    border-bottom: var(--ink);
  }

  .tm-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 820px;
    margin-inline: auto;
    display: grid;
    gap: 16px;
    justify-items: center;
    padding: calc(100vw * 0.15) 22px calc(100vw * 0.15);
  }

  .tm-title { font-size: 4rem; color: var(--lavender); }

  .tm-photo {
    position: relative;
    width: min(640px, 100%);
    margin: 0;
    background-color: var(--paper);
    color: var(--black);
    padding: 10px 10px 12px;
  }

  .tm-photo :global(.pic) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }

  .tm-photo figcaption {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-top: 10px;
    font-family: var(--mono);
    font-weight: 700;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
  }

  .tm-photo :global(.tm-slap) {
    top: -28px;
    right: -8px;
    width: 66px;
    height: auto;
    transform: rotate(10deg);
  }

  @media (min-width: 761px) {
    .tm-hero-inner { gap: 22px; padding: calc(100vw * 0.08) 16px calc(100vw * 0.08); }
    .tm-title { font-size: clamp(4.4rem, 8vw, 7rem); }
    .tm-photo { padding: 14px 14px 18px; }
    .tm-photo figcaption { font-size: 0.72rem; }

    .tm-photo :global(.tm-slap) {
      top: -38px;
      right: -26px;
      width: 92px;
    }
  }

  /* ── BIOS ── */
  .intro {
    font-family: var(--display);
    font-weight: 400;
    font-size: 2.3rem;
    color: var(--beige);
    margin: 0;
    padding-block: 36px 16px;
  }

  .bios {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    padding-bottom: 44px;
    align-items: start;
  }

  .bio {
    background-color: var(--paper);
    color: var(--black);
    padding: 22px 18px;
    display: grid;
    gap: 12px;
  }

  .bio .who {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .bio .who .role { margin-left: auto; color: var(--green); }

  .face {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    border: 2.5px solid var(--black);
    background-repeat: no-repeat;
    flex: none;
  }

  .bio h2 { font-size: 2.4rem; color: var(--purple); }
  .bio p { margin: 0; font-size: 1.05rem; line-height: 1.55; }
  .bio a { color: var(--purple); font-weight: 700; }

  /* Photo order on desktop, David first on phones */
  .b-david { order: 1; }
  .b-nandi { order: 2; }
  .b-fabiola { order: 3; }

  @media (min-width: 761px) {
    .intro { font-size: clamp(2.4rem, 4vw, 3.2rem); padding-block: 52px 22px; }
    .bios { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 26px; padding-bottom: 64px; }
    .bio { padding: 26px 24px 24px; }
    .bio h2 { font-size: 2.8rem; }
    .b-nandi { order: 1; }
    .b-david { order: 2; }
  }

  /* ── LEND A HAND ── */
  .lend {
    background-color: var(--green);
    color: var(--beige);
    padding-block: 40px;
  }

  .lend-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    align-items: center;
  }

  .lend .ill {
    width: 140px;
    height: 110px;
    object-fit: cover;
    object-position: center 55%;
  }

  .lend h2 { font-size: 2.8rem; }
  .lend p { margin: 12px 0 26px; font-size: 1.2rem; font-weight: 600; }
  .lend .btn { width: 100%; }

  @media (min-width: 761px) {
    .lend { padding-block: 56px; }
    .lend-grid { grid-template-columns: auto minmax(0, 1fr); gap: 40px; }
    .lend .ill { width: 200px; height: 170px; }
    .lend h2 { font-size: clamp(2.8rem, 5vw, 4.2rem); }
    .lend .btn { width: auto; }
  }
</style>
