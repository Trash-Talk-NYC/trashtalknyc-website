---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SocialLinks from '../components/SocialLinks.astro';
import davidPhoto from '../assets/IMG_0952_Original.jpeg';
---

<BaseLayout
  title="About — Trash Talk NYC"
  description="Meet Trash Talk NYC — a grassroots initiative cleaning New York City through fun volunteer cleanup events, community engagement, and educational entertainment."
  showSocialBar={false}
>

  <PageHero eyebrowEn="About" eyebrowEs="Sobre Nosotros" word="ABOUT">
    <span data-en="WE KEEP" data-es="MANTENEMOS">WE KEEP</span><br /><span class="accent" data-en="NYC CLEAN" data-es="NYC LIMPIA">NYC CLEAN</span>
  </PageHero>

  <!-- DAVID -->
  <section class="david-section">
    <div class="david-inner">

      <div>
        <div class="david-photo" id="davidPhoto">
          <!-- 1140px wide keeps the CSS square crop sharp at 2x on the
               ~380px polaroid (height scales to ~760px) -->
          <Image src={davidPhoto} alt="David, organizer of Trash Talk NYC" class="david-img" width={1140} />
          <div class="david-tag" data-en="Organizer" data-es="Organizador">Organizer</div>
        </div>
      </div>

      <div class="david-text">
        <div class="david-name" id="davidName"><mark>David</mark></div>
        <div class="david-role" id="davidRole" data-en="Organizer" data-es="Organizador">Organizer</div>
        <div class="david-divider" id="davidDivider"></div>

        <div class="david-bio">
          <p id="davidP1" data-en="Trash Talk is my grassroots social media initiative to clean New York through educational entertainment." data-es="Trash Talk es mi iniciativa de base impulsada por las redes sociales para limpiar Nueva York a través del entretenimiento educativo.">Trash Talk is my grassroots social media initiative to clean New York through educational entertainment.</p>
          <p id="davidP2" data-en="By growing a national and international following, I hope to clean my neighborhood and the city through fun volunteer events and community engagement. Funds for the projects come from donations and sponsorships." data-es="Al generar una comunidad de seguidores a nivel nacional e internacional, espero limpiar mi vecindario y la ciudad a través de eventos de voluntariado divertidos y la participación comunitaria. Los fondos para los proyectos se reciben mediante donaciones y patrocinios.">By growing a national and international following, I hope to clean my neighborhood and the city through fun volunteer events and community engagement. Funds for the projects come from donations and sponsorships.</p>
          <p id="davidP3" data-en="This is an incredibly complex and exciting project, and I hope you'll join us to clean New York!" data-es="¡Este es un proyecto increíblemente complejo y emocionante, y espero que te unas a nosotros para limpiar Nueva York!">This is an incredibly complex and exciting project, and I hope you'll join us to clean New York!</p>
        </div>

        <div class="david-socials" id="davidIg">
          <SocialLinks />
        </div>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  /* ── DAVID SECTION ── */
  .david-section {
    background: var(--off-white);
    padding: var(--space-xl) max(var(--gutter), var(--safe-right)) var(--space-xl) max(var(--gutter), var(--safe-left));
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid #ddd9d0;
  }

  .david-section::before {
    content: '';
    position: absolute;
    left: -10%;
    top: -20%;
    width: 55vw;
    height: 100%;
    background: radial-gradient(ellipse at center, rgba(245, 208, 0, 0.07) 0%, transparent 65%);
    pointer-events: none;
  }

  .david-section::after {
    content: '';
    position: absolute;
    right: -5%;
    bottom: -20%;
    width: 40vw;
    height: 80%;
    background: radial-gradient(ellipse at center, rgba(155, 93, 229, 0.06) 0%, transparent 65%);
    pointer-events: none;
  }

  .david-inner {
    max-width: 960px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: clamp(220px, 26vw, 280px) 1fr;
    gap: var(--space-lg);
    align-items: flex-start;
    position: relative;
    z-index: 1;
  }

  @media (max-width: 700px) {
    .david-inner { grid-template-columns: 1fr; }
    .david-photo { max-width: min(280px, 70vw); }
  }

  /* Polaroid treatment: white frame with a deep bottom lip, tilted,
     pinned to the page with two tape strips */
  .david-photo {
    width: 100%;
    position: relative;
    background: #fff;
    border: 1px solid #d8d3c8;
    border-radius: 4px;
    padding: 0.7rem 0.7rem 3rem;
    box-shadow: var(--press);
    opacity: 0;
    transform: rotate(-2deg) translateY(24px) scale(0.97);
    transition: opacity 500ms var(--ease-out), transform 500ms var(--ease-out);
  }

  .david-photo.visible { opacity: 1; transform: rotate(-2deg) translateY(0) scale(1); }

  .david-photo::before,
  .david-photo::after {
    content: '';
    position: absolute;
    top: -0.8rem;
    width: 4.5rem;
    height: 1.6rem;
    background: rgba(245, 208, 0, 0.75);
    border: 1px solid rgba(201, 169, 0, 0.4);
  }

  .david-photo::before { left: 8%; transform: rotate(-6deg); }
  .david-photo::after { right: 8%; transform: rotate(5deg); }

  /* Class instead of a bare img selector: the element is rendered by
     astro:assets' <Image>, so it only picks up this page's scoped style
     via the class we pass through */
  .david-photo .david-img {
    width: 100%;
    /* Override the height="" attribute <Image> emits, or the square
       aspect-ratio crop below never kicks in */
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center 20%;
    display: block;
  }

  .david-tag {
    position: absolute;
    bottom: 0.85rem;
    left: 50%;
    background: transparent;
    color: var(--charcoal);
    font-family: 'Space Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    opacity: 0;
    transform: translate(-50%, 6px);
    transition: opacity 300ms 200ms var(--ease-out), transform 300ms 200ms var(--ease-out);
  }

  .david-photo.visible .david-tag { opacity: 1; transform: translate(-50%, 0); }

  .david-text { padding-top: 0.5rem; }

  .david-name {
    font-family: 'Nunito', sans-serif;
    font-size: var(--step-4);
    font-weight: 800;
    color: var(--charcoal);
    line-height: 1;
    letter-spacing: -0.01em;
    margin-bottom: 0.25rem;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 440ms 60ms var(--ease-out), transform 440ms 60ms var(--ease-out);
  }

  /* Marker-highlight swipe behind the name */
  .david-name mark {
    color: inherit;
    background: linear-gradient(transparent 52%, var(--yellow) 52%, var(--yellow) 94%, transparent 94%);
    padding-inline: 0.08em;
  }

  .david-name.visible { opacity: 1; transform: translateY(0); }

  .david-role {
    font-family: 'Nunito', sans-serif;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--warm-gray);
    margin-bottom: 2rem;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 400ms 100ms var(--ease-out), transform 400ms 100ms var(--ease-out);
  }

  .david-role.visible { opacity: 1; transform: translateY(0); }

  .david-divider {
    height: 2px;
    background: linear-gradient(90deg, var(--purple-light), transparent);
    border-radius: 2px;
    margin-bottom: 1.75rem;
    opacity: 0;
    width: 0;
    transition: opacity 400ms 130ms var(--ease-out), width 500ms 130ms var(--ease-out);
  }

  .david-divider.visible { opacity: 1; width: 2.5rem; }

  .david-bio { display: flex; flex-direction: column; gap: 1rem; }

  .david-bio p {
    font-size: 0.97rem;
    font-weight: 600;
    color: #4a4850;
    line-height: 1.8;
    max-width: 62ch;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 380ms var(--ease-out), transform 380ms var(--ease-out);
  }

  .david-bio p.visible { opacity: 1; transform: translateY(0); }
  .david-bio p:nth-child(1) { transition-delay: 150ms; }
  .david-bio p:nth-child(2) { transition-delay: 210ms; }
  .david-bio p:nth-child(3) { transition-delay: 270ms; }

  .david-socials {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 360ms 300ms var(--ease-out), transform 360ms 300ms var(--ease-out);
    font-family: 'Space Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--purple);
    letter-spacing: 0.06em;
  }

  .david-socials.visible { opacity: 1; transform: translateY(0); }

  .david-socials :global(.social-link) {
    border-bottom: 2px solid rgba(107, 63, 160, 0.25);
    padding-bottom: 0.1rem;
    transition: color 160ms var(--ease-out), border-color 160ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .david-socials :global(.social-link:hover) { color: var(--purple-light); border-color: var(--purple-light); }
  }

  @media (prefers-reduced-motion: reduce) {
    .david-photo,
    .david-name,
    .david-role,
    .david-bio p,
    .david-socials {
      transform: none !important;
      opacity: 1 !important;
    }
    .david-divider { width: 2.5rem !important; opacity: 1 !important; }
  }
</style>

<script>
  const photoObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        photoObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });

  const photo = document.getElementById('davidPhoto');
  if (photo) photoObserver.observe(photo);

  const textObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        textObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  ['davidName', 'davidRole', 'davidDivider', 'davidP1', 'davidP2', 'davidP3', 'davidIg'].forEach((id) => {
    const el = document.getElementById(id);
    if (el) textObserver.observe(el);
  });
</script>
