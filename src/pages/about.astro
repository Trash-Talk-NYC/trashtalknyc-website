<script>
  const entryEls = Array.from(document.querySelectorAll<HTMLElement>('.team-entry'));
  const entries = new Map(entryEls.map((el) => [el.dataset.person, el]));
  const markers = new Map(
    Array.from(document.querySelectorAll<HTMLElement>('.face-marker')).map((el) => [el.dataset.person, el]),
  );
  const hero = document.querySelector<HTMLElement>('.team-hero');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Two independent sources drive the name-chip illumination (the
  // photograph itself always stays fully lit):
  // - pointerId: hover or keyboard focus on a face (wins while active,
  //   and additionally raises that person's bio entry)
  // - scrollId: which bio currently owns the viewport (stacked layouts
  //   only — in the desktop 3-column row no single bio owns the scroll)
  let pointerId: string | null = null;
  let focusStrong = false;
  let scrollId: string | null = null;

  function render() {
    const id = pointerId ?? scrollId;
    markers.forEach((marker, key) => {
      marker.classList.toggle('is-active', key === id);
      marker.classList.toggle('is-focus', key === id && pointerId !== null && focusStrong);
    });
    entries.forEach((entry, key) => {
      entry.classList.toggle('is-raised', pointerId !== null && key === pointerId);
      entry.classList.toggle('is-receded', pointerId !== null && key !== pointerId);
    });
  }

  // ── Scroll ownership ──
  // A bio owns the viewport while the 55%-height line sits inside it;
  // in the gaps the previous owner holds on (the line's crossing of
  // the next entry's top is the single, monotone handover point — no
  // flicker). Above the first bio and well past the last one, nobody
  // owns and no name chip is illuminated.
  let stacked = false;

  function computeStacked() {
    const els = Array.from(entries.values());
    stacked = els.length > 1 && Math.abs(els[0].offsetLeft - els[1].offsetLeft) < 4;
  }

  function ownerFromScroll(): string | null {
    if (!stacked) return null;
    // At page open no chip is illuminated — nobody owns the scroll
    // until the reader actually moves toward a bio; returning to the
    // very top restores that resting state. 8px separates "landed"
    // from "reading".
    if (window.scrollY < 8) return null;
    const line = window.innerHeight * 0.55;
    let owner: string | null = null;
    let ownerTop = -Infinity;
    let lastKey: string | null = null;
    let lastRect: DOMRect | null = null;
    entries.forEach((el, key) => {
      const r = el.getBoundingClientRect();
      if (r.top <= line && r.top > ownerTop) {
        owner = key ?? null;
        ownerTop = r.top;
      }
      if (!lastRect || r.top > lastRect.top) {
        lastRect = r;
        lastKey = key ?? null;
      }
    });
    if (owner !== null && owner === lastKey && lastRect && (lastRect as DOMRect).bottom + 120 < line) {
      return null;
    }
    return owner;
  }

  let scrollTick = false;
  function onScroll() {
    if (scrollTick) return;
    scrollTick = true;
    requestAnimationFrame(() => {
      scrollTick = false;
      const owner = ownerFromScroll();
      if (owner !== scrollId) {
        scrollId = owner;
        render();
      }
    });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', () => { computeStacked(); onScroll(); });
  computeStacked();
  onScroll();

  // Scroll the chosen entry's top under the sticky chrome. Walks the
  // offset chain (transform-proof) and accounts for the pinned photo
  // plate on mobile, which scrollIntoView knows nothing about.
  function scrollToEntry(el: HTMLElement) {
    let y = 0;
    for (let n: Element | null = el; n instanceof HTMLElement; n = n.offsetParent) y += n.offsetTop;
    const navH = document.querySelector('nav')?.getBoundingClientRect().height ?? 70;
    const pinned = hero && getComputedStyle(hero).position === 'sticky' ? hero.offsetHeight : 0;
    window.scrollTo(0, Math.max(0, y - navH - pinned - 16));
  }

  document.querySelectorAll<HTMLButtonElement>('.hotspot').forEach((btn) => {
    const id = btn.dataset.person ?? null;
    if (!id) return;
    // pointerType check keeps hover states off touch devices, where a
    // tap would otherwise leave a person stuck in the spotlight
    btn.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      pointerId = id;
      focusStrong = false;
      render();
    });
    btn.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      pointerId = null;
      render();
    });
    // The spotlight is the focus indicator (the ring is suppressed in
    // CSS): keyboard focus lights the person with a deeper veil
    btn.addEventListener('focus', () => {
      pointerId = id;
      focusStrong = btn.matches(':focus-visible');
      render();
    });
    btn.addEventListener('blur', () => {
      pointerId = null;
      focusStrong = false;
      render();
    });
    // Activating a face takes you to that bio; the scroll handler then
    // hands the spotlight to the same person, so the state is stable
    btn.addEventListener('click', () => {
      const entry = entries.get(id);
      if (entry) scrollToEntry(entry);
    });
  });

  // Staggered entrance, delayed in JS rather than transition-delay so
  // the same transform transition can serve the hover lift undelayed
  const entryObserver = new IntersectionObserver((observed) => {
    observed.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      const delay = reduceMotion.matches ? 0 : Number(el.dataset.index ?? 0) * 90;
      window.setTimeout(() => el.classList.add('visible'), delay);
      entryObserver.unobserve(el);
    });
  }, { threshold: 0.1 });

  entryEls.forEach((el) => entryObserver.observe(el));
</script>

<script>
  import { actions } from 'astro:actions';
  import { getCurrentLang, onLanguageChange, submitErrorText } from '../lib/language';

  // ── JOIN THE TEAM ──
  const joinForm = document.getElementById('joinForm') as HTMLFormElement | null;
  const joinRoleSelect = document.getElementById('joinRole') as HTMLSelectElement | null;
  const joinErrorEl = document.getElementById('joinFormError');
  const roleCards = Array.from(document.querySelectorAll<HTMLButtonElement>('.role-card'));
  const joinReduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Spam-timing field (same heuristic as the other two forms)
  const joinStartedAt = document.getElementById('joinStartedAt') as HTMLInputElement | null;
  if (joinStartedAt) joinStartedAt.value = String(Date.now());

  function markSelectedRole(value: string) {
    roleCards.forEach((card) => {
      const selected = card.dataset.role === value;
      card.classList.toggle('selected', selected);
      card.setAttribute('aria-pressed', String(selected));
    });
  }

  // Role box → pre-filled form: choosing a card sets the select, then
  // hands the viewport to the form with the name field ready to type in
  roleCards.forEach((card) => {
    card.addEventListener('click', () => {
      const value = card.dataset.role ?? '';
      if (joinRoleSelect) joinRoleSelect.value = value;
      markSelectedRole(value);
      const nameInput = document.getElementById('joinName') as HTMLInputElement | null;
      nameInput?.focus({ preventScroll: true });
      document.getElementById('joinFormWrap')?.scrollIntoView({
        behavior: joinReduceMotion.matches ? 'auto' : 'smooth',
        block: 'start',
      });
    });
  });

  // …and the reverse: picking from the select lights the matching card
  joinRoleSelect?.addEventListener('change', () => markSelectedRole(joinRoleSelect.value));

  joinForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;

    const submitBtn = form.querySelector<HTMLButtonElement>('.form-submit')!;
    const originalText = submitBtn.textContent ?? '';
    submitBtn.textContent = getCurrentLang() === 'es' ? 'Enviando…' : 'Submitting…';
    submitBtn.disabled = true;
    submitBtn.style.opacity = '0.7';
    if (joinErrorEl) joinErrorEl.textContent = '';

    const { error } = await actions.joinTeam(new FormData(form));

    if (!error) {
      form.style.display = 'none';
      (document.getElementById('joinSuccess') as HTMLElement).style.display = 'block';
      return;
    }

    // Persistent aria-live message so the failure survives the transient
    // button swap and is announced by screen readers
    if (joinErrorEl) joinErrorEl.textContent = submitErrorText(getCurrentLang());
    submitBtn.textContent = submitErrorText(getCurrentLang());
    submitBtn.style.background = '#c0392b';
    submitBtn.style.borderColor = '#c0392b';
    submitBtn.style.color = '#fff';
    submitBtn.disabled = false;
    setTimeout(() => {
      submitBtn.textContent = originalText;
      submitBtn.style.background = '';
      submitBtn.style.borderColor = '';
      submitBtn.style.color = '';
      submitBtn.style.opacity = '';
    }, 3500);
  });

  onLanguageChange((lang) => {
    if (joinErrorEl?.textContent) joinErrorEl.textContent = submitErrorText(lang);
  });
</script>
