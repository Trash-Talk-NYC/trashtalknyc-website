<script>
  // Play the assembly once when ~35% of the drawing is on screen, then
  // leave it be — no loop, no off-screen animation. Reduced-motion users
  // never get .play's animations (the CSS is media-gated), so the finished
  // still renders immediately.
  const fig = document.getElementById('assemblyFig');

  if (fig) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          fig.classList.add('play');
          io.disconnect();
        }
      });
    }, { threshold: 0.35 });

    io.observe(fig);
  }
</script>
