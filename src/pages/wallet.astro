---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchDonationTotal, GOFUNDME_CAMPAIGN_SLUG } from '../lib/server/gofundme';

// Build-time snapshot so the embossed number paints without JS; the
// client script refreshes it from /api/donation-total.json. A failed
// fetch renders the em-dash fallback instead of failing the build.
const total = await fetchDonationTotal();
const formattedTotal = total === null ? '$—' : `$${total.toLocaleString('en-US')}`;

const campaignUrl = `https://www.gofundme.com/f/${GOFUNDME_CAMPAIGN_SLUG}`;
---

<BaseLayout
  title="The Wallet — Trash Talk NYC"
  description="See what your donations fund: cleanups and tree guards across New York City."
>
  <section class="wallet-scene diag-texture">
    <p class="sticker wallet-eyebrow" data-en="The People's Wallet" data-es="La Cartera del Pueblo">The People's Wallet</p>

    <div class="wallet-stage">
      <div class="wallet3d">
        <div class="wallet-back" aria-hidden="true"></div>

        <ul class="wallet-cards" role="list">
          <li role="listitem">
            <a class="wcard wcard-trees" href="/tree-guards">
              <span class="wcard-top">
                <span class="wcard-title">Tree Guards</span>
                <span class="wcard-sub" data-en="Protecting street trees" data-es="Protegiendo los árboles">Protecting street trees</span>
              </span>
              <span class="wcard-foot" aria-hidden="true">
                <span class="wcard-chip"></span>
                <span class="wcard-arrow">&rarr;</span>
              </span>
            </a>
          </li>
          <li role="listitem">
            <a class="wcard wcard-cleanups" href="/cleanups">
              <span class="wcard-top">
                <span class="wcard-title">Cleanups</span>
                <span class="wcard-sub" data-en="Bags, gloves, grabbers" data-es="Bolsas, guantes, pinzas">Bags, gloves, grabbers</span>
              </span>
              <span class="wcard-foot" aria-hidden="true">
                <span class="wcard-chip"></span>
                <span class="wcard-arrow">&rarr;</span>
              </span>
            </a>
          </li>
        </ul>

        <div class="wallet-front">
          <h1 class="emboss">
            <span data-en="Your" data-es="Tus">Your</span>
            <span class="emboss-amount" id="donationAmount" data-total={total ?? ''}>{formattedTotal}</span>
            <span data-en="donations" data-es="en donaciones">donations</span>
          </h1>
          <p class="emboss-sub" data-en="Hard at work across NYC" data-es="Trabajando por Nueva York">Hard at work across NYC</p>
          <p class="wallet-stamp" aria-hidden="true">Trash Talk NYC</p>
        </div>
      </div>
    </div>

    <a class="wallet-donate-link" href={campaignUrl} target="_blank" rel="noopener" data-en="Add to the wallet ↗" data-es="Aporta a la cartera ↗">Add to the wallet ↗</a>
  </section>
</BaseLayout>

<style>
  /* Registered so the entrance keyframes can interpolate it; without
     registration a custom property flips discretely mid-animation. */
  @property --pop-y {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  /* ── Scene: full viewport under the nav, wallet centered ── */
  .wallet-scene {
    min-height: calc(100svh - var(--nav-h));
    background: var(--charcoal);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    padding:
      var(--space-md)
      max(var(--gutter), var(--safe-right))
      max(var(--space-md), var(--safe-bottom))
      max(var(--gutter), var(--safe-left));
    overflow: hidden;
  }

  .wallet-eyebrow { --tilt: -3deg; }

  /* Container so all wallet geometry can use cqw units of its width;
     also the perspective camera for the 3D scene inside. */
  .wallet-stage {
    width: min(100%, 720px);
    container-type: inline-size;
    perspective: 1100px;
    perspective-origin: 50% 20%;
  }

  /* The 3D assembly: back panel (z=0) → cards → front panel, viewed
     from slightly above so the slot opening reads as real depth.
     Heights in cqw: front panel 48, slot headroom 18, total 66. */
  .wallet3d {
    position: relative;
    height: 66cqw;
    transform-style: preserve-3d;
    transform: rotateX(11deg);
  }

  /* ── Back panel: the wallet's rear wall / interior lining ── */
  .wallet-back {
    position: absolute;
    inset: 0;
    border-radius: clamp(16px, 3.4cqw, 26px);
    background:
      radial-gradient(120% 60% at 50% 0%, rgba(0, 0, 0, 0.45), transparent 60%),
      linear-gradient(160deg, #4a2a72, #3a2058 70%);
    border: 3px solid #2a1742;
    transform: translateZ(0);
  }

  /* ── Cards: wide wallet-card shapes standing in the slot ── */
  .wallet-cards {
    list-style: none;
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    pointer-events: none; /* only the cards themselves take the pointer */
  }

  .wallet-cards li {
    display: contents;
  }

  .wcard {
    /* Composable 3D placement: --y/--z move per state, --lean is fixed */
    --pop-y: 0cqw;
    --pop-z: 0px;
    position: absolute;
    left: 50%;
    width: 76cqw;
    height: 48cqw; /* credit-card 1.586 aspect at 76cqw wide */
    padding: 1.8cqw 3cqw;
    display: flex;
    flex-direction: column;
    border: 3px solid var(--charcoal);
    border-radius: clamp(8px, 1.8cqw, 14px);
    box-shadow: 0 4px 0 rgba(0, 0, 0, 0.4);
    text-decoration: none;
    pointer-events: auto;
    /* iOS double-tap zoom would otherwise eat the second tap of the
       pop-then-navigate flow */
    touch-action: manipulation;
    transform:
      translateX(calc(-50% + var(--lean-x, 0cqw)))
      translateY(calc(var(--rest-y) + var(--pop-y)))
      translateZ(calc(var(--rest-z) + var(--pop-z)))
      rotate(var(--lean, 0deg));
    transition: transform 0.35s var(--ease-out);
    /* backwards fill: hidden until the delay elapses, then rise to the
       base value; once finished the animation stops applying so the
       hover/focus/tap pop can take over --pop-y again */
    animation: wcard-rise 0.8s var(--ease-out) backwards;
  }

  /* Rear card: higher in the slot, deeper in z */
  .wcard-trees {
    --rest-y: 3cqw;
    --rest-z: 16px;
    --lean-x: 1.2cqw;
    --lean: 0.7deg;
    top: 0;
    background: var(--green);
    color: var(--off-white);
    animation-delay: 0.15s;
  }

  /* Front card: lower, closer to the viewer */
  .wcard-cleanups {
    --rest-y: 10.5cqw;
    --rest-z: 34px;
    --lean-x: -1.2cqw;
    --lean: -0.8deg;
    top: 0;
    background: var(--yellow);
    color: var(--charcoal);
    animation-delay: 0.3s;
  }

  /* Slide up out of the slot with a slight lean toward the viewer —
     z stays below the front panel's 58px so the leather keeps masking
     the card's lower body, like a real card pulled partway out.
     .is-popped is the touch equivalent (hover doesn't exist there):
     the script pops on first tap and navigates on the second. */
  .wcard:hover,
  .wcard:focus-visible,
  .wcard.is-popped {
    --pop-y: -9cqw;
    --pop-z: 14px;
  }

  @keyframes wcard-rise {
    from { --pop-y: 16cqw; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wcard {
      animation: none;
      transition: none;
    }
  }

  .wcard-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2cqw;
    flex-wrap: wrap;
  }

  .wcard-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.3rem, 5.4cqw, 2.4rem);
    letter-spacing: 0.05em;
    line-height: 1;
    text-transform: uppercase;
  }

  .wcard-sub {
    font-family: 'Space Mono', monospace;
    font-size: clamp(0.5rem, 1.9cqw, 0.72rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.75;
  }

  .wcard-foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Little bank-card chip so the cards read as cards, not buttons */
  .wcard-chip {
    width: clamp(18px, 5cqw, 34px);
    height: clamp(14px, 3.6cqw, 25px);
    border: 2px solid currentColor;
    border-radius: 5px;
    opacity: 0.65;
    background:
      linear-gradient(currentColor, currentColor) 50% 0 / 2px 100% no-repeat,
      linear-gradient(currentColor, currentColor) 0 50% / 100% 2px no-repeat;
  }

  .wcard-arrow {
    font-size: clamp(0.9rem, 3.4cqw, 1.5rem);
    font-weight: 800;
    line-height: 1;
  }

  /* ── Front panel: the purple leather face ── */
  .wallet-front {
    /* Taps must reach the cards, never the leather; a tap falling
       through onto a hidden card body acts as a first tap on it. */
    pointer-events: none;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 48cqw;
    border-radius: clamp(16px, 3.4cqw, 26px);
    background:
      radial-gradient(120% 90% at 30% 0%, rgba(247, 244, 237, 0.06), transparent 55%),
      linear-gradient(150deg, #6f42a6, #5c3492 55%, #4a2a78);
    border: 3px solid #33205a;
    box-shadow: 14px 18px 0 rgba(0, 0, 0, 0.45);
    transform: translateZ(58px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.5rem, 1.8cqw, 1rem);
    padding: clamp(1rem, 4cqw, 2.5rem);
  }

  /* Leather grain — same turbulence device as the site-wide overlay */
  .wallet-front::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='leather'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23leather)' opacity='0.1'/%3E%3C/svg%3E");
    pointer-events: none;
  }

  /* Caution-yellow thread stitched inside the edge */
  .wallet-front::before {
    content: '';
    position: absolute;
    inset: clamp(8px, 1.8cqw, 14px);
    border: 2px dashed rgba(245, 208, 0, 0.55);
    border-radius: clamp(10px, 2.4cqw, 18px);
    pointer-events: none;
  }

  /* ── Embossed lettering: pressed into the leather, light catching
        the lower edge of each depression ── */
  .emboss {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.9rem, 8.4cqw, 4.1rem);
    letter-spacing: 0.05em;
    line-height: 1.05;
    text-transform: uppercase;
    text-align: center;
    color: #2b1850;
    text-shadow:
      0 1px 0 rgba(240, 232, 255, 0.24),
      0 -1px 1px rgba(0, 0, 0, 0.55);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.28em;
    position: relative;
    z-index: 1;
  }

  /* Gold-foil stamp for the number itself */
  .emboss-amount {
    color: var(--yellow);
    font-variant-numeric: tabular-nums;
  }

  .emboss-sub {
    font-family: 'Space Mono', monospace;
    font-size: clamp(0.55rem, 1.9cqw, 0.78rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.26em;
    text-align: center;
    color: rgba(20, 10, 40, 0.6);
    text-shadow: 0 1px 0 rgba(240, 232, 255, 0.22);
    position: relative;
    z-index: 1;
  }

  /* Maker's mark in the corner */
  .wallet-stamp {
    position: absolute;
    bottom: clamp(14px, 3.4cqw, 26px);
    right: clamp(16px, 4cqw, 30px);
    font-family: 'Space Mono', monospace;
    font-size: 0.58rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: rgba(20, 10, 40, 0.55);
    text-shadow: 0 1px 0 rgba(240, 232, 255, 0.18);
  }

  .wallet-donate-link {
    margin-top: var(--space-xs); /* clear the front panel's press shadow */
    font-family: 'Space Mono', monospace;
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--yellow);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .wallet-donate-link:hover { color: var(--off-white); }

  /* Narrow screens: same construction, slightly deeper slot so the
     rem-floored card text still fits its visible strip */
  @media (max-width: 520px) {
    .wallet3d { height: 72cqw; }
    .wcard-trees { --rest-y: 4cqw; }
    .wcard-cleanups { --rest-y: 13cqw; }
    .wallet-front { height: 50cqw; }
  }
</style>

<script>
  // Touch has no hover, so tapping works in two steps: first tap pops
  // the card out of the slot, second tap navigates, tapping anywhere
  // else settles it back. Gated on (hover: none) and driven by click —
  // not touch coordinates — so VoiceOver/TalkBack synthesized
  // activations take the same pop-then-navigate path instead of being
  // suppressed. Keyboard is untouched: :focus-visible already pops the
  // card, so Enter navigates directly.
  const cards = document.querySelectorAll<HTMLAnchorElement>('.wcard');
  const noHover = window.matchMedia('(hover: none)');

  let poppedCard: HTMLAnchorElement | null = null;

  const settle = () => {
    poppedCard?.classList.remove('is-popped');
    poppedCard = null;
  };

  for (const card of cards) {
    card.addEventListener('click', (event) => {
      if (!noHover.matches) return;
      if (poppedCard === card || card.matches(':focus-visible')) return;

      event.preventDefault();
      settle();
      poppedCard = card;
      card.classList.add('is-popped');
    });
  }

  document.addEventListener('click', (event) => {
    if (poppedCard && event.target instanceof Node && !poppedCard.contains(event.target)) {
      settle();
    }
  });

  // Refresh the embossed total with the live GoFundMe number, counting
  // up from the build-time value once the cards have risen out of the
  // wallet — the server-rendered amount stays up until then.
  const amountEl = document.getElementById('donationAmount');

  if (amountEl instanceof HTMLElement) {
    const format = (value: number) => `$${Math.round(value).toLocaleString('en-US')}`;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const parsed = Number(amountEl.dataset.total);
    const buildTotal = Number.isFinite(parsed) && parsed > 0 ? parsed : null;

    let shown = buildTotal ?? 0;
    let lastTarget: number | null = buildTotal;
    let raf = 0;

    const renderTo = (target: number) => {
      if (target === lastTarget) return;
      lastTarget = target;
      cancelAnimationFrame(raf);

      if (reduceMotion) {
        shown = target;
        amountEl.textContent = format(target);
        return;
      }

      const from = shown;
      const start = performance.now();
      const durationMs = 1100;
      const tick = (now: number) => {
        const t = Math.min((now - start) / durationMs, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        shown = from + (target - from) * eased;
        amountEl.textContent = format(shown);
        if (t < 1) raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    };

    // Hold the stamp until the cards' rise finishes (0.3s delay + 0.8s).
    const stampDelayMs = 1100;
    const loadedAt = performance.now();
    const reveal = (value: number) => {
      const wait = Math.max(0, stampDelayMs - (performance.now() - loadedAt));
      setTimeout(() => renderTo(value), wait);
    };

    fetch('/api/donation-total.json')
      .then((res) => (res.ok ? res.json() : null))
      .then((data: unknown) => {
        const live = (data as { amountRaised?: unknown } | null)?.amountRaised;
        if (typeof live === 'number' && Number.isFinite(live) && live > 0) reveal(live);
      })
      .catch(() => {
        /* build-time value (or the $— fallback) stays up */
      });
  }
</script>
