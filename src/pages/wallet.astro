---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchDonationTotal, GOFUNDME_CAMPAIGN_SLUG } from '../lib/server/gofundme';

// Build-time snapshot so the embossed number paints without JS; the
// client script refreshes it from /api/donation-total.json. A failed
// fetch renders the em-dash fallback instead of failing the build.
const total = await fetchDonationTotal();
const formattedTotal = total === null ? '$—' : `$${total.toLocaleString('en-US')}`;

const campaignUrl = `https://www.gofundme.com/f/${GOFUNDME_CAMPAIGN_SLUG}`;
---

<BaseLayout
  title="The Wallet — Trash Talk NYC"
  description="See what your donations fund: cleanups and tree guards across New York City."
>
  <section class="wallet-scene diag-texture">
    <p class="sticker wallet-eyebrow" data-en="The People's Wallet" data-es="La Cartera del Pueblo">The People's Wallet</p>

    <div class="wallet-stage">
      <div class="wallet">
        <ul class="wallet-cards" role="list">
          <li class="wallet-slot">
            <a class="wcard wcard-cleanups" href="/cleanups">
              <span class="wcard-title">Cleanups</span>
              <span class="wcard-sub" data-en="Bags, gloves, grabbers" data-es="Bolsas, guantes, pinzas">Bags, gloves, grabbers</span>
              <span class="wcard-foot" aria-hidden="true">
                <span class="wcard-chip"></span>
                <span class="wcard-arrow">&rarr;</span>
              </span>
            </a>
          </li>
          <li class="wallet-slot">
            <a class="wcard wcard-trees" href="/tree-guards">
              <span class="wcard-title">Tree Guards</span>
              <span class="wcard-sub" data-en="Protecting street trees" data-es="Protegiendo los árboles">Protecting street trees</span>
              <span class="wcard-foot" aria-hidden="true">
                <span class="wcard-chip"></span>
                <span class="wcard-arrow">&rarr;</span>
              </span>
            </a>
          </li>
        </ul>

        <div class="wallet-body">
          <h1 class="emboss">
            <span data-en="Your" data-es="Tus">Your</span>
            <span class="emboss-amount" id="donationAmount" data-total={total ?? ''}>{formattedTotal}</span>
            <span data-en="donations" data-es="en donaciones">donations</span>
          </h1>
          <p class="emboss-sub" data-en="Hard at work across NYC" data-es="Trabajando por Nueva York">Hard at work across NYC</p>
          <p class="wallet-stamp" aria-hidden="true">Trash Talk NYC</p>
        </div>
      </div>
    </div>

    <p class="wallet-caption" data-en="Two initiatives. Pick a card to see the work." data-es="Dos iniciativas. Elige una tarjeta para ver el trabajo.">Two initiatives. Pick a card to see the work.</p>
    <a class="wallet-donate-link" href={campaignUrl} target="_blank" rel="noopener" data-en="Add to the wallet ↗" data-es="Aporta a la cartera ↗">Add to the wallet ↗</a>
  </section>
</BaseLayout>

<style>
  /* ── Scene: full viewport under the nav, wallet centered ── */
  .wallet-scene {
    min-height: calc(100svh - var(--nav-h));
    background: var(--charcoal);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding:
      var(--space-md)
      max(var(--gutter), var(--safe-right))
      max(var(--space-md), var(--safe-bottom))
      max(var(--gutter), var(--safe-left));
    overflow: hidden;
  }

  .wallet-eyebrow { --tilt: -3deg; }

  /* Container so card/peek geometry can use cqw units of the wallet width */
  .wallet-stage {
    width: min(100%, 760px);
    container-type: inline-size;
  }

  /* Reserve headroom above the leather body for the peeking cards:
     card height is ~25.5cqw (two cards, 8cqw side insets, 3cqw gap,
     credit-card 1.586 aspect), and 16cqw of it shows at full peek. */
  .wallet {
    position: relative;
    padding-top: 16cqw;
  }

  /* ── Cards: tucked behind the leather, rising out of the top ── */
  .wallet-cards {
    list-style: none;
    position: absolute;
    top: 0;
    left: 8cqw;
    right: 8cqw;
    display: flex;
    gap: 3cqw;
  }

  .wallet-slot { flex: 1; min-width: 0; }

  .wcard {
    /* Resting tuck depth — % of the card's own height left in the slot */
    --rest: 21%;
    display: flex;
    flex-direction: column;
    height: 25.5cqw;
    padding: 1.6cqw 2.4cqw;
    border: 3px solid var(--charcoal);
    border-radius: clamp(8px, 1.8cqw, 14px);
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.5);
    text-decoration: none;
    transform: translateY(var(--rest)) rotate(var(--card-tilt, -1.2deg));
    transition: transform 0.35s var(--ease-out);
    animation: wcard-rise 0.7s var(--ease-out) 0.15s backwards;
  }

  .wcard-trees {
    --card-tilt: 1deg;
    animation-delay: 0.3s;
  }

  .wcard:hover,
  .wcard:focus-visible {
    transform: translateY(3%) rotate(var(--card-tilt, -1.2deg));
  }

  @keyframes wcard-rise {
    from { transform: translateY(85%) rotate(var(--card-tilt, -1.2deg)); }
    to { transform: translateY(var(--rest)) rotate(var(--card-tilt, -1.2deg)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wcard {
      animation: none;
      transition: none;
    }
  }

  .wcard-cleanups {
    background: var(--yellow);
    color: var(--charcoal);
  }

  .wcard-trees {
    background: var(--green);
    color: var(--off-white);
  }

  .wcard-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.15rem, 5.4cqw, 2.4rem);
    letter-spacing: 0.05em;
    line-height: 1;
    text-transform: uppercase;
  }

  .wcard-sub {
    font-family: 'Space Mono', monospace;
    font-size: clamp(0.5rem, 1.9cqw, 0.72rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.75;
    margin-top: 0.3em;
  }

  .wcard-foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Little bank-card chip so the cards read as cards, not buttons */
  .wcard-chip {
    width: clamp(18px, 5cqw, 34px);
    height: clamp(14px, 3.6cqw, 25px);
    border: 2px solid currentColor;
    border-radius: 5px;
    opacity: 0.65;
    background:
      linear-gradient(currentColor, currentColor) 50% 0 / 2px 100% no-repeat,
      linear-gradient(currentColor, currentColor) 0 50% / 100% 2px no-repeat;
  }

  .wcard-arrow {
    font-size: clamp(0.9rem, 3.4cqw, 1.5rem);
    font-weight: 800;
    line-height: 1;
  }

  /* ── The leather body ── */
  .wallet-body {
    position: relative;
    z-index: 2;
    aspect-ratio: 2 / 1;
    border-radius: clamp(16px, 3.4cqw, 26px);
    background:
      radial-gradient(120% 90% at 30% 0%, rgba(247, 244, 237, 0.07), transparent 55%),
      linear-gradient(150deg, #2b2b34, #1f1f27 60%, #1a1a21);
    border: 3px solid #121217;
    box-shadow: 10px 10px 0 var(--purple);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.5rem, 1.8cqw, 1rem);
    padding: clamp(1rem, 4cqw, 2.5rem);
  }

  /* Leather grain — same turbulence device as the site-wide overlay */
  .wallet-body::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='leather'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23leather)' opacity='0.09'/%3E%3C/svg%3E");
    pointer-events: none;
  }

  /* Caution-yellow thread stitched inside the edge */
  .wallet-body::before {
    content: '';
    position: absolute;
    inset: clamp(8px, 1.8cqw, 14px);
    border: 2px dashed rgba(201, 169, 0, 0.6);
    border-radius: clamp(10px, 2.4cqw, 18px);
    pointer-events: none;
  }

  /* ── Embossed lettering: pressed into the leather, light catching
        the lower edge of each depression ── */
  .emboss {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.9rem, 8.4cqw, 4.1rem);
    letter-spacing: 0.05em;
    line-height: 1.05;
    text-transform: uppercase;
    text-align: center;
    color: #131318;
    text-shadow:
      0 1px 0 rgba(247, 244, 237, 0.16),
      0 -1px 1px rgba(0, 0, 0, 0.65);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.28em;
    position: relative;
    z-index: 1;
  }

  /* Gold-foil stamp for the number itself */
  .emboss-amount {
    color: var(--yellow-dark);
    font-variant-numeric: tabular-nums;
  }

  .emboss-sub {
    font-family: 'Space Mono', monospace;
    font-size: clamp(0.55rem, 1.9cqw, 0.78rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.26em;
    text-align: center;
    color: rgba(0, 0, 0, 0.55);
    text-shadow: 0 1px 0 rgba(247, 244, 237, 0.13);
    position: relative;
    z-index: 1;
  }

  /* Maker's mark in the corner */
  .wallet-stamp {
    position: absolute;
    bottom: clamp(14px, 3.4cqw, 26px);
    right: clamp(16px, 4cqw, 30px);
    font-family: 'Space Mono', monospace;
    font-size: 0.58rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: rgba(0, 0, 0, 0.5);
    text-shadow: 0 1px 0 rgba(247, 244, 237, 0.1);
  }

  /* ── Scene copy under the wallet ── */
  .wallet-caption {
    margin-top: var(--space-sm);
    color: var(--paper-a70);
    font-size: var(--step-0);
    font-weight: 600;
    text-align: center;
  }

  .wallet-donate-link {
    font-family: 'Space Mono', monospace;
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--yellow);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .wallet-donate-link:hover { color: var(--off-white); }

  /* Narrow screens: taller leather for the embossed line, and a higher
     resting peek so the rem-floored card text still clears the slot */
  @media (max-width: 520px) {
    .wallet-body { aspect-ratio: 10 / 7; }
    .wcard { --rest: -2%; }
    .wcard:hover,
    .wcard:focus-visible { transform: translateY(-12%) rotate(var(--card-tilt, -1.2deg)); }
  }
</style>

<script>
  // Refresh the embossed total with the live GoFundMe number and stamp
  // it in with a count-up once the cards have risen out of the wallet.
  const amountEl = document.getElementById('donationAmount');

  if (amountEl instanceof HTMLElement) {
    const format = (value: number) => `$${Math.round(value).toLocaleString('en-US')}`;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const parsed = Number(amountEl.dataset.total);
    const buildTotal = Number.isFinite(parsed) && parsed > 0 ? parsed : null;

    let shown = 0;
    let lastTarget: number | null = null;
    let raf = 0;

    const renderTo = (target: number) => {
      if (target === lastTarget) return;
      lastTarget = target;
      cancelAnimationFrame(raf);

      if (reduceMotion) {
        shown = target;
        amountEl.textContent = format(target);
        return;
      }

      const from = shown;
      const start = performance.now();
      const durationMs = 1100;
      const tick = (now: number) => {
        const t = Math.min((now - start) / durationMs, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        shown = from + (target - from) * eased;
        amountEl.textContent = format(shown);
        if (t < 1) raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    };

    // Hold the stamp until the cards' rise finishes (0.3s delay + 0.7s).
    const stampDelayMs = 1000;
    const loadedAt = performance.now();
    const reveal = (value: number) => {
      const wait = Math.max(0, stampDelayMs - (performance.now() - loadedAt));
      setTimeout(() => renderTo(value), wait);
    };

    if (buildTotal !== null) reveal(buildTotal);

    fetch('/api/donation-total.json')
      .then((res) => (res.ok ? res.json() : null))
      .then((data: unknown) => {
        const live = (data as { amountRaised?: unknown } | null)?.amountRaised;
        if (typeof live === 'number' && Number.isFinite(live) && live > 0) reveal(live);
      })
      .catch(() => {
        /* build-time value (or the $— fallback) stays up */
      });
  }
</script>
