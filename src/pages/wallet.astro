---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchDonationTotal, GOFUNDME_CAMPAIGN_SLUG } from '../lib/server/gofundme';

// Build-time snapshot so the embossed number paints without JS; the
// client script refreshes it from /api/donation-total.json. A failed
// fetch renders the em-dash fallback instead of failing the build.
const total = await fetchDonationTotal();
const formattedTotal = total === null ? '$—' : `$${total.toLocaleString('en-US')}`;

const campaignUrl = `https://www.gofundme.com/f/${GOFUNDME_CAMPAIGN_SLUG}`;
---

<BaseLayout
  title="The Wallet — Trash Talk NYC"
  description="See what your donations fund: cleanups and tree guards across New York City."
>
  <section class="wallet-scene diag-texture">
    <p class="sticker wallet-eyebrow" data-en="The People's Wallet" data-es="La Cartera del Pueblo">The People's Wallet</p>

    <div class="wallet-stage">
      <div class="wallet3d">
        <div class="wallet-back" aria-hidden="true"></div>

        <ul class="wallet-cards" role="list">
          <li role="listitem">
            <a class="wcard wcard-trees" href="/tree-guards" data-slot="rear">
              <span class="wcard-top">
                <span class="wcard-title" data-en="Tree Guards" data-es="Protectores de Árboles">Tree Guards</span>
                <span class="wcard-sub" data-en="Protecting street trees" data-es="Protegiendo los árboles">Protecting street trees</span>
              </span>
              <span class="wcard-foot" aria-hidden="true">
                <span class="wcard-chip"></span>
                <span class="wcard-arrow">&rarr;</span>
              </span>
            </a>
          </li>
          <li role="listitem">
            <a class="wcard wcard-cleanups" href="/cleanups" data-slot="front">
              <span class="wcard-top">
                <span class="wcard-title" data-en="Cleanups" data-es="Limpiezas">Cleanups</span>
                <span class="wcard-sub" data-en="Bags, gloves, grabbers" data-es="Bolsas, guantes, pinzas">Bags, gloves, grabbers</span>
              </span>
              <span class="wcard-foot" aria-hidden="true">
                <span class="wcard-chip"></span>
                <span class="wcard-arrow">&rarr;</span>
              </span>
            </a>
          </li>
        </ul>

        <div class="wallet-front">
          <h1 class="emboss">
            <span data-en="Your" data-es="Tus">Your</span>
            <span class="emboss-amount" id="donationAmount" data-total={total ?? ''}>{formattedTotal}</span>
            <span data-en="donations" data-es="en donaciones">donations</span>
          </h1>
          <p class="emboss-sub" data-en="Hard at work across NYC" data-es="Trabajando por Nueva York">Hard at work across NYC</p>
          <p class="wallet-stamp" aria-hidden="true">Trash Talk NYC</p>
        </div>
      </div>

      <button class="cycle-btn cycle-btn-left" id="cycleLeft" type="button">
        <span aria-hidden="true">&larr;</span>
        <span class="visually-hidden" data-en="Show other card" data-es="Mostrar la otra tarjeta">Show other card</span>
      </button>
      <button class="cycle-btn cycle-btn-right" id="cycleRight" type="button">
        <span aria-hidden="true">&rarr;</span>
        <span class="visually-hidden" data-en="Show other card" data-es="Mostrar la otra tarjeta">Show other card</span>
      </button>
    </div>

    <a class="wallet-donate-link" href={campaignUrl} target="_blank" rel="noopener" data-en="Add to the wallet ↗" data-es="Aporta a la cartera ↗">Add to the wallet ↗</a>
  </section>
</BaseLayout>

<style>
  /* Registered so keyframes can interpolate them; without registration
     a custom property flips discretely mid-animation. */
  @property --pop-x {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }
  @property --pop-y {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }
  @property --pop-z {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }
  @property --pop-r {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  /* ── Scene: full viewport under the nav, wallet centered ── */
  .wallet-scene {
    min-height: calc(100svh - var(--nav-h));
    background: var(--charcoal);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    padding:
      var(--space-md)
      max(var(--gutter), var(--safe-right))
      max(var(--space-md), var(--safe-bottom))
      max(var(--gutter), var(--safe-left));
    overflow: hidden;
  }

  .wallet-eyebrow { --tilt: -3deg; }

  /* Container so all wallet geometry can use cqw units of its width;
     also the perspective camera for the 3D scene inside. */
  .wallet-stage {
    width: min(100%, 720px);
    container-type: inline-size;
    perspective: 1100px;
    perspective-origin: 50% 40%;
    position: relative; /* anchors the cycle arrows */
  }

  /* The 3D assembly: back panel (z=0) → cards → front panel. Tilted
     FORWARD — top edge toward the viewer — so you look slightly down
     into the slot opening, like a wallet leaning at you.
     Heights in cqw: front panel 48, slot headroom 18, total 66. */
  .wallet3d {
    position: relative;
    height: 66cqw;
    transform-style: preserve-3d;
    transform: rotateX(-10deg);
  }

  /* ── Back panel: the wallet's rear wall / interior lining ── */
  .wallet-back {
    position: absolute;
    inset: 0;
    border-radius: clamp(16px, 3.4cqw, 26px);
    background:
      radial-gradient(120% 60% at 50% 0%, rgba(0, 0, 0, 0.45), transparent 60%),
      linear-gradient(160deg, #4a2a72, #3a2058 70%);
    border: 3px solid #2a1742;
    transform: translateZ(0);
  }

  /* ── Cards: wide wallet-card shapes standing in the slot ── */
  .wallet-cards {
    list-style: none;
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    pointer-events: none; /* only the cards themselves take the pointer */
  }

  .wallet-cards li {
    display: contents;
  }

  .wcard {
    /* Composable 3D placement: slot rest values + per-state pop deltas */
    --slot-dy: 7.5cqw; /* front-slot minus rear-slot rest-y, for swipes */
    --pop-x: 0px;
    --pop-y: 0px;
    --pop-z: 0px;
    --pop-r: 0deg;
    position: absolute;
    top: 0;
    left: 50%;
    width: 76cqw;
    height: 48cqw; /* credit-card 1.586 aspect at 76cqw wide */
    padding: 1.8cqw 3cqw;
    display: flex;
    flex-direction: column;
    border: 3px solid var(--charcoal);
    border-radius: clamp(8px, 1.8cqw, 14px);
    box-shadow: 0 4px 0 rgba(0, 0, 0, 0.4);
    text-decoration: none;
    pointer-events: auto;
    /* No double-tap gesture here — a tap is always a plain navigation */
    touch-action: manipulation;
    /* iOS paints its tap highlight over the card's full (mostly hidden)
       box, which read as a translucent block over the wallet */
    -webkit-tap-highlight-color: transparent;
    transform:
      translateX(calc(-50% + var(--lean-x, 0px) + var(--pop-x)))
      translateY(calc(var(--rest-y) + var(--pop-y)))
      translateZ(calc(var(--rest-z) + var(--pop-z)))
      rotate(calc(var(--lean, 0deg) + var(--pop-r)));
    transition: transform 0.35s var(--ease-out);
    /* backwards fill: hidden until the delay elapses, then rise to the
       base value; once finished the animation stops applying so the
       hover/focus pop can take over --pop-y again */
    animation: wcard-rise 0.8s var(--ease-out) backwards;
  }

  /* Slot geometry: which card occupies which slot changes as the
     arrows cycle the stack, so it lives on data-slot, not the card */
  .wcard[data-slot='rear'] {
    --rest-y: 3cqw;
    --rest-z: 16px;
    --lean-x: 1.2cqw;
    --lean: 0.7deg;
  }

  .wcard[data-slot='front'] {
    --rest-y: 10.5cqw;
    --rest-z: 34px;
    --lean-x: -1.2cqw;
    --lean: -0.8deg;
  }

  .wcard-trees {
    background: var(--green);
    color: var(--off-white);
    animation-delay: 0.15s;
  }

  .wcard-cleanups {
    background: var(--yellow);
    color: var(--charcoal);
    animation-delay: 0.3s;
  }

  /* Desktop: hovering slides the card up out of the slot toward the
     viewer; un-hovering transitions it back down the same way. The
     z delta stays below the front panel's 58px so the leather keeps
     masking the card's lower body, like a real card pulled partway
     out. Keyboard focus pops on every device. */
  .wcard:focus-visible {
    --pop-y: -9cqw;
    --pop-z: 14px;
  }

  @media (hover: hover) {
    .wcard:hover {
      --pop-y: -9cqw;
      --pop-z: 14px;
    }
  }

  @keyframes wcard-rise {
    from { --pop-y: 16cqw; }
  }

  /* Arrow-driven cycle: the outgoing front card swings out sideways,
     dips behind the stack, and settles into the rear slot. The card's
     data-slot is already 'rear' when this runs, so the 0% frame
     re-creates its old front-slot position via deltas and the 100%
     frame (all zeros) lands exactly on its new rest state. */
  @keyframes wcard-swipe-left {
    0% { --pop-x: -2.4cqw; --pop-y: var(--slot-dy); --pop-z: 18px; --pop-r: -1.5deg; }
    40% { --pop-x: -74cqw; --pop-y: 3cqw; --pop-z: 34px; --pop-r: -7deg; }
    70% { --pop-x: -46cqw; --pop-y: 0px; --pop-z: -56px; --pop-r: 3deg; }
    100% { --pop-x: 0px; --pop-y: 0px; --pop-z: 0px; --pop-r: 0deg; }
  }

  @keyframes wcard-swipe-right {
    0% { --pop-x: -2.4cqw; --pop-y: var(--slot-dy); --pop-z: 18px; --pop-r: -1.5deg; }
    40% { --pop-x: 74cqw; --pop-y: 3cqw; --pop-z: 34px; --pop-r: 7deg; }
    70% { --pop-x: 46cqw; --pop-y: 0px; --pop-z: -56px; --pop-r: -3deg; }
    100% { --pop-x: 0px; --pop-y: 0px; --pop-z: 0px; --pop-r: 0deg; }
  }

  /* wcard-rise stays in the list so the (long-finished) entrance
     animation survives the swipe class being added and removed —
     dropping its name from the computed animation-name would restart
     it, replaying the rise every time a swipe ends. */
  .wcard.is-swiping-left {
    animation:
      wcard-rise 0.8s var(--ease-out) backwards,
      wcard-swipe-left 0.65s var(--ease-out);
  }

  .wcard.is-swiping-right {
    animation:
      wcard-rise 0.8s var(--ease-out) backwards,
      wcard-swipe-right 0.65s var(--ease-out);
  }

  /* ── Cycle arrows: mobile has no hover cursor, so explicit buttons
        flanking the wallet swap which card is in front ── */
  .cycle-btn {
    position: absolute;
    top: 6cqw;
    z-index: 5;
    min-width: var(--tap);
    min-height: var(--tap);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--yellow);
    color: var(--charcoal);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1;
    border: 3px solid var(--charcoal);
    border-radius: 8px;
    box-shadow: var(--press-sm);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .cycle-btn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--charcoal); }

  .cycle-btn-left { left: 0; transform: rotate(-2deg); }
  .cycle-btn-right { right: 0; transform: rotate(2deg); }

  .cycle-btn-left:active { transform: rotate(-2deg) translate(2px, 2px); }
  .cycle-btn-right:active { transform: rotate(2deg) translate(2px, 2px); }

  /* Hover devices interact with the cards directly */
  @media (hover: hover) and (pointer: fine) {
    .cycle-btn { display: none; }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .wcard,
    .wcard.is-swiping-left,
    .wcard.is-swiping-right {
      animation: none;
      transition: none;
    }
  }

  .wcard-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2cqw;
    flex-wrap: wrap;
  }

  .wcard-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.3rem, 5.4cqw, 2.4rem);
    letter-spacing: 0.05em;
    line-height: 1;
    text-transform: uppercase;
  }

  .wcard-sub {
    font-family: 'Space Mono', monospace;
    font-size: clamp(0.5rem, 1.9cqw, 0.72rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.75;
  }

  .wcard-foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Little bank-card chip so the cards read as cards, not buttons */
  .wcard-chip {
    width: clamp(18px, 5cqw, 34px);
    height: clamp(14px, 3.6cqw, 25px);
    border: 2px solid currentColor;
    border-radius: 5px;
    opacity: 0.65;
    background:
      linear-gradient(currentColor, currentColor) 50% 0 / 2px 100% no-repeat,
      linear-gradient(currentColor, currentColor) 0 50% / 100% 2px no-repeat;
  }

  .wcard-arrow {
    font-size: clamp(0.9rem, 3.4cqw, 1.5rem);
    font-weight: 800;
    line-height: 1;
  }

  /* ── Front panel: the purple leather face ── */
  .wallet-front {
    /* The leather must swallow pointer events: with the tap toggle
       gone, a tap falling through onto a hidden card body would
       navigate from what looks like a tap on the embossed panel. */
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 48cqw;
    border-radius: clamp(16px, 3.4cqw, 26px);
    background:
      radial-gradient(120% 90% at 30% 0%, rgba(247, 244, 237, 0.06), transparent 55%),
      linear-gradient(150deg, #6f42a6, #5c3492 55%, #4a2a78);
    border: 3px solid #33205a;
    box-shadow: 14px 18px 0 rgba(0, 0, 0, 0.45);
    transform: translateZ(58px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.5rem, 1.8cqw, 1rem);
    padding: clamp(1rem, 4cqw, 2.5rem);
  }

  /* Leather grain — same turbulence device as the site-wide overlay */
  .wallet-front::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='leather'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23leather)' opacity='0.1'/%3E%3C/svg%3E");
    pointer-events: none;
  }

  /* Caution-yellow thread stitched inside the edge */
  .wallet-front::before {
    content: '';
    position: absolute;
    inset: clamp(8px, 1.8cqw, 14px);
    border: 2px dashed rgba(245, 208, 0, 0.55);
    border-radius: clamp(10px, 2.4cqw, 18px);
    pointer-events: none;
  }

  /* ── Embossed lettering: pressed into the leather, light catching
        the lower edge of each depression ── */
  .emboss {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.9rem, 8.4cqw, 4.1rem);
    letter-spacing: 0.05em;
    line-height: 1.05;
    text-transform: uppercase;
    text-align: center;
    color: #2b1850;
    text-shadow:
      0 1px 0 rgba(240, 232, 255, 0.24),
      0 -1px 1px rgba(0, 0, 0, 0.55);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.28em;
    position: relative;
    z-index: 1;
  }

  /* Gold-foil stamp for the number itself */
  .emboss-amount {
    color: var(--yellow);
    font-variant-numeric: tabular-nums;
  }

  .emboss-sub {
    font-family: 'Space Mono', monospace;
    font-size: clamp(0.55rem, 1.9cqw, 0.78rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.26em;
    text-align: center;
    color: rgba(20, 10, 40, 0.6);
    text-shadow: 0 1px 0 rgba(240, 232, 255, 0.22);
    position: relative;
    z-index: 1;
  }

  /* Maker's mark in the corner */
  .wallet-stamp {
    position: absolute;
    bottom: clamp(14px, 3.4cqw, 26px);
    right: clamp(16px, 4cqw, 30px);
    font-family: 'Space Mono', monospace;
    font-size: 0.58rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: rgba(20, 10, 40, 0.55);
    text-shadow: 0 1px 0 rgba(240, 232, 255, 0.18);
  }

  .wallet-donate-link {
    margin-top: var(--space-xs); /* clear the front panel's press shadow */
    font-family: 'Space Mono', monospace;
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--yellow);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .wallet-donate-link:hover { color: var(--off-white); }

  /* Narrow screens: same construction, slightly deeper slot so the
     rem-floored card text still fits its visible strip */
  @media (max-width: 520px) {
    .wallet3d { height: 72cqw; }
    .wcard { --slot-dy: 9cqw; }
    .wcard[data-slot='rear'] { --rest-y: 4cqw; }
    .wcard[data-slot='front'] { --rest-y: 13cqw; }
    .wallet-front { height: 50cqw; }
  }
</style>

<script>
  // Arrow-driven card cycling (touch devices; hidden on hover devices).
  // Pressing an arrow swaps the slots immediately — the rising card
  // transitions into the front slot — while the outgoing card replays
  // its old position via the swipe keyframes and swings out sideways,
  // dips behind the stack, and settles into the rear slot. Tapping a
  // card always just navigates; the arrows are real buttons, so
  // keyboard and screen-reader users cycle the same way.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Only a finished swipe may strip the swipe class: the entrance rise
  // also ends on this card (its animation stays in the swipe list), and
  // reacting to it would cut a concurrent swing-out short.
  for (const card of document.querySelectorAll<HTMLAnchorElement>('.wcard')) {
    card.addEventListener('animationend', (event) => {
      if (event.animationName.startsWith('wcard-swipe')) {
        card.classList.remove('is-swiping-left', 'is-swiping-right');
      }
    });
  }

  const cycle = (direction: 'left' | 'right') => {
    const front = document.querySelector<HTMLAnchorElement>('.wcard[data-slot="front"]');
    const rear = document.querySelector<HTMLAnchorElement>('.wcard[data-slot="rear"]');
    if (!front || !rear) return;
    // A press mid-swipe restarts cleanly: drop any running swipe class
    // so re-adding one re-triggers its animation from the new slots.
    for (const card of [front, rear]) {
      card.classList.remove('is-swiping-left', 'is-swiping-right');
    }

    rear.dataset.slot = 'front';
    front.dataset.slot = 'rear';
    if (reduceMotion) return;

    front.classList.add(direction === 'left' ? 'is-swiping-left' : 'is-swiping-right');
  };

  document.getElementById('cycleLeft')?.addEventListener('click', () => cycle('left'));
  document.getElementById('cycleRight')?.addEventListener('click', () => cycle('right'));

  // Refresh the embossed total with the live GoFundMe number, counting
  // up from the build-time value once the cards have risen out of the
  // wallet — the server-rendered amount stays up until then.
  const amountEl = document.getElementById('donationAmount');

  if (amountEl instanceof HTMLElement) {
    const format = (value: number) => `$${Math.round(value).toLocaleString('en-US')}`;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const parsed = Number(amountEl.dataset.total);
    const buildTotal = Number.isFinite(parsed) && parsed > 0 ? parsed : null;

    let shown = buildTotal ?? 0;
    let lastTarget: number | null = buildTotal;
    let raf = 0;

    const renderTo = (target: number) => {
      if (target === lastTarget) return;
      lastTarget = target;
      cancelAnimationFrame(raf);

      if (reduceMotion) {
        shown = target;
        amountEl.textContent = format(target);
        return;
      }

      const from = shown;
      const start = performance.now();
      const durationMs = 1100;
      const tick = (now: number) => {
        const t = Math.min((now - start) / durationMs, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        shown = from + (target - from) * eased;
        amountEl.textContent = format(shown);
        if (t < 1) raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    };

    // Hold the stamp until the cards' rise finishes (0.3s delay + 0.8s).
    const stampDelayMs = 1100;
    const loadedAt = performance.now();
    const reveal = (value: number) => {
      const wait = Math.max(0, stampDelayMs - (performance.now() - loadedAt));
      setTimeout(() => renderTo(value), wait);
    };

    fetch('/api/donation-total.json')
      .then((res) => (res.ok ? res.json() : null))
      .then((data: unknown) => {
        const live = (data as { amountRaised?: unknown } | null)?.amountRaised;
        if (typeof live === 'number' && Number.isFinite(live) && live > 0) reveal(live);
      })
      .catch(() => {
        /* build-time value (or the $— fallback) stays up */
      });
  }
</script>
