---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PersonSocials from '../../components/PersonSocials.astro';
import { team } from '../../lib/team';
import groupPhoto from '../../assets/film-group-pic-1.jpg';

/**
 * One page per team member (/about/david, /about/nandi, /about/fabiola),
 * built from src/lib/team.ts. The portrait is a CSS crop of the shared
 * group shot — no individual photo files exist yet; when the captain
 * supplies real portraits, swap the crop for a plain <Image> here.
 */
export function getStaticPaths() {
  return team.map((person) => ({ params: { person: person.id }, props: { person } }));
}

const { person } = Astro.props;

/**
 * Portrait crop math. The 4:5 frame shows the group photo zoomed to
 * z× the frame width, positioned so the person's portrait point
 * (fx, fy — fractions of the full photo frame) sits horizontally
 * centred and at 45% of the frame's height. Percentages are computed
 * here once so the CSS stays dumb.
 */
const PHOTO_AR = 5820 / 3858;
const FRAME_H = 1.25; // frame height in frame-width units (4:5)
const { fx, fy, z } = person.portrait;
const imgWidthPct = z * 100;
const imgLeftPct = (0.5 - fx * z) * 100;
const imgTopPct = ((0.45 * FRAME_H - (fy * z) / PHOTO_AR) / FRAME_H) * 100;
---

<BaseLayout title={`${person.name} — Trash Talk NYC`} description={person.metaDescription}>
  <PageHero eyebrowEn="The Crew" eyebrowEs="El Equipo" word={person.name.toUpperCase()}>
    <span class="accent">{person.name}</span>
  </PageHero>

  <section class="person-section grid-paper">
    <div class="person-inner">
      <figure class="person-polaroid">
        <div class="person-crop">
          <Image
            src={groupPhoto}
            alt={`${person.name} in the Trash Talk NYC team photo, sitting on a rock in a park`}
            class="person-img"
            width={1600}
            widths={[640, 960, 1280, 1600]}
            sizes={`(min-width: 900px) ${Math.round(420 * z)}px, ${Math.round(90 * z)}vw`}
            loading="eager"
            fetchpriority="high"
            style={`width:${imgWidthPct}%; left:${imgLeftPct}%; top:${imgTopPct}%;`}
          />
        </div>
        <figcaption class="person-polaroid-lip">TRASH TALK NYC</figcaption>
      </figure>

      <div class="person-text">
        <p class="person-role" data-en={person.role.en} data-es={person.role.es}>{person.role.en}</p>
        <div class="person-bio">
          {person.bio.map((b) => (
            <p data-en={b.en} data-es={b.es}>{b.en}</p>
          ))}
        </div>
        <div class="person-socials">
          <PersonSocials socials={person.socials} />
        </div>
        <nav class="person-links">
          <a class="person-back" href="/about" data-en="← Meet the whole crew" data-es="← Conoce a todo el equipo">← Meet the whole crew</a>
          <a class="person-join" href="/about#join" data-en="Join the team →" data-es="Únete al equipo →">Join the team →</a>
        </nav>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .person-section {
    background: var(--off-white);
    padding: var(--space-xl) max(var(--gutter), var(--safe-right)) var(--space-xl) max(var(--gutter), var(--safe-left));
    position: relative;
    overflow: hidden;
  }

  .person-section::before {
    content: '';
    position: absolute;
    left: -10%;
    top: -20%;
    width: 55vw;
    height: 100%;
    background: radial-gradient(ellipse at center, rgba(245, 208, 0, 0.07) 0%, transparent 65%);
    pointer-events: none;
  }

  .person-inner {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
    position: relative;
    z-index: 1;
  }

  @media (max-width: 820px) {
    .person-inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      max-width: 26rem;
    }
  }

  /* Polaroid plate: white frame, deep bottom lip, slight tilt, hard
     press shadow, two yellow tape strips — the site's photo device. */
  .person-polaroid {
    background: #fff;
    padding: 4% 4% 0;
    border-radius: 3px;
    box-shadow: var(--press);
    transform: rotate(-2deg);
    position: relative;
    margin-inline: auto;
    width: 100%;
    max-width: 420px;
  }

  .person-polaroid::before,
  .person-polaroid::after {
    content: '';
    position: absolute;
    top: -12px;
    width: 92px;
    height: 26px;
    background: rgba(245, 208, 0, 0.85);
    transform: rotate(-4deg);
    z-index: 2;
  }

  .person-polaroid::before { left: 8%; }
  .person-polaroid::after { right: 8%; transform: rotate(5deg); }

  /* The crop window: the group shot zoomed and offset (inline style
     from frontmatter) so this person fills a 4:5 portrait. height:auto
     beats the <Image> height attribute (see AGENTS.md gotcha). */
  .person-crop {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    line-height: 0;
  }

  .person-crop :global(.person-img) {
    position: absolute;
    height: auto;
    max-width: none;
  }

  .person-polaroid-lip {
    font-family: 'Space Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: rgba(28, 28, 34, 0.55);
    text-align: center;
    padding: 1.4rem 0 1.5rem;
    line-height: 1;
  }

  .person-role {
    font-family: 'Space Mono', monospace;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--warm-gray);
    margin-bottom: 1.3rem;
  }

  /* Hi-vis orange dash — same crossing-guard accent as the About cards */
  .person-role::before {
    content: '';
    display: inline-block;
    width: 1.1rem;
    height: 3px;
    background: var(--orange);
    border-radius: 2px;
    margin-right: 0.55rem;
    vertical-align: 0.18em;
  }

  .person-bio {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .person-bio p {
    font-size: 1rem;
    font-weight: 600;
    color: #4a4850;
    line-height: 1.75;
    max-width: 52ch;
  }

  .person-socials {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin-top: 1.6rem;
    flex-wrap: wrap;
    font-family: 'Space Mono', monospace;
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--purple);
    letter-spacing: 0.06em;
  }

  .person-socials :global(.social-link) {
    border-bottom: 2px solid rgba(107, 63, 160, 0.25);
    padding-bottom: 0.1rem;
    transition: color 160ms var(--ease-out), border-color 160ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .person-socials :global(.social-link:hover) {
      color: var(--purple-light);
      border-color: var(--purple-light);
    }
  }

  .person-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 2.2rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .person-links a {
    color: var(--charcoal);
    text-decoration: none;
    border-bottom: 2px solid var(--yellow);
    padding-bottom: 0.15rem;
    transition: color 160ms var(--ease-out), border-color 160ms var(--ease-out);
    min-height: 0;
  }

  @media (pointer: coarse) {
    .person-links a { display: inline-flex; align-items: center; min-height: var(--tap); }
  }

  @media (hover: hover) and (pointer: fine) {
    .person-links a:hover { color: var(--purple); border-color: var(--purple); }
  }
</style>
