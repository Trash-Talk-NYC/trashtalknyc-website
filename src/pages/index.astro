<script>
  import { actions } from 'astro:actions';
  import { getCurrentLang, onLanguageChange, submitErrorText, type Lang } from '../lib/language';
  import { attachFieldValidation, setFieldError } from '../lib/clientValidation';
  import { boroughForZip, parseZipPlace, zipLookupUrl, type Borough, type ZipPlace } from '../lib/zip';
  import { countries, US_COUNTRY, OTHER_COUNTRY } from '../lib/countries';
  import { attachCombobox, fetchJson, type ComboOption } from '../lib/combobox';

  attachFieldValidation();

  // ── WAIVER TEXT (bilingual) ──
  const waiverEN = 'By participating in a Trash Talk NYC community cleanup event, I acknowledge that outdoor cleanup activities involve inherent risks including — but not limited to — slipping or falling on uneven surfaces, cuts or punctures from sharp objects or broken glass, exposure to hazardous materials, traffic hazards near roadways, physical strain from lifting, and adverse weather conditions. I voluntarily assume all such risks.<br><br>To the fullest extent permitted by law, I release and discharge Trash Talk NYC, its organizers, coordinators, volunteers, and affiliated individuals from any and all liability, claims, or causes of action arising from injury, loss, or damage sustained during my participation — whether caused by negligence of the Released Parties or otherwise.<br><br>I confirm I am in adequate physical condition to participate. I agree to follow all safety instructions provided on the day of the event. I understand that <strong>participants under 18 must be accompanied by a parent or guardian</strong> who has signed a physical waiver at the event.';

  const waiverES = 'Al participar en un evento de limpieza comunitaria de Trash Talk NYC, reconozco que las actividades de limpieza al aire libre conllevan riesgos inherentes que incluyen — pero no se limitan a — resbalones o caídas en superficies irregulares, cortes o pinchazos de objetos afilados o vidrios rotos, exposición a materiales peligrosos, peligros de tráfico cerca de carreteras, esfuerzo físico al levantar objetos y condiciones climáticas adversas. Asumo voluntariamente todos estos riesgos.<br><br>En la máxima medida permitida por la ley, libero y descargo a Trash Talk NYC, sus organizadores, coordinadores, voluntarios e individuos afiliados de toda responsabilidad, reclamación o causa de acción derivada de lesiones, pérdidas o daños sufridos durante mi participación — ya sea causada por negligencia de las Partes Liberadas o de otro modo.<br><br>Confirmo que estoy en condiciones físicas adecuadas para participar. Acepto seguir todas las instrucciones de seguridad proporcionadas el día del evento. Entiendo que <strong>los participantes menores de 18 años deben estar acompañados por un padre o tutor</strong> que haya firmado una exención física en el evento.';

  const signupErrorEl = document.getElementById('signupFormError');

  onLanguageChange((lang) => {
    const wt = document.getElementById('waiverText');
    if (wt) wt.innerHTML = lang === 'es' ? waiverES : waiverEN;
    if (signupErrorEl?.textContent) signupErrorEl.textContent = submitErrorText(lang);
  });

  // Apply saved language to waiver on load
  if (getCurrentLang() !== 'en') {
    const wt = document.getElementById('waiverText');
    if (wt) wt.innerHTML = waiverES;
  }

  // ── PHOTO ALT TEXT ──
  // setLang never translates attributes, so the Contribute photo's alt
  // follows the language from its data-alt-* pair
  const altImages = Array.from(document.querySelectorAll<HTMLImageElement>('img[data-alt-en]'));
  const applyAlts = (lang: Lang) => altImages.forEach((img) => (img.alt = img.getAttribute(`data-alt-${lang}`) ?? img.alt));
  applyAlts(getCurrentLang());
  onLanguageChange(applyAlts);

  // ── SPAM-TIMING FIELD ──
  const startedAtInput = document.getElementById('signupStartedAt') as HTMLInputElement | null;
  if (startedAtInput) startedAtInput.value = String(Date.now());

  // ── "SOMEWHERE ELSE" FOLLOW-UP ──
  const hearSelect = document.getElementById('hear') as HTMLSelectElement | null;
  const hearOtherGroup = document.getElementById('hearOtherGroup') as HTMLElement | null;
  const hearOtherInput = document.getElementById('hearOther') as HTMLInputElement | null;

  hearSelect?.addEventListener('change', () => {
    if (!hearOtherGroup || !hearOtherInput) return;
    const somewhereElse = hearSelect.value === 'Somewhere else';
    hearOtherGroup.hidden = !somewhereElse;
    // A hidden field must never submit a stale value
    if (!somewhereElse) hearOtherInput.value = '';
  });

  // ── LOCATION (country first) ──
  // US: the ZIP fills in city and state (zippopotam.us, free and
  // keyless) and an NYC ZIP names the borough from our own table, so
  // there is no borough question. Elsewhere: city from a list plus an
  // optional region and postal code. The server re-checks all of it,
  // so this is only a preview and an early typo catch.
  const countrySelect = document.getElementById('w-country') as HTMLSelectElement | null;
  const zipGroup = document.getElementById('zipGroup') as HTMLElement | null;
  const zipInput = document.getElementById('w-zip') as HTMLInputElement | null;
  const zipStatus = document.getElementById('zipStatus') as HTMLElement | null;
  const cityGroup = document.getElementById('cityGroup') as HTMLElement | null;
  const cityInput = document.getElementById('w-city') as HTMLInputElement | null;
  const cityList = document.getElementById('cityList') as HTMLUListElement | null;
  const regionGroup = document.getElementById('regionGroup') as HTMLElement | null;
  const regionInput = document.getElementById('w-region') as HTMLInputElement | null;
  const postalGroup = document.getElementById('postalGroup') as HTMLElement | null;
  const postalInput = document.getElementById('w-postal') as HTMLInputElement | null;

  const ZIP_MSG = {
    short: { en: 'Enter a 5-digit ZIP code.', es: 'Escribe un código ZIP de 5 dígitos.' },
    unknown: { en: "We couldn't find that ZIP code.", es: 'No encontramos ese código ZIP.' },
    looking: { en: 'Looking up your ZIP…', es: 'Buscando tu código ZIP…' },
  };

  const BOROUGH_ES: Record<Borough, string> = {
    Manhattan: 'Manhattan',
    Brooklyn: 'Brooklyn',
    Queens: 'Queens',
    'The Bronx': 'El Bronx',
    'Staten Island': 'Staten Island',
  };

  type ZipState =
    | { kind: 'empty' }
    | { kind: 'short' }
    | { kind: 'looking' }
    | { kind: 'found'; place: ZipPlace; borough: Borough | undefined }
    | { kind: 'unknown' }
    // Lookup service down: the server still takes the ZIP, so no error
    | { kind: 'unavailable'; borough: Borough | undefined };

  let zipState: ZipState = { kind: 'empty' };
  let zipLookupSeq = 0;

  /** Renders the ZIP's status line and validity from zipState, in the current language. */
  function renderZip() {
    if (!zipInput || !zipStatus) return;
    const lang = getCurrentLang();
    const boroughText = (b: Borough | undefined) =>
      b ? (lang === 'es' ? `Condado: ${BOROUGH_ES[b]}` : `Borough: ${b}`) : '';
    let status = '';
    let error = '';
    switch (zipState.kind) {
      case 'looking':
        status = ZIP_MSG.looking[lang];
        break;
      case 'found':
        // An NYC ZIP shows only its borough (captain, 2026-10-21); any
        // other ZIP shows its city and state
        status = zipState.borough ? boroughText(zipState.borough) : `${zipState.place.city}, ${zipState.place.stateCode}`;
        break;
      case 'unavailable':
        status = boroughText(zipState.borough);
        break;
      case 'unknown':
        error = ZIP_MSG.unknown[lang];
        break;
      case 'short':
        error = ZIP_MSG.short[lang];
        break;
    }
    zipStatus.textContent = status;
    setFieldError(zipInput, error);
  }

  async function checkZip(final: boolean) {
    if (!zipInput) return;
    // Digits only, five max: paste-friendly ("11211-1234" → "11211")
    const digits = zipInput.value.replace(/\D/g, '').slice(0, 5);
    if (zipInput.value !== digits) zipInput.value = digits;
    const seq = ++zipLookupSeq;

    if (!digits) zipState = { kind: 'empty' };
    else if (digits.length < 5) zipState = final ? { kind: 'short' } : { kind: 'empty' };
    else {
      zipState = { kind: 'looking' };
      renderZip();
      const borough = boroughForZip(digits);
      try {
        const res = await fetch(zipLookupUrl(digits), { signal: AbortSignal.timeout(5000) });
        const place = res.ok ? parseZipPlace(await res.json()) : null;
        if (seq !== zipLookupSeq) return; // a newer keystroke owns the field
        if (res.status === 404) zipState = { kind: 'unknown' };
        else zipState = place ? { kind: 'found', place, borough } : { kind: 'unavailable', borough };
      } catch {
        if (seq !== zipLookupSeq) return;
        zipState = { kind: 'unavailable', borough };
      }
    }
    renderZip();
  }

  zipInput?.addEventListener('input', () => void checkZip(false));
  zipInput?.addEventListener('blur', () => void checkZip(true));

  // ── CITY PICKER (outside the US) ──
  // A real city from the Open-Meteo geocoding list (free, keyless),
  // scoped to the chosen country. An outage lets the typed city stand.
  const countryCodes = new Map(countries.map((c) => [c.value, c.code]));

  type OpenMeteoSearch = {
    results?: Array<{ name: string; country_code?: string; country?: string; admin1?: string }>;
  };

  async function searchCities(query: string, lang: Lang): Promise<ComboOption[]> {
    const data = await fetchJson<OpenMeteoSearch>(
      `https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(query)}&count=10&language=${lang}&format=json`,
    );
    const country = countrySelect?.value ?? '';
    const code = countryCodes.get(country) ?? null;
    const other = country === OTHER_COUNTRY;
    const hits = (data.results ?? [])
      .filter((r) => (other ? true : r.country_code === code))
      .slice(0, 6)
      .map((r) => {
        const region = other ? r.country : r.admin1;
        return region && region !== r.name ? `${r.name}, ${region}` : r.name;
      });
    return [...new Set(hits)].map((c) => ({ value: c, text: c }));
  }

  const cityPicker =
    cityInput && cityList
      ? attachCombobox({
          input: cityInput,
          list: cityList,
          search: searchCities,
          pickMessage: { en: 'Pick your city from the list.', es: 'Elige tu ciudad de la lista.' },
          emptyMessage: { en: 'No match yet. Keep typing.', es: 'Sin coincidencias todavía. Sigue escribiendo.' },
          onUnavailable: (picker) => picker.setInvalid(null),
        })
      : null;

  /** Shows the US or the outside-US fields for the chosen country. */
  function syncCountry() {
    if (!countrySelect || !zipGroup || !zipInput || !cityGroup || !cityInput) return;
    const us = countrySelect.value === US_COUNTRY;
    zipGroup.hidden = !us;
    zipInput.required = us;
    cityGroup.hidden = us;
    cityInput.required = !us;
    if (regionGroup) regionGroup.hidden = us;
    if (postalGroup) postalGroup.hidden = us;
    // Fields hidden from the person must never submit stale values
    if (us) {
      cityPicker?.reset();
      if (regionInput) regionInput.value = '';
      if (postalInput) postalInput.value = '';
    } else {
      zipInput.value = '';
      zipState = { kind: 'empty' };
      renderZip();
    }
  }

  countrySelect?.addEventListener('change', () => {
    cityPicker?.reset();
    syncCountry();
  });
  onLanguageChange(renderZip);
  syncCountry();

  // ── SUBMIT ──
  document.getElementById('volunteerForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;

    const submitBtn = form.querySelector<HTMLButtonElement>('.form-submit')!;
    const originalText = submitBtn.textContent ?? '';
    submitBtn.textContent = getCurrentLang() === 'es' ? 'Enviando…' : 'Submitting…';
    submitBtn.disabled = true;
    submitBtn.style.opacity = '0.7';
    if (signupErrorEl) signupErrorEl.textContent = '';

    const { error } = await actions.signup(new FormData(form));

    if (!error) {
      form.style.display = 'none';
      (document.getElementById('formSuccess') as HTMLElement).style.display = 'block';
      return;
    }

    // Turnstile tokens are single-use — the failed attempt consumed this
    // one, so reset the widget or a retry would submit a spent token
    window.turnstile?.reset();

    // Persistent aria-live message so the failure survives the transient
    // button swap and is announced by screen readers
    if (signupErrorEl) signupErrorEl.textContent = submitErrorText(getCurrentLang());
    submitBtn.textContent = submitErrorText(getCurrentLang());
    submitBtn.disabled = false;
    setTimeout(() => {
      submitBtn.textContent = originalText;
      submitBtn.style.opacity = '';
    }, 3500);
  });
</script>
