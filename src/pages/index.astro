---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchEventsAtBuildTime, formatDate, formatTime } from '../lib/events';
import { actions } from 'astro:actions';
import primaryLogo from '../assets/primary-logo.png';

const { upcoming } = await fetchEventsAtBuildTime();

const deepCleanEvents = upcoming.map((ev) => {
  const startIso = ev.start.local || ev.start.utc;
  const endIso = ev.end.local || ev.end.utc;
  const location = ev.venue ? (ev.venue.name || '') + (ev.venue.city ? `, ${ev.venue.city}` : '') : '';
  return {
    id: ev.id,
    name: ev.name,
    url: ev.url,
    startIso,
    endIso,
    dateStr: formatDate(startIso, 'en'),
    timeStr: `${formatTime(startIso, 'en')} – ${formatTime(endIso, 'en')}`,
    location,
    lat: ev.venue?.lat ?? undefined,
    lng: ev.venue?.lng ?? undefined,
  };
});
const defaultEvent = deepCleanEvents[0] ?? null;
const hasEventCoords = deepCleanEvents.some((ev) => ev.lat != null && ev.lng != null);
---

<BaseLayout title="Trash Talk NYC — Community Cleanup">

<!-- Load Eventbrite widget JS early; skipped on localhost so local dev doesn't depend on it -->
<script is:inline>
  if (location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
    var s = document.createElement('script');
    s.src = 'https://www.eventbrite.com/static/widgets/eb_widgets.js';
    document.head.appendChild(s);
  }
</script>

<!-- HERO -->
<section class="hero diag-texture" id="top">
  <div class="hero-bg-word" aria-hidden="true">TRASH&nbsp;TALK</div>
  <div class="hero-core">
    <div class="sticker hero-chip" data-en="New York City's Cleanup Club" data-es="El Club de Limpieza de Nueva York">New York City's Cleanup Club</div>
    <h1 class="sr-only">Trash Talk NYC</h1>
    <!-- densities covers retina at the 500px CSS max width; eager because
         the logo is the homepage LCP element -->
    <Image src={primaryLogo} alt="Trash Talk NYC" class="hero-logo" width={500} height={500} densities={[1, 2]} loading="eager" fetchpriority="high" />
    <div class="hero-btns">
      <a href="#signup" class="btn-primary" data-en="Join" data-es="Únete">Join</a>
      <a href="#deep-clean" class="btn-secondary" data-en="Next Club Event →" data-es="Próximo Evento del Club →">Next Club Event →</a>
    </div>
  </div>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      <div class="ticker-group">
        <span data-en="Keep NYC clean" data-es="Mantén NYC limpia">Keep NYC clean</span>
        <span data-en="Join the club" data-es="Únete al club">Join the club</span>
        <span data-en="Every block counts" data-es="Cada cuadra cuenta">Every block counts</span>
        <span data-en="All five boroughs" data-es="Los cinco condados">All five boroughs</span>
      </div>
      <div class="ticker-group">
        <span data-en="Keep NYC clean" data-es="Mantén NYC limpia">Keep NYC clean</span>
        <span data-en="Join the club" data-es="Únete al club">Join the club</span>
        <span data-en="Every block counts" data-es="Cada cuadra cuenta">Every block counts</span>
        <span data-en="All five boroughs" data-es="Los cinco condados">All five boroughs</span>
      </div>
    </div>
  </div>
</section>

<!-- BENTO: DEEP CLEAN + DONATE -->
<section class="bento grid-paper">
  <div class="bento-inner">

    <div class="bento-box deepclean-box" id="deep-clean">
      <div class="sticker bento-label" data-en="Deep Clean" data-es="Limpieza Profunda">Deep Clean</div>
      {defaultEvent ? (
        <div class="dc-body" id="dcBody">
          <div class="dc-eyebrow">
            <span class="pulse-dot"></span>
            <span data-en="Nearest cleanup" data-es="Limpieza más cercana">Nearest cleanup</span>
          </div>
          <h3 class="dc-event-name" id="dcEventName">{defaultEvent.name}</h3>
          <div class="dc-meta">
            <div class="dc-meta-row">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <span class="hero-date-text" id="dcDate" data-start-iso={defaultEvent.startIso}>{defaultEvent.dateStr}</span>
            </div>
            <div class="dc-meta-row">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span id="dcTime">{defaultEvent.timeStr}</span>
            </div>
            <div class="dc-meta-row" id="dcLocRow" style={defaultEvent.location ? '' : 'display:none'}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span id="dcLoc">{defaultEvent.location}</span>
            </div>
          </div>
          <button
            type="button"
            class="btn-eb-rsvp"
            id="dcRsvpBtn"
            data-event-id={defaultEvent.id}
            data-url={defaultEvent.url}
            data-name={defaultEvent.name}
            data-date={defaultEvent.dateStr}
            data-time={defaultEvent.timeStr}
            data-loc={defaultEvent.location}
            data-en="RSVP →" data-es="Regístrate →"
          >
            RSVP &rarr;
          </button>
        </div>
      ) : (
        <div class="dc-fallback">
          <p>
            <span data-en="No upcoming events right now — follow" data-es="No hay eventos próximos — síguenos en">No upcoming events right now — follow</span>
            {' '}<a href="https://www.instagram.com/trashtalk_nyc/" target="_blank" rel="noopener">@trashtalk_nyc</a>{' '}
            <span data-en="for updates." data-es="para actualizaciones.">for updates.</span>
          </p>
          <a href="#signup" class="dc-fallback-cta" data-en="Join the club list — hear about the next one first ↓" data-es="Únete a la lista — entérate primero del próximo ↓">Join the club list — hear about the next one first ↓</a>
        </div>
      )}
      {hasEventCoords && (
        <div id="dcEventsData" hidden>
          {deepCleanEvents.map((ev) => (
            <div
              class="dc-event-data"
              data-event-id={ev.id}
              data-url={ev.url}
              data-name={ev.name}
              data-date={ev.dateStr}
              data-time={ev.timeStr}
              data-loc={ev.location}
              data-start-iso={ev.startIso}
              data-lat={ev.lat}
              data-lng={ev.lng}
            ></div>
          ))}
        </div>
      )}
    </div>

    <div class="bento-box donate-box" id="donate">
      <div class="sticker bento-label bento-label-purple" data-en="Donate" data-es="Donar">Donate</div>
      <h3 class="donate-title" data-en="We are crushing it." data-es="Lo estamos logrando.">We are crushing it.</h3>
      <div class="gfm-widget-wrap">
        <div class="gfm-embed" data-url="https://www.gofundme.com/f/join-trash-talk-clean-up-new-york-together/widget/medium/"></div>
      </div>
      <a href="/about" class="donate-subtle-link" data-en="Where does our money go?" data-es="¿A dónde va nuestro dinero?">Where does our money go?</a>
    </div>

  </div>
</section>

<!-- CAN'T ATTEND CTA -->
<div class="cant-attend-cta grid-paper">
  <a href="#signup" class="cant-attend-link">
    <span class="cta-arrow" aria-hidden="true">&darr;</span>
    <span data-en="Can't attend just yet?" data-es="¿Aún no puedes asistir?">Can't attend just yet?</span>
    <span class="cta-arrow" aria-hidden="true">&darr;</span>
  </a>
</div>

<!-- SIGNUP -->
<section class="signup" id="signup">
  <div class="signup-inner">
    <div class="signup-header">
      <h2 class="sign-plate" data-en="Join Trash Talk" data-es="Únete a Trash Talk">Join Trash Talk</h2>
      <p class="signup-subtitle" data-en="New York City's Cleanup Club" data-es="El Club de Limpieza de Nueva York">New York City's Cleanup Club</p>
    </div>

    <div class="form-wrap">
      <form id="volunteerForm" method="POST" action={actions.signup}>
        <input type="hidden" name="botcheck" value="">
        <input type="hidden" name="startedAt" id="signupStartedAt" value="">
        <div class="form-row">
          <div class="form-group">
            <label for="fname" data-en="First name *" data-es="Nombre *">First name *</label>
            <input type="text" id="fname" name="fname" required placeholder="Jane" autocomplete="given-name">
          </div>
          <div class="form-group">
            <label for="lname" data-en="Last name *" data-es="Apellido *">Last name *</label>
            <input type="text" id="lname" name="lname" required placeholder="Doe" autocomplete="family-name">
          </div>
        </div>

        <div class="form-group">
          <label for="email" data-en="Email address *" data-es="Correo electrónico *">Email address *</label>
          <input type="email" id="email" name="email" required placeholder="jane@example.com" autocomplete="email">
        </div>

        <div class="form-group">
          <label for="phone"><span data-en="Phone number" data-es="Teléfono">Phone number</span> <span class="form-optional" data-en="(optional)" data-es="(opcional)">(optional)</span></label>
          <input type="tel" id="phone" name="phone" placeholder="(212) 555-0100" autocomplete="tel">
        </div>

        <div class="form-group borough-picker" id="boroughPickerGroup">
          <label class="borough-picker-label" data-en="Which borough do you live in? *" data-es="¿En qué condado vives? *">Which borough do you live in? *</label>
          <div class="borough-pills">
            <button type="button" class="borough-pill" data-borough="Manhattan">
              <span class="pill-emoji"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="10" width="3" height="11"/><rect x="6" y="6" width="4" height="15"/><rect x="11" y="4" width="3" height="17"/><rect x="15" y="8" width="4" height="13"/><rect x="20" y="12" width="2" height="9"/><line x1="1" y1="21" x2="23" y2="21"/></svg></span>
              <span data-en="Manhattan" data-es="Manhattan">Manhattan</span>
            </button>
            <button type="button" class="borough-pill" data-borough="Brooklyn">
              <span class="pill-emoji"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><line x1="2" y1="18" x2="22" y2="18"/><line x1="4" y1="18" x2="4" y2="8"/><line x1="20" y1="18" x2="20" y2="8"/><path d="M4 8 Q12 2 20 8"/><line x1="10" y1="8" x2="10" y2="18"/><line x1="14" y1="8" x2="14" y2="18"/></svg></span>
              <span data-en="Brooklyn" data-es="Brooklyn">Brooklyn</span>
            </button>
            <button type="button" class="borough-pill" data-borough="Queens">
              <span class="pill-emoji"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9"/><polygon points="12 3 14.5 9.5 21 12 14.5 14.5 12 21 9.5 14.5 3 12 9.5 9.5"/></svg></span>
              <span data-en="Queens" data-es="Queens">Queens</span>
            </button>
            <button type="button" class="borough-pill" data-borough="The Bronx">
              <span class="pill-emoji"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M12 2L8 10h3v10h2V10h3L12 2z"/><rect x="2" y="14" width="5" height="7"/><rect x="17" y="11" width="5" height="10"/><line x1="1" y1="21" x2="23" y2="21"/></svg></span>
              <span data-en="The Bronx" data-es="El Bronx">The Bronx</span>
            </button>
            <button type="button" class="borough-pill" data-borough="Staten Island">
              <span class="pill-emoji"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M2 20h20"/><path d="M5 17L3 9h18l-2 8H5z"/><rect x="9" y="5" width="6" height="5" rx="1"/><line x1="12" y1="5" x2="12" y2="2"/><line x1="9" y1="2" x2="15" y2="2"/></svg></span>
              <span data-en="Staten Island" data-es="Staten Island">Staten Island</span>
            </button>
          </div>
          <input type="hidden" id="borough" name="borough" required>
        </div>

        <div class="form-group">
          <label for="experience"><span data-en="Anything we should know?" data-es="¿Algo que debamos saber?">Anything we should know?</span> <span class="form-optional" data-en="(optional)" data-es="(opcional)">(optional)</span></label>
          <textarea id="experience" name="experience" data-placeholder-en="e.g. I've done this before, I have mobility limitations, I'm bringing a friend…" data-placeholder-es="p.ej. Ya he participado antes, tengo limitaciones de movilidad, voy con un amigo…" placeholder="e.g. I've done this before, I have mobility limitations, I'm bringing a friend…"></textarea>
        </div>

        <div class="form-group">
          <label for="hear"><span data-en="How'd you hear about us?" data-es="¿Cómo nos conociste?">How'd you hear about us?</span> <span class="form-optional" data-en="(optional)" data-es="(opcional)">(optional)</span></label>
          <!-- value attributes must exactly match the HEAR_ABOUT_US enum
               options configured in Brevo; display text is friendlier -->
          <select id="hear" name="hear">
            <option value="" selected data-en="Select one" data-es="Selecciona una opción">Select one</option>
            <option value="Saw Tree Guard" data-en="Saw a Tree Guard" data-es="Vi un Tree Guard">Saw a Tree Guard</option>
            <option value="Saw the Purple Vests" data-en="Saw the Purple Vests" data-es="Vi los chalecos morados">Saw the Purple Vests</option>
            <option value="My Block Entered the Clean Zone" data-en="My block entered the Clean Zone" data-es="Mi cuadra entró a la Zona Limpia">My block entered the Clean Zone</option>
            <option value="Word of Mouth" data-en="Word of mouth" data-es="De boca en boca">Word of mouth</option>
            <option value="Instagram" data-en="Instagram @trashtalk_nyc" data-es="Instagram @trashtalk_nyc">Instagram @trashtalk_nyc</option>
            <option value="TikTok" data-en="TikTok" data-es="TikTok">TikTok</option>
            <option value="LinkedIn" data-en="LinkedIn" data-es="LinkedIn">LinkedIn</option>
            <option value="Facebook" data-en="Facebook" data-es="Facebook">Facebook</option>
            <option value="YouTube" data-en="YouTube" data-es="YouTube">YouTube</option>
            <option value="Flyer / QR Code" data-en="Flyer / QR code" data-es="Volante / código QR">Flyer / QR code</option>
            <option value="Local Community Board" data-en="Local community board" data-es="Junta comunitaria local">Local community board</option>
          </select>
        </div>

        <!-- WAIVER -->
        <div class="form-group waiver-block">
          <div class="waiver-header" data-en="Release &amp; Waiver of Liability" data-es="Liberación y Exención de Responsabilidad">Release &amp; Waiver of Liability</div>
          <div class="waiver-text" id="waiverText">
            By participating in a Trash Talk NYC community cleanup event, I acknowledge that outdoor cleanup activities involve inherent risks including — but not limited to — slipping or falling on uneven surfaces, cuts or punctures from sharp objects or broken glass, exposure to hazardous materials, traffic hazards near roadways, physical strain from lifting, and adverse weather conditions. I voluntarily assume all such risks.<br><br>
            To the fullest extent permitted by law, I release and discharge Trash Talk NYC, its organizers, coordinators, volunteers, and affiliated individuals from any and all liability, claims, or causes of action arising from injury, loss, or damage sustained during my participation — whether caused by negligence of the Released Parties or otherwise.<br><br>
            I confirm I am in adequate physical condition to participate. I agree to follow all safety instructions provided on the day of the event. I understand that <strong>participants under 18 must be accompanied by a parent or guardian</strong> who has signed a physical waiver at the event.<br><br>
            I grant permission for Trash Talk NYC to photograph or video me during the event for use on social media, including Instagram (@trashtalk_nyc), for promotional and community purposes. Notify the organizer on the day if you do not consent.
          </div>
          <label class="waiver-check-row">
            <input type="checkbox" id="waiverCheck" name="waiverCheck" required>
            <span data-en="I have read and agree to the Release &amp; Waiver of Liability above. I understand this is a legally binding document and I am signing voluntarily. *" data-es="He leído y acepto la Liberación y Exención de Responsabilidad anterior. Entiendo que este es un documento legalmente vinculante y firmo voluntariamente. *">I have read and agree to the Release &amp; Waiver of Liability above. I understand this is a legally binding document and I am signing voluntarily. *</span>
          </label>
          <label class="waiver-check-row">
            <input type="checkbox" id="ageCheck" name="ageCheck" required>
            <span data-en="I confirm I am 18 years of age or older, OR that a parent or guardian will sign a physical waiver for me at the event. *" data-es="Confirmo que tengo 18 años o más, O que un padre o tutor firmará una exención física por mí en el evento. *">I confirm I am 18 years of age or older, OR that a parent or guardian will sign a physical waiver for me at the event. *</span>
          </label>
        </div>

        <button type="submit" class="form-submit" data-en="Submit my signup →" data-es="Enviar mi inscripción →">Submit my signup →</button>
        <!-- No data-en/data-es here: setLang() would inject the error text on
             every toggle even when no error occurred; the submit handler and
             onLanguageChange own this element's content -->
        <p class="form-error" id="signupFormError" aria-live="polite"></p>
      </form>

      <div class="form-success" id="formSuccess">
        <div class="check">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--purple)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" style="width:3rem;height:3rem"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/></svg>
        </div>
        <h3 data-en="Success" data-es="Éxito">Success</h3>
        <p data-en="We'll be in touch. See you out there." data-es="Estaremos en contacto. Nos vemos allá.">We'll be in touch. See you out there.</p>
      </div>
    </div>
  </div>
</section>

<!-- RSVP MODAL: fallback on localhost; Eventbrite widget used in production -->
<div class="modal-overlay" id="rsvpModal" onclick="if(event.target===this)closeModal()">
  <div class="modal-box">
    <div class="modal-header">
      <div class="modal-event-name" id="modalEventName"></div>
      <button class="modal-close" onclick="closeModal()" aria-label="Close">✕</button>
    </div>
    <div class="modal-meta">
      <div class="modal-meta-row">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <span id="modalDate"></span>
      </div>
      <div class="modal-meta-row">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span id="modalTime"></span>
      </div>
      <div class="modal-meta-row">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <span id="modalLoc"></span>
      </div>
    </div>
    <div class="eb-sim">
      <div class="eb-head">
        <span class="eb-logo">eventbrite</span>
        <span class="eb-secure">🔒 Secure checkout</span>
      </div>
      <div class="eb-ticket">
        <div>
          <div class="eb-ticket-name">General Admission</div>
          <div class="eb-ticket-price">Free</div>
        </div>
        <div class="eb-qty">
          <button class="eb-qty-btn" onclick="adjQty(-1)">−</button>
          <span class="eb-qty-num" id="modalQty">1</span>
          <button class="eb-qty-btn" onclick="adjQty(1)">+</button>
        </div>
      </div>
      <div class="eb-cta-area">
        <a class="eb-register" id="modalRegisterBtn" href="#" target="_blank" rel="noopener">Register Now</a>
      </div>
      <div class="eb-powered">Powered by Eventbrite</div>
    </div>
    <div class="modal-foot">Checkout handled securely by Eventbrite</div>
  </div>
</div>

<script is:inline defer src="https://www.gofundme.com/static/js/embed.js"></script>
</BaseLayout>

<style>
  /* ── HERO — centered street-poster composition ── */
  .hero {
    min-height: calc(100svh - var(--nav-h));
    background: var(--charcoal);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding:
      var(--space-lg)
      max(var(--gutter), var(--safe-right))
      calc(var(--space-lg) + 3.25rem)
      max(var(--gutter), var(--safe-left));
  }

  .hero::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(90vw, 60rem);
    height: 70%;
    background: radial-gradient(ellipse at center, rgba(107, 63, 160, 0.22) 0%, transparent 70%);
    pointer-events: none;
  }

  /* Giant outlined wordmark behind the logo — poster texture, not content */
  .hero-bg-word {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(7rem, 26vw, 24rem);
    letter-spacing: 0.02em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px rgba(155, 93, 229, 0.22);
    white-space: nowrap;
    user-select: none;
    pointer-events: none;
  }

  .hero-core {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-chip { margin-bottom: 0.5rem; }

  .hero-logo {
    width: clamp(270px, min(46vw, 52svh), 500px);
    height: auto;
    display: block;
    margin-bottom: var(--space-sm);
    filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.55));
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero-btns {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Sticker buttons: hard press shadow, tiny tilt, press-down on hover */
  .btn-primary,
  .btn-secondary {
    font-family: 'Nunito', sans-serif;
    font-size: 0.82rem;
