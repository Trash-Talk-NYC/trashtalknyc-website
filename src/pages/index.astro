---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { actions } from 'astro:actions';
import { getSocials } from '../lib/socials';
import { countries } from '../lib/countries';
import vestSticker from '../assets/vest-sticker.png';
import bricksTop from '../assets/bricks-top-lav.svg';
import bricksBottom from '../assets/bricks-bottom-lav.svg';
import illTreebed from '../assets/ill-treebed-beige.svg';
import illGloveShovel from '../assets/ill-glove-shovel-beige.svg';
import illGlovePlant from '../assets/ill-glove-plant-beige.svg';
import illFamilyVests from '../assets/ill-family-vests-beige.svg';

const socialTiles = getSocials(['instagram', 'tiktok', 'youtube', 'linkedin', 'facebook']);

// Baked in at build time (pages are prerendered): when unset, no widget
// renders and the signup action skips Turnstile verification. After setting
// the key in Netlify, a redeploy is required for the widget to appear.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

// Organization schema for Google: name + logo beside search results, and the
// social profiles it should associate with the brand.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Trash Talk NYC',
  url: Astro.site?.href,
  logo: new URL('/logo.png', Astro.site).href,
  sameAs: [
    'https://www.instagram.com/trashtalk_nyc/',
    'https://www.tiktok.com/@trashtalk_nyc',
    'https://trashtalknyc.eventbrite.com',
  ],
};
---

<BaseLayout
  title="Trash Talk NYC"
  description="Trash Talk NYC is New York City's cleanup club. Find upcoming community cleanup events, sign up for the newsletter, and help keep NYC clean."
>

<script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(orgSchema)} />

<!-- Turnstile bot check on the signup form; implicit rendering picks up the
     .cf-turnstile div. Only loaded when a site key was set at build time. -->
{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<!-- HERO: the brick drawing split into its two halves, stretched edge to
     edge, with the vest sticker logo centered in the opening and one
     button that says "Events" (captain). -->
<section class="hero" id="top">
  <img class="bricks bricks-top" src={bricksTop.src} alt="" />
  <img class="bricks bricks-bottom" src={bricksBottom.src} alt="" />
  <div class="hero-inner">
    <h1 class="sr-only">Trash Talk NYC</h1>
    <!-- eager: the vest sticker is the homepage LCP element -->
    <Image src={vestSticker} alt="Trash Talk NYC" class="hero-logo" width={440} densities={[1, 2]} loading="eager" fetchpriority="high" />
    <div class="hero-btns">
      <a href="/events" class="btn btn-primary" data-en="Events" data-es="Eventos">Events</a>
    </div>
  </div>
</section>

<!-- DONATE -->
<section class="bento">
  <div class="wrap bento-grid">
    <article class="card donate paste" id="donate">
      <img class="ill donate-art" src={illTreebed.src} alt="" />
      <h2 class="donate-title" data-en="Because of you:" data-es="Gracias a ti:">Because of you:</h2>
      <div class="gfm">
        <div class="gfm-embed" data-url="https://www.gofundme.com/f/join-trash-talk-clean-up-new-york-together/widget/medium/"></div>
      </div>
      <p class="donate-note" data-en="Trash Talk started in May 2026. Funds help scale cleanups, flower-planting, and builds." data-es="Trash Talk empezó en mayo de 2026. Los fondos ayudan a escalar las limpiezas, la plantación de flores y las construcciones.">Trash Talk started in May 2026. Funds help scale cleanups, flower-planting, and builds.</p>
    </article>
  </div>
</section>

<!-- SOCIALS -->
<section class="socials">
  <div class="wrap">
    <h2 data-en="Keep up with club socials" data-es="Síguenos en redes">Keep up with club socials</h2>
    <div class="soc-grid">
      {socialTiles.map((c) => (
        <a class="soc-tile paste" href={c.href} {...(c.placeholder ? {} : { target: '_blank', rel: 'noopener' })}>
          <span class="soc-badge" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={c.path} /></svg></span>
          <b>{c.label}</b>
          <small>{c.handle}</small>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- NEWSLETTER SIGNUP -->
<section class="signup" id="signup">
  <div class="wrap signup-grid">
    <div class="sign-head">
      <div class="sign-text">
        <h2 class="sign-plate"><span data-en="Trash Talk NYC" data-es="Trash Talk NYC">Trash Talk NYC</span> <span class="accent" data-en="Newsletter" data-es="Boletín">Newsletter</span></h2>
        <p class="sign-blurb" data-en="Get emailed about cleanups, tree guard builds, and other beautification efforts in your neighborhood." data-es="Recibe correos sobre limpiezas, construcción de protectores de árboles y otros esfuerzos de embellecimiento en tu vecindario.">Get emailed about cleanups, tree guard builds, and other beautification efforts in your neighborhood.</p>
      </div>
      <div class="sign-arts" aria-hidden="true">
        <img class="ill sign-art-shovel" src={illGloveShovel.src} alt="" />
        <img class="ill sign-art-plant" src={illGlovePlant.src} alt="" />
      </div>
    </div>

    <div class="form-wrap">
      <form id="volunteerForm" class="paste" method="POST" action={actions.signup}>
        <Image src={vestSticker} alt="" class="slap slap-form" width={110} densities={[1, 2]} />
        <input type="hidden" name="botcheck" value="" />
        <input type="hidden" name="startedAt" id="signupStartedAt" value="" />

        <div class="field">
          <label for="fname" data-en="First name *" data-es="Nombre *">First name *</label>
          <input type="text" id="fname" name="fname" required placeholder="Jane" autocomplete="given-name" />
        </div>
        <div class="field">
          <label for="lname" data-en="Last name *" data-es="Apellido *">Last name *</label>
          <input type="text" id="lname" name="lname" required placeholder="Doe" autocomplete="family-name" />
        </div>
        <div class="field">
          <label for="email" data-en="Email address *" data-es="Correo electrónico *">Email address *</label>
          <input type="email" id="email" name="email" required placeholder="jane@example.com" autocomplete="email" />
        </div>
        <div class="field">
          <label for="phone"><span data-en="Phone number" data-es="Teléfono">Phone number</span> <span class="opt" data-en="(optional)" data-es="(opcional)">(optional)</span></label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" />
        </div>

        <div class="field full">
          <label for="borough" data-en="Which borough do you live in? *" data-es="¿En qué condado vives? *">Which borough do you live in? *</label>
          <select id="borough" name="borough" required>
            <option value="" selected disabled data-en="Select your borough" data-es="Selecciona tu condado">Select your borough</option>
            <option value="Manhattan">Manhattan</option>
            <option value="Brooklyn">Brooklyn</option>
            <option value="Queens">Queens</option>
            <option value="The Bronx" data-en="The Bronx" data-es="El Bronx">The Bronx</option>
            <option value="Staten Island">Staten Island</option>
            <option value="Not in NYC" data-en="Not in NYC" data-es="Fuera de NYC">Not in NYC</option>
          </select>
        </div>

        <!-- Outside-NYC flow: country (starts on the US), city picked
             from a list, ZIP for the US only (captain). -->
        <div class="field full" id="whereGroup" hidden>
          <span class="lbl" data-en="Where are you located? *" data-es="¿Dónde te encuentras? *">Where are you located? *</span>
          <div class="loc-row">
            <div class="field">
              <label for="w-country" data-en="Country" data-es="País">Country</label>
              <select id="w-country" name="country">
                {countries.map((c) => (
                  <option value={c.value} selected={c.code === 'US'} data-en={c.value} data-es={c.es}>{c.value}</option>
                ))}
              </select>
            </div>
            <div class="field">
              <label for="w-city" data-en="City *" data-es="Ciudad *">City *</label>
              <div class="addr">
                <input id="w-city" name="city" autocomplete="off" placeholder="Start typing your city" data-placeholder-en="Start typing your city" data-placeholder-es="Empieza a escribir tu ciudad" role="combobox" aria-autocomplete="list" aria-expanded="false" />
                <ul class="addr-list" id="cityList" role="listbox" hidden></ul>
              </div>
            </div>
            <div class="field" id="zipGroup">
              <label for="w-zip" data-en="ZIP code *" data-es="Código ZIP *">ZIP code *</label>
              <input id="w-zip" name="zip" inputmode="numeric" autocomplete="postal-code" placeholder="e.g. 07030" data-placeholder-en="e.g. 07030" data-placeholder-es="p.ej. 07030" />
            </div>
          </div>
        </div>

        <div class="field full">
          <label for="experience"><span data-en="Anything we should know?" data-es="¿Algo que debamos saber?">Anything we should know?</span> <span class="opt" data-en="(optional)" data-es="(opcional)">(optional)</span></label>
          <textarea id="experience" name="experience" placeholder="e.g. I've done this before, I have mobility limitations, I'm bringing a friend…" data-placeholder-en="e.g. I've done this before, I have mobility limitations, I'm bringing a friend…" data-placeholder-es="p.ej. Ya he participado antes, tengo limitaciones de movilidad, voy con un amigo…"></textarea>
        </div>

        <div class="field full">
          <label for="hear"><span data-en="How'd you hear about us?" data-es="¿Cómo nos conociste?">How'd you hear about us?</span> <span class="opt" data-en="(optional)" data-es="(opcional)">(optional)</span></label>
          <!-- value attributes must exactly match the HEAR_ABOUT_US enum
               options configured in Brevo; display text is friendlier -->
          <select id="hear" name="hear">
            <option value="" selected data-en="Select one" data-es="Selecciona una opción">Select one</option>
            <option value="Saw Tree Guard" data-en="Saw a Tree Guard" data-es="Vi un Tree Guard">Saw a Tree Guard</option>
            <option value="Saw the Purple Vests" data-en="Saw the Purple Vests" data-es="Vi los chalecos morados">Saw the Purple Vests</option>
            <option value="My Block Entered the Clean Zone" data-en="My block entered the Clean Zone" data-es="Mi cuadra entró a la Zona Limpia">My block entered the Clean Zone</option>
            <option value="Word of Mouth" data-en="Word of mouth" data-es="De boca en boca">Word of mouth</option>
            <option value="Instagram" data-en="Instagram @trashtalk_nyc" data-es="Instagram @trashtalk_nyc">Instagram @trashtalk_nyc</option>
            <option value="TikTok" data-en="TikTok" data-es="TikTok">TikTok</option>
            <option value="LinkedIn" data-en="LinkedIn" data-es="LinkedIn">LinkedIn</option>
            <option value="Facebook" data-en="Facebook" data-es="Facebook">Facebook</option>
            <option value="YouTube" data-en="YouTube" data-es="YouTube">YouTube</option>
            <option value="Flyer / QR Code" data-en="Flyer / QR code" data-es="Volante / código QR">Flyer / QR code</option>
            <option value="Local Community Board" data-en="Local community board" data-es="Junta comunitaria local">Local community board</option>
          </select>
        </div>

        <!-- WAIVER -->
        <div class="field full waiver">
          <div class="waiver-head mono" data-en="Release &amp; Waiver of Liability" data-es="Liberación y Exención de Responsabilidad">Release &amp; Waiver of Liability</div>
          <div class="waiver-body" id="waiverText">
            By participating in a Trash Talk NYC community cleanup event, I acknowledge that outdoor cleanup activities involve inherent risks including — but not limited to — slipping or falling on uneven surfaces, cuts or punctures from sharp objects or broken glass, exposure to hazardous materials, traffic hazards near roadways, physical strain from lifting, and adverse weather conditions. I voluntarily assume all such risks.<br /><br />
            To the fullest extent permitted by law, I release and discharge Trash Talk NYC, its organizers, coordinators, volunteers, and affiliated individuals from any and all liability, claims, or causes of action arising from injury, loss, or damage sustained during my participation — whether caused by negligence of the Released Parties or otherwise.<br /><br />
            I confirm I am in adequate physical condition to participate. I agree to follow all safety instructions provided on the day of the event. I understand that <strong>participants under 18 must be accompanied by a parent or guardian</strong> who has signed a physical waiver at the event.<br /><br />
            I grant permission for Trash Talk NYC to photograph or video me during the event for use on social media, including Instagram (@trashtalk_nyc), for promotional and community purposes. Notify the organizer on the day if you do not consent.
          </div>
        </div>
        <label class="check full">
          <input type="checkbox" id="waiverCheck" name="waiverCheck" required />
          <span data-en="I have read and agree to the Release &amp; Waiver of Liability above. I understand this is a legally binding document and I am signing voluntarily. *" data-es="He leído y acepto la Liberación y Exención de Responsabilidad anterior. Entiendo que este es un documento legalmente vinculante y firmo voluntariamente. *">I have read and agree to the Release &amp; Waiver of Liability above. I understand this is a legally binding document and I am signing voluntarily. *</span>
        </label>
        <label class="check full">
          <input type="checkbox" id="ageCheck" name="ageCheck" required />
          <span data-en="I confirm I am 18 years of age or older, OR that a parent or guardian will sign a physical waiver for me at the event. *" data-es="Confirmo que tengo 18 años o más, O que un padre o tutor firmará una exención física por mí en el evento. *">I confirm I am 18 years of age or older, OR that a parent or guardian will sign a physical waiver for me at the event. *</span>
        </label>

        {turnstileSiteKey && (
          <div class="field full turnstile-group">
            <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="signup" data-theme="light"></div>
          </div>
        )}

        <button type="submit" class="btn btn-primary full form-submit" data-en="Submit my signup →" data-es="Enviar mi inscripción →">Submit my signup →</button>
        <!-- No data-en/data-es here: setLang() would inject the error text on
             every toggle even when no error occurred; the submit handler and
             onLanguageChange own this element's content -->
        <p class="form-error full" id="signupFormError" aria-live="polite"></p>
      </form>

      <div class="form-success paste" id="formSuccess">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><polyline points="9 12 11 14 15 10" /></svg>
        <h3 data-en="Success" data-es="Éxito">Success</h3>
        <p data-en="We'll be in touch. See you out there." data-es="Estaremos en contacto. Nos vemos allá.">We'll be in touch. See you out there.</p>
      </div>
    </div>
  </div>
</section>

<!-- BEHIND-THE-SCENES CREW CALLOUT: the signup above is the mailing list
     and is for everyone; this is the pitch for people who want to WORK on
     Trash Talk (roles live at /recruit). -->
<section class="crew">
  <div class="wrap crew-grid">
    <img class="ill crew-art" src={illFamilyVests.src} alt="" />
    <div>
      <h2 data-en="Help Trash Talk behind the scenes" data-es="Ayuda a Trash Talk detrás de cámaras">Help Trash Talk behind the scenes</h2>
      <p data-en="Every cleanup has a crew behind it: people filming, editing, and running our social media. If that's your kind of work, we'd love to meet you." data-es="Detrás de cada limpieza hay un equipo: gente que filma, edita y maneja nuestras redes sociales. Si eso es lo tuyo, queremos conocerte.">Every cleanup has a crew behind it: people filming, editing, and running our social media. If that's your kind of work, we'd love to meet you.</p>
      <a href="/recruit" class="btn btn-ghost-light" data-en="Introduce yourself" data-es="Preséntate">Introduce yourself</a>
    </div>
  </div>
</section>

<script is:inline defer src="https://www.gofundme.com/static/js/embed.js"></script>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── HERO ── */
  /* Hero min-height keeps the two brick halves from colliding at any
     width; the inner padding tracks the bricks' own height. */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: calc(100vw * 1.12);
    border-bottom: var(--ink);
  }

  .hero .bricks-top { top: 6px; }
  .hero .bricks-bottom { bottom: 6px; }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 16px;
    padding: calc(100vw * 0.13) 16px calc(100vw * 0.14);
  }

  .hero :global(.hero-logo) {
    width: 64%;
    max-width: 440px;
    height: auto;
    transform: rotate(-3deg);
    filter: drop-shadow(6px 6px 0 rgba(234, 233, 218, 0.25));
  }

  .hero-btns {
    display: flex;
    justify-content: center;
    margin: 0;
  }

  .hero-btns .btn { padding: 12px 34px; font-size: 0.8rem; }

  @media (min-width: 761px) {
    .hero { min-height: calc(100vw * 0.7); }
    .hero .bricks-top { top: 10px; }
    .hero .bricks-bottom { bottom: 10px; }
    .hero-inner { gap: 26px; padding: calc(100vw * 0.075) 16px calc(100vw * 0.08); }
    .hero :global(.hero-logo) { width: min(440px, 52%); }
    .hero-btns .btn { padding: 14px 22px; font-size: 0.85rem; }
  }

  /* ── DONATE ── */
  .bento { padding-block: 44px 30px; }

  .bento-grid {
    display: grid;
    grid-template-columns: minmax(0, 680px);
    justify-content: center;
  }

  .card {
    position: relative;
    padding: 34px 20px 24px;
  }

  .donate {
    background-color: var(--green);
    color: var(--beige);
  }

  .donate-art {
    position: absolute;
    width: 110px;
    right: 4px;
    top: 4px;
    opacity: 0.9;
  }

  .donate-title {
    font-size: 2.6rem;
    margin-bottom: 22px;
    padding-right: 100px;
  }

  .gfm {
    background: var(--paper);
    color: var(--black);
    border: var(--ink);
    border-radius: 10px;
    padding: 12px;
  }

  /* The live GoFundMe widget, boxed in poster paper so it reads as part
     of the card; its internals are an iframe and stay GoFundMe's. */
  .gfm :global(.gfm-embed) { min-height: 180px; }

  .donate-note { margin: 30px 0 0; font-size: 1.12rem; }

  @media (min-width: 761px) {
    .bento { padding-block: 84px 64px; }
    .card { padding: 40px 34px 34px; }
    .donate-art { width: 170px; right: 10px; top: 6px; }
    .donate-title { font-size: clamp(2.6rem, 4.8vw, 3.8rem); padding-right: 160px; }
    .gfm { padding: 18px; }
  }

  /* ── SOCIALS ── */
  .socials { padding-block: 44px 48px; }

  .socials h2 {
    font-size: clamp(2.6rem, 5vw, 4rem);
    color: var(--beige);
    margin-bottom: 24px;
  }

  .soc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .soc-tile {
    display: grid;
    justify-items: start;
    gap: 6px;
    padding: 16px 14px;
    background-color: var(--paper);
    color: var(--black);
    text-decoration: none;
    transition: transform 0.15s;
  }

  .soc-tile:hover { transform: translate(-2px, -3px) rotate(-0.6deg); }
  .soc-tile:last-child:nth-child(odd) { grid-column: 1 / -1; }

  .soc-badge {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--yellow);
    border: 3px solid var(--black);
    box-shadow: 0 0 0 4px var(--beige), 2px 4px 0 4px rgba(0, 0, 0, 0.3);
    display: grid;
    place-items: center;
    margin-bottom: 6px;
    transform: rotate(-6deg);
  }

  .soc-badge svg { width: 24px; height: 24px; fill: var(--black); }

  .soc-tile b { font-family: var(--body); font-weight: 700; font-size: 1.25rem; }

  .soc-tile small {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 0.78rem;
    color: var(--purple);
  }

  @media (min-width: 761px) {
    .socials { padding-block: 64px 70px; }
    .soc-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; }
    .soc-tile { padding: 20px 18px; }
    .soc-tile:last-child:nth-child(odd) { grid-column: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .soc-tile { transition: none; }
  }

  /* ── NEWSLETTER ── */
  .signup {
    padding-block: 36px 52px;
    border-block: 3px solid var(--beige);
  }

  .signup-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 34px;
    align-items: start;
  }

  /* Heading row: text column + the two glove drawings beside it */
  .sign-head {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .sign-text { display: grid; gap: 12px; min-width: 0; flex: 1; }

  .sign-plate {
    font-size: clamp(3.2rem, 8vw, 5rem);
    color: var(--beige);
    overflow-wrap: anywhere;
  }

  .sign-plate .accent { color: var(--yellow); }

  .sign-blurb { font-size: 1.2rem; max-width: 32ch; margin: 0; }

  .sign-arts {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: none;
  }

  /* The glove drawings carry empty space at the top of their artboard;
     crop so they sit near the section top. */
  .sign-arts .ill { width: 80px; height: 74px; object-fit: contain; }
  .sign-arts .sign-art-plant { object-fit: cover; object-position: center 42%; height: 56px; }

  @media (min-width: 761px) {
    .signup { padding-block: 56px 88px; }
    .sign-head { gap: 16px; }
    .sign-text { gap: 16px; }
    .sign-arts .ill { width: 120px; height: 110px; }
    .sign-arts .sign-art-plant { height: 84px; }
  }

  @media (min-width: 1101px) {
    .signup-grid { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 56px; }
    /* Capped so "Newsletter" fits the heading column as a whole word
       (the mockup's larger size broke it "Newslet/ter" mid-word) —
       overflow-wrap: anywhere above is a backstop, not the plan. */
    .sign-plate { font-size: clamp(3.2rem, 4.5vw, 4.4rem); }
  }

  /* ── FORM ── */
  #volunteerForm {
    background-color: var(--paper);
    color: var(--black);
    border-radius: 6px;
    padding: 22px 14px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 12px 10px;
    transform: rotate(-0.3deg);
  }

  #volunteerForm :global(.slap-form) {
    bottom: -34px;
    right: -10px;
    top: auto;
    width: 74px;
    height: auto;
    transform: rotate(-9deg);
  }

  #volunteerForm label,
  #volunteerForm .lbl { font-size: 0.88rem; }

  #volunteerForm input:not([type='checkbox']),
  #volunteerForm select,
  #volunteerForm textarea { font-size: 0.95rem; padding: 8px 10px; }

  .loc-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .loc-row .field:first-child { grid-column: 1 / -1; }
  .loc-row .field[hidden] { display: none; }

  .waiver {
    border: 2.5px dashed var(--black);
    border-radius: 8px;
    overflow: hidden;
    gap: 0;
  }

  .waiver-head {
    background: var(--black);
    color: var(--beige);
    padding: 10px 14px;
  }

  .waiver-body {
    max-height: 92px;
    overflow: auto;
    padding: 12px 14px;
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .check {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 0.95rem;
    line-height: 1.35;
    cursor: pointer;
  }

  .check input {
    appearance: none;
    flex: none;
    width: 24px;
    height: 24px;
    min-height: 0;
    padding: 0;
    border: var(--ink);
    border-radius: 5px;
    background: var(--paper-bright);
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .check input:checked { background: var(--yellow); }

  .check input:checked::after {
    content: '';
    width: 6px;
    height: 12px;
    border: solid var(--black);
    border-width: 0 3px 3px 0;
    transform: rotate(45deg) translate(-1px, -1px);
  }

  /* Reserve the widget's rendered height (normal size is 65px) so the
     submit button doesn't jump when the Turnstile iframe loads in */
  .turnstile-group { min-height: 65px; }

  .form-submit { font-size: 1rem; padding: 17px; }

  /* Stays rendered (never display:none) so screen readers announce text
     inserted into the aria-live region; :empty just collapses the gap */
  .form-error {
    font-size: 0.9rem;
    font-weight: 700;
    text-align: center;
    color: var(--error);
    margin: 0;
  }

  .form-error:empty { display: none; }

  .form-success {
    display: none;
    background-color: var(--paper);
    color: var(--black);
    border-radius: 6px;
    padding: 3rem 2rem;
    text-align: center;
  }

  .form-success svg { width: 3rem; height: 3rem; color: var(--purple); margin-bottom: 1rem; }
  .form-success h3 { font-size: 2.4rem; color: var(--purple); margin-bottom: 0.5rem; }
  .form-success p { font-weight: 600; }

  @media (min-width: 761px) {
    #volunteerForm {
      padding: 34px;
      gap: 14px;
      box-shadow: 8px 8px 0 var(--purple);
    }

    #volunteerForm :global(.slap-form) {
      top: -52px;
      right: -26px;
      bottom: auto;
      width: 110px;
    }

    #volunteerForm label,
    #volunteerForm .lbl { font-size: 1rem; }

    #volunteerForm input:not([type='checkbox']),
    #volunteerForm select,
    #volunteerForm textarea { font-size: 1.05rem; padding: 9px 12px; }

    .loc-row { grid-template-columns: 1.2fr 1fr 0.8fr; }
    .loc-row .field:first-child { grid-column: auto; }
  }

  /* ── CREW CALLOUT ── */
  .crew {
    background-color: var(--green);
    color: var(--beige);
    padding-block: 26px 52px;
  }

  .crew-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    align-items: center;
  }

  .crew-art {
    width: 150px;
    height: 110px;
    object-fit: cover;
    object-position: center 55%;
  }

  .crew h2 { font-size: 2.8rem; margin-bottom: 16px; }

  .crew p {
    font-size: 1.18rem;
    line-height: 1.62;
    max-width: 52ch;
    margin: 0 0 40px;
  }

  .crew .btn { width: 100%; }

  @media (min-width: 761px) {
    .crew { padding-block: 44px 80px; }
    .crew-grid { grid-template-columns: auto minmax(0, 1fr); gap: 56px; }
    .crew-art { width: 260px; height: 170px; }
    .crew h2 { font-size: clamp(2.8rem, 5vw, 4.4rem); margin-bottom: 18px; }
    .crew p { margin: 0 0 56px; }
    .crew .btn { width: auto; }
  }
</style>

<script>
  import { actions } from 'astro:actions';
  import { getCurrentLang, onLanguageChange, submitErrorText, type Lang } from '../lib/language';
  import { attachFieldValidation } from '../lib/clientValidation';
  import { countries, US_COUNTRY, OTHER_COUNTRY } from '../lib/countries';
  import { attachCombobox, fetchJson, type ComboOption } from '../lib/combobox';

  attachFieldValidation();

  // ── WAIVER TEXT (bilingual) ──
  const waiverEN = 'By participating in a Trash Talk NYC community cleanup event, I acknowledge that outdoor cleanup activities involve inherent risks including — but not limited to — slipping or falling on uneven surfaces, cuts or punctures from sharp objects or broken glass, exposure to hazardous materials, traffic hazards near roadways, physical strain from lifting, and adverse weather conditions. I voluntarily assume all such risks.<br><br>To the fullest extent permitted by law, I release and discharge Trash Talk NYC, its organizers, coordinators, volunteers, and affiliated individuals from any and all liability, claims, or causes of action arising from injury, loss, or damage sustained during my participation — whether caused by negligence of the Released Parties or otherwise.<br><br>I confirm I am in adequate physical condition to participate. I agree to follow all safety instructions provided on the day of the event. I understand that <strong>participants under 18 must be accompanied by a parent or guardian</strong> who has signed a physical waiver at the event.<br><br>I grant permission for Trash Talk NYC to photograph or video me during the event for use on social media, including Instagram (@trashtalk_nyc), for promotional and community purposes. Notify the organizer on the day if you do not consent.';

  const waiverES = 'Al participar en un evento de limpieza comunitaria de Trash Talk NYC, reconozco que las actividades de limpieza al aire libre conllevan riesgos inherentes que incluyen — pero no se limitan a — resbalones o caídas en superficies irregulares, cortes o pinchazos de objetos afilados o vidrios rotos, exposición a materiales peligrosos, peligros de tráfico cerca de carreteras, esfuerzo físico al levantar objetos y condiciones climáticas adversas. Asumo voluntariamente todos estos riesgos.<br><br>En la máxima medida permitida por la ley, libero y descargo a Trash Talk NYC, sus organizadores, coordinadores, voluntarios e individuos afiliados de toda responsabilidad, reclamación o causa de acción derivada de lesiones, pérdidas o daños sufridos durante mi participación — ya sea causada por negligencia de las Partes Liberadas o de otro modo.<br><br>Confirmo que estoy en condiciones físicas adecuadas para participar. Acepto seguir todas las instrucciones de seguridad proporcionadas el día del evento. Entiendo que <strong>los participantes menores de 18 años deben estar acompañados por un padre o tutor</strong> que haya firmado una exención física en el evento.<br><br>Doy permiso a Trash Talk NYC para fotografiarme o filmarme durante el evento para su uso en redes sociales, incluido Instagram (@trashtalk_nyc), con fines promocionales y comunitarios. Notifique al organizador el día del evento si no da su consentimiento.';

  const signupErrorEl = document.getElementById('signupFormError');

  onLanguageChange((lang) => {
    const wt = document.getElementById('waiverText');
    if (wt) wt.innerHTML = lang === 'es' ? waiverES : waiverEN;
    if (signupErrorEl?.textContent) signupErrorEl.textContent = submitErrorText(lang);
  });

  // Apply saved language to waiver on load
  if (getCurrentLang() !== 'en') {
    const wt = document.getElementById('waiverText');
    if (wt) wt.innerHTML = waiverES;
  }

  // ── SPAM-TIMING FIELD ──
  const startedAtInput = document.getElementById('signupStartedAt') as HTMLInputElement | null;
  if (startedAtInput) startedAtInput.value = String(Date.now());

  // ── OUTSIDE-NYC FLOW ──
  const boroughSelect = document.getElementById('borough') as HTMLSelectElement | null;
  const whereGroup = document.getElementById('whereGroup') as HTMLElement | null;
  const countrySelect = document.getElementById('w-country') as HTMLSelectElement | null;
  const cityInput = document.getElementById('w-city') as HTMLInputElement | null;
  const cityList = document.getElementById('cityList') as HTMLUListElement | null;
  const zipGroup = document.getElementById('zipGroup') as HTMLElement | null;
  const zipInput = document.getElementById('w-zip') as HTMLInputElement | null;

  // ── CITY PICKER ──
  // People choose a real city from a list instead of free typing. The
  // list comes from the Open-Meteo geocoding API (free, keyless),
  // scoped to the selected country's ISO code. An Open-Meteo outage
  // (network error or non-ok response) lets the typed city stand: the
  // server accepts any non-empty city, so signups never block on it.
  const countryCodes = new Map(countries.map((c) => [c.value, c.code]));

  type OpenMeteoSearch = {
    results?: Array<{ name: string; country_code?: string; country?: string; admin1?: string }>;
  };

  async function searchCities(query: string, lang: Lang): Promise<ComboOption[]> {
    const data = await fetchJson<OpenMeteoSearch>(
      `https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(query)}&count=10&language=${lang}&format=json`,
    );
    const country = countrySelect?.value ?? '';
    const code = countryCodes.get(country) ?? null;
    const other = country === OTHER_COUNTRY;
    const hits = (data.results ?? [])
      .filter((r) => (other ? true : r.country_code === code))
      .slice(0, 6)
      .map((r) => {
        const region = r.country_code === 'US' ? r.admin1 : other ? r.country : r.admin1;
        return region && region !== r.name ? `${r.name}, ${region}` : r.name;
      });
    return [...new Set(hits)].map((c) => ({ value: c, text: c }));
  }

  const cityPicker =
    cityInput && cityList
      ? attachCombobox({
          input: cityInput,
          list: cityList,
          search: searchCities,
          pickMessage: { en: 'Pick your city from the list.', es: 'Elige tu ciudad de la lista.' },
          emptyMessage: { en: 'No match yet. Keep typing.', es: 'Sin coincidencias todavía. Sigue escribiendo.' },
          onUnavailable: (picker) => picker.setInvalid(null),
        })
      : null;

  function syncLocation() {
    if (!boroughSelect || !whereGroup || !countrySelect || !cityInput || !zipGroup || !zipInput) return;
    const outside = boroughSelect.value === 'Not in NYC';
    const us = countrySelect.value === US_COUNTRY;
    whereGroup.hidden = !outside;
    cityInput.required = outside;
    // A non-US country hides ZIP so it is just City (captain)
    zipGroup.hidden = !us;
    zipInput.required = outside && us;
    const zipBad = outside && us && !!zipInput.value && !/^\d{5}(-\d{4})?$/.test(zipInput.value);
    zipInput.setCustomValidity(zipBad ? (getCurrentLang() === 'es' ? 'Escribe un código ZIP de 5 dígitos.' : 'Enter a 5-digit ZIP code.') : '');
    // Fields hidden from the user must never submit stale values
    if (!outside) {
      cityPicker?.reset();
      zipInput.value = '';
      zipInput.setCustomValidity('');
    }
  }

  boroughSelect?.addEventListener('change', () => {
    syncLocation();
    if (boroughSelect.value === 'Not in NYC') countrySelect?.focus();
  });
  countrySelect?.addEventListener('change', () => {
    cityPicker?.reset();
    syncLocation();
  });
  zipInput?.addEventListener('input', syncLocation);
  syncLocation();

  // ── SUBMIT ──
  document.getElementById('volunteerForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;

    const submitBtn = form.querySelector<HTMLButtonElement>('.form-submit')!;
    const originalText = submitBtn.textContent ?? '';
    submitBtn.textContent = getCurrentLang() === 'es' ? 'Enviando…' : 'Submitting…';
    submitBtn.disabled = true;
    submitBtn.style.opacity = '0.7';
    if (signupErrorEl) signupErrorEl.textContent = '';

    const { error } = await actions.signup(new FormData(form));

    if (!error) {
      form.style.display = 'none';
      (document.getElementById('formSuccess') as HTMLElement).style.display = 'block';
      return;
    }

    // Turnstile tokens are single-use — the failed attempt consumed this
    // one, so reset the widget or a retry would submit a spent token
    window.turnstile?.reset();

    // Persistent aria-live message so the failure survives the transient
    // button swap and is announced by screen readers
    if (signupErrorEl) signupErrorEl.textContent = submitErrorText(getCurrentLang());
    submitBtn.textContent = submitErrorText(getCurrentLang());
    submitBtn.disabled = false;
    setTimeout(() => {
      submitBtn.textContent = originalText;
      submitBtn.style.opacity = '';
    }, 3500);
  });
</script>
