    document.getElementById('modalEventName').textContent = btn.getAttribute('data-name') || '';
    document.getElementById('modalDate').textContent      = btn.getAttribute('data-date') || '';
    document.getElementById('modalTime').textContent      = btn.getAttribute('data-time') || '';
    document.getElementById('modalLoc').textContent       = btn.getAttribute('data-loc')  || '';
    document.getElementById('modalQty').textContent       = '1';
    var reg = document.getElementById('modalRegisterBtn');
    if (reg) reg.href = btn.getAttribute('data-url') || '#';
    document.getElementById('rsvpModal').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    document.getElementById('rsvpModal').classList.remove('open');
    document.body.style.overflow = '';
  }

  function adjQty(delta) {
    var el = document.getElementById('modalQty');
    el.textContent = Math.max(1, parseInt(el.textContent, 10) + delta);
  }

  function initWidgets(skipEl) {
    document.querySelectorAll('[data-event-id]').forEach(function(btn) {
      if (skipEl && btn === skipEl) return;
      var id = btn.getAttribute('data-event-id');
      if (!id || !btn.id || btn.dataset.widgetInit) return;
      btn.dataset.widgetInit = '1';
      if (btn._ebFallbackHandler) {
        btn.removeEventListener('click', btn._ebFallbackHandler);
        btn._ebFallbackHandler = null;
      }
      if (!isLocalhost && window.EBWidgets) {
        window.EBWidgets.createWidget({ widgetType: 'checkout', eventId: id, modal: true, modalTriggerElementId: btn.id });
      } else {
        btn._ebFallbackHandler = function() { openModal(btn); };
        btn.addEventListener('click', btn._ebFallbackHandler);
      }
    });
  }

  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });

  // ── DEEP CLEAN: nearest-event lookup via geolocation, falls back to the next upcoming event ──
  function haversineKm(lat1, lng1, lat2, lng2) {
    var R = 6371, dLat = (lat2-lat1)*Math.PI/180, dLng = (lng2-lng1)*Math.PI/180;
    var a = Math.sin(dLat/2)*Math.sin(dLat/2) + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLng/2)*Math.sin(dLng/2);
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  }

  function findNearestEvent(lat, lng) {
    var container = document.getElementById('dcEventsData');
    if (!container) return null;
    var candidates = Array.from(container.querySelectorAll('.dc-event-data[data-lat][data-lng]'));
    if (!candidates.length) return null;

    var nearest = null, nearestDist = Infinity;
    candidates.forEach(function(el) {
      var d = haversineKm(lat, lng, parseFloat(el.dataset.lat), parseFloat(el.dataset.lng));
      if (d < nearestDist) {
        nearestDist = d;
        nearest = el;
      }
    });
    if (!nearest) return null;
    return {
      eventId: nearest.dataset.eventId,
      url: nearest.dataset.url,
      name: nearest.dataset.name,
      date: nearest.dataset.date,
      time: nearest.dataset.time,
      loc: nearest.dataset.loc,
      startIso: nearest.dataset.startIso,
    };
  }

  function renderDcEvent(data) {
    var btn = document.getElementById('dcRsvpBtn');
    if (!btn || !data || btn.getAttribute('data-event-id') === data.eventId) return;

    document.getElementById('dcEventName').textContent = data.name;
    var dateEl = document.getElementById('dcDate');
    dateEl.textContent = data.date;
    if (data.startIso) dateEl.setAttribute('data-start-iso', data.startIso);
    document.getElementById('dcTime').textContent = data.time;

    var locRow = document.getElementById('dcLocRow');
    var locSpan = document.getElementById('dcLoc');
    if (data.loc) {
      if (locSpan) locSpan.textContent = data.loc;
      if (locRow) locRow.style.display = '';
    } else if (locRow) {
      locRow.style.display = 'none';
    }

    btn.setAttribute('data-event-id', data.eventId);
    btn.setAttribute('data-url', data.url);
    btn.setAttribute('data-name', data.name);
    btn.setAttribute('data-date', data.date);
    btn.setAttribute('data-time', data.time);
    btn.setAttribute('data-loc', data.loc);
    delete btn.dataset.widgetInit;
    initWidgets();
  }

  document.addEventListener('DOMContentLoaded', function() {
    var dcBtn = document.getElementById('dcRsvpBtn');
    var hasCoords = document.querySelector('#dcEventsData .dc-event-data[data-lat]');
    var deferDc = !!(dcBtn && hasCoords && navigator.geolocation);

    initWidgets(deferDc ? dcBtn : null);
    if (!deferDc) return;

    var origEn = dcBtn.getAttribute('data-en');
    var origEs = dcBtn.getAttribute('data-es');
    var isEs = typeof window.getCurrentLang === 'function' && window.getCurrentLang() === 'es';
    dcBtn.disabled = true;
    dcBtn.setAttribute('data-en', 'Loading…');
    dcBtn.setAttribute('data-es', 'Cargando…');
    dcBtn.textContent = isEs ? 'Cargando…' : 'Loading…';

    function settleDc(nearest) {
      if (nearest) renderDcEvent(nearest);
      dcBtn.setAttribute('data-en', origEn);
      dcBtn.setAttribute('data-es', origEs);
      dcBtn.textContent = (typeof window.getCurrentLang === 'function' && window.getCurrentLang() === 'es') ? origEs : origEn;
      dcBtn.disabled = false;
      initWidgets();
    }

    navigator.geolocation.getCurrentPosition(
      function(pos) {
        settleDc(findNearestEvent(pos.coords.latitude, pos.coords.longitude));
      },
      function() { settleDc(null); /* denied/unavailable — keep the next-upcoming-event fallback already rendered */ },
      { timeout: 6000 },
    );
  });
</script>

<script>
  import { actions } from 'astro:actions';
  import { getCurrentLang, onLanguageChange, submitErrorText } from '../lib/language';
  import { formatDate } from '../lib/events';

  // ── WAIVER TEXT (bilingual) ──
  const waiverEN = 'By participating in a Trash Talk NYC community cleanup event, I acknowledge that outdoor cleanup activities involve inherent risks including — but not limited to — slipping or falling on uneven surfaces, cuts or punctures from sharp objects or broken glass, exposure to hazardous materials, traffic hazards near roadways, physical strain from lifting, and adverse weather conditions. I voluntarily assume all such risks.<br><br>To the fullest extent permitted by law, I release and discharge Trash Talk NYC, its organizers, coordinators, volunteers, and affiliated individuals from any and all liability, claims, or causes of action arising from injury, loss, or damage sustained during my participation — whether caused by negligence of the Released Parties or otherwise.<br><br>I confirm I am in adequate physical condition to participate. I agree to follow all safety instructions provided on the day of the event. I understand that <strong>participants under 18 must be accompanied by a parent or guardian</strong> who has signed a physical waiver at the event.<br><br>I grant permission for Trash Talk NYC to photograph or video me during the event for use on social media, including Instagram (@trashtalk_nyc), for promotional and community purposes. Notify the organizer on the day if you do not consent.';

  const waiverES = 'Al participar en un evento de limpieza comunitaria de Trash Talk NYC, reconozco que las actividades de limpieza al aire libre conllevan riesgos inherentes que incluyen — pero no se limitan a — resbalones o caídas en superficies irregulares, cortes o pinchazos de objetos afilados o vidrios rotos, exposición a materiales peligrosos, peligros de tráfico cerca de carreteras, esfuerzo físico al levantar objetos y condiciones climáticas adversas. Asumo voluntariamente todos estos riesgos.<br><br>En la máxima medida permitida por la ley, libero y descargo a Trash Talk NYC, sus organizadores, coordinadores, voluntarios e individuos afiliados de toda responsabilidad, reclamación o causa de acción derivada de lesiones, pérdidas o daños sufridos durante mi participación — ya sea causada por negligencia de las Partes Liberadas o de otro modo.<br><br>Confirmo que estoy en condiciones físicas adecuadas para participar. Acepto seguir todas las instrucciones de seguridad proporcionadas el día del evento. Entiendo que <strong>los participantes menores de 18 años deben estar acompañados por un padre o tutor</strong> que haya firmado una exención física en el evento.<br><br>Doy permiso a Trash Talk NYC para fotografiarme o filmarme durante el evento para su uso en redes sociales, incluido Instagram (@trashtalk_nyc), con fines promocionales y comunitarios. Notifique al organizador el día del evento si no da su consentimiento.';

  // ── SUBMIT ERROR MESSAGE (aria-live region, bilingual) ──
  const signupErrorEl = document.getElementById('signupFormError');

  // ── LANGUAGE CHANGE HANDLER ──
  onLanguageChange((lang) => {
    const wt = document.getElementById('waiverText');
    if (wt) wt.innerHTML = lang === 'es' ? waiverES : waiverEN;

    const dateEl = document.querySelector<HTMLElement>('.hero-date-text[data-start-iso]');
    if (dateEl) dateEl.textContent = formatDate(dateEl.dataset.startIso!, lang);

    if (signupErrorEl?.textContent) signupErrorEl.textContent = submitErrorText(lang);
  });

  // Apply saved language to waiver on load
  if (getCurrentLang() !== 'en') {
    const wt = document.getElementById('waiverText');
    if (wt) wt.innerHTML = waiverES;
  }

  // ── SPAM-TIMING FIELD ──
  const startedAtInput = document.getElementById('signupStartedAt') as HTMLInputElement | null;
  if (startedAtInput) startedAtInput.value = String(Date.now());

  // ── BOROUGH PICKER ──
  const boroughInput = document.getElementById('borough') as HTMLInputElement | null;
  document.querySelectorAll<HTMLButtonElement>('.borough-pill').forEach((pill) => {
    pill.addEventListener('click', () => {
      document.querySelectorAll('.borough-pill').forEach((p) => p.classList.remove('selected'));
      pill.classList.add('selected');
      if (boroughInput) boroughInput.value = pill.dataset.borough ?? '';
    });
  });

  // ── VOLUNTEER FORM SUBMIT ──
  document.getElementById('volunteerForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;

    if (!boroughInput?.value) {
      const group = document.getElementById('boroughPickerGroup')!;
      group.scrollIntoView({ behavior: 'smooth', block: 'center' });
      group.querySelectorAll<HTMLElement>('.borough-pill').forEach((p) => {
        p.style.borderColor = '#c0392b';
        setTimeout(() => { p.style.borderColor = ''; }, 1800);
      });
      return;
    }

    const submitBtn = form.querySelector<HTMLButtonElement>('.form-submit')!;
    const originalText = submitBtn.textContent ?? '';
    submitBtn.textContent = getCurrentLang() === 'es' ? 'Enviando…' : 'Submitting…';
    submitBtn.disabled = true;
    submitBtn.style.opacity = '0.7';
    if (signupErrorEl) signupErrorEl.textContent = '';

    const { error } = await actions.signup(new FormData(form));

    if (!error) {
      form.style.display = 'none';
      (document.getElementById('formSuccess') as HTMLElement).style.display = 'block';
      return;
    }

    // Persistent aria-live message so the failure survives the transient
    // button swap and is announced by screen readers
    if (signupErrorEl) signupErrorEl.textContent = submitErrorText(getCurrentLang());
    submitBtn.textContent = submitErrorText(getCurrentLang());
    submitBtn.style.background = '#c0392b';
    submitBtn.style.borderColor = '#c0392b';
    submitBtn.style.color = '#fff';
    submitBtn.disabled = false;
    setTimeout(() => {
      submitBtn.textContent = originalText;
      submitBtn.style.background = '';
      submitBtn.style.borderColor = '';
      submitBtn.style.color = '';
      submitBtn.style.opacity = '';
    }, 3500);
  });
</script>
