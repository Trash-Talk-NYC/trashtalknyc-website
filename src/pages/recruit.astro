---
import BaseLayout from '../layouts/BaseLayout.astro';
import WallHero from '../components/WallHero.astro';
import wallHero from '../assets/walls/wall-blue-plate.webp';

/**
 * Open Roles — the recruitment page, top-level at /recruit (captain,
 * round 20; moved from /contact/join, where it was "Join the Team").
 * 2026-10 redesign: no hero and no page-title box. The page is a short
 * "Open Roles" heading, the two role posters, and the email button.
 * Applications stay email-only. The captain-verbatim "A note before you
 * apply" letter was removed on team feedback (2026-10-15); it lives in
 * git history.
 *
 * The "[your name]" placeholder in the mailto subject is deliberate —
 * a mailto can't know the sender, so the subject asks them to say so
 * (captain's sketch: "I'm <name> and I want to join Trash Talk NYC").
 * English subjects are baked into the static hrefs; the language toggle
 * swaps them client-side from data-subject-* attributes, because
 * setLang never translates attributes.
 */
const TEAM_EMAIL = 'team@trashtalknyc.org';
const mailto = (subject: string) => `mailto:${TEAM_EMAIL}?subject=${encodeURIComponent(subject)}`;

// The captain's subject line, verbatim; role boxes append the role after
// an em dash so an application still says what it's for.
const baseSubject = {
  en: "I'm [your name] and I want to join Trash Talk NYC",
  es: 'Soy [tu nombre] y quiero unirme a Trash Talk NYC',
};

// Two roles since 2026-10 (captain: "remove all roles other than
// social media manager and long form videography") — the Content
// Videographer / Editor poster lives in git history if it returns.
const roles = [
  {
    tone: 'r-purple',
    title: { en: 'Social Media Manager', es: 'Gestor/a de Redes' },
    // Captain's copy verbatim ("vital organ" stays exactly); only
    // "channel" was pluralized — the club runs Instagram, TikTok and
    // Eventbrite. The Spanish keeps the anatomical metaphor.
    // Every bare "Trash Talk" on this page (both role descriptions and
    // the note) became "Trash Talk NYC" on the captain's approval
    // (2026-10-09), a sanctioned change to the verbatim copy.
    desc: {
      en: 'Run the channels. Social media is a vital organ of Trash Talk NYC.',
      es: 'Maneja las cuentas. Las redes sociales son un órgano vital de Trash Talk NYC.',
    },
  },
  {
    tone: 'r-black',
    title: { en: 'Long-form Videographer / Editor', es: 'Videógrafo/a / Editor/a de Formato Largo' },
    // Captain's copy — people and policy over time, and the three-month
    // compound effect are theirs; keep the substance intact.
    desc: {
      en: "Help us tell the slower, deeper stories behind Trash Talk NYC. We move fast on cleanups, but we want to document projects, people, and policy over time. In just three months there is a compound effect of sustained community effort we are looking forward to capturing.",
      es: 'Ayúdanos a contar las historias más lentas y profundas detrás de Trash Talk NYC. En las limpiezas nos movemos rápido, pero queremos documentar proyectos, personas y políticas a lo largo del tiempo. En apenas tres meses ya hay un efecto compuesto del esfuerzo comunitario sostenido que esperamos capturar.',
    },
  },
].map((r) => ({
  ...r,
  subject: {
    en: `${baseSubject.en} — ${r.title.en}`,
    es: `${baseSubject.es} — ${r.title.es}`,
  },
}));

---

<BaseLayout
  title="Open Roles — Trash Talk NYC"
  description="Trash Talk NYC needs helping hands. Open roles in social media and long-form video. Apply by email to team@trashtalknyc.org."
>
  <!-- The shared left-aligned hero on the captain's wall pick
       (2026-10-21) -->
  <WallHero src={wallHero} title={[{ en: 'Open Roles', es: 'Puestos Abiertos' }]} seed={19} />

  <section class="wrap rc-body">
    <div class="roles">
      {roles.map((r) => (
        <a class:list={['role', 'paste', r.tone, r.tone === 'r-black' ? 'f-tape' : 'f-staple']} href={mailto(r.subject.en)} data-subject-en={r.subject.en} data-subject-es={r.subject.es}>
          <span class="role-t" data-en={r.title.en} data-es={r.title.es}>{r.title.en}</span>
          <span class="role-d" data-en={r.desc.en} data-es={r.desc.es}>{r.desc.en}</span>
          <span class="apply mono"><span data-en="Apply →" data-es="Postúlate →">Apply →</span></span>
        </a>
      ))}
    </div>
    <!-- The address alone read as plain text on phones; a leading verb
         and the arrow make it an action (captain: "like an action
         word"). The address stays visible so it can be remembered or
         long-pressed. -->
    <div class="email">
      <a class="btn btn-primary" href={mailto(baseSubject.en)} data-subject-en={baseSubject.en} data-subject-es={baseSubject.es}>
        <span class="email-label" data-en="✉ Email" data-es="✉ Escribe a">✉ Email</span> <span class="email-addr">{TEAM_EMAIL} <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* The address never breaks mid-word: on phones the label and the
     address stack as two clean lines (captain, 2026-10-21: "the spacing
     is really messed up here"), on desktop they share one */
  .email-addr { white-space: nowrap; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }

  /* ── ROLES ── */
  .rc-body {
    display: grid;
    gap: 24px;
    padding-block: 56px 44px;
  }


  .roles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    align-items: stretch;
  }

  .role {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px 18px;
    text-decoration: none;
    color: var(--beige);
    transition: transform 0.15s;
  }

  .role:hover { transform: translate(-2px, -3px) rotate(-0.4deg); }

  .r-purple { --flyer-bg: var(--purple); }
  .r-green { --flyer-bg: var(--green); }

  /* The black role poster needs an edge on the black ground */
  .r-black {
    --flyer-bg: var(--black);
    box-shadow: inset 0 0 0 3px var(--lavender), 6px 7px 0 rgba(20, 20, 24, 0.55);
  }


  .role-t {
    font-family: var(--display);
    font-weight: 400;
    font-size: 1.9rem;
    line-height: 0.95;
  }

  .role-d { font-size: 1.05rem; line-height: 1.5; }

  .apply {
    margin-top: auto;
    align-self: flex-start;
    background: var(--yellow);
    color: var(--black);
    border: 2.5px solid var(--black);
    border-radius: 8px;
    padding: 8px 14px;
  }

  .email {
    display: grid;
    justify-items: center;
    gap: 12px;
    text-align: center;
  }

  /* The team inbox is the page's one action, so it is the biggest
     button on the site (captain, 2026-10-09: "bigger and more
     pronounced") */
  .email .btn {
    width: 100%;
    flex-direction: column;
    gap: 6px;
    font-size: 1rem;
    line-height: 1.2;
    padding: 18px 22px;
    letter-spacing: 0.02em;
    box-shadow: 6px 6px 0 rgba(234, 233, 218, 0.4);
  }

  @media (min-width: 761px) {
    .rc-body { gap: 34px; padding-block: 56px 72px; }
    /* Two posters since 2026-10; capped and centered so a pair doesn't
       stretch into billboard-wide sheets inside the 1240px wrap */
    .roles { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; max-width: 57.5rem; margin-inline: auto; width: 100%; }
    .role { padding: 26px 24px 22px; }
    .role-t { font-size: 2.2rem; }
    .email .btn { width: auto; flex-direction: row; gap: 0.5em; font-size: clamp(1.15rem, 1.6vw, 1.4rem); padding: 22px 36px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .role { transition: none; }
  }
</style>

<script>
  import { getCurrentLang, onLanguageChange, type Lang } from '../lib/language';

  // Mailto subjects are baked into the hrefs in English at build time
  // (the no-JS default); setLang swaps textContent only, never
  // attributes, so the language toggle re-renders the hrefs here.
  const mailLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-subject-en]'));

  function applyMailSubjects(lang: Lang) {
    mailLinks.forEach((a) => {
      const subject = lang === 'es' ? a.dataset.subjectEs : a.dataset.subjectEn;
      if (subject) a.href = `mailto:team@trashtalknyc.org?subject=${encodeURIComponent(subject)}`;
    });
  }

  if (getCurrentLang() !== 'en') applyMailSubjects(getCurrentLang());
  onLanguageChange(applyMailSubjects);
</script>
