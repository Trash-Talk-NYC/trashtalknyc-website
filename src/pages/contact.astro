---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { actions } from 'astro:actions';
---

<BaseLayout title="Contact — Trash Talk NYC">

  <PageHero eyebrowEn="Contact" eyebrowEs="Contacto" word="HELLO">
    <span data-en="TALK TO" data-es="HABLA CON">TALK TO</span><br /><span class="accent" data-en="TRASH TALK" data-es="TRASH TALK">TRASH TALK</span>
  </PageHero>

  <section class="contact-section grid-paper">
    <div class="contact-inner">
      <div class="form-wrap">
        <div class="contact-tabs" role="tablist">
          <button type="button" class="contact-tab active" id="tabGeneral" data-type="general" role="tab" aria-selected="true">
            <span data-en="General" data-es="General">General</span>
          </button>
          <button type="button" class="contact-tab" id="tabPartnership" data-type="partnership" role="tab" aria-selected="false">
            <span data-en="Collaborate" data-es="Colaborar">Collaborate</span>
          </button>
        </div>

        <h2 class="form-heading" id="formHeading">Message Trash Talk NYC</h2>
        <p class="form-intro" id="formIntro">Questions, concerns, or a bug to report — we typically respond within 24 hours.</p>

        <div class="form-success" id="formSuccess">
          <div class="success-icon">✓</div>
          <h3 data-en="Message sent!" data-es="¡Mensaje enviado!">Message sent!</h3>
          <p data-en="We'll get back to you as soon as we can." data-es="Te responderemos lo antes posible.">We'll get back to you as soon as we can.</p>
        </div>

        <form id="contactForm" method="POST" action={actions.contact}>
          <input type="hidden" name="botcheck" value="" />
          <input type="hidden" name="startedAt" id="contactStartedAt" value="" />
          <input type="hidden" name="inquiryType" id="inquiryType" value="general" />

          <div class="form-row">
            <div class="form-group">
              <label for="fname" data-en="First name *" data-es="Nombre *">First name *</label>
              <input type="text" id="fname" name="fname" required placeholder="Jane" autocomplete="given-name" data-placeholder-en="Jane" data-placeholder-es="Jane" />
            </div>
            <div class="form-group">
              <label for="lname" data-en="Last name *" data-es="Apellido *">Last name *</label>
              <input type="text" id="lname" name="lname" required placeholder="Doe" autocomplete="family-name" data-placeholder-en="Doe" data-placeholder-es="Doe" />
            </div>
          </div>

          <div class="form-group">
            <label for="email" data-en="Email address *" data-es="Correo electrónico *">Email address *</label>
            <input type="email" id="email" name="email" required placeholder="jane@example.com" autocomplete="email" data-placeholder-en="jane@example.com" data-placeholder-es="jane@ejemplo.com" />
          </div>

          <div class="form-group">
            <label for="phone"><span data-en="Phone number" data-es="Teléfono">Phone number</span> <span class="form-optional" data-en="(optional)" data-es="(opcional)">(optional)</span></label>
            <input type="tel" id="phone" name="phone" placeholder="(212) 555-0100" autocomplete="tel" />
          </div>

          <div class="form-group" id="orgGroup" hidden>
            <label for="organization" data-en="Organization, brand, or group name *" data-es="Organización, marca o grupo *">Organization, brand, or group name *</label>
            <input type="text" id="organization" name="organization" autocomplete="organization" />
          </div>

          <div class="form-group">
            <label for="message" data-en="Message *" data-es="Mensaje *">Message *</label>
            <textarea id="message" name="message" required></textarea>
          </div>

          <button type="submit" class="form-submit" id="submitBtn" data-en="Send message →" data-es="Enviar mensaje →">Send message →</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-section {
    padding: var(--space-lg) max(var(--gutter), var(--safe-right)) var(--space-xl) max(var(--gutter), var(--safe-left));
  }

  .contact-inner {
    max-width: 600px;
    margin: 0 auto;
  }

  .form-wrap {
    background: #fff;
    border-radius: var(--radius-md);
    border: 2.5px solid var(--charcoal);
    box-shadow: var(--press);
    padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1.25rem, 3.5vw, 2rem);
    text-align: center;
  }

  .form-wrap :global(form),
  .form-wrap .form-group,
  .form-wrap .form-row {
    text-align: left;
  }

  .contact-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  /* Tabs styled as pressable sign plates: the active tab sits "pressed
     down" (translated into its shadow) in charcoal + yellow */
  .contact-tab {
    flex: 1;
    background: var(--off-white);
    border: 2px solid var(--charcoal);
    border-radius: 8px;
    padding: 0.65rem 1rem;
    min-height: var(--tap);
    font-family: 'Nunito', sans-serif;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--gray);
    cursor: pointer;
    box-shadow: var(--press-sm);
    transition: transform 0.15s var(--ease-out), box-shadow 0.15s var(--ease-out), background 0.15s, color 0.15s;
  }

  .contact-tab:hover { color: var(--charcoal); }

  .contact-tab.active {
    background: var(--charcoal);
    color: var(--yellow);
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--charcoal);
  }

  .form-heading {
    font-family: 'Bebas Neue', sans-serif;
    font-size: var(--step-2);
    letter-spacing: 0.04em;
    color: var(--charcoal);
    margin-bottom: 0.5rem;
  }

  .form-intro {
    font-size: 0.92rem;
    color: var(--gray);
    margin-bottom: 1.75rem;
    line-height: 1.5;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0 1rem;
  }

  .form-group label {
    display: block;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--charcoal);
    margin-bottom: 0.4rem;
  }

  .form-optional { font-size: 0.7rem; color: var(--gray); margin-left: 0.2rem; font-weight: 400; }

  /* 16px input text so iOS Safari doesn't zoom the page on focus */
  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.7rem 0.9rem;
    min-height: var(--tap);
    border: 1.5px solid var(--cream);
    border-radius: 8px;
    font-family: 'Nunito', sans-serif;
    font-size: 1rem;
    color: var(--charcoal);
    background: var(--off-white);
    transition: border-color 0.15s;
    outline: none;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--purple);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 130px;
  }

  .form-submit {
    width: 100%;
    padding: 0.85rem 1.5rem;
    min-height: 52px;
    background: var(--yellow);
    color: var(--charcoal);
    border: 2.5px solid var(--charcoal);
    border-radius: 8px;
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    box-shadow: 4px 4px 0 var(--charcoal);
    transition: transform 0.15s var(--ease-out), box-shadow 0.15s var(--ease-out), background 0.15s;
    margin-top: 0.75rem;
  }

  .form-submit:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--charcoal);
  }
  .form-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; box-shadow: var(--press-sm); }

  /* ── SUCCESS STATE ── */
  .form-success {
    display: none;
    text-align: center;
    padding: 2rem 1rem;
  }

  .form-success .success-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .form-success h3 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2rem;
    letter-spacing: 0.04em;
    color: var(--charcoal);
    margin-bottom: 0.5rem;
  }

  .form-success p {
    color: var(--gray);
    font-size: 0.9rem;
  }
</style>

<script>
  import { actions } from 'astro:actions';
  import { getCurrentLang, onLanguageChange } from '../lib/language';

  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const btn = document.getElementById('submitBtn') as HTMLButtonElement | null;
  const successDiv = document.getElementById('formSuccess') as HTMLElement | null;
  const orgGroup = document.getElementById('orgGroup') as HTMLElement | null;
  const orgInput = document.getElementById('organization') as HTMLInputElement | null;
  const inquiryTypeInput = document.getElementById('inquiryType') as HTMLInputElement | null;
  const tabGeneral = document.getElementById('tabGeneral') as HTMLButtonElement | null;
  const tabPartnership = document.getElementById('tabPartnership') as HTMLButtonElement | null;
  const headingEl = document.getElementById('formHeading') as HTMLElement | null;
  const introEl = document.getElementById('formIntro') as HTMLElement | null;
  const startedAtInput = document.getElementById('contactStartedAt') as HTMLInputElement | null;

  if (startedAtInput) startedAtInput.value = String(Date.now());

  type ContactType = 'general' | 'partnership';
  let currentType: ContactType = 'general';

  // formHeading/formIntro intentionally carry no data-en/data-es attributes —
  // their text depends on tab type as well as language, so this object is the
  // sole owner of their content (matches the #waiverText pattern in index.astro).
  const copy: Record<ContactType, Record<'en' | 'es', { heading: string; intro: string }>> = {
    general: {
      en: { heading: 'Message Trash Talk NYC', intro: "Questions, concerns, or report a bug on the site." },
      es: { heading: 'Escríbenos', intro: 'Preguntas, comentarios o reporta un error en el sitio.' },
    },
    partnership: {
      en: { heading: 'Collaborate with Trash Talk NYC', intro: "Have an idea to create something together? Organizations, creators, and community partners — let's discuss!" },
      es: { heading: 'Colabora con Trash Talk NYC', intro: '¿Tienes una idea para crear algo juntos? Organizaciones, creadores y aliados comunitarios — ¡hablemos!' },
    },
  };

  function applyCopy() {
    const c = copy[currentType][getCurrentLang()];
    if (headingEl) headingEl.textContent = c.heading;
    if (introEl) introEl.textContent = c.intro;
  }

  function setType(type: ContactType) {
    currentType = type;
    tabGeneral?.classList.toggle('active', type === 'general');
    tabPartnership?.classList.toggle('active', type === 'partnership');
    tabGeneral?.setAttribute('aria-selected', String(type === 'general'));
    tabPartnership?.setAttribute('aria-selected', String(type === 'partnership'));

    if (orgGroup) orgGroup.hidden = type !== 'partnership';
    if (orgInput) orgInput.required = type === 'partnership';
    if (inquiryTypeInput) inquiryTypeInput.value = type;

    applyCopy();
  }

  tabGeneral?.addEventListener('click', () => setType('general'));
  tabPartnership?.addEventListener('click', () => setType('partnership'));

  // Keep heading/intro in sync when the user switches language
  onLanguageChange(() => applyCopy());

  applyCopy();

  form?.addEventListener('submit', async (e: Event) => {
    e.preventDefault();
    if (!form || !btn || !successDiv) return;

    const originalText = btn.textContent ?? '';
    btn.disabled = true;
    btn.textContent = getCurrentLang() === 'es' ? 'Enviando…' : 'Sending…';

    const { error } = await actions.contact(new FormData(form));

    if (!error) {
      form.style.display = 'none';
      successDiv.style.display = 'block';
      return;
    }

    btn.textContent = getCurrentLang() === 'es'
      ? '¡Algo salió mal! Inténtalo de nuevo.'
      : 'Something went wrong — please try again.';
    btn.style.background = '#c0392b';
    btn.style.borderColor = '#c0392b';
    btn.style.color = '#fff';
    btn.disabled = false;
    setTimeout(() => {
      btn.textContent = originalText;
      btn.style.background = '';
      btn.style.borderColor = '';
      btn.style.color = '';
    }, 3500);
  });
</script>
