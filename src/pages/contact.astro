---
import Bricks from '../components/Bricks.astro';
import { brickHeroStyle, type BrickRows } from '../lib/bricks';
import BaseLayout from '../layouts/BaseLayout.astro';
import { actions } from 'astro:actions';
import { rollingMonths } from '../lib/months';

/**
 * Contact — Talk Trash (sentence case, captain 2026-10-09). The choices are poster tiles in the captain's
 * order (Lead a Cleanup / Collaborate / Sponsor / General) and no form
 * shows until a tile is picked. General, Collaborate and Sponsor share
 * one message form (the existing contact action); Lead a Cleanup is
 * its own application form backed by the leadCleanup action, with NYC
 * GeoSearch address picking, libphonenumber validation, and secure
 * route photos.
 */

// Baked in at build time (pages are prerendered): when unset, no widget
// renders and the actions skip Turnstile verification. After setting
// the key in Netlify, a redeploy is required for the widget to appear.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

// Build-time rendering of the rolling months; the page script re-derives
// them on load so a stale build can never offer a month already past.
const monthOptions = rollingMonths();

// Whole brick rows per half: as many as this hero's height fits
const bricks: BrickRows = { phone: 6, desktop: 3 };
---

<BaseLayout
  title="Contact — Trash Talk NYC"
  description="Get in touch with Trash Talk NYC: apply to lead a cleanup, collaborate on content, sponsor cleanups, or ask us anything."
>

  <!-- Turnstile bot check on both forms; implicit rendering picks up the
       .cf-turnstile divs. Only loaded when a site key was set at build time. -->
  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

  <!-- HERO -->
  <section class="ct-hero brick-hero" style={brickHeroStyle(bricks)}>
    <Bricks rows={bricks} />
    <div class="ct-hero-inner">
      <div class="mono ct-eyebrow" data-en="Contact" data-es="Contacto">Contact</div>
      <h1 class="ct-title"><span data-en="Talk" data-es="Habla">Talk</span><br /><span class="accent" data-en="Trash" data-es="Basura">Trash</span></h1>
    </div>
  </section>

  <!-- The form is its own section and "Help out behind the scenes" is
       the next one (captain, 2026-10-09) — no side column, no loose
       decoration beside them. -->
  <section class="wrap ct-body">
    <div class="ct-form paste f-tape">
      <div class="pick-label mono" id="pickLabel" data-en="Choose one to start" data-es="Elige una opción para empezar">Choose one to start</div>
      <div class="tiles" role="group" aria-labelledby="pickLabel">
        <button type="button" class="tile" aria-pressed="false" data-type="lead">
          <b data-en="Lead a Cleanup" data-es="Lidera una Limpieza">Lead a Cleanup</b>
          <small data-en="Apply to lead a cleanup with Trash Talk NYC" data-es="Postúlate para liderar una limpieza con Trash Talk NYC">Apply to lead a cleanup with Trash Talk NYC</small>
        </button>
        <button type="button" class="tile" aria-pressed="false" data-type="partnership">
          <b data-en="Collaborate" data-es="Colaborar">Collaborate</b>
          <small data-en="For content or podcast collaborations" data-es="Para colaboraciones de contenido o pódcast">For content or podcast collaborations</small>
        </button>
        <button type="button" class="tile" aria-pressed="false" data-type="sponsor">
          <b data-en="Sponsor" data-es="Patrocinar">Sponsor</b>
          <small data-en="Put your name behind cleanups" data-es="Pon tu nombre detrás de las limpiezas">Put your name behind cleanups</small>
        </button>
        <button type="button" class="tile" aria-pressed="false" data-type="general">
          <b data-en="General" data-es="General">General</b>
          <small data-en="For questions, concerns, or a website bug" data-es="Para preguntas, comentarios o un error del sitio">For questions, concerns, or a website bug</small>
        </button>
      </div>

      <div class="form-area" id="formArea" hidden>
        <h2 id="formHeading">Message Trash Talk NYC</h2>
        <p class="intro" id="formIntro">Questions, concerns, or report a bug on the site.</p>

        <div class="form-success" id="formSuccess">
          <div class="success-icon" aria-hidden="true">✓</div>
          <h3 data-en="Message sent!" data-es="¡Mensaje enviado!">Message sent!</h3>
          <p data-en="We'll get back to you as soon as we can." data-es="Te responderemos lo antes posible.">We'll get back to you as soon as we can.</p>
        </div>

        <!-- GENERAL / COLLABORATE / SPONSOR -->
        <form id="contactForm" method="POST" action={actions.contact}>
          <input type="hidden" name="botcheck" value="" />
          <input type="hidden" name="startedAt" data-started-at value="" />
          <input type="hidden" name="inquiryType" id="inquiryType" value="general" />

          <div class="field">
            <label for="c-fname" data-en="First name *" data-es="Nombre *">First name *</label>
            <input type="text" id="c-fname" name="fname" required placeholder="Jane" autocomplete="given-name" />
          </div>
          <div class="field">
            <label for="c-lname" data-en="Last name *" data-es="Apellido *">Last name *</label>
            <input type="text" id="c-lname" name="lname" required placeholder="Doe" autocomplete="family-name" />
          </div>
          <div class="field">
            <label for="c-email" data-en="Email address *" data-es="Correo electrónico *">Email address *</label>
            <input type="email" id="c-email" name="email" required placeholder="jane@example.com" autocomplete="email" />
          </div>
          <div class="field">
            <label for="c-phone"><span data-en="Phone number" data-es="Teléfono">Phone number</span> <span class="opt" data-en="(optional)" data-es="(opcional)">(optional)</span></label>
            <input type="tel" id="c-phone" name="phone" autocomplete="tel" />
          </div>
          <div class="field full" id="orgGroup" hidden>
            <label for="c-org" data-en="Organization, brand, or group name *" data-es="Organización, marca o grupo *">Organization, brand, or group name *</label>
            <input type="text" id="c-org" name="organization" autocomplete="organization" />
          </div>
          <div class="field full">
            <label for="c-msg" data-en="Message *" data-es="Mensaje *">Message *</label>
            <textarea id="c-msg" name="message" required></textarea>
          </div>

          {turnstileSiteKey && (
            <div class="field full turnstile-group">
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="contact" data-theme="light"></div>
            </div>
          )}

          <button type="submit" class="btn btn-primary full form-submit" data-en="Send message →" data-es="Enviar mensaje →">Send message →</button>
          <p class="form-error full" id="contactFormError" aria-live="polite"></p>
        </form>

        <!-- LEAD A CLEANUP -->
        <form id="leadForm" method="POST" action={actions.leadCleanup} hidden>
          <input type="hidden" name="botcheck" value="" />
          <input type="hidden" name="startedAt" data-started-at value="" />
          <input type="hidden" name="behalf" id="behalfInput" value="individual" />
          <input type="hidden" name="routeType" id="routeTypeInput" value="loop" />

          <fieldset class="field full bare-fieldset">
            <legend class="lbl" data-en="Applying on behalf of *" data-es="Postulación en nombre de *">Applying on behalf of *</legend>
            <div class="chips" role="radiogroup" aria-label="Applying on behalf of">
              <button type="button" class="chip-btn" role="radio" aria-checked="true" data-behalf="individual" data-en="An individual" data-es="Una persona">An individual</button>
              <button type="button" class="chip-btn" role="radio" aria-checked="false" data-behalf="organization" data-en="An organization" data-es="Una organización">An organization</button>
            </div>
          </fieldset>

          <div class="field">
            <label for="l-fname" data-en="First name *" data-es="Nombre *">First name *</label>
            <input type="text" id="l-fname" name="fname" required autocomplete="given-name" />
          </div>
          <div class="field">
            <label for="l-lname" data-en="Last name *" data-es="Apellido *">Last name *</label>
            <input type="text" id="l-lname" name="lname" required autocomplete="family-name" />
          </div>
          <div class="field full">
            <label for="l-mail" data-en="Mailing address *" data-es="Dirección postal *">Mailing address *</label>
            <input type="text" id="l-mail" name="mailingAddress" required autocomplete="street-address" placeholder="Street, apt, city, state, ZIP" data-placeholder-en="Street, apt, city, state, ZIP" data-placeholder-es="Calle, apto, ciudad, estado, ZIP" />
          </div>
          <div class="field">
            <label for="l-email" data-en="Email address *" data-es="Correo electrónico *">Email address *</label>
            <input type="email" id="l-email" name="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="l-phone" data-en="Phone number *" data-es="Teléfono *">Phone number *</label>
            <input type="tel" id="l-phone" name="phone" required autocomplete="tel" />
          </div>

          <fieldset class="field full bare-fieldset">
            <legend class="lbl" data-en="Route type *" data-es="Tipo de ruta *">Route type *</legend>
            <div class="chips" role="radiogroup" aria-label="Route type">
              <button type="button" class="chip-btn" role="radio" aria-checked="true" data-route="loop" data-en="Loop" data-es="Circuito">Loop</button>
              <button type="button" class="chip-btn" role="radio" aria-checked="false" data-route="oneway" data-en="One-way route" data-es="Ruta de ida">One-way route</button>
            </div>
          </fieldset>

          <div class="field" id="startGroup">
            <label for="l-start" data-en="Starting address *" data-es="Dirección de inicio *">Starting address *</label>
            <div class="addr">
              <input id="l-start" name="startAddress" class="addr-in" autocomplete="off" required placeholder="Start typing an NYC address" data-placeholder-en="Start typing an NYC address" data-placeholder-es="Empieza a escribir una dirección de NYC" role="combobox" aria-autocomplete="list" aria-expanded="false" />
              <input type="hidden" name="startAddressId" class="addr-id" />
              <input type="hidden" name="startAddressPoint" class="addr-point" />
              <ul class="addr-list" id="l-start-list" role="listbox" hidden></ul>
              <p class="addr-ok" hidden data-en="✓ Found on the map" data-es="✓ Encontrada en el mapa">✓ Found on the map</p>
              <p class="addr-err f-err" id="l-start-err" aria-live="polite" hidden></p>
            </div>
          </div>
          <div class="field" id="endGroup" hidden>
            <label for="l-end" data-en="End address *" data-es="Dirección final *">End address *</label>
            <div class="addr">
              <input id="l-end" name="endAddress" class="addr-in" autocomplete="off" placeholder="Start typing an NYC address" data-placeholder-en="Start typing an NYC address" data-placeholder-es="Empieza a escribir una dirección de NYC" role="combobox" aria-autocomplete="list" aria-expanded="false" />
              <input type="hidden" name="endAddressId" class="addr-id" />
              <input type="hidden" name="endAddressPoint" class="addr-point" />
              <ul class="addr-list" id="l-end-list" role="listbox" hidden></ul>
              <p class="addr-ok" hidden data-en="✓ Found on the map" data-es="✓ Encontrada en el mapa">✓ Found on the map</p>
              <p class="addr-err f-err" id="l-end-err" aria-live="polite" hidden></p>
            </div>
          </div>

          <!-- Captain's note, verbatim -->
          <p class="route-note full" data-en="We recommend 4 blocks max. Beauty is about the detail, not necessarily scale." data-es="Recomendamos 4 cuadras como máximo. La belleza está en el detalle, no necesariamente en la escala.">We recommend 4 blocks max. Beauty is about the detail, not necessarily scale.</p>

          <div class="field full">
            <label for="l-month" data-en="Preferred month for your cleanup *" data-es="Mes preferido para tu limpieza *">Preferred month for your cleanup *</label>
            <select id="l-month" name="preferredMonth" required>
              <option value="" selected disabled data-en="Choose a month" data-es="Elige un mes">Choose a month</option>
              {monthOptions.map((m) => (
                <option value={m.value} data-en={m.en} data-es={m.es}>{m.en}</option>
              ))}
            </select>
          </div>

          <div class="field full">
            <label for="l-photos"><span data-en="Photos of the route" data-es="Fotos de la ruta">Photos of the route</span> <span class="opt" data-en="(optional · up to 5 photos, JPG, PNG, WebP or HEIC, 10 MB each)" data-es="(opcional · hasta 5 fotos, JPG, PNG, WebP o HEIC, 10 MB cada una)">(optional · up to 5 photos, JPG, PNG, WebP or HEIC, 10 MB each)</span></label>
            <label class="drop-zone" for="l-photos">
              <!-- No HEIC in accept on purpose: iOS then hands over a JPEG
                   conversion of HEIC photos itself; anything still exotic is
                   converted (or rejected) by the picker script below. -->
              <input id="l-photos" type="file" accept="image/jpeg,image/png,image/webp" multiple />
              <span class="dz-text"><b data-en="Add photos" data-es="Agrega fotos">Add photos</b> <span data-en="or drag them here" data-es="o arrástralas aquí">or drag them here</span></span>
            </label>
            <div class="thumbs" id="thumbs"></div>
            <p class="dz-err f-err" id="dzErr" hidden></p>
            <p class="dz-note" data-en="Kept secure — photos are stored privately and stripped of location data." data-es="Se guardan de forma segura — las fotos se almacenan en privado y sin datos de ubicación.">Kept secure — photos are stored privately and stripped of location data.</p>
          </div>

          {turnstileSiteKey && (
            <div class="field full turnstile-group">
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="lead" data-theme="light"></div>
            </div>
          )}

          <button type="submit" class="btn btn-primary full form-submit" data-en="Apply to lead →" data-es="Postúlate para liderar →">Apply to lead →</button>
          <p class="form-error full" id="leadFormError" aria-live="polite"></p>
        </form>
      </div>
    </div>

  </section>

  <section class="ct-join" aria-labelledby="joinBannerHeading">
    <div class="wrap ct-join-grid">
      <div>
        <h2 id="joinBannerHeading" data-en="Help out behind the scenes" data-es="Ayuda detrás de cámaras">Help out behind the scenes</h2>
        <p data-en="There are open roles, but if there's something or someone we're missing, our inbox is open." data-es="Hay puestos abiertos, pero si falta algo o alguien que no hemos visto, nuestro correo está abierto.">There are open roles, but if there's something or someone we're missing, our inbox is open.</p>
        <a class="btn btn-primary" href="/recruit" data-en="See more →" data-es="Ver más →">See more →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── HERO ── */
  /* One brick-frame behavior site-wide (captain): the two halves run
     edge to edge and scale with the viewport, and the vw-proportional
     padding keeps the content inside the opening between them — same
     pattern as the homepage and Club Events heroes. */
  .ct-hero {
    position: relative;
    overflow: hidden;
    border-bottom: var(--ink);
  }

  .ct-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: calc(100vw * 0.17) 22px calc(100vw * 0.17);
  }

  .ct-eyebrow { color: var(--yellow); }

  .ct-title {
    font-size: 4rem;
    color: var(--beige);
    text-align: center;
    line-height: 0.92;
  }

  .ct-title .accent { color: var(--lavender); }

  @media (min-width: 761px) {
    .ct-hero-inner { padding: calc(100vw * 0.095) 16px calc(100vw * 0.09); }
    .ct-title { font-size: clamp(4.6rem, 9.5vw, 8rem); }
  }

  /* ── BODY ── */
  .ct-body {
    display: grid;
    grid-template-columns: minmax(0, 62rem);
    justify-content: center;
    /* A full section of its own (captain, 2026-10-09): generous room
       above and below the picker */
    padding-block: 72px 88px;
  }

  .ct-form {
    --flyer-bg: var(--paper);
    color: var(--black);
    padding: 22px 14px;
  }

  .pick-label { color: var(--black); margin-bottom: 10px; }

  /* ── TILES ── */
  .tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 6px;
  }

  .tile {
    display: grid;
    gap: 4px;
    justify-items: start;
    align-content: start;
    text-align: left;
    padding: 12px;
    border: var(--ink);
    border-radius: 10px;
    background: var(--paper-bright);
    color: var(--black);
    cursor: pointer;
    transition: transform 0.12s;
  }

  .tile:hover { transform: translate(-1px, -2px); background: var(--yellow); }

  .tile b {
    font-family: var(--body);
    font-weight: 700;
    font-size: 1.1rem;
    line-height: 1.05;
  }

  .tile small { font-size: 0.9rem; line-height: 1.25; opacity: 0.8; }

  .tile[aria-pressed='true'] {
    background: var(--purple);
    color: var(--beige);
    border-color: var(--purple);
  }

  .tile[aria-pressed='true'] img { filter: brightness(0) invert(0.92); }

  /* ── FORM AREA ── */
  .form-area {
    margin-top: 22px;
    padding-top: 22px;
    border-top: 2px dashed var(--black);
  }

  .form-area[hidden] { display: none; }

  .form-area h2 {
    font-size: clamp(2.2rem, 3.6vw, 3rem);
    color: var(--purple);
    margin-bottom: 16px;
  }

  .form-area .intro { margin: -6px 0 20px; font-size: 1.08rem; }

  .form-area form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 12px 10px;
  }

  .form-area form[hidden] { display: none; }
  .form-area :global(.field[hidden]) { display: none; }

  .form-area label { font-size: 0.88rem; }

  .form-area input:not([type='checkbox']):not([type='file']),
  .form-area select,
  .form-area textarea { font-size: 0.95rem; padding: 8px 10px; }

  .form-area textarea { min-height: 120px; }

  .bare-fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  .bare-fieldset legend { padding: 0; margin-bottom: 6px; }

  .route-note {
    margin: -2px 0 0;
    font-size: 0.95rem;
    color: var(--green);
  }

  /* ── PHOTO DROP ZONE ── */
  .drop-zone {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 96px;
    border: 2.5px dashed var(--black);
    border-radius: 10px;
    background: var(--paper-bright);
    cursor: pointer;
    text-align: center;
    padding: 14px;
  }

  .drop-zone:hover,
  .drop-zone.over { background: var(--yellow); }

  .drop-zone input {
    position: absolute;
    width: 1px;
    height: 1px;
    min-height: 0;
    opacity: 0;
  }

  .drop-zone:focus-within { outline: 3px solid var(--purple); outline-offset: 2px; }

  .dz-text { font-size: 1rem; }

  .thumbs { display: flex; flex-wrap: wrap; gap: 8px; }
  .thumbs:empty { display: none; }

  .thumbs :global(img) {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border: 2px solid var(--black);
    border-radius: 6px;
  }

  .dz-note { margin: 0; font-size: 0.85rem; opacity: 0.65; }

  .turnstile-group { min-height: 65px; }

  .form-area :global(.form-submit) { font-size: 1rem; padding: 15px; }

  .form-error {
    font-size: 0.9rem;
    font-weight: 700;
    text-align: center;
    color: var(--error);
    margin: 0;
  }

  .form-error:empty { display: none; }

  /* ── SUCCESS ── */
  .form-success {
    display: none;
    text-align: center;
    padding: 2rem 1rem;
  }

  .form-success .success-icon { font-size: 2.5rem; margin-bottom: 1rem; color: var(--green); }
  .form-success h3 { font-size: 2.2rem; color: var(--purple); margin-bottom: 0.5rem; }
  .form-success p { font-weight: 500; }

  /* ── BEHIND THE SCENES ── */
  /* A full-width Post No Bills band, the same shape as the homepage's
     behind-the-scenes section */
  .ct-join {
    background-color: var(--green);
    color: var(--beige);
    border-top: 3px solid var(--beige);
    padding-block: 36px 48px;
  }

  .ct-join-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    align-items: center;
  }

  .ct-join h2 { font-size: 2.6rem; margin-bottom: 12px; }
  .ct-join p { margin: 0 0 24px; max-width: 52ch; font-size: 1.12rem; line-height: 1.55; }
  .ct-join .btn { width: 100%; }

  @media (min-width: 761px) {
    .ct-body { padding-block: 128px 144px; }

    .ct-form { padding: 30px clamp(18px, 3vw, 36px); }
    .tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
    .tile { padding: 14px 14px 16px; }
    .tile b { font-size: 1.2rem; }
    .form-area form { gap: 14px 12px; }
    .form-area label { font-size: 1rem; }

    .form-area input:not([type='checkbox']):not([type='file']),
    .form-area select,
    .form-area textarea { font-size: 1.05rem; padding: 9px 12px; }

    .ct-join { padding-block: 56px 72px; }
    .ct-join h2 { font-size: clamp(2.8rem, 5vw, 4.2rem); }
    .ct-join .btn { width: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile { transition: none; }
  }
</style>

<script>
  import { actions, isInputError } from 'astro:actions';
  import { getCurrentLang, onLanguageChange, submitErrorText, type Lang } from '../lib/language';
  import { attachFieldValidation, setFieldError } from '../lib/clientValidation';
  import { rollingMonths } from '../lib/months';
  import { attachCombobox, fetchJson, type BilingualText, type ComboOption, type Combobox } from '../lib/combobox';
  import { ADDRESS_UNAVAILABLE } from '../lib/addressErrors';

  attachFieldValidation();

  document.querySelectorAll<HTMLInputElement>('[data-started-at]').forEach((el) => {
    el.value = String(Date.now());
  });

  type TileType = 'lead' | 'partnership' | 'sponsor' | 'general';

  const tiles = Array.from(document.querySelectorAll<HTMLButtonElement>('.tile'));
  const formArea = document.getElementById('formArea') as HTMLElement;
  const headingEl = document.getElementById('formHeading') as HTMLElement;
  const introEl = document.getElementById('formIntro') as HTMLElement;
  const msgForm = document.getElementById('contactForm') as HTMLFormElement;
  const leadForm = document.getElementById('leadForm') as HTMLFormElement;
  const orgGroup = document.getElementById('orgGroup') as HTMLElement;
  const orgInput = document.getElementById('c-org') as HTMLInputElement;
  const inquiryTypeInput = document.getElementById('inquiryType') as HTMLInputElement;
  const successDiv = document.getElementById('formSuccess') as HTMLElement;
  const contactErrorEl = document.getElementById('contactFormError') as HTMLElement;
  const leadErrorEl = document.getElementById('leadFormError') as HTMLElement;

  let currentType: TileType | null = null;

  // formHeading/formIntro intentionally carry no data-en/data-es attributes —
  // their text depends on the picked tile as well as language, so this object
  // is the sole owner of their content.
  const copy: Record<TileType, Record<Lang, { heading: string; intro: string }>> = {
    lead: {
      en: { heading: 'Apply to lead a cleanup with Trash Talk NYC', intro: '' },
      es: { heading: 'Postúlate para liderar una limpieza con Trash Talk NYC', intro: '' },
    },
    partnership: {
      en: { heading: 'Collaborate with Trash Talk NYC', intro: "Have an idea to create something together? Whether you're an organization, a creator, or a community partner, let's discuss!" },
      es: { heading: 'Colabora con Trash Talk NYC', intro: '¿Tienes una idea para crear algo juntos? Seas una organización, creador o aliado comunitario, ¡hablemos!' },
    },
    sponsor: {
      en: { heading: 'Sponsor Trash Talk NYC', intro: 'Companies and brands: put your name behind cleanup events, supplies, and a cleaner New York City.' },
      es: { heading: 'Patrocina a Trash Talk NYC', intro: 'Empresas y marcas: pongan su nombre detrás de eventos de limpieza, materiales y una Nueva York más limpia.' },
    },
    general: {
      en: { heading: 'Message Trash Talk NYC', intro: 'Questions, concerns, or report a bug on the site.' },
      es: { heading: 'Escríbenos', intro: 'Preguntas, comentarios o reporta un error en el sitio.' },
    },
  };

  function applyCopy() {
    if (!currentType) return;
    const c = copy[currentType][getCurrentLang()];
    headingEl.textContent = c.heading;
    introEl.textContent = c.intro;
    introEl.hidden = !c.intro;
  }

  /** Resets a form's single-use Turnstile widget (each form has its own). */
  function resetTurnstile(form: HTMLFormElement) {
    const widget = form.querySelector<HTMLElement>('.cf-turnstile');
    if (widget) window.turnstile?.reset(widget);
  }

  /**
   * A submission hides the forms behind the success view; picking a tile
   * afterwards must bring the right form back or the new choice appears
   * dead. Message content is cleared (it belonged to the previous
   * inquiry) but identity fields are kept so the sender doesn't retype.
   */
  function restoreAfterSuccess() {
    if (successDiv.style.display !== 'block') return;
    successDiv.style.display = '';
    resetTurnstile(msgForm);
    resetTurnstile(leadForm);
    const messageInput = msgForm.elements.namedItem('message') as HTMLTextAreaElement | null;
    if (messageInput) messageInput.value = '';
  }

  function setType(type: TileType) {
    currentType = type;
    tiles.forEach((tile) => tile.setAttribute('aria-pressed', String(tile.dataset.type === type)));
    formArea.hidden = false;
    restoreAfterSuccess();

    const isLead = type === 'lead';
    msgForm.hidden = isLead;
    leadForm.hidden = !isLead;

    if (!isLead) {
      // Both org-backed inquiries (Collaborate and Sponsor) come from an
      // organization, so the org field shows and is required for either
      const needsOrg = type !== 'general';
      orgGroup.hidden = !needsOrg;
      orgInput.required = needsOrg;
      inquiryTypeInput.value = type;
    }

    // Errors belong to the previous inquiry attempt
    contactErrorEl.textContent = '';
    leadErrorEl.textContent = '';
    applyCopy();
  }

  tiles.forEach((tile) => {
    tile.addEventListener('click', () => setType(tile.dataset.type as TileType));
  });

  onLanguageChange((lang) => {
    applyCopy();
    if (contactErrorEl.textContent) contactErrorEl.textContent = submitErrorText(lang);
    if (leadErrorEl.textContent) leadErrorEl.textContent = submitErrorText(lang);
  });

  // ── CHIP RADIOS (behalf, route type) ──
  /** Wires a chip group; returns a picker so the group can be set programmatically. */
  function wireChips(selector: string, onPick: (value: string) => void): (value: string) => void {
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(selector));
    const valueOf = (chip: HTMLButtonElement) => chip.dataset.behalf ?? chip.dataset.route ?? '';
    function pick(chip: HTMLButtonElement) {
      chips.forEach((c) => c.setAttribute('aria-checked', String(c === chip)));
      onPick(valueOf(chip));
    }
    chips.forEach((chip) => chip.addEventListener('click', () => pick(chip)));
    return (value) => {
      const chip = chips.find((c) => valueOf(c) === value);
      if (chip) pick(chip);
    };
  }

  const behalfInput = document.getElementById('behalfInput') as HTMLInputElement;
  const pickBehalf = wireChips('[data-behalf]', (v) => { behalfInput.value = v; });

  const routeTypeInput = document.getElementById('routeTypeInput') as HTMLInputElement;
  const endGroup = document.getElementById('endGroup') as HTMLElement;
  const endInput = document.getElementById('l-end') as HTMLInputElement;
  const pickRoute = wireChips('[data-route]', (v) => {
    routeTypeInput.value = v;
    const oneway = v === 'oneway';
    endGroup.hidden = !oneway;
    endInput.required = oneway;
    if (!oneway) addressPickers.get(endInput)?.combo.reset();
  });

  // ── NYC ADDRESS PICKER (GeoSearch autocomplete) ──
  // People pick a real suggestion; free text never satisfies the field.
  // The chosen feature's id and map point travel with its label so the
  // action can verify that exact feature server-side. GeoSearch being unreachable
  // blocks the pick (the server rejects unverifiable addresses anyway),
  // so the applicant is told to retry instead of hitting a generic error.
  const ADDR_MSG = {
    pick: { en: 'Pick an address from the list so we can find it on the map.', es: 'Elige una dirección de la lista para poder ubicarla en el mapa.' },
    none: { en: 'No NYC match yet. Keep typing the street and cross street.', es: 'Aún no hay coincidencias en NYC. Sigue escribiendo la calle y la transversal.' },
    unavailable: { en: "We couldn't reach the map just now. Please try again in a moment.", es: 'No pudimos conectar con el mapa. Inténtalo de nuevo en un momento.' },
  };

  type GeoSearchAutocomplete = {
    features?: Array<{
      geometry?: { coordinates?: number[] };
      properties?: { gid?: string; label?: string; name?: string; borough?: string; postalcode?: string };
    }>;
  };

  /** GeoJSON `lon,lat` of every suggested feature, keyed by gid. */
  const featurePoints = new Map<string, string>();

  async function searchNycAddresses(query: string): Promise<ComboOption[]> {
    const data = await fetchJson<GeoSearchAutocomplete>(
      `https://geosearch.planninglabs.nyc/v2/autocomplete?text=${encodeURIComponent(query)}&size=6`,
    );
    return (data.features ?? [])
      .filter((f) => !!f.properties?.label && !!f.properties.gid && f.geometry?.coordinates?.length === 2)
      .slice(0, 6)
      .map(({ geometry, properties: p }) => {
        featurePoints.set(p!.gid!, geometry!.coordinates!.join(','));
        return {
          value: p!.label!,
          text: p!.name ?? p!.label!,
          detail: [p!.borough, p!.postalcode].filter(Boolean).join(' ') || undefined,
          id: p!.gid,
        };
      });
  }

  type AddressPicker = { combo: Combobox; reject: () => void; unavailable: () => void };
  const addressPickers = new Map<HTMLInputElement, AddressPicker>();

  document.querySelectorAll<HTMLElement>('#leadForm .addr').forEach((wrap) => {
    const input = wrap.querySelector<HTMLInputElement>('.addr-in')!;
    const idInput = wrap.querySelector<HTMLInputElement>('.addr-id')!;
    const pointInput = wrap.querySelector<HTMLInputElement>('.addr-point')!;
    const ok = wrap.querySelector<HTMLParagraphElement>('.addr-ok')!;
    const err = wrap.querySelector<HTMLParagraphElement>('.addr-err')!;

    function showError(message: BilingualText | null) {
      err.hidden = !message;
      err.textContent = message ? message[getCurrentLang()] : '';
      if (message) {
        err.setAttribute('data-en', message.en);
        err.setAttribute('data-es', message.es);
        input.setAttribute('aria-describedby', err.id);
      } else {
        err.removeAttribute('data-en');
        err.removeAttribute('data-es');
        input.removeAttribute('aria-describedby');
      }
      input.setAttribute('aria-invalid', String(!!message));
    }

    const combo = attachCombobox({
      input,
      list: wrap.querySelector<HTMLUListElement>('.addr-list')!,
      search: searchNycAddresses,
      pickMessage: ADDR_MSG.pick,
      emptyMessage: ADDR_MSG.none,
      onChange: (option) => {
        idInput.value = option?.id ?? '';
        pointInput.value = (option?.id && featurePoints.get(option.id)) ?? '';
        ok.hidden = !option;
        showError(null);
      },
      onUnavailable: (picker) => picker.setInvalid(ADDR_MSG.unavailable),
    });
    addressPickers.set(input, {
      combo,
      // The server couldn't verify this pick: clear it so the applicant
      // re-picks, and say why right under the field.
      reject() {
        combo.reset();
        combo.setInvalid(ADDR_MSG.pick);
        showError(ADDR_MSG.pick);
      },
      // The map service was down at submit: the pick itself may be fine,
      // so it stays and the applicant can simply resubmit shortly.
      unavailable() {
        showError(ADDR_MSG.unavailable);
      },
    });
  });

  // ── ROLLING MONTHS ──
  // Re-derive on load so a page built weeks ago never offers a month
  // that has already passed.
  const monthSelect = document.getElementById('l-month') as HTMLSelectElement;
  {
    const placeholder = monthSelect.options[0];
    const fresh = rollingMonths();
    monthSelect.innerHTML = '';
    monthSelect.append(placeholder);
    fresh.forEach((m) => {
      const opt = document.createElement('option');
      opt.value = m.value;
      opt.textContent = getCurrentLang() === 'es' ? m.es : m.en;
      opt.setAttribute('data-en', m.en);
      opt.setAttribute('data-es', m.es);
      monthSelect.append(opt);
    });
    placeholder.selected = true;
  }

  // ── PHOTOS ──
  // Client-side: enforce the captain's limits (images only, max 5,
  // 10 MB each) and re-encode to bounded JPEGs before upload — that is
  // what lets iPhone HEIC photos through (iOS hands the input a JPEG)
  // and keeps the upload under the platform's request-size budget. The
  // server re-validates content and re-encodes again regardless.
  const MAX_PHOTOS = 5;
  const MAX_PHOTO_BYTES = 10 * 1024 * 1024;
  const MAX_UPLOAD_TOTAL = 4.5 * 1024 * 1024;
  const OK_TYPES = ['image/jpeg', 'image/png', 'image/webp', 'image/heic', 'image/heif'];

  const photoInput = document.getElementById('l-photos') as HTMLInputElement;
  const dropZone = photoInput.closest('.drop-zone') as HTMLElement;
  const thumbs = document.getElementById('thumbs') as HTMLElement;
  const dzErr = document.getElementById('dzErr') as HTMLParagraphElement;

  let pickedPhotos: File[] = [];

  const DZ_MSG = {
    type: { en: 'Only JPG, PNG, WebP or HEIC photos up to 10 MB each can be added.', es: 'Solo se pueden agregar fotos JPG, PNG, WebP o HEIC de hasta 10 MB cada una.' },
    count: { en: 'Up to 5 photos. Only the first 5 were kept.', es: 'Hasta 5 fotos. Solo se conservaron las primeras 5.' },
    total: { en: 'Those photos are too large together. Please remove one or use smaller photos.', es: 'Esas fotos juntas son demasiado pesadas. Quita una o usa fotos más pequeñas.' },
    decode: { en: "One photo couldn't be read. Please use JPG, PNG or WebP.", es: 'No se pudo leer una foto. Usa JPG, PNG o WebP.' },
  };

  function showDzError(key: keyof typeof DZ_MSG | null) {
    dzErr.hidden = !key;
    dzErr.textContent = key ? DZ_MSG[key][getCurrentLang()] : '';
  }

  /** Decode + re-encode one photo to a ≤2048px JPEG in the browser. */
  async function toJpeg(file: File): Promise<File | null> {
    try {
      const bitmap = await createImageBitmap(file);
      const scale = Math.min(1, 2048 / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.max(1, Math.round(bitmap.width * scale));
      canvas.height = Math.max(1, Math.round(bitmap.height * scale));
      canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      bitmap.close();
      const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.82));
      if (!blob) return null;
      const base = file.name.replace(/\.[^.]*$/, '') || 'route-photo';
      return new File([blob], `${base}.jpg`, { type: 'image/jpeg' });
    } catch {
      return null;
    }
  }

  async function takeFiles(files: FileList | File[]) {
    showDzError(null);
    const list = [...files];
    const typeOk = list.filter((f) => OK_TYPES.includes(f.type) && f.size <= MAX_PHOTO_BYTES);
    if (typeOk.length < list.length) showDzError('type');

    const capped = typeOk.slice(0, MAX_PHOTOS);
    if (typeOk.length > MAX_PHOTOS) showDzError('count');

    const processed: File[] = [];
    for (const file of capped) {
      const jpeg = await toJpeg(file);
      if (jpeg) {
        processed.push(jpeg);
      } else if (file.type === 'image/jpeg' || file.type === 'image/png' || file.type === 'image/webp') {
        // Couldn't re-encode but the original is already a safe type —
        // send it as-is if it fits the upload budget.
        processed.push(file);
      } else {
        showDzError('decode');
      }
    }

    if (processed.reduce((sum, f) => sum + f.size, 0) > MAX_UPLOAD_TOTAL) {
      showDzError('total');
      return;
    }

    pickedPhotos = processed;
    thumbs.replaceChildren();
    pickedPhotos.forEach((f) => {
      const img = document.createElement('img');
      img.src = URL.createObjectURL(f);
      img.alt = f.name;
      img.addEventListener('load', () => URL.revokeObjectURL(img.src));
      thumbs.append(img);
    });
  }

  photoInput.addEventListener('change', () => {
    if (photoInput.files) void takeFiles(photoInput.files);
  });

  ['dragover', 'dragenter'].forEach((ev) =>
    dropZone.addEventListener(ev, (e) => { e.preventDefault(); dropZone.classList.add('over'); }),
  );
  ['dragleave', 'drop'].forEach((ev) =>
    dropZone.addEventListener(ev, (e) => { e.preventDefault(); dropZone.classList.remove('over'); }),
  );
  dropZone.addEventListener('drop', (e) => {
    const dt = (e as DragEvent).dataTransfer;
    if (dt?.files) void takeFiles(dt.files);
  });

  /**
   * After a successful application the lead form goes back to a blank
   * slate, so picking the tile again can't resend the previous
   * applicant's details or photos.
   */
  function resetLeadForm() {
    leadForm.reset();
    pickBehalf('individual');
    pickRoute('loop');
    addressPickers.forEach((picker) => picker.combo.reset());
    monthSelect.selectedIndex = 0;
    pickedPhotos = [];
    thumbs.replaceChildren();
    photoInput.value = '';
    showDzError(null);
    leadForm.querySelectorAll<HTMLInputElement>('input[aria-invalid]').forEach((input) => setFieldError(input, ''));
    leadErrorEl.textContent = '';
  }

  const startInput = document.getElementById('l-start') as HTMLInputElement;

  /**
   * Puts the server's address rejections on the address fields
   * themselves. Returns true when every rejected field was an address,
   * so the generic form error isn't needed.
   */
  function showAddressErrors(error: unknown): boolean {
    if (!isInputError(error)) return false;
    const fields = Object.entries(error.fields) as Array<[string, string[] | undefined]>;
    let addressOnly = fields.length > 0;
    for (const [field, messages] of fields) {
      const input = field.startsWith('startAddress') ? startInput : field.startsWith('endAddress') ? endInput : null;
      const picker = input && addressPickers.get(input);
      if (!picker) {
        addressOnly = false;
        continue;
      }
      if (messages?.includes(ADDRESS_UNAVAILABLE)) picker.unavailable();
      else picker.reject();
    }
    const first = [startInput, endInput].find((input) => input.getAttribute('aria-invalid') === 'true');
    first?.focus();
    return addressOnly;
  }

  // ── SUBMITS ──
  function wireSubmit(
    form: HTMLFormElement,
    errorEl: HTMLElement,
    send: (data: FormData) => Promise<{ error: unknown }>,
    showFieldErrors: (error: unknown) => boolean = () => false,
  ) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('.form-submit')!;
      const originalText = btn.textContent ?? '';
      btn.disabled = true;
      btn.textContent = getCurrentLang() === 'es' ? 'Enviando…' : 'Sending…';
      errorEl.textContent = '';

      const data = new FormData(form);
      if (form === leadForm) {
        // The input element's FileList may hold originals; the processed
        // JPEGs are what actually upload.
        data.delete('photos');
        pickedPhotos.forEach((f) => data.append('photos', f));
      }

      const { error } = await send(data);

      if (!error) {
        // Picking a tile again restores the right form via setType
        msgForm.hidden = true;
        leadForm.hidden = true;
        if (form === leadForm) resetLeadForm();
        successDiv.style.display = 'block';
        btn.disabled = false;
        btn.textContent = originalText;
        return;
      }

      // Turnstile tokens are single-use — the failed attempt consumed
      // this one, so reset the widget or a retry would submit a spent token
      resetTurnstile(form);

      if (showFieldErrors(error)) {
        btn.textContent = originalText;
        btn.disabled = false;
        return;
      }

      errorEl.textContent = submitErrorText(getCurrentLang());
      btn.textContent = submitErrorText(getCurrentLang());
      btn.disabled = false;
      setTimeout(() => { btn.textContent = originalText; }, 3500);
    });
  }

  wireSubmit(msgForm, contactErrorEl, (data) => actions.contact(data));
  wireSubmit(leadForm, leadErrorEl, (data) => actions.leadCleanup(data), showAddressErrors);
</script>
