# Eventbrite integration (build-time event fetch)
EVENTBRITE_TOKEN=
EVENTBRITE_ORGANIZER_ID=

# Brevo (form submissions → Brevo contact lists via Astro Actions).
# All four MUST be set for the forms to work; the actions fail with a
# logged error + generic user-facing message if any is missing.
BREVO_API_KEY=
# Numeric ID of the Brevo list named "signups_list" (home-page volunteer signup form)
BREVO_LIST_ID_SIGNUP=
# Contact form list IDs, one per tab. Deliberately short names (no
# BREVO_LIST_ID_ prefix): Netlify rejected the longer variable names,
# so these match what is actually configured there.
# General tab
CONTACT_GENERAL=
# Collaborate/partnership tab
CONTACT_COLLAB=

# Cloudflare Turnstile (bot check on both forms — blocks bot pollution of
# the paid Brevo list). Dormant until provisioned: with the site key unset
# no widget renders and the actions skip verification (logged as
# turnstile_not_configured). Once the site key is set, the secret is
# required or submissions fail. The site key bakes into the prerendered
# pages at BUILD time, so setting it in Netlify needs a redeploy.
# Cloudflare's public test keys (always pass, for local dev):
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
