# Eventbrite integration (build-time event fetch)
EVENTBRITE_TOKEN=
EVENTBRITE_ORGANIZER_ID=

# Brevo (form submissions → Brevo contact lists via Astro Actions).
# All of these MUST be set for the forms to work; the actions fail with a
# logged error + generic user-facing message if any is missing.
BREVO_API_KEY=
# Numeric ID of the Brevo list named "signups_list" (home-page volunteer signup form)
BREVO_LIST_ID_SIGNUP=
# Contact form list IDs, one per tab. Deliberately short names (no
# BREVO_LIST_ID_ prefix): Netlify rejected the longer variable names,
# so these match what is actually configured there.
# General tab
CONTACT_GENERAL=
# Collaborate/partnership tab
CONTACT_COLLAB=
# Sponsor tab — the Brevo sponsors list, list ID 13. This must ALSO be set in
# the Netlify env (all deploy contexts) or production sponsor submissions fail
# loudly (form_env_missing + generic form error) rather than landing in
# another list.
CONTACT_SPONSOR=13
# Lead a Cleanup applications (the fourth contact tile, 2026-10 redesign).
# Numeric ID of the Brevo leads list — the list must be created in Brevo and
# this var set in Netlify per context, or lead submissions fail loudly
# (form_env_missing + generic form error), exactly like the sponsor tab.
BREVO_LIST_ID_LEADS=

# Team notification for contact-page inquiries (every tile, Lead a Cleanup
# included). When someone submits, the team is emailed the inquiry details
# with reply-to set to the sender, and the subject differs by tile ("New
# collaboration inquiry — …" / "New sponsorship inquiry — …" / "New
# cleanup-lead application — …" vs "New contact message — …"). Dormant until
# CONTACT_NOTIFY_FROM is set, so non-production environments send nothing.
# Point the recipient vars at a test inbox in preview/staging; use the real
# recipients only in production. Recipient vars may be comma-separated lists
# to alert several addresses. CONTACT_NOTIFY_FROM must be a Brevo-verified
# sender.
#
# Each kind of inquiry has its own inbox (captain, 2026-10-15), with NO
# fallback between them: an unset var means that inquiry sends no email and
# the function logs an error naming the var (inquiry_notify_unconfigured),
# never a misroute. See src/lib/server/notifyRouting.ts.
# General tile
CONTACT_NOTIFY_TO=
# Sponsor tile (sponsors@trashtalknyc.org in production)
SPONSOR_NOTIFY_TO=
# Partner tile: content collaboration, content creation, influencer,
# corporate event, and other partnerships
PARTNER_CONTENT_NOTIFY_TO=
# Partner tile: podcast partnerships
PODCAST_NOTIFY_TO=
# Partner tile: nonprofit partnerships
NONPROFIT_NOTIFY_TO=
# Lead a Cleanup tile
LEAD_NOTIFY_TO=
CONTACT_NOTIFY_FROM=

# Cloudflare Turnstile (bot check on all three forms — blocks bot pollution of
# the paid Brevo list). Dormant until provisioned: with the site key unset
# no widget renders and the actions skip verification (logged as
# turnstile_not_configured). Once the site key is set, the secret is
# required or submissions fail. The site key bakes into the prerendered
# pages at BUILD time, so setting it in Netlify needs a redeploy.
# Cloudflare's public test keys (always pass, for local dev):
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
# WARNING: the dummy secret above is written in this repo as documentation,
# so if you set TURNSTILE_SECRET_KEY to it in a Netlify context, Netlify's
# secrets scanner matches the value against these files and FAILS THE BUILD
# (exit code 2) unless that context has
# SECRETS_SCAN_OMIT_KEYS=TURNSTILE_SECRET_KEY. Non-production contexts only —
# never add the omission to production, where the real secret must stay
# scanned. See AGENTS.md, "Turnstile bot check".
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
