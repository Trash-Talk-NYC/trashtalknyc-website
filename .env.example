# Eventbrite integration (build-time event fetch)
EVENTBRITE_TOKEN=
EVENTBRITE_ORGANIZER_ID=

# Brevo (form submissions → Brevo contact lists via Astro Actions).
# All three MUST be filled in before the forms go live; the actions fail
# with a logged error + generic user-facing message if any is missing.
BREVO_API_KEY=
# Numeric ID of the Brevo list named "signups_list" (home-page volunteer signup form)
BREVO_LIST_ID_SIGNUP=
# Numeric ID of the Brevo list for contact/partnership inquiries
BREVO_LIST_ID_CONTACT=
