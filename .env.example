# Eventbrite integration (build-time event fetch)
EVENTBRITE_TOKEN=
EVENTBRITE_ORGANIZER_ID=

# Brevo (form submissions → Brevo contact lists via Astro Actions).
# All of these MUST be set for the forms to work; the actions fail with a
# logged error + generic user-facing message if any is missing.
BREVO_API_KEY=
# Numeric ID of the Brevo list named "signups_list" (home-page volunteer signup form)
BREVO_LIST_ID_SIGNUP=
# Contact form list IDs, one per tab. Deliberately short names (no
# BREVO_LIST_ID_ prefix): Netlify rejected the longer variable names,
# so these match what is actually configured there.
# General tab
CONTACT_GENERAL=
# Collaborate/partnership tab
CONTACT_COLLAB=
# Sponsor tab — the Brevo sponsors list, list ID 13. This must ALSO be set in
# the Netlify env (all deploy contexts) or production sponsor submissions fail
# loudly (form_env_missing + generic form error) rather than landing in
# another list.
CONTACT_SPONSOR=13

# Team notification for contact-form inquiries (all tabs). When someone
# submits, the team is emailed the inquiry details with reply-to set to the
# sender, and the subject differs by tab ("New collaboration inquiry — …" /
# "New sponsorship inquiry — …" vs "New contact message — …"). Dormant until
# both a recipient and CONTACT_NOTIFY_FROM are set, so non-production
# environments send nothing. Point CONTACT_NOTIFY_TO at a test inbox in
# preview/staging; use the real recipient only in production. Recipient vars
# may be comma-separated lists to alert several addresses.
# CONTACT_NOTIFY_FROM must be a Brevo-verified sender.
# General + Collaborate tabs
CONTACT_NOTIFY_TO=
# Sponsor tab notifies this address INSTEAD of CONTACT_NOTIFY_TO
# (sponsors@trashtalknyc.org in production). No fallback: if unset, sponsor
# submissions send no notification (logged as inquiry_notify_skipped).
SPONSOR_NOTIFY_TO=
CONTACT_NOTIFY_FROM=

# Cloudflare Turnstile (bot check on both forms — blocks bot pollution of
# the paid Brevo list). Dormant until provisioned: with the site key unset
# no widget renders and the actions skip verification (logged as
# turnstile_not_configured). Once the site key is set, the secret is
# required or submissions fail. The site key bakes into the prerendered
# pages at BUILD time, so setting it in Netlify needs a redeploy.
# Cloudflare's public test keys (always pass, for local dev):
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
